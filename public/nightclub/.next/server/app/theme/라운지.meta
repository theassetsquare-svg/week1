{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/theme/layout,_N_T_/theme/[theme]/layout,_N_T_/theme/[theme]/page,_N_T_/theme/%EB%9D%BC%EC%9A%B4%EC%A7%80/"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/theme/$d$theme/__PAGE__",
    "/theme/$d$theme",
    "/theme",
    "/_index",
    "/_head"
  ]
}