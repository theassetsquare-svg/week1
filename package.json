{
  "name": "nightlife-korea",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "parse": "node scripts/parse-venues.mjs",
    "geocode": "node scripts/geocode.mjs",
    "gen-svgs": "node scripts/generate-venue-svgs.mjs",
    "similarity": "node scripts/similarity-check.mjs",
    "fix-repeat": "node scripts/fix-venue-repetition.mjs",
    "pipeline": "npm run parse && npm run fix-repeat && npm run geocode && npm run gen-svgs",
    "dev": "astro dev",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "search-index": "node scripts/generate-search-index.mjs",
    "gen:card-copy": "node scripts/generate-card-copy.mjs",
    "lint:copy": "node scripts/lint-copy.mjs",
    "build": "node scripts/lint-copy.mjs && node scripts/generate-search-index.mjs && astro build && node scripts/convert-og-to-png.mjs && node scripts/generate-sitemap.mjs && node scripts/generate-rss.mjs && node scripts/generate-redirects.mjs && node scripts/qa_url_duplicates.mjs && node scripts/qa_gate_stage2.mjs && node scripts/qa_funnel.mjs",
    "build:full": "astro build",
    "preview": "astro preview",
    "qa:url": "node scripts/qa_url_duplicates.mjs",
    "qa:repeat": "node scripts/qa_repeat_limit.mjs",
    "qa:brand": "node scripts/qa_brand_count.mjs",
    "qa:similarity": "node scripts/qa_similarity.mjs",
    "qa:seo": "node scripts/qa_seo_meta.mjs",
    "qa:search": "node scripts/qa_search.mjs",
    "qa:all": "node scripts/qa_url_duplicates.mjs && node scripts/qa_repeat_limit.mjs && node scripts/qa_brand_count.mjs && node scripts/qa_similarity.mjs && node scripts/qa_seo_meta.mjs && node scripts/qa_search.mjs",
    "seo:monitor": "node scripts/seo-monitor-24h.mjs",
    "seo:check": "node scripts/seo-monitor-24h.mjs --once",
    "seo:24h": "node scripts/seo-monitor-24h.mjs",
    "seo:audit": "node scripts/seo-audit.mjs",
    "gsc:report": "node scripts/gsc-report.mjs",
    "seo:monitor:all": "node scripts/auto-seo.mjs",
    "seo:autofix": "node scripts/auto-fix.mjs",
    "seo:cron": "bash scripts/seo-cron.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.99.2",
    "astro": "^4.16.0"
  },
  "devDependencies": {
    "playwright": "^1.60.0"
  }
}
