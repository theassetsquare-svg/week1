{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/theme/layout,_N_T_/theme/[theme]/layout,_N_T_/theme/[theme]/page,_N_T_/theme/%EA%B0%90%EC%84%B1%EC%A3%BC%EC%A0%90/"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/theme/$d$theme/__PAGE__",
    "/theme/$d$theme",
    "/theme",
    "/_index",
    "/_head"
  ]
}