---
import type { Venue } from '../utils/venues';
import { getVenueUrl } from '../utils/venues';

interface Props {
  venue: Venue;
}

const { venue: v } = Astro.props;
const url = getVenueUrl(v);
const hook = v.card_hook || v.teaser;
const value = v.card_value || '';
const tags = v.card_tags || [];
const imgAlt = v.image_alt || v.images[0]?.alt || v.name_display;
const mapUrl = v.map_url || `https://map.kakao.com/?q=${encodeURIComponent(v.name_display + ' ' + v.region)}`;
---

<a href={url} target="_blank" rel="noopener noreferrer" class="venue-card" data-region={v.regionSlug} data-name={v.name_display + ' ' + v.region}>
  <div class="vc-inner">
    <div class="vc-thumb">
      <img src={v.images[0].src} alt={imgAlt} width="400" height="400" loading="lazy" />
    </div>
    <div class="vc-body">
      <div class="vc-meta">
        <span class={`vc-type type-${v.type}`}>{v.typeLabel}</span>
        <span class="vc-region">{v.region}</span>
      </div>
      <h3 class="vc-name">{v.name_display}</h3>
      <p class="vc-hook">{hook}</p>
      {value && <p class="vc-value">{value}</p>}
      {tags.length > 0 && (
        <div class="vc-tags">
          {tags.map(tag => <span class="vc-tag">{tag}</span>)}
        </div>
      )}
    </div>
  </div>
</a>

<style>
  /* ── Card inner: horizontal layout ── */
  .vc-inner {
    display: flex;
    gap: 0.875rem;
    padding: 0.875rem;
    height: 100%;
  }

  /* ── Thumbnail ── */
  .vc-thumb {
    width: 100px;
    height: 100px;
    flex-shrink: 0;
    border-radius: 10px;
    overflow: hidden;
    background: var(--bg-accent);
  }
  .vc-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ── Body ── */
  .vc-body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  /* ── Meta: type + region ── */
  .vc-meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 0.2rem;
  }
  .vc-type {
    display: inline-block;
    padding: 0.1rem 0.45rem;
    border-radius: 8px;
    font-size: 0.7rem;
    font-weight: 600;
    line-height: 1.5;
  }
  .vc-region {
    color: var(--text-muted);
    font-size: 0.75rem;
  }

  /* ── Name ── */
  .vc-name {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 0.25rem;
    line-height: 1.35;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ── Hook (main description) ── */
  .vc-hook {
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 0 0 0.2rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ── Value (sub description) ── */
  .vc-value {
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--text-secondary);  /* bumped from text-muted for contrast */
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ── Tags ── */
  .vc-tags {
    display: flex;
    flex-wrap: nowrap;
    gap: 0.3rem;
    margin-top: auto;
    padding-top: 0.4rem;
    overflow: hidden;
  }
  .vc-tag {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.15rem 0.5rem;
    border-radius: 8px;
    background: var(--accent-light, rgba(44,62,122,0.08));
    color: var(--accent);
    white-space: nowrap;
    line-height: 1.4;
    flex-shrink: 0;
  }

  /* ── Responsive: larger cards on wide screens ── */
  @media (min-width: 600px) {
    .vc-thumb { width: 112px; height: 112px; }
    .vc-name { font-size: 1rem; }
    .vc-hook { font-size: 0.9rem; }
  }
</style>
