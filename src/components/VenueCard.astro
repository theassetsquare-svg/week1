---
import type { Venue } from '../data/venues';

interface Props {
  venue: Venue;
  rank?: number;
}

const { venue, rank } = Astro.props;
---

<a href={`/venue/${venue.slug}/`} class="venue-card" target="_blank">
  <div class="venue-card-header">
    {rank && <span class="rank-badge">#{rank}</span>}
    <span class="venue-region-text">{venue.region}</span>
  </div>
  <div class="venue-card-name">{venue.name}</div>
  <div class="venue-card-desc">{venue.shortDesc}</div>
  {venue.tags.length > 0 && (
    <div class="venue-card-tags">
      {venue.tags.slice(0, 3).map(t => (
        <span class="venue-tag">#{t}</span>
      ))}
    </div>
  )}
  {venue.nickname && (
    <div class="venue-card-contact">
      담당: {venue.nickname} {venue.phone && `| ${venue.phone}`}
    </div>
  )}
</a>
