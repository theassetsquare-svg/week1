---
interface Props {
  hook: string;
  valuePromise: string;
  scanBox: string[];
  checklist: string[];
  riskItems: { dont: string; doInstead: string }[];
  teasers: string[];
}
const { hook, valuePromise, scanBox, checklist, riskItems, teasers } = Astro.props;
---
<section class="intro-section" aria-label="핵심 요약">
  <div class="intro-hook">
    <p>{hook}</p>
  </div>

  <p class="intro-value-promise">{valuePromise}</p>

  <div class="intro-scan-box">
    <div class="intro-scan-box__title">한눈에 보기</div>
    <ul class="intro-scan-box__list">
      {scanBox.map(line => <li>{line}</li>)}
    </ul>
  </div>

  <div class="intro-checklist">
    <div class="intro-checklist__title">방문 전 체크</div>
    <ul class="intro-checklist__list">
      {checklist.map(item => (
        <li><span class="intro-check-icon">&#9744;</span> <span>{item}</span></li>
      ))}
    </ul>
  </div>

  <div class="intro-risk">
    <div class="intro-risk__title">실수 방지</div>
    {riskItems.map(r => (
      <div class="intro-risk__item">
        <div class="intro-risk__dont"><span class="intro-risk__icon">&#10007;</span> {r.dont}</div>
        <div class="intro-risk__do"><span class="intro-risk__icon">&#10003;</span> {r.doInstead}</div>
      </div>
    ))}
  </div>

  <div class="intro-teasers">
    <div class="intro-teasers__title">이 페이지에서 확인할 수 있는 정보</div>
    {teasers.map(t => (
      <p class="intro-teaser__item">{t}</p>
    ))}
  </div>
</section>
