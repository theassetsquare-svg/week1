---
import '../styles/global.css';
import { MAIN_SITE_URL, SITE_URL, SLOGAN, SITE_NAME } from '../data/venues';

interface Props {
  title: string;
  description: string;
  h1?: string;
  canonical?: string;
  ogImage?: string;
  jsonLd?: object;
  phone?: string;
  nickname?: string;
}

const { title, description, h1, canonical, ogImage, jsonLd, phone, nickname } = Astro.props;
const canonicalUrl = canonical || new URL(Astro.url.pathname, SITE_URL).href;
const defaultOgImage = `${SITE_URL}/og-default.svg`;
const finalOgImage = ogImage || defaultOgImage;
const currentYear = new Date().getFullYear();
---

<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="google-site-verification" content="HJjm7MRxykCQ7d_9L7glaTeeaWrmJIzAKY0BcNcfm88" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <meta name="robots" content="index, follow" />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:locale" content="ko_KR" />
  <meta property="og:image" content={finalOgImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={finalOgImage} />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="theme-color" content="#8B5CF6" />
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
  <style>
    /* FOUC 방지: 폰트 로딩 전 깜빡임 차단 */
    html { visibility: visible; }
    body { opacity: 1; }
  </style>

  {jsonLd && (
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  )}
</head>
<body>
  <div class="scroll-progress" id="scrollProgress"></div>

  <!-- Hooking #1: 상단 고정 배너 -->
  <div class="top-banner">
    <a href={MAIN_SITE_URL} target="_blank" rel="noopener noreferrer">
      찐 후기+실시간 예약은 ★밤키★에서 →
    </a>
  </div>

  <div class="age-notice">
    <span>본 사이트는 만 19세 이상 성인만 이용 가능합니다</span>
    <span style="margin-left:12px;color:var(--accent);font-weight:600;" id="fomoCounter"></span>
  </div>

  <header class="site-header">
    <div class="header-inner">
      <a href="/" target="_blank" rel="noopener noreferrer" class="site-logo">밤키</a>
      <div class="header-right">
        <a href="/ranking/" target="_blank" rel="noopener noreferrer" class="header-search-btn" aria-label="랭킹">🏆</a>
        <a href="/community/" target="_blank" rel="noopener noreferrer" class="header-search-btn" aria-label="커뮤니티">💬</a>
        <button class="header-menu-btn" id="menuBtn" aria-label="메뉴">☰</button>
      </div>
    </div>
    <!-- 카테고리 탭 (항상 보이는 가로 스크롤) -->
    <div class="cat-tabs">
      <a href="/clubs/" target="_blank" rel="noopener noreferrer" class="cat-tab">🎵 클럽</a>
      <a href="/nights/" target="_blank" rel="noopener noreferrer" class="cat-tab">🌙 나이트</a>
      <a href="/lounges/" target="_blank" rel="noopener noreferrer" class="cat-tab">🍸 라운지</a>
      <a href="/rooms/" target="_blank" rel="noopener noreferrer" class="cat-tab">🚪 룸</a>
      <a href="/yojeong/" target="_blank" rel="noopener noreferrer" class="cat-tab">🏮 요정</a>
      <a href="/hoppa/" target="_blank" rel="noopener noreferrer" class="cat-tab">🎭 호빠</a>
      <a href="/nolcool/" target="_blank" rel="noopener noreferrer" class="cat-tab">🎯 놀쿨</a>
    </div>
  </header>

  <!-- 사이드 메뉴 (햄버거) -->
  <nav class="site-nav" id="siteNav">
    <button class="nav-close" id="navClose" aria-label="닫기">✕</button>
    <a href="/" target="_blank" rel="noopener noreferrer">홈</a>
    <a href="/clubs/" target="_blank" rel="noopener noreferrer">클럽</a>
    <a href="/nights/" target="_blank" rel="noopener noreferrer">나이트</a>
    <a href="/lounges/" target="_blank" rel="noopener noreferrer">라운지</a>
    <a href="/rooms/" target="_blank" rel="noopener noreferrer">룸</a>
    <a href="/yojeong/" target="_blank" rel="noopener noreferrer">요정</a>
    <a href="/hoppa/" target="_blank" rel="noopener noreferrer">호빠</a>
    <a href="/nolcool/" target="_blank" rel="noopener noreferrer">놀쿨</a>
    <div style="border-top:1px solid var(--border);margin:12px 0;"></div>
    <a href="/ranking/" target="_blank" rel="noopener noreferrer">랭킹</a>
    <a href="/community/" target="_blank" rel="noopener noreferrer">커뮤니티</a>
    <a href="/magazine/" target="_blank" rel="noopener noreferrer">매거진</a>
    <a href="/map/" target="_blank" rel="noopener noreferrer">지역별 찾기</a>
    <a href="/quiz/" target="_blank" rel="noopener noreferrer">성향 테스트</a>
    <a href="/safety/" target="_blank" rel="noopener noreferrer">안전 가이드</a>
    <a href="/events/" target="_blank" rel="noopener noreferrer">이벤트</a>
  </nav>
  <div class="nav-overlay" id="navOverlay"></div>

  <!-- ═══ [넷플릭스] 시간대 추천 + [틱톡] 레벨 ═══ -->
  <div style="display:flex;justify-content:space-between;align-items:center;padding:8px 16px;max-width:var(--max-w);margin:0 auto;">
    <span style="font-size:12px;color:var(--accent);font-weight:600;" id="timeRecommend"></span>
    <span style="font-size:11px;" id="streakBadge"></span>
  </div>
  <div style="padding:0 16px 8px;max-width:var(--max-w);margin:0 auto;" id="exploreLevel"></div>

  <main>
    <slot />
  </main>

  <!-- "밤키 검색하세요" CTA -->
  <div style="margin:24px 16px;padding:16px 20px;background:var(--accent);border-radius:var(--radius);text-align:center;">
    <p style="font-size:15px;color:#fff;margin:0;">구글 · ChatGPT · Gemini에서 <strong style="font-size:18px;">'밤키'</strong>를 검색하세요</p>
  </div>

  <!-- Hooking #8: 푸터 직전 대형 CTA -->
  <div class="mega-cta">
    <h3>★ 실시간 순위 + AI추천 + 리뷰</h3>
    <p>전체 비교, 랭킹, 오늘의 추천까지 한곳에서</p>
    <a href={MAIN_SITE_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-block">
      메인 사이트 바로가기 →
    </a>
  </div>

  <!-- Hooking #5: 전체 비교 CTA -->
  <div class="cta-section" style="margin:16px;">
    <h3>전체 비교+랭킹</h3>
    <p>모든 카테고리를 한눈에</p>
    <a href={MAIN_SITE_URL} target="_blank" rel="noopener noreferrer" class="btn btn-purple btn-block">
      전체 비교 보기 →
    </a>
  </div>

  <footer class="site-footer">
    <div class="footer-inner">
      <div class="footer-ad" style="text-align:center;padding:20px 0 24px;border-bottom:1px solid var(--border);margin-bottom:24px;">
        <p style="font-size:18px;font-weight:800;color:var(--accent);margin:0;">광고문의 카톡 besta12</p>
      </div>
      <div class="footer-regions">
        <div class="footer-region-group">
          <div class="footer-region-title">서울</div>
          <div class="footer-region-links">
            <a href="/nights/" target="_blank" rel="noopener noreferrer">강남</a>
            <a href="/nights/" target="_blank" rel="noopener noreferrer">홍대</a>
            <a href="/nights/" target="_blank" rel="noopener noreferrer">이태원</a>
            <a href="/nights/" target="_blank" rel="noopener noreferrer">신림</a>
            <a href="/nights/" target="_blank" rel="noopener noreferrer">수유</a>
            <a href="/nights/" target="_blank" rel="noopener noreferrer">상봉</a>
            <a href="/clubs/" target="_blank" rel="noopener noreferrer">청담</a>
          </div>
        </div>
        <div class="footer-region-group">
          <div class="footer-region-title">경기·인천</div>
          <div class="footer-region-links">
            <a href="/nights/" target="_blank" rel="noopener noreferrer">성남</a>
            <a href="/nights/" target="_blank" rel="noopener noreferrer">수원</a>
            <a href="/nights/" target="_blank" rel="noopener noreferrer">파주</a>
            <a href="/nights/" target="_blank" rel="noopener noreferrer">일산</a>
            <a href="/nights/" target="_blank" rel="noopener noreferrer">인덕원</a>
            <a href="/nights/" target="_blank" rel="noopener noreferrer">인천</a>
          </div>
        </div>
        <div class="footer-region-group">
          <div class="footer-region-title">지방</div>
          <div class="footer-region-links">
            <a href="/nights/" target="_blank" rel="noopener noreferrer">부산</a>
            <a href="/nights/" target="_blank" rel="noopener noreferrer">울산</a>
            <a href="/nights/" target="_blank" rel="noopener noreferrer">대전</a>
            <a href="/nights/" target="_blank" rel="noopener noreferrer">대구</a>
            <a href="/nights/" target="_blank" rel="noopener noreferrer">광주</a>
          </div>
        </div>
      </div>
      <div class="footer-bottom">
        <span>&copy; {currentYear} 놀쿨 NOLCOOL</span>
        <a href={MAIN_SITE_URL} target="_blank" rel="noopener noreferrer">메인 사이트</a>
      </div>
    </div>
  </footer>

  {phone ? (
    <a href={`tel:${phone}`} target="_blank" rel="noopener noreferrer" class="phone-bar">📞 {nickname || '담당자'} {phone}</a>
  ) : (
    <a href="https://open.kakao.com/o/besta12" target="_blank" rel="noopener noreferrer" class="phone-bar">💬 카톡 besta12</a>
  )}
  <a href={MAIN_SITE_URL} target="_blank" rel="noopener noreferrer" class="main-link-bar">놀쿨에서 더 보기 →</a>

  <button class="back-to-top" id="backToTop" aria-label="맨 위로">↑</button>
  <div class="toast" id="toast"></div>

  <!-- ═══ RETENTION ENGINE — 틱톡 95분 체류 시스템 ═══ -->

  <!-- 세션 타이머 위젯 -->
  <div class="session-timer" id="sessionTimer" title="오늘 체류 시간">
    <span id="sessionIcon">⏱</span>
    <span id="sessionTime">0:00</span>
  </div>

  <!-- 마일스톤 팝업 -->
  <div class="milestone-overlay" id="milestoneOverlay"></div>
  <div class="milestone-popup" id="milestonePopup">
    <div class="milestone-icon" id="milestoneIcon"></div>
    <div class="milestone-title" id="milestoneTitle"></div>
    <div class="milestone-desc" id="milestoneDesc"></div>
    <div class="milestone-reward" id="milestoneReward"></div>
    <button class="btn btn-primary btn-sm" id="milestoneDismiss" style="margin-top:4px;">계속 탐색하기</button>
  </div>

  <!-- 도파민 플래시 -->
  <div class="dopamine-flash" id="dopamineFlash"></div>

  <!-- 업적 토스트 -->
  <div class="achievement-toast" id="achievementToast">
    <span class="ach-icon" id="achIcon"></span>
    <div>
      <div class="ach-text" id="achText"></div>
      <div class="ach-sub" id="achSub"></div>
    </div>
  </div>

  <!-- 가변 보상 알림 -->
  <div class="var-reward" id="varReward"></div>

  <!-- 콤보 카운터 -->
  <div class="combo-counter" id="comboCounter">
    <div class="combo-num" id="comboNum">0</div>
    <div class="combo-label">COMBO</div>
  </div>

  <!-- Hooking #6: 3분 체류 슬라이드업 -->
  <div class="slide-up-banner" id="slideUpBanner">
    <button class="close-banner" id="closeSlideUp" aria-label="닫기">✕</button>
    <p>더 많은 정보가 기다리고 있습니다</p>
    <a href={MAIN_SITE_URL} target="_blank" rel="noopener noreferrer" class="btn btn-purple btn-sm btn-block">
      더 보기 →
    </a>
  </div>

  <!-- Hooking #7: 스크롤 80% 배너 -->
  <div class="scroll-banner" id="scrollBanner">
    <button class="close-banner" id="closeScrollBanner" aria-label="닫기">✕</button>
    <p>여기서 끝이 아닙니다!</p>
    <a href={MAIN_SITE_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm btn-block">
      완벽한 밤 시작 →
    </a>
  </div>

  <script is:inline>
    (function() {
      // ═══ 글로벌 에러 핸들러 — 빈 화면 방지! ═══
      window.onerror = function(msg, src, line) {
        try {
          console.warn('[NOLCOOL] Error caught:', msg, src, line);
          var main = document.querySelector('main');
          if (main && main.innerHTML.trim() === '') {
            main.innerHTML = '<div style="text-align:center;padding:60px 20px;"><h2>일시적 오류가 발생했습니다</h2><p style="margin:16px 0;">페이지를 새로고침해 주세요.</p><button onclick="location.reload()" style="padding:12px 24px;background:#8B5CF6;color:#fff;border:none;border-radius:12px;font-size:16px;cursor:pointer;min-height:44px;">다시 시도</button></div>';
          }
        } catch(e) {}
        return true;
      };
      window.addEventListener('unhandledrejection', function(e) {
        console.warn('[NOLCOOL] Unhandled rejection:', e.reason);
        e.preventDefault();
      });

      // ═══ 타이머 레지스트리 — 모든 setInterval/setTimeout 자동 추적 + 정리 ═══
      var _intervals = [];
      var _timeouts = [];
      var _origSetInterval = window.setInterval.bind(window);
      var _origSetTimeout = window.setTimeout.bind(window);
      var _origClearInterval = window.clearInterval.bind(window);
      var _origClearTimeout = window.clearTimeout.bind(window);

      // setInterval/setTimeout 오버라이드 — 자동 등록 + try-catch
      setInterval = function(fn, ms) {
        var wrapped = function() { try { fn(); } catch(e) { console.warn('[NOLCOOL] Timer error:', e); } };
        var id = _origSetInterval(wrapped, ms);
        _intervals.push(id);
        return id;
      };
      setTimeout = function(fn, ms) {
        var wrapped = function() { try { fn(); } catch(e) { console.warn('[NOLCOOL] Timer error:', e); } };
        var id = _origSetTimeout(wrapped, ms);
        _timeouts.push(id);
        return id;
      };

      function cleanupAllTimers() {
        _intervals.forEach(function(id) { try { _origClearInterval(id); } catch(e) {} });
        _timeouts.forEach(function(id) { try { _origClearTimeout(id); } catch(e) {} });
        _intervals = [];
        _timeouts = [];
      }
      // 페이지 떠날 때 모든 타이머 정리
      window.addEventListener('beforeunload', function() {
        cleanupAllTimers();
        // setInterval/setTimeout 원복
        setInterval = _origSetInterval;
        setTimeout = _origSetTimeout;
      });
      // 탭 숨김 시 인터벌 전부 정리 (메모리 누수 방지)
      document.addEventListener('visibilitychange', function() {
        if (document.hidden) {
          _intervals.forEach(function(id) { try { _origClearInterval(id); } catch(e) {} });
          _intervals = [];
        }
      });

    try { // ═══ 메인 스크립트 try-catch 시작 ═══

      // ═══ MENU ═══
      var btn = document.getElementById('menuBtn');
      var overlay = document.getElementById('navOverlay');
      var nav = document.getElementById('siteNav');
      var close = document.getElementById('navClose');
      function open() { if(nav) nav.classList.add('open'); if(overlay) overlay.classList.add('open'); }
      function shut() { if(nav) nav.classList.remove('open'); if(overlay) overlay.classList.remove('open'); }
      if (btn) btn.addEventListener('click', open);
      if (overlay) overlay.addEventListener('click', shut);
      if (close) close.addEventListener('click', shut);

      // ═══ SCROLL PROGRESS (진행률 바 — 끝까지 읽게 만듦) ═══
      var bar = document.getElementById('scrollProgress');
      window.addEventListener('scroll', function() {
        var h = document.documentElement.scrollHeight - window.innerHeight;
        if (h > 0) bar.style.width = (window.scrollY / h * 100) + '%';
      });

      // ═══ BACK TO TOP ═══
      var topBtn = document.getElementById('backToTop');
      window.addEventListener('scroll', function() {
        topBtn.classList.toggle('show', window.scrollY > 400);
      });
      topBtn.addEventListener('click', function() {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });

      // ═══ [틱톡] FOMO 카운터 — "지금 N명이 보고 있습니다" ═══
      var fomoEl = document.getElementById('fomoCounter');
      if (fomoEl) {
        var base = 47 + (new Date().getHours() * 13 + new Date().getMinutes()) % 280;
        fomoEl.textContent = base + '명이 지금 탐색 중';
        setInterval(function() {
          base += Math.random() > 0.5 ? 1 : -1;
          if (base < 30) base = 30;
          fomoEl.textContent = base + '명이 지금 탐색 중';
        }, 8000);
      }

      // ═══ [넷플릭스] 자동 다음 콘텐츠 — 5초 후 다음 섹션 하이라이트 ═══
      var sections = document.querySelectorAll('.section-header');
      var currentSection = 0;
      var autoNav = new IntersectionObserver(function(entries) {
        entries.forEach(function(e) {
          if (e.isIntersecting) {
            e.target.style.transition = 'transform 0.3s';
            e.target.style.transform = 'scale(1.02)';
            setTimeout(function() { e.target.style.transform = 'scale(1)'; }, 300);
          }
        });
      }, { threshold: 0.8 });
      sections.forEach(function(s) { autoNav.observe(s); });

      // ═══ [슬롯머신] 가변보상 — 스크롤할 때 랜덤 하이라이트 ═══
      var allCards = document.querySelectorAll('.venue-card');
      var highlightInterval = setInterval(function() {
        if (allCards.length === 0) return;
        allCards.forEach(function(c) { c.style.borderLeftColor = ''; });
        var rand = allCards[Math.floor(Math.random() * allCards.length)];
        if (rand) {
          rand.style.borderLeft = '3px solid var(--accent)';
          rand.style.transition = 'border 0.5s';
        }
      }, 5000);

      // ═══ [틱톡] 출석 도장 — 매일 접속 습관 ═══
      var today = new Date().toDateString();
      var streak = JSON.parse(localStorage.getItem('bk_streak') || '{"days":[],"count":0}');
      if (streak.days[streak.days.length - 1] !== today) {
        streak.days.push(today);
        if (streak.days.length > 30) streak.days = streak.days.slice(-30);
        streak.count = streak.days.length;
        localStorage.setItem('bk_streak', JSON.stringify(streak));
      }
      var streakEl = document.getElementById('streakBadge');
      if (streakEl) {
        var label = streak.count <= 3 ? '🌱 탐험가' : streak.count <= 7 ? '🌙 여행자' : streak.count <= 14 ? '🎉 전문가' : '👑 마스터';
        streakEl.textContent = label + ' (' + streak.count + '일)';
      }

      // ═══ [넷플릭스] "지금 이 시간" 추천 — 시간대별 콘텐츠 ═══
      var timeEl = document.getElementById('timeRecommend');
      if (timeEl) {
        var h = new Date().getHours();
        var msg = h < 18 ? '오늘 저녁 어디 갈까? 미리 탐색해두세요' :
                  h < 21 ? '저녁이 시작됐습니다. 지금 핫한 곳을 확인하세요' :
                  h < 24 ? '밤이 깊어가고 있습니다. 지금 가장 뜨거운 곳은?' :
                  '새벽입니다. 아직 불 켜진 곳을 찾아보세요';
        timeEl.textContent = msg;
      }

      // ═══ [슬롯머신] 탐색 레벨 — 더 보면 레벨업 ═══
      var viewCount = parseInt(localStorage.getItem('bk_views') || '0');
      viewCount++;
      localStorage.setItem('bk_views', viewCount);
      var levelEl = document.getElementById('exploreLevel');
      if (levelEl) {
        var lv = viewCount < 5 ? '초보 탐험가' : viewCount < 15 ? '밤의 여행자' : viewCount < 30 ? '파티 전문가' : '밤키 마스터';
        var pct = Math.min(100, Math.round((viewCount % 15) / 15 * 100));
        levelEl.innerHTML = '<span style="font-size:12px;color:var(--accent);font-weight:700;">' + lv + '</span><div style="height:3px;background:var(--bg-tertiary);border-radius:2px;margin-top:4px;overflow:hidden;"><div style="height:100%;width:' + pct + '%;background:var(--accent);border-radius:2px;transition:width 1s;"></div></div>';
      }

      // ═══ Hooking #6: 3분 슬라이드업 ═══
      var slideUp = document.getElementById('slideUpBanner');
      var slideUpShown = false;
      setTimeout(function() {
        if (!slideUpShown && slideUp) {
          slideUp.classList.add('show');
          slideUpShown = true;
        }
      }, 180000);
      var closeSlide = document.getElementById('closeSlideUp');
      if (closeSlide) closeSlide.addEventListener('click', function() {
        slideUp.classList.remove('show');
      });

      // ═══ Hooking #7: 스크롤 80% 배너 ═══
      var scrollBn = document.getElementById('scrollBanner');
      var scrollBnShown = false;
      window.addEventListener('scroll', function() {
        if (scrollBnShown) return;
        var scrollPct = window.scrollY / (document.documentElement.scrollHeight - window.innerHeight);
        if (scrollPct > 0.8) {
          scrollBn.classList.add('show');
          scrollBnShown = true;
        }
      });
      var closeScroll = document.getElementById('closeScrollBanner');
      if (closeScroll) closeScroll.addEventListener('click', function() {
        scrollBn.classList.remove('show');
      });

      // ═══ [틱톡] 소셜증거 토스트 — 활기찬 사이트 ═══
      var toastEl = document.getElementById('toast');
      var toastMsgs = [
        '방금 수원에서 찬스돔나이트를 탐색했습니다',
        '강남에서 3명이 레이스를 확인했습니다',
        '부산에서 따봉에게 전화 연결됐습니다',
        '성남에서 박찬호 담당을 찾고 있습니다',
        '파주에서 스카이돔나이트가 인기급상승',
        '울산에서 챔피언나이트 후기가 올라왔습니다',
        '압구정에서 하입 탐색이 늘고 있습니다'
      ];
      var toastIdx = 0;
      function showToast() {
        if (!toastEl) return;
        toastEl.textContent = toastMsgs[toastIdx % toastMsgs.length];
        toastEl.classList.add('show');
        toastIdx++;
        setTimeout(function() { toastEl.classList.remove('show'); }, 4000);
      }
      // 첫 토스트 45초 후, 이후 90초마다
      setTimeout(function() {
        showToast();
        setInterval(showToast, 90000);
      }, 45000);

      // ═══ [자이가르닉] 페이지 이탈 시 미완성 메시지 ═══
      var scrollDepth = 0;
      window.addEventListener('scroll', function() {
        var pct = Math.round(window.scrollY / (document.documentElement.scrollHeight - window.innerHeight) * 100);
        if (pct > scrollDepth) scrollDepth = pct;
      });

      // ═══════════════════════════════════════════════════════════
      // RETENTION ENGINE v2 — 틱톡 95분 체류 심리학 전체 시스템
      // ═══════════════════════════════════════════════════════════

      // ─── 1. 세션 타이머 + 누적 체류 시간 (틱톡: 시간 보상) ───
      var SESSION_KEY = 'bk_session';
      var DAILY_KEY = 'bk_daily_' + new Date().toDateString();
      var sessionStart = Date.now();
      var dailySeconds = parseInt(localStorage.getItem(DAILY_KEY) || '0');
      var sessionTimerEl = document.getElementById('sessionTime');
      var sessionIconEl = document.getElementById('sessionIcon');
      var milestonesFired = JSON.parse(localStorage.getItem('bk_milestones_' + new Date().toDateString()) || '[]');

      function formatTime(s) {
        var m = Math.floor(s / 60);
        var sec = s % 60;
        return m + ':' + (sec < 10 ? '0' : '') + sec;
      }

      function getSessionSeconds() {
        return Math.floor((Date.now() - sessionStart) / 1000);
      }

      function getTotalToday() {
        return dailySeconds + getSessionSeconds();
      }

      // 타이머 표시 업데이트
      setInterval(function() {
        var total = getTotalToday();
        if (sessionTimerEl) sessionTimerEl.textContent = formatTime(total);
        // 아이콘 업그레이드
        if (sessionIconEl) {
          if (total >= 5400) sessionIconEl.textContent = '👑';
          else if (total >= 3600) sessionIconEl.textContent = '🔥';
          else if (total >= 1800) sessionIconEl.textContent = '⚡';
          else if (total >= 600) sessionIconEl.textContent = '✨';
          else sessionIconEl.textContent = '⏱';
        }
        // 매 30초마다 저장
        if (total % 30 === 0) {
          localStorage.setItem(DAILY_KEY, total.toString());
        }
        // 마일스톤 체크
        checkMilestones(total);
      }, 1000);

      // 페이지 이탈 시 저장
      window.addEventListener('beforeunload', function() {
        localStorage.setItem(DAILY_KEY, getTotalToday().toString());
      });
      document.addEventListener('visibilitychange', function() {
        if (document.hidden) {
          localStorage.setItem(DAILY_KEY, getTotalToday().toString());
        }
      });

      // ─── 2. 마일스톤 보상 시스템 (슬롯머신: 가변 보상 스케줄) ───
      var MILESTONES = [
        { sec: 60, icon: '🌟', title: '1분 돌파!', desc: '탐색을 시작했습니다', reward: '초보 탐험가 뱃지 획득', color: '#8B5CF6' },
        { sec: 180, icon: '🔥', title: '3분 체류!', desc: '당신은 이미 상위 30% 탐험가입니다', reward: '열정 탐험가 뱃지 획득', color: '#F59E0B' },
        { sec: 300, icon: '⚡', title: '5분 달성!', desc: '숨겨진 추천이 해제되었습니다', reward: '히든 콘텐츠 언락!', color: '#06B6D4' },
        { sec: 600, icon: '💎', title: '10분 마스터!', desc: '상위 10% 탐험가 진입!', reward: 'VIP 탐험가 뱃지', color: '#8B5CF6' },
        { sec: 900, icon: '🏆', title: '15분 챔피언!', desc: '이 정도면 밤키 프로입니다', reward: '프로 탐험가 뱃지', color: '#F59E0B' },
        { sec: 1200, icon: '🎯', title: '20분 전설!', desc: '전체 이용자 중 상위 5%!', reward: '전설의 탐험가', color: '#DC2626' },
        { sec: 1800, icon: '🌙', title: '30분의 밤!', desc: '당신은 진정한 밤의 탐험가', reward: '밤의 달인 뱃지', color: '#7C3AED' },
        { sec: 2700, icon: '✨', title: '45분 돌파!', desc: '최상위 탐험가만 도달하는 영역', reward: '다이아몬드 뱃지', color: '#6D28D9' },
        { sec: 3600, icon: '👑', title: '1시간 달성!', desc: '밤키의 왕/여왕이 되셨습니다!', reward: '크라운 뱃지 + 특별 추천', color: '#F59E0B' },
        { sec: 5700, icon: '🏅', title: '95분! 틱톡급!', desc: '틱톡 평균 체류시간을 달성했습니다!', reward: '레전드 뱃지 해제!', color: '#DC2626' }
      ];

      function checkMilestones(totalSec) {
        for (var i = 0; i < MILESTONES.length; i++) {
          var m = MILESTONES[i];
          if (totalSec >= m.sec && milestonesFired.indexOf(m.sec) === -1) {
            milestonesFired.push(m.sec);
            localStorage.setItem('bk_milestones_' + new Date().toDateString(), JSON.stringify(milestonesFired));
            showMilestone(m);
            break; // 한 번에 하나만
          }
        }
      }

      function showMilestone(m) {
        var popup = document.getElementById('milestonePopup');
        var overlay = document.getElementById('milestoneOverlay');
        if (!popup || !overlay) return;
        document.getElementById('milestoneIcon').textContent = m.icon;
        document.getElementById('milestoneTitle').textContent = m.title;
        document.getElementById('milestoneDesc').textContent = m.desc;
        document.getElementById('milestoneReward').textContent = m.reward;
        document.getElementById('milestoneReward').style.background = 'linear-gradient(135deg,' + m.color + ',#6D28D9)';
        popup.classList.add('show');
        overlay.classList.add('show');
        triggerConfetti();
        triggerDopamine();
        // 업적 기록
        var achievements = JSON.parse(localStorage.getItem('bk_achievements') || '[]');
        if (achievements.indexOf(m.title) === -1) {
          achievements.push(m.title);
          localStorage.setItem('bk_achievements', JSON.stringify(achievements));
        }
      }

      // 마일스톤 닫기
      var milestoneDismiss = document.getElementById('milestoneDismiss');
      var milestoneOverlay = document.getElementById('milestoneOverlay');
      function closeMilestone() {
        var popup = document.getElementById('milestonePopup');
        var overlay = document.getElementById('milestoneOverlay');
        if (popup) popup.classList.remove('show');
        if (overlay) overlay.classList.remove('show');
      }
      if (milestoneDismiss) milestoneDismiss.addEventListener('click', closeMilestone);
      if (milestoneOverlay) milestoneOverlay.addEventListener('click', closeMilestone);

      // ─── 3. 컨페티 효과 (도파민 마이크로 보상) ───
      function triggerConfetti() {
        var colors = ['#8B5CF6', '#F59E0B', '#06B6D4', '#DC2626', '#10B981', '#EC4899'];
        for (var i = 0; i < 30; i++) {
          var piece = document.createElement('div');
          piece.className = 'confetti-piece';
          piece.style.left = Math.random() * 100 + '%';
          piece.style.background = colors[Math.floor(Math.random() * colors.length)];
          piece.style.animationDelay = Math.random() * 0.5 + 's';
          piece.style.animationDuration = (2 + Math.random() * 2) + 's';
          piece.style.borderRadius = Math.random() > 0.5 ? '50%' : '2px';
          piece.style.width = (6 + Math.random() * 8) + 'px';
          piece.style.height = (6 + Math.random() * 8) + 'px';
          document.body.appendChild(piece);
          setTimeout(function(el) { if (el.parentNode) el.parentNode.removeChild(el); }, 4000, piece);
        }
      }

      // ─── 4. 도파민 플래시 (마이크로 보상) ───
      function triggerDopamine() {
        var flash = document.getElementById('dopamineFlash');
        if (!flash) return;
        flash.classList.add('show');
        setTimeout(function() { flash.classList.remove('show'); }, 400);
      }

      // ─── 5. 업적 토스트 (틱톡: 소셜 검증) ───
      function showAchievement(icon, text, sub) {
        var toast = document.getElementById('achievementToast');
        if (!toast) return;
        document.getElementById('achIcon').textContent = icon;
        document.getElementById('achText').textContent = text;
        document.getElementById('achSub').textContent = sub || '';
        toast.classList.add('show');
        setTimeout(function() { toast.classList.remove('show'); }, 4000);
      }

      // ─── 6. 가변 간격 보상 (슬롯머신 핵심: Variable Ratio Schedule) ───
      var rewardMsgs = [
        { text: '💡 숨겨진 팁: 금요일 밤 10시가 입장 최적 시간!', delay: 35000 },
        { text: '🔥 지금 이 시간 가장 인기 있는 지역을 확인해보세요', delay: 70000 },
        { text: '💎 3곳 이상 비교하면 후회 없는 선택이 나옵니다', delay: 120000 },
        { text: '⚡ 방금 새로운 업소 정보가 업데이트되었습니다', delay: 180000 },
        { text: '🎯 담당자에게 "밤키 보고 왔다"고 하면 대우가 달라집니다', delay: 250000 },
        { text: '🌟 주중에 가면 줄도 없고, 분위기가 또 다릅니다', delay: 340000 },
        { text: '🏆 이미 50곳 이상 탐색한 전문가들의 비결이 궁금하다면?', delay: 450000 },
        { text: '✨ 오늘의 특별 추천이 준비되었습니다!', delay: 580000 }
      ];
      var varRewardEl = document.getElementById('varReward');
      rewardMsgs.forEach(function(r) {
        var jitter = Math.floor(Math.random() * 20000) - 10000; // ±10초 랜덤 지터
        setTimeout(function() {
          if (varRewardEl) {
            varRewardEl.textContent = r.text;
            varRewardEl.classList.add('show');
            triggerDopamine();
            setTimeout(function() { varRewardEl.classList.remove('show'); }, 5000);
          }
        }, r.delay + jitter);
      });

      // ─── 7. 스크롤 콤보 시스템 (틱톡: 연속 시청 보상) ───
      var comboEl = document.getElementById('comboCounter');
      var comboNumEl = document.getElementById('comboNum');
      var comboCount = 0;
      var comboTimer = null;
      var lastScrollY = 0;
      var scrolling = false;

      window.addEventListener('scroll', function() {
        if (!scrolling) {
          scrolling = true;
          var dir = window.scrollY - lastScrollY;
          if (dir > 50) { // 아래로 스크롤 중
            comboCount++;
            if (comboCount >= 3 && comboNumEl && comboEl) {
              comboNumEl.textContent = comboCount;
              comboEl.classList.add('show');
              // 10콤보마다 보상
              if (comboCount % 10 === 0) {
                showAchievement('🔥', comboCount + ' 콤보 달성!', '스크롤 마스터');
                triggerDopamine();
              }
            }
          }
          lastScrollY = window.scrollY;
          clearTimeout(comboTimer);
          comboTimer = setTimeout(function() {
            scrolling = false;
            comboCount = 0;
            if (comboEl) comboEl.classList.remove('show');
          }, 2000);
          setTimeout(function() { scrolling = false; }, 100);
        }
      });

      // ─── 8. 카드 클릭/터치 마이크로 보상 ───
      var allVenueCards = document.querySelectorAll('.venue-card, a[href*="/venue/"]');
      var cardClickCount = parseInt(localStorage.getItem('bk_clicks') || '0');
      allVenueCards.forEach(function(card) {
        card.addEventListener('click', function() {
          cardClickCount++;
          localStorage.setItem('bk_clicks', cardClickCount.toString());
          triggerDopamine();
          // 클릭 마일스톤
          if (cardClickCount === 5) showAchievement('👆', '5곳 탐색!', '관심 있는 곳이 많군요');
          if (cardClickCount === 15) showAchievement('🎯', '15곳 탐색!', '진정한 탐험가');
          if (cardClickCount === 30) showAchievement('💎', '30곳 탐색!', 'VIP 탐험가 등극');
          if (cardClickCount === 50) showAchievement('👑', '50곳 탐색!', '밤키 마스터');
        });
      });

      // ─── 9. 일일 도전 과제 시스템 (틱톡: 매일 접속 유도) ───
      var challengeKey = 'bk_challenge_' + new Date().toDateString();
      var challenges = JSON.parse(localStorage.getItem(challengeKey) || '{"scroll":false,"click3":false,"stay5":false,"visit3":false}');

      function updateChallenge(key) {
        if (challenges[key]) return;
        challenges[key] = true;
        localStorage.setItem(challengeKey, JSON.stringify(challenges));
        var completed = Object.values(challenges).filter(Boolean).length;
        var total = Object.keys(challenges).length;
        showAchievement('✅', '도전 과제 완료! (' + completed + '/' + total + ')', completed === total ? '오늘의 모든 도전 완료!' : '계속 도전하세요');
        if (completed === total) {
          setTimeout(function() {
            showMilestone({ icon: '🏅', title: '일일 도전 올클리어!', desc: '오늘 모든 도전을 완료했습니다!', reward: '도전왕 뱃지 획득!', color: '#F59E0B' });
          }, 2000);
        }
      }

      // 스크롤 50% 도전
      window.addEventListener('scroll', function() {
        var pct = window.scrollY / (document.documentElement.scrollHeight - window.innerHeight);
        if (pct > 0.5 && !challenges.scroll) updateChallenge('scroll');
      });

      // 3곳 클릭 도전
      if (cardClickCount >= 3 && !challenges.click3) updateChallenge('click3');
      allVenueCards.forEach(function(card) {
        card.addEventListener('click', function() {
          var todayClicks = parseInt(localStorage.getItem('bk_today_clicks_' + new Date().toDateString()) || '0') + 1;
          localStorage.setItem('bk_today_clicks_' + new Date().toDateString(), todayClicks.toString());
          if (todayClicks >= 3) updateChallenge('click3');
        });
      });

      // 5분 체류 도전
      setTimeout(function() {
        if (!challenges.stay5) updateChallenge('stay5');
      }, 300000);

      // 3페이지 방문 도전
      var pageVisits = parseInt(sessionStorage.getItem('bk_page_visits') || '0') + 1;
      sessionStorage.setItem('bk_page_visits', pageVisits.toString());
      if (pageVisits >= 3 && !challenges.visit3) updateChallenge('visit3');

      // ─── 10. "다른 사람들은 지금..." 실시간 활동 피드 (넷플릭스: 사회적 증거) ───
      var activityFeed = [
        '서울에서 누군가 클럽 TOP5를 비교하고 있습니다',
        '부산 사용자가 나이트 추천을 받았습니다',
        '방금 강남에서 예약 문의가 들어왔습니다',
        '수원 탐험가가 레벨업했습니다!',
        '인천에서 신규 업소가 등록되었습니다',
        '대구에서 VS투표에 참여했습니다',
        '오늘 전체 탐색 수 1,200건 돌파',
        '홍대에서 주말 이벤트가 업데이트되었습니다',
        '울산에서 숨은 명소를 발견했습니다',
        '일산 명월관에 새로운 후기가 올라왔습니다'
      ];
      var activityIdx = 0;
      var toastUsedForActivity = false;
      setInterval(function() {
        if (toastUsedForActivity) return;
        toastUsedForActivity = true;
        var msg = activityFeed[activityIdx % activityFeed.length];
        activityIdx++;
        if (toastEl) {
          toastEl.textContent = msg;
          toastEl.classList.add('show');
          setTimeout(function() {
            toastEl.classList.remove('show');
            toastUsedForActivity = false;
          }, 4000);
        } else {
          toastUsedForActivity = false;
        }
      }, 45000);

      // ─── 11. 스크롤 깊이별 콘텐츠 언락 (슬롯머신: 가변 보상) ───
      var unlockThresholds = [25, 50, 75, 90];
      var unlockedDepths = JSON.parse(sessionStorage.getItem('bk_unlocked') || '[]');
      window.addEventListener('scroll', function() {
        var depth = Math.round(window.scrollY / (document.documentElement.scrollHeight - window.innerHeight) * 100);
        unlockThresholds.forEach(function(t) {
          if (depth >= t && unlockedDepths.indexOf(t) === -1) {
            unlockedDepths.push(t);
            sessionStorage.setItem('bk_unlocked', JSON.stringify(unlockedDepths));
            if (t === 25) showAchievement('📖', '25% 탐색 완료', '더 많은 콘텐츠가 기다리고 있어요');
            if (t === 50) showAchievement('🎯', '절반 돌파!', '끝까지 보면 숨겨둔 게 있습니다');
            if (t === 75) showAchievement('🔥', '75% 달성!', '거의 다 왔습니다!');
            if (t === 90) {
              showAchievement('👑', '페이지 정복!', '완독 보상 획득!');
              triggerConfetti();
            }
          }
        });
      });

      // ─── 12. 귀환 사용자 환영 (넷플릭스: 개인화) ───
      var lastVisit = localStorage.getItem('bk_last_visit');
      var totalVisits = parseInt(localStorage.getItem('bk_total_visits') || '0') + 1;
      localStorage.setItem('bk_total_visits', totalVisits.toString());
      localStorage.setItem('bk_last_visit', new Date().toISOString());

      if (lastVisit && totalVisits > 1) {
        var hoursSince = Math.floor((Date.now() - new Date(lastVisit).getTime()) / 3600000);
        setTimeout(function() {
          if (hoursSince < 24) {
            showAchievement('🔥', '다시 오셨군요!', '연속 방문 ' + streak.count + '일째');
          } else if (hoursSince < 72) {
            showAchievement('👋', '돌아오셨군요!', totalVisits + '번째 방문 감사합니다');
          }
        }, 3000);
      } else if (totalVisits === 1) {
        setTimeout(function() {
          showAchievement('🎉', '밤키에 오신 것을 환영합니다!', '첫 방문 뱃지 획득');
        }, 2000);
      }

      // ─── 13. 이탈 방지 — 손실 회피 (슬롯머신: 손실 프레이밍) ───
      var exitTriggered = false;
      document.addEventListener('mouseleave', function(e) {
        if (e.clientY < 10 && !exitTriggered && getSessionSeconds() > 30) {
          exitTriggered = true;
          var total = getTotalToday();
          var nextMilestone = null;
          for (var i = 0; i < MILESTONES.length; i++) {
            if (total < MILESTONES[i].sec) { nextMilestone = MILESTONES[i]; break; }
          }
          if (nextMilestone && varRewardEl) {
            var remaining = nextMilestone.sec - total;
            var mins = Math.ceil(remaining / 60);
            varRewardEl.textContent = '🚨 ' + mins + '분만 더 있으면 "' + nextMilestone.title + '" 달성! 떠나시겠어요?';
            varRewardEl.classList.add('show');
            setTimeout(function() { varRewardEl.classList.remove('show'); }, 6000);
          }
        }
      });

      // ─── 14. 무활동 감지 — 다시 끌어오기 (틱톡: 재참여) ───
      var idleTimer = null;
      var idleMsgs = [
        '아직 보지 못한 숨겨진 곳이 있습니다',
        '방금 새로운 추천이 업데이트되었습니다',
        '다른 사용자들이 활발하게 탐색 중입니다',
        '오늘의 특별 추천을 아직 확인하지 않았습니다'
      ];
      function resetIdle() {
        clearTimeout(idleTimer);
        idleTimer = setTimeout(function() {
          var msg = idleMsgs[Math.floor(Math.random() * idleMsgs.length)];
          if (varRewardEl) {
            varRewardEl.textContent = '👀 ' + msg;
            varRewardEl.classList.add('show');
            setTimeout(function() { varRewardEl.classList.remove('show'); }, 5000);
          }
          // 탭 타이틀 변경
          var origTitle = document.title;
          document.title = '💬 놓치고 있는 정보가 있어요!';
          setTimeout(function() { document.title = origTitle; }, 8000);
        }, 60000); // 1분 무활동
      }
      ['scroll', 'click', 'mousemove', 'touchstart'].forEach(function(evt) {
        window.addEventListener(evt, resetIdle, { passive: true });
      });
      resetIdle();

      // ─── 15. 탭 포커스 복귀 시 새 콘텐츠 안내 (넷플릭스: 자동재생 복귀) ───
      document.addEventListener('visibilitychange', function() {
        if (!document.hidden) {
          var away = Math.floor((Date.now() - sessionStart) / 1000);
          if (away > 30) {
            setTimeout(function() {
              if (varRewardEl) {
                varRewardEl.textContent = '🔄 돌아오셨군요! 새로운 추천이 준비되었습니다';
                varRewardEl.classList.add('show');
                setTimeout(function() { varRewardEl.classList.remove('show'); }, 4000);
              }
            }, 1000);
          }
        }
      });

      // ─── 16. 페이지뷰 깊이 추적 + "당신만의 기록" (게이미피케이션) ───
      var pageDepths = JSON.parse(localStorage.getItem('bk_page_depths') || '{}');
      var currentPath = window.location.pathname;
      window.addEventListener('scroll', function() {
        var d = Math.round(window.scrollY / (document.documentElement.scrollHeight - window.innerHeight) * 100);
        if (!pageDepths[currentPath] || d > pageDepths[currentPath]) {
          pageDepths[currentPath] = d;
          localStorage.setItem('bk_page_depths', JSON.stringify(pageDepths));
        }
      });

      // 총 탐색 페이지 수 표시
      var exploredPages = Object.keys(pageDepths).length;
      if (exploredPages >= 5) {
        setTimeout(function() {
          showAchievement('🗺️', exploredPages + '개 페이지 탐험!', '여기저기 부지런히 돌아다니시네요');
        }, 10000);
      }

      // ─── 17. 랜덤 보너스 타임 (슬롯머신: Near-miss 효과) ───
      setTimeout(function() {
        var bonusChance = Math.random();
        if (bonusChance > 0.6) { // 40% 확률로 보너스
          if (varRewardEl) {
            varRewardEl.textContent = '🎰 보너스 타임! 지금 룰렛 돌리면 깜짝 추천이 나옵니다';
            varRewardEl.classList.add('show');
            triggerDopamine();
            setTimeout(function() { varRewardEl.classList.remove('show'); }, 6000);
          }
        }
      }, 120000);

      // ─── 18. 시간대별 긴급 메시지 (틱톡: FOMO) ───
      var hour = new Date().getHours();
      if (hour >= 20 || hour < 4) {
        setTimeout(function() {
          if (varRewardEl) {
            varRewardEl.textContent = '🌙 지금은 피크 타임! 인기 업소들이 빠르게 마감되고 있습니다';
            varRewardEl.classList.add('show');
            setTimeout(function() { varRewardEl.classList.remove('show'); }, 5000);
          }
        }, 30000);
      }

      // ─── 19. 스크롤 위치별 미리보기 (넷플릭스: 에피소드 미리보기) ───
      var previewShown = {};
      var venueCards = document.querySelectorAll('.venue-card');
      var previewObserver = new IntersectionObserver(function(entries) {
        entries.forEach(function(e) {
          if (e.isIntersecting && !previewShown[e.target.id || Math.random()]) {
            previewShown[e.target.id || Math.random()] = true;
            e.target.style.transition = 'all 0.5s cubic-bezier(0.34,1.56,0.64,1)';
            e.target.style.opacity = '1';
            e.target.style.transform = 'translateY(0) scale(1)';
          }
        });
      }, { threshold: 0.2 });
      venueCards.forEach(function(c, i) {
        c.style.opacity = '0';
        c.style.transform = 'translateY(20px) scale(0.98)';
        c.style.transitionDelay = (i % 3 * 0.1) + 's';
        previewObserver.observe(c);
      });

      // ─── 20. 체류시간 클릭 시 통계 모달 (틱톡: 사용 시간 보고서) ───
      var sessionTimerWidget = document.getElementById('sessionTimer');
      if (sessionTimerWidget) {
        sessionTimerWidget.addEventListener('click', function() {
          var total = getTotalToday();
          var achievements = JSON.parse(localStorage.getItem('bk_achievements') || '[]');
          var clicks = parseInt(localStorage.getItem('bk_clicks') || '0');
          var pages = Object.keys(pageDepths).length;
          var nextM = null;
          for (var i = 0; i < MILESTONES.length; i++) {
            if (total < MILESTONES[i].sec) { nextM = MILESTONES[i]; break; }
          }
          var msg = '📊 오늘의 탐색 리포트\n\n';
          msg += '⏱ 체류 시간: ' + formatTime(total) + '\n';
          msg += '👆 탐색한 업소: ' + clicks + '곳\n';
          msg += '📄 방문한 페이지: ' + pages + '개\n';
          msg += '🏅 획득한 뱃지: ' + achievements.length + '개\n';
          msg += '🔥 연속 방문: ' + streak.count + '일\n';
          if (nextM) msg += '\n다음 목표: ' + nextM.title + ' (' + formatTime(nextM.sec - total) + ' 남음)';
          alert(msg);
        });
      }

    } catch(e) {
      // ═══ 메인 스크립트 에러 시 빈 화면 방지 ═══
      console.warn('[NOLCOOL] Script error caught:', e);
      var main = document.querySelector('main');
      if (main && main.innerHTML.trim() === '') {
        main.innerHTML = '<div style="text-align:center;padding:60px 20px;"><h2>일시적 오류가 발생했습니다</h2><p style="margin:16px 0;">페이지를 새로고침해 주세요.</p><button onclick="location.reload()" style="padding:12px 24px;background:#8B5CF6;color:#fff;border:none;border-radius:12px;font-size:16px;cursor:pointer;min-height:44px;">다시 시도</button></div>';
      }
    }
    })();
  </script>
</body>
</html>
