---
import '../styles/global.css';
import { MAIN_SITE_URL, SITE_URL, SLOGAN, SITE_NAME } from '../data/venues';

interface Props {
  title: string;
  description: string;
  h1?: string;
  canonical?: string;
  ogImage?: string;
  jsonLd?: object;
}

const { title, description, h1, canonical, ogImage, jsonLd } = Astro.props;
const canonicalUrl = canonical || new URL(Astro.url.pathname, SITE_URL).href;
const defaultOgImage = `${SITE_URL}/og-default.svg`;
const finalOgImage = ogImage || defaultOgImage;
---

<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <meta name="robots" content="index, follow" />

  <!-- OG Tags -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:locale" content="ko_KR" />
  <meta property="og:image" content={finalOgImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={finalOgImage} />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  {jsonLd && (
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  )}
</head>
<body>
  <!-- HOOKING #1: 상단 고정 배너 -->
  <div class="top-banner">
    <a href={MAIN_SITE_URL} target="_blank" rel="noopener noreferrer">
      프리미엄 정보+실시간 예약은 ★오늘밤어디★에서 →
    </a>
  </div>

  <!-- HEADER -->
  <header class="site-header">
    <a href="/" class="site-logo">NIGHTLIFE_CYBER//</a>
    <div class="site-slogan">// {SLOGAN}</div>
    <nav class="nav-links">
      <a href="/" target="_blank" rel="noopener noreferrer">HOME</a>
      <a href="/nights/" target="_blank" rel="noopener noreferrer">NIGHT</a>
      <a href="/clubs/" target="_blank" rel="noopener noreferrer">CLUB</a>
      <a href="/lounges/" target="_blank" rel="noopener noreferrer">LOUNGE</a>
    </nav>
  </header>

  <!-- MAIN CONTENT -->
  <main>
    <slot />
  </main>

  <!-- HOOKING #5: 전체 비교 -->
  <div class="hook-compare">
    <p style="font-size:14px;color:var(--text-primary);margin-bottom:8px;">전체 업소 비교+랭킹 보기</p>
    <a href={MAIN_SITE_URL} target="_blank" rel="noopener noreferrer" class="cta-btn">
      오늘밤어디에서 전체 비교 →
    </a>
  </div>

  <!-- HOOKING #8: 푸터 직전 대형 CTA -->
  <div class="footer-cta">
    <h2>전국 업소 실시간 순위</h2>
    <p>AI추천+리뷰까지 한곳에서</p>
    <a href={MAIN_SITE_URL} target="_blank" rel="noopener noreferrer" class="cta-btn" style="font-size:15px;padding:14px 32px;">
      오늘밤어디 바로가기 →
    </a>
  </div>

  <!-- FOOTER -->
  <footer class="site-footer">
    <div class="footer-newsletter">
      <h3>// NEWSLETTER</h3>
      <p>새로운 업소 정보를 받아보세요</p>
    </div>
    <div class="footer-links">
      <a href="/" target="_blank" rel="noopener noreferrer">HOME</a>
      <a href="/nights/" target="_blank" rel="noopener noreferrer">NIGHT</a>
      <a href="/clubs/" target="_blank" rel="noopener noreferrer">CLUB</a>
      <a href="/lounges/" target="_blank" rel="noopener noreferrer">LOUNGE</a>
      <a href={MAIN_SITE_URL} target="_blank" rel="noopener noreferrer">MAIN</a>
    </div>
    <div class="footer-copy">
      &copy; <span id="footer-year"></span> {SITE_NAME} — {SLOGAN}
    </div>
  </footer>

  <!-- 연도 자동 -->
  <script is:inline>
    document.getElementById('footer-year').textContent = new Date().getFullYear();
  </script>

  <!-- Progress tracker -->
  <script is:inline>
    (function() {
      var trackers = document.querySelectorAll('.progress-count');
      trackers.forEach(function(el) {
        var current = parseInt(el.dataset.current || '1');
        el.textContent = current + '/19 탐색 중';
      });
    })();
  </script>
</body>
</html>
