---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  keywords?: string;
  jsonLd?: object[];
}

const { title, description, canonical, ogImage, keywords, jsonLd = [] } = Astro.props;
const siteUrl = 'https://week1-6m5.pages.dev';
const canonicalUrl = canonical || new URL(Astro.url.pathname, siteUrl).href;
const currentPath = Astro.url.pathname;
---
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="alternate" hreflang="ko" href={canonicalUrl} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:locale" content="ko_KR" />
  {ogImage && <meta property="og:image" content={ogImage} />}
  {ogImage && <meta property="og:image:width" content="1200" />}
  {ogImage && <meta property="og:image:height" content="630" />}
  {ogImage && <meta property="og:image:alt" content={title} />}
  <meta property="og:site_name" content="나이트코리아" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  {ogImage && <meta name="twitter:image" content={ogImage} />}
  {keywords && <meta name="keywords" content={keywords} />}
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
  <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large" />
  <meta name="naver-site-verification" content="" />
  <meta name="naverbot" content="index, follow" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  {jsonLd.map(ld => (
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  ))}
</head>
<body>
  <div class="scroll-progress" id="scrollProgress"></div>

  <header class="site-header">
    <div class="container site-header__inner">
      <a href="/" class="site-logo">나이트코리아</a>
      <button class="nav-toggle" id="navToggle" aria-label="메뉴 열기">
        <span></span><span></span><span></span>
      </button>
      <nav class="site-nav" id="siteNav">
        <a href="/nights/" class={currentPath.startsWith('/nights') ? 'active' : ''}>나이트</a>
        <a href="/clubs/" class={currentPath.startsWith('/clubs') ? 'active' : ''}>클럽</a>
        <a href="/lounges/" class={currentPath.startsWith('/lounges') ? 'active' : ''}>라운지</a>
        <a href="/guides/" class={currentPath.startsWith('/guides') ? 'active' : ''}>가이드</a>
        <a href="/editorial-policy/" class={currentPath.startsWith('/editorial') ? 'active' : ''}>정책</a>
      </nav>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="container">
      <div class="footer-top">
        <div class="footer-brand">
          <span class="footer-logo">나이트코리아</span>
          <p class="footer-desc">전국 나이트 · 클럽 · 라운지 정보 디렉토리</p>
        </div>
        <nav class="footer-nav">
          <a href="/about/">소개</a>
          <a href="/editorial-policy/">편집 방침</a>
          <a href="/guides/">가이드</a>
        </nav>
      </div>
      <div class="footer-cta-row" id="kakaoCta" role="button" tabindex="0" aria-label="카카오톡 ID besta12 복사">
        <span class="footer-cta-text">제휴/정정 문의</span>
        <span class="footer-cta-id">카카오톡 besta12</span>
      </div>
      <div class="footer-bottom">
        <p class="footer-copyright">&copy; 2026 나이트코리아. All rights reserved.</p>
        <p class="footer-age">본 사이트는 만 19세 이상 이용 가능한 정보를 포함합니다.</p>
      </div>
    </div>
  </footer>

  <div class="toast" id="toast">카톡 ID 복사됨: besta12</div>

  <script>
    // Scroll progress
    const prog = document.getElementById('scrollProgress');
    if (prog) {
      window.addEventListener('scroll', () => {
        const h = document.documentElement.scrollHeight - window.innerHeight;
        prog.style.width = h > 0 ? ((window.scrollY / h) * 100) + '%' : '0%';
      }, { passive: true });
    }

    // Mobile nav toggle
    const navToggle = document.getElementById('navToggle');
    const siteNav = document.getElementById('siteNav');
    if (navToggle && siteNav) {
      navToggle.addEventListener('click', () => {
        const open = siteNav.classList.toggle('open');
        navToggle.classList.toggle('open', open);
        navToggle.setAttribute('aria-label', open ? '메뉴 닫기' : '메뉴 열기');
      });
    }

    // KakaoTalk CTA
    const cta = document.getElementById('kakaoCta');
    const toast = document.getElementById('toast');
    if (cta) {
      cta.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText('besta12');
        } catch {
          const ta = document.createElement('textarea');
          ta.value = 'besta12'; ta.style.position = 'fixed'; ta.style.opacity = '0';
          document.body.appendChild(ta); ta.select(); document.execCommand('copy');
          document.body.removeChild(ta);
        }
        if (toast) {
          toast.classList.add('show');
          setTimeout(() => toast.classList.remove('show'), 2500);
        }
      });
      cta.addEventListener('keydown', (e) => { if (e.key === 'Enter') cta.click(); });
    }

    // Correction request button (detail pages)
    const corrBtn = document.getElementById('correctionBtn');
    if (corrBtn) {
      corrBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText('besta12');
        } catch {
          const ta = document.createElement('textarea');
          ta.value = 'besta12'; ta.style.position = 'fixed'; ta.style.opacity = '0';
          document.body.appendChild(ta); ta.select(); document.execCommand('copy');
          document.body.removeChild(ta);
        }
        if (toast) {
          toast.classList.add('show');
          setTimeout(() => toast.classList.remove('show'), 2500);
        }
      });
    }

    // Accordion
    document.querySelectorAll('.accordion-trigger').forEach(btn => {
      btn.addEventListener('click', () => {
        const item = btn.parentElement;
        const content = item?.querySelector('.accordion-content');
        if (!item || !content) return;
        const isOpen = item.classList.contains('open');
        if (isOpen) {
          (content as HTMLElement).style.maxHeight = '0';
          item.classList.remove('open');
        } else {
          (content as HTMLElement).style.maxHeight = content.scrollHeight + 'px';
          item.classList.add('open');
        }
      });
    });
  </script>
</body>
</html>
