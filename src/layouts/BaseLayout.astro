---
import '../styles/global.css';
import { MAIN_SITE_URL, SITE_URL, SLOGAN, SITE_NAME } from '../data/venues';

interface Props {
  title: string;
  description: string;
  h1?: string;
  canonical?: string;
  ogImage?: string;
  jsonLd?: object;
}

const { title, description, h1, canonical, ogImage, jsonLd } = Astro.props;
const canonicalUrl = canonical || new URL(Astro.url.pathname, SITE_URL).href;
const defaultOgImage = `${SITE_URL}/og-default.svg`;
const finalOgImage = ogImage || defaultOgImage;
const currentYear = new Date().getFullYear();
---

<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="google-site-verification" content="HJjm7MRxykCQ7d_9L7glaTeeaWrmJIzAKY0BcNcfm88" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <meta name="robots" content="index, follow" />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:locale" content="ko_KR" />
  <meta property="og:image" content={finalOgImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={finalOgImage} />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="theme-color" content="#0A0A0F" />

  {jsonLd && (
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  )}
</head>
<body>
  <div class="scroll-progress" id="scrollProgress"></div>

  <!-- Hooking #1: 상단 고정 배너 -->
  <div class="top-banner">
    <a href={MAIN_SITE_URL} target="_blank" rel="noopener noreferrer">
      프리미엄 정보+실시간 예약은 ★밤키★에서 →
    </a>
  </div>

  <div class="age-notice">
    본 사이트는 만 19세 이상 성인만 이용 가능합니다
  </div>

  <header class="site-header">
    <div class="header-inner">
      <a href="/" class="site-logo neon-flicker">{SITE_NAME}</a>
      <nav class="site-nav" id="siteNav">
        <button class="nav-close" id="navClose" aria-label="닫기">✕</button>
        <a href="/nights/">나이트</a>
        <a href="/clubs/">클럽</a>
        <a href="/lounges/">라운지</a>
      </nav>
      <div class="header-right">
        <a href={MAIN_SITE_URL} target="_blank" rel="noopener noreferrer" class="header-search-btn" aria-label="탐색">🔍</a>
        <button class="header-menu-btn" id="menuBtn" aria-label="메뉴">☰</button>
      </div>
    </div>
  </header>

  <div class="nav-overlay" id="navOverlay"></div>

  <main>
    <slot />
  </main>

  <!-- Hooking #8: 푸터 직전 대형 CTA -->
  <div class="mega-cta">
    <h3>★ 전국 업소 실시간 순위 + AI추천 + 리뷰</h3>
    <p>103개 업소 비교, 랭킹, 오늘의 추천까지 한곳에서</p>
    <a href={MAIN_SITE_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-block">
      밤키 바로가기 →
    </a>
  </div>

  <!-- Hooking #5: 103개 전체 비교 CTA -->
  <div class="cta-section" style="margin:16px;">
    <h3>103개 전체 업소 비교+랭킹</h3>
    <p>나이트, 클럽, 라운지 모든 카테고리를 한눈에</p>
    <a href={MAIN_SITE_URL} target="_blank" rel="noopener noreferrer" class="btn btn-purple btn-block">
      밤키에서 전체 비교 →
    </a>
  </div>

  <footer class="site-footer">
    <div class="footer-inner">
      <div class="footer-regions">
        <div class="footer-region-group">
          <div class="footer-region-title">서울</div>
          <div class="footer-region-links">
            <a href={MAIN_SITE_URL} target="_blank" rel="noopener noreferrer">강남</a>
            <a href={MAIN_SITE_URL} target="_blank" rel="noopener noreferrer">홍대</a>
            <a href={MAIN_SITE_URL} target="_blank" rel="noopener noreferrer">이태원</a>
            <a href={MAIN_SITE_URL} target="_blank" rel="noopener noreferrer">신림</a>
            <a href={MAIN_SITE_URL} target="_blank" rel="noopener noreferrer">수유</a>
            <a href={MAIN_SITE_URL} target="_blank" rel="noopener noreferrer">상봉</a>
            <a href={MAIN_SITE_URL} target="_blank" rel="noopener noreferrer">청담</a>
          </div>
        </div>
        <div class="footer-region-group">
          <div class="footer-region-title">경기·인천</div>
          <div class="footer-region-links">
            <a href={MAIN_SITE_URL} target="_blank" rel="noopener noreferrer">성남</a>
            <a href={MAIN_SITE_URL} target="_blank" rel="noopener noreferrer">수원</a>
            <a href={MAIN_SITE_URL} target="_blank" rel="noopener noreferrer">파주</a>
            <a href={MAIN_SITE_URL} target="_blank" rel="noopener noreferrer">일산</a>
            <a href={MAIN_SITE_URL} target="_blank" rel="noopener noreferrer">인덕원</a>
            <a href={MAIN_SITE_URL} target="_blank" rel="noopener noreferrer">인천</a>
          </div>
        </div>
        <div class="footer-region-group">
          <div class="footer-region-title">지방</div>
          <div class="footer-region-links">
            <a href={MAIN_SITE_URL} target="_blank" rel="noopener noreferrer">부산</a>
            <a href={MAIN_SITE_URL} target="_blank" rel="noopener noreferrer">울산</a>
            <a href={MAIN_SITE_URL} target="_blank" rel="noopener noreferrer">대전</a>
            <a href={MAIN_SITE_URL} target="_blank" rel="noopener noreferrer">대구</a>
            <a href={MAIN_SITE_URL} target="_blank" rel="noopener noreferrer">광주</a>
          </div>
        </div>
      </div>
      <div class="footer-bottom">
        <span>&copy; {currentYear} {SITE_NAME} · {SLOGAN}</span>
        <a href={MAIN_SITE_URL} target="_blank" rel="noopener noreferrer">밤키 메인</a>
      </div>
    </div>
  </footer>

  <nav class="mobile-nav">
    <a href="/" class="active">
      <span class="nav-icon">🏠</span>
      홈
    </a>
    <a href="/nights/">
      <span class="nav-icon">🌙</span>
      나이트
    </a>
    <a href="/clubs/">
      <span class="nav-icon">🎵</span>
      클럽
    </a>
    <a href={MAIN_SITE_URL} target="_blank" rel="noopener noreferrer">
      <span class="nav-icon">🔍</span>
      탐색
    </a>
    <a href={MAIN_SITE_URL} target="_blank" rel="noopener noreferrer">
      <span class="nav-icon">⭐</span>
      밤키
    </a>
  </nav>

  <button class="back-to-top" id="backToTop" aria-label="맨 위로">↑</button>
  <a href="http://pf.kakao.com/_YSxjhX/chat" target="_blank" rel="noopener noreferrer" class="kakao-float" aria-label="카카오톡 상담">
    <svg viewBox="0 0 24 24" width="28" height="28" fill="#3C1E1E"><path d="M12 3C6.48 3 2 6.58 2 10.9c0 2.78 1.86 5.21 4.64 6.59-.15.56-.54 2.03-.62 2.34-.1.39.14.39.3.28.12-.08 1.94-1.32 2.73-1.86.62.09 1.26.14 1.95.14 5.52 0 10-3.58 10-7.99S17.52 3 12 3z"/></svg>
  </a>
  <div class="toast" id="toast"></div>

  <!-- Hooking #6: 3분 체류 슬라이드업 -->
  <div class="slide-up-banner" id="slideUpBanner">
    <button class="close-banner" id="closeSlideUp" aria-label="닫기">✕</button>
    <p>더 많은 정보가 기다리고 있습니다</p>
    <a href={MAIN_SITE_URL} target="_blank" rel="noopener noreferrer" class="btn btn-purple btn-sm btn-block">
      밤키 바로가기 →
    </a>
  </div>

  <!-- Hooking #7: 스크롤 80% 배너 -->
  <div class="scroll-banner" id="scrollBanner">
    <button class="close-banner" id="closeScrollBanner" aria-label="닫기">✕</button>
    <p>여기서 끝이 아닙니다!</p>
    <a href={MAIN_SITE_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm btn-block">
      밤키에서 완벽한 밤 시작 →
    </a>
  </div>

  <script is:inline>
    (function() {
      // Menu toggle
      var btn = document.getElementById('menuBtn');
      var overlay = document.getElementById('navOverlay');
      var nav = document.getElementById('siteNav');
      var close = document.getElementById('navClose');
      function open() { nav.classList.add('open'); overlay.classList.add('open'); }
      function shut() { nav.classList.remove('open'); overlay.classList.remove('open'); }
      if (btn) btn.addEventListener('click', open);
      if (overlay) overlay.addEventListener('click', shut);
      if (close) close.addEventListener('click', shut);

      // Scroll progress
      var bar = document.getElementById('scrollProgress');
      window.addEventListener('scroll', function() {
        var h = document.documentElement.scrollHeight - window.innerHeight;
        if (h > 0) bar.style.width = (window.scrollY / h * 100) + '%';
      });

      // Back to top
      var topBtn = document.getElementById('backToTop');
      window.addEventListener('scroll', function() {
        topBtn.classList.toggle('show', window.scrollY > 400);
      });
      topBtn.addEventListener('click', function() {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });

      // Hooking #6: 3분 슬라이드업
      var slideUp = document.getElementById('slideUpBanner');
      var slideUpShown = false;
      setTimeout(function() {
        if (!slideUpShown && slideUp) {
          slideUp.classList.add('show');
          slideUpShown = true;
        }
      }, 180000);
      var closeSlide = document.getElementById('closeSlideUp');
      if (closeSlide) closeSlide.addEventListener('click', function() {
        slideUp.classList.remove('show');
      });

      // Hooking #7: 스크롤 80% 배너
      var scrollBn = document.getElementById('scrollBanner');
      var scrollBnShown = false;
      window.addEventListener('scroll', function() {
        if (scrollBnShown) return;
        var scrollPct = window.scrollY / (document.documentElement.scrollHeight - window.innerHeight);
        if (scrollPct > 0.8) {
          scrollBn.classList.add('show');
          scrollBnShown = true;
        }
      });
      var closeScroll = document.getElementById('closeScrollBanner');
      if (closeScroll) closeScroll.addEventListener('click', function() {
        scrollBn.classList.remove('show');
      });

      // Toast (reserved for real notifications only)
    })();
  </script>
</body>
</html>
