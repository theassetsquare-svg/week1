---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { venues, getVenuesByType, getVenue, getVenueUrl, getReadingTime, guides } from '../../../utils/venues';

export function getStaticPaths() {
  return venues.filter(v => v.type === 'lounge').map(v => ({
    params: { regionSlug: v.regionSlug, venueSlug: v.urlSlug || v.venueSlug },
    props: { venue: v },
  }));
}

const { venue } = Astro.props;
const v = venue;
const siteUrl = 'https://week1-6m5.pages.dev';
const venueUrl = getVenueUrl(v);
const updateDate = '2026-02-18';

const sameRegion = v.relatedVenueIds.sameRegion.map(id => getVenue(id)).filter(Boolean).slice(0, 3);
const sameType = v.relatedVenueIds.sameType.map(id => getVenue(id)).filter(Boolean).slice(0, 3);
const nearby = v.relatedVenueIds.nearby.map(id => getVenue(id)).filter(Boolean).slice(0, 2);
const relatedVenues = [...sameRegion, ...sameType, ...nearby].slice(0, 6);

const shortName = v.name_display.replace(v.region + ' ', '').replace(/\s*라운지\s*$/,'').trim() || v.urlSlug || v.venueSlug;
const ogImage = `https://week1-6m5.pages.dev${encodeURI(v.images[0].src)}`;
const canonicalUrl = `${siteUrl}${encodeURI(venueUrl)}`;
const title = v.pageTitle || `${v.name_display} 안내`;
const description = `${v.name_display} - ${v.teaser?.slice(0, 100) || ''}`;

const mapUrl = `https://map.naver.com/v5/search/${encodeURIComponent(v.name_display)}`;

const tocItems = [
  { id: 'summary', label: '30초 요약' },
  { id: 'hook', label: '소개' },
  { id: 'atmosphere', label: '감성 요약' },
  { id: 'story', label: '스토리텔링' },
  { id: 'timeline', label: '타임라인' },
  { id: 'planner', label: '커스텀 코스' },
  { id: 'checklist', label: '체크리스트' },
  { id: 'music', label: '음악' },
  { id: 'location', label: '위치' },
  { id: 'faq', label: 'FAQ' },
  { id: 'related', label: '관련 페이지' },
];
---
<BaseLayout title={title} description={description} canonical={canonicalUrl} ogImage={ogImage}>
  <section class="venue-hero-immersive venue-hero-immersive--lounge">
    <div class="container content-narrow">
      <div class="breadcrumb">
        <a href="/">홈</a><span>/</span>
        <a href="/lounges/">라운지 목록</a><span>/</span>
        {v.region !== shortName && <><a href={`/region/${v.regionSlug}/`}>{v.region}</a><span>/</span></>}
        <span>{shortName}</span>
      </div>
      <img src={encodeURI(v.images[0].src)} alt={`${v.name_display} 대표 이미지`} class="venue-hero-img" width="500" height="500" loading="eager" />
      <h1 class="venue-hero__title">{v.name_display}</h1>
    </div>
  </section>

  <div class="container content-narrow">
    <!-- 30초 요약 -->
    <section class="quick-summary" id="summary">
      <div class="quick-summary__title">30초 요약</div>
      <ul class="quick-summary__list">
        <li>{v.region} 지역 라운지 · {v.geo.formatted_address !== '확인 필요' ? v.geo.formatted_address : `${v.region} 소재`}</li>
        <li>{v.bodySections.atmosphere.split('.')[0]}.</li>
        <li>{v.bodySections.music.split('.')[0]}.</li>
        {v.checklist[0] && <li>첫 방문 팁: {v.checklist[0]}</li>}
        {v.timeline[0] && <li>추천 시간대: {v.timeline[0].time} — {v.timeline[0].label}</li>}
        <li>정보 갱신일: {updateDate}</li>
      </ul>
    </section>

    <!-- CTA #1: 상단 -->
    <div class="venue-cta-inline">
      <a href={mapUrl} target="_blank" rel="noopener noreferrer" class="venue-cta-btn venue-cta-btn--primary">네이버 지도에서 {shortName} 찾기</a>
      <a href="/lounges/" class="venue-cta-btn">라운지 목록 보기</a>
    </div>

    <aside class="fact-box" aria-label="기본 정보">
      <time class="fact-box__date" datetime={updateDate}>갱신 {updateDate}</time>
    </aside>

    <nav class="toc">
      <h3>목차</h3>
      <ol>
        {tocItems.map(item => (
          <li><a href={`#${item.id}`}>{item.label}</a></li>
        ))}
      </ol>
    </nav>

    {v.hookIntro && (
      <section class="venue-section" id="hook">
        <h2>소개</h2>
        <p>{v.hookIntro}</p>
      </section>
    )}

    <section class="venue-section" id="atmosphere">
      <h2>감성 요약</h2>
      <p>{v.bodySections.atmosphere}</p>
    </section>

    <section class="venue-section" id="story">
      <h2>스토리텔링: {v.storyFrame.style}</h2>
      <div class="accordion">
        <div class="accordion-item">
          <button class="accordion-trigger">Act 1 – 도착 <span class="icon">▼</span></button>
          <div class="accordion-content"><div class="accordion-content-inner">{v.story.scene1}</div></div>
        </div>
        <div class="accordion-item">
          <button class="accordion-trigger">Act 2 – 경험 <span class="icon">▼</span></button>
          <div class="accordion-content"><div class="accordion-content-inner">{v.story.scene2}</div></div>
        </div>
        <div class="accordion-item">
          <button class="accordion-trigger">Act 3 – 절정과 마무리 <span class="icon">▼</span></button>
          <div class="accordion-content"><div class="accordion-content-inner">{v.story.scene3}</div></div>
        </div>
        <div class="accordion-item">
          <button class="accordion-trigger">감각의 디테일 <span class="icon">▼</span></button>
          <div class="accordion-content"><div class="accordion-content-inner">{v.story.scene4}</div></div>
        </div>
        <div class="accordion-item">
          <button class="accordion-trigger">감성의 여운 <span class="icon">▼</span></button>
          <div class="accordion-content"><div class="accordion-content-inner">{v.story.scene5}</div></div>
        </div>
        {v.story.scene6 && (
          <div class="accordion-item">
            <button class="accordion-trigger">Act 4 – 사람들 <span class="icon">▼</span></button>
            <div class="accordion-content"><div class="accordion-content-inner">{v.story.scene6}</div></div>
          </div>
        )}
        {v.story.scene7 && (
          <div class="accordion-item">
            <button class="accordion-trigger">Act 5 – 비하인드 <span class="icon">▼</span></button>
            <div class="accordion-content"><div class="accordion-content-inner">{v.story.scene7}</div></div>
          </div>
        )}
        {v.story.scene8 && (
          <div class="accordion-item">
            <button class="accordion-trigger">Act 6 – 재방문 <span class="icon">▼</span></button>
            <div class="accordion-content"><div class="accordion-content-inner">{v.story.scene8}</div></div>
          </div>
        )}
      </div>
    </section>

    <section class="venue-section" id="timeline">
      <h2>타임라인</h2>
      <div class="timeline">
        {v.timeline.map(t => (
          <div class="timeline-item">
            <div class="timeline-dot"></div>
            <div class="timeline-time">{t.time}</div>
            <div class="timeline-label">{t.label}</div>
            <div class="timeline-desc">{t.desc}</div>
          </div>
        ))}
      </div>
    </section>

    <section class="venue-section" id="planner">
      <h2>커스텀 코스</h2>
      <div class="planner">
        <div class="planner-group">
          <label>1</label>
          <div class="planner-options" data-group="purpose">
            {Object.keys(v.plannerRules['p'] || {}).map((k, i) => (
              <button class="planner-btn" data-key={`p${i}`} >{k}</button>
            ))}
          </div>
        </div>
        <div class="planner-group">
          <label>2</label>
          <div class="planner-options" data-group="time">
            {Object.keys(v.plannerRules['t'] || {}).map((k, i) => (
              <button class="planner-btn" data-key={`t${i}`} >{k}</button>
            ))}
          </div>
        </div>
        <div class="planner-result" id="plannerResult">선택해주세요.</div>
      </div>
    </section>

    <section class="venue-section" id="checklist">
      <h2>체크리스트</h2>
      <table class="checklist-table">
        <thead><tr><th>항목</th><th>체크</th></tr></thead>
        <tbody>
          {v.checklist.map((item, i) => (
            <tr><td>{item}</td><td><input type="checkbox" id={`ck${i}`} /></td></tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="venue-section" id="music">
      <h2>음악</h2>
      <p>{v.bodySections.music}</p>
    </section>

    <section class="venue-section" id="location">
      <h2>위치</h2>
      <div class="location-info">
        {v.geo.precision !== 'none' ? (
          <p><span class="location-label">주소:</span> {v.geo.formatted_address === '확인 필요' ? '확인 필요 – 출발 전 직접 확인을 권장합니다' : v.geo.formatted_address}</p>
        ) : (
          <p>정확한 위치 정보 확인이 필요합니다. 출발 전 직접 확인을 권장합니다.</p>
        )}
      </div>
      <div class="map-buttons">
        <a href={mapUrl} target="_blank" rel="noopener noreferrer" class="map-btn map-btn--naver">네이버 지도에서 {shortName} 찾기</a>
        <a href={`https://www.google.com/maps/search/${encodeURIComponent(v.name_display)}`} target="_blank" rel="noopener noreferrer" class="map-btn map-btn--google">구글 지도에서 {shortName} 찾기</a>
      </div>
    </section>

    <!-- CTA #2: 중간 -->
    <div class="venue-cta-inline">
      <a href={mapUrl} target="_blank" rel="noopener noreferrer" class="venue-cta-btn venue-cta-btn--primary">지도에서 보기</a>
      <a href={`/region/${v.regionSlug}/`} class="venue-cta-btn">{v.region} 다른 매장 보기</a>
    </div>

    <section class="venue-section" id="faq">
      <h2>자주 묻는 질문</h2>
      {v.faq.map(f => (
        <div class="faq-item">
          <div class="faq-q">{f.q}</div>
          <div class="faq-a">{f.a}</div>
        </div>
      ))}
    </section>

    <section class="venue-section">
      <h2>매너/안전/예산 안내</h2>
      <p>{v.bodySections.safety}</p>
    </section>

    <section class="venue-section" id="related">
      <h2>관련 페이지</h2>
      <div class="related-grid">
        {relatedVenues.map(rv => (
          <a href={encodeURI(getVenueUrl(rv!))} class="related-link">{rv!.name_display}</a>
        ))}
        <a href={`/region/${v.regionSlug}/`} class="related-link">{v.region} 전체 보기</a>
        <a href="/lounges/" class="related-link">라운지 전체 목록</a>
      </div>
    </section>

    <section class="venue-section" id="gallery">
      <h2>갤러리</h2>
      <div class="gallery">
        {v.images.slice(0, 3).map((img, i) => (
          <figure>
            <img src={encodeURI(img.src)} alt={`${v.name_display} 이미지 ${i + 1}`} width="400" height="340" loading="lazy" />
          </figure>
        ))}
      </div>
    </section>

    <!-- CTA #3: 하단 -->
    <div class="venue-cta-area">
      <a href={mapUrl} target="_blank" rel="noopener noreferrer" class="venue-cta-btn venue-cta-btn--primary">지도에서 보기</a>
      <a href="/lounges/" class="venue-cta-btn">목록으로</a>
      <button class="venue-cta-btn" id="correctionBtn" type="button">정정 요청</button>
    </div>

  </div>

  <script define:vars={{ plannerRules: v.plannerRules }}>
    let selectedPurpose = '';
    let selectedTime = '';

    document.querySelectorAll('.planner-options').forEach(group => {
      group.querySelectorAll('.planner-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const g = group.getAttribute('data-group');
          const key = btn.textContent?.trim() || '';
          group.querySelectorAll('.planner-btn').forEach(b => b.classList.remove('selected'));
          btn.classList.add('selected');
          if (g === 'purpose') selectedPurpose = key;
          if (g === 'time') selectedTime = key;
          updatePlan();
        });
      });
    });

    function updatePlan() {
      const result = document.getElementById('plannerResult');
      if (!result) return;
      let text = '';
      if (selectedPurpose && plannerRules['p']) {
        text += plannerRules['p'][selectedPurpose] || '';
      }
      if (selectedTime && plannerRules['t']) {
        text += (text ? ' ' : '') + (plannerRules['t'][selectedTime] || '');
      }
      result.textContent = text || '선택해주세요.';
    }
  </script>
</BaseLayout>
