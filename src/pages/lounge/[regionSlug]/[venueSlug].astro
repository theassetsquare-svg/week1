---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { venues, getVenuesByType, getVenue, getVenueUrl, getReadingTime, guides } from '../../../utils/venues';

export function getStaticPaths() {
  return venues.filter(v => v.type === 'lounge').map(v => ({
    params: { regionSlug: v.regionSlug, venueSlug: v.urlSlug || v.venueSlug },
    props: { venue: v },
  }));
}

const { venue } = Astro.props;
const v = venue;
const siteUrl = 'https://week1-6m5.pages.dev';
const venueUrl = getVenueUrl(v);
const updateDate = '2026-02-18';

const sameRegion = v.relatedVenueIds.sameRegion.map(id => getVenue(id)).filter(Boolean).slice(0, 3);
const sameType = v.relatedVenueIds.sameType.map(id => getVenue(id)).filter(Boolean).slice(0, 3);
const nearby = v.relatedVenueIds.nearby.map(id => getVenue(id)).filter(Boolean).slice(0, 2);
const relatedVenues = [...sameRegion, ...sameType, ...nearby].slice(0, 6);

const shortName = v.name_display.replace(v.region + ' ', '').replace(/\s+라운지\s*$/,'').trim() || v.urlSlug || v.venueSlug;
const ogImage = `https://week1-6m5.pages.dev${encodeURI(v.images[0].src)}`;
const canonicalUrl = `${siteUrl}${encodeURI(venueUrl)}`;
const title = v.pageTitle || `${v.name_display} 안내`;
const description = v.metaDescription || `${v.name_display} - ${v.teaser?.slice(0, 100) || ''}`;

const mapUrl = `https://map.naver.com/v5/search/${encodeURIComponent(v.name_display)}`;

const tocItems = [
  { id: 'summary', label: '미리 보기' },
  { id: 'hook', label: '이 공간은' },
  { id: 'atmosphere', label: '무드 노트' },
  { id: 'story', label: '한 잔의 기록' },
  { id: 'gallery', label: '인테리어 컷' },
  { id: 'timeline', label: '시간대별 추천' },
  { id: 'planner', label: '시나리오 플래너' },
  { id: 'checklist', label: '방문 전 확인' },
  { id: 'music', label: '선곡 & BGM' },
  { id: 'location', label: '위치 안내' },
  { id: 'faq', label: '자주 묻는 질문' },
  { id: 'conclusion', label: '소믈리에 코멘트' },
  { id: 'related', label: '취향이 비슷한 곳' },
];

const jsonLdSchemas: object[] = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": title,
    "description": description,
    "url": canonicalUrl,
    "dateModified": updateDate,
    "inLanguage": "ko",
    "isPartOf": {
      "@type": "WebSite",
      "name": "NLC 전국 나이트·클럽·라운지 정보",
      "url": siteUrl
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "홈", "item": siteUrl + "/" },
      { "@type": "ListItem", "position": 2, "name": "라운지", "item": siteUrl + "/lounges/" },
      { "@type": "ListItem", "position": 3, "name": v.region, "item": siteUrl + "/region/" + v.regionSlug + "/" },
      { "@type": "ListItem", "position": 4, "name": v.name_display }
    ]
  }
];

if (v.faq && v.faq.length > 0) {
  jsonLdSchemas.push({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": v.faq.slice(0, 8).map((f: { q: string; a: string }) => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": f.a
      }
    }))
  });
}
---
<BaseLayout title={title} description={description} canonical={canonicalUrl} ogImage={ogImage} jsonLd={jsonLdSchemas}>
  <section class="venue-hero-immersive venue-hero-immersive--lounge">
    <div class="container content-narrow">
      <div class="breadcrumb">
        <a href="/">홈</a><span>/</span>
        <a href="/lounges/">라운지 목록</a><span>/</span>
        {v.region !== shortName && <><a href={`/region/${v.regionSlug}/`}>{v.region}</a><span>/</span></>}
        <span>{shortName}</span>
      </div>
      <img src={encodeURI(v.images[0].src)} alt={`${v.name_display} 대표 이미지`} class="venue-hero-img" width="500" height="500" loading="eager" />
      <span class="venue-hero__cat-badge">라운지</span>
      <h1 class="venue-hero__title">{v.name_display} 방문 가이드</h1>
    </div>
  </section>

  <div class="container content-narrow">
    <section class="quick-summary" id="summary">
      <div class="quick-summary__title">미리 보기</div>
      <ul class="quick-summary__list">
        <li>{v.region} 프리미엄 라운지 · {v.geo.formatted_address !== '확인 필요' ? v.geo.formatted_address : `${v.region} 위치`}</li>
        <li>공간감 — {v.bodySections.atmosphere.split('.')[0]}.</li>
        <li>선곡 — {v.bodySections.music.split('.')[0]}.</li>
        {v.checklist[0] && <li>예약 전 참고: {v.checklist[0]}</li>}
        {v.timeline[0] && <li>베스트 타임: {v.timeline[0].time} — {v.timeline[0].label}</li>}
        <li>정보 기준일: {updateDate}</li>
      </ul>
    </section>

    <div class="venue-cta-inline">
      <a href={mapUrl} target="_blank" rel="noopener noreferrer" class="venue-cta-btn venue-cta-btn--primary">{shortName} 예약 전 위치 보기</a>
      <a href="/lounges/" target="_blank" rel="noopener noreferrer" class="venue-cta-btn">다른 라운지 둘러보기</a>
    </div>

    <aside class="fact-box" aria-label="기본 정보">
      <time class="fact-box__date" datetime={updateDate}>갱신 {updateDate}</time>
    </aside>

    <nav class="toc">
      <h3>목차</h3>
      <ol>
        {tocItems.map(item => (
          <li><a href={`#${item.id}`}>{item.label}</a></li>
        ))}
      </ol>
    </nav>

    {v.hookIntro && (
      <section class="venue-section" id="hook">
        <h2>이 공간은</h2>
        <p>{v.hookIntro}</p>
      </section>
    )}

    <section class="venue-section" id="atmosphere">
      <h2>무드 노트</h2>
      <p>{v.bodySections.atmosphere}</p>
    </section>

    <section class="venue-section" id="story">
      <h2>한 잔의 기록: {v.storyFrame.style}</h2>
      <div class="accordion">
        <div class="accordion-item">
          <button class="accordion-trigger">도착 — 문을 열면 퍼지는 향 <span class="icon">▼</span></button>
          <div class="accordion-content"><div class="accordion-content-inner">{v.story.scene1}</div></div>
        </div>
        <div class="accordion-item">
          <button class="accordion-trigger">자리 — 바 카운터에 앉다 <span class="icon">▼</span></button>
          <div class="accordion-content"><div class="accordion-content-inner">{v.story.scene2}</div></div>
        </div>
        <div class="accordion-item">
          <button class="accordion-trigger">대화 — 잔 너머로 눈이 마주치다 <span class="icon">▼</span></button>
          <div class="accordion-content"><div class="accordion-content-inner">{v.story.scene3}</div></div>
        </div>
        <div class="accordion-item">
          <button class="accordion-trigger">감각 — 조명, 잔의 온도, 배경음악 <span class="icon">▼</span></button>
          <div class="accordion-content"><div class="accordion-content-inner">{v.story.scene4}</div></div>
        </div>
        <div class="accordion-item">
          <button class="accordion-trigger">마무리 — 마지막 한 모금의 여운 <span class="icon">▼</span></button>
          <div class="accordion-content"><div class="accordion-content-inner">{v.story.scene5}</div></div>
        </div>
        {v.story.scene6 && (
          <div class="accordion-item">
            <button class="accordion-trigger">바텐더 — 이 공간의 호스트 <span class="icon">▼</span></button>
            <div class="accordion-content"><div class="accordion-content-inner">{v.story.scene6}</div></div>
          </div>
        )}
        {v.story.scene7 && (
          <div class="accordion-item">
            <button class="accordion-trigger">숨은 메뉴 — 아는 사람만 아는 한 잔 <span class="icon">▼</span></button>
            <div class="accordion-content"><div class="accordion-content-inner">{v.story.scene7}</div></div>
          </div>
        )}
        {v.story.scene8 && (
          <div class="accordion-item">
            <button class="accordion-trigger">단골 — 다시 그 자리에 앉는 이유 <span class="icon">▼</span></button>
            <div class="accordion-content"><div class="accordion-content-inner">{v.story.scene8}</div></div>
          </div>
        )}
      </div>
    </section>

    <section class="venue-section" id="gallery">
      <h2>인테리어 컷</h2>
      <div class="gallery-mid">
        {v.images.slice(0, 3).map((img, i) => (
          <img src={encodeURI(img.src)} alt={`${v.name_display} ${i === 0 ? '외관과 간판' : i === 1 ? '바 카운터와 조명' : '좌석 배치와 인테리어'}`} width="400" height="400" loading="lazy" />
        ))}
      </div>
    </section>

    <section class="venue-section" id="timeline">
      <h2>시간대별 추천</h2>
      <div class="timeline">
        {v.timeline.map(t => (
          <div class="timeline-item">
            <div class="timeline-dot"></div>
            <div class="timeline-time">{t.time}</div>
            <div class="timeline-label">{t.label}</div>
            <div class="timeline-desc">{t.desc}</div>
          </div>
        ))}
      </div>
    </section>

    <section class="venue-section" id="planner">
      <h2>시나리오 플래너</h2>
      <div class="planner">
        <div class="planner-group">
          <label>상황</label>
          <div class="planner-options" data-group="purpose">
            {Object.keys(v.plannerRules['p'] || {}).map((k, i) => (
              <button class="planner-btn" data-key={`p${i}`} >{k}</button>
            ))}
          </div>
        </div>
        <div class="planner-group">
          <label>방문 시간</label>
          <div class="planner-options" data-group="time">
            {Object.keys(v.plannerRules['t'] || {}).map((k, i) => (
              <button class="planner-btn" data-key={`t${i}`} >{k}</button>
            ))}
          </div>
        </div>
        <div class="planner-result" id="plannerResult">상황과 방문 시간을 선택해주세요.</div>
      </div>
    </section>

    <section class="venue-section" id="checklist">
      <h2>방문 전 확인사항</h2>
      <table class="checklist-table">
        <thead><tr><th>사항</th><th>완료</th></tr></thead>
        <tbody>
          {v.checklist.map((item, i) => (
            <tr><td>{item}</td><td><input type="checkbox" id={`ck${i}`} /></td></tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="venue-section" id="music">
      <h2>선곡 & BGM</h2>
      <p>{v.bodySections.music}</p>
    </section>

    <section class="venue-section" id="location">
      <h2>위치 안내</h2>
      <div class="location-info">
        {v.geo.precision !== 'none' ? (
          <p><span class="location-label">주소:</span> {v.geo.formatted_address === '확인 필요' ? '확인 필요 – 예약 시 매장에 직접 문의하세요' : v.geo.formatted_address}</p>
        ) : (
          <p>정확한 위치는 매장에 직접 문의해주세요.</p>
        )}
      </div>
      <div class="map-buttons">
        <a href={mapUrl} target="_blank" rel="noopener noreferrer" class="map-btn map-btn--naver">네이버 지도에서 확인</a>
        <a href={`https://www.google.com/maps/search/${encodeURIComponent(v.name_display)}`} target="_blank" rel="noopener noreferrer" class="map-btn map-btn--google">구글 맵에서 보기</a>
      </div>
    </section>

    <div class="venue-cta-inline">
      <a href={mapUrl} target="_blank" rel="noopener noreferrer" class="venue-cta-btn venue-cta-btn--primary">{shortName} 위치 보기</a>
      <a href={`/region/${v.regionSlug}/`} target="_blank" rel="noopener noreferrer" class="venue-cta-btn">{v.region} 추천 라운지</a>
    </div>

    <section class="venue-section" id="faq">
      <h2>자주 묻는 질문</h2>
      {v.faq.map(f => (
        <div class="faq-item">
          <div class="faq-q">{f.q}</div>
          <div class="faq-a">{f.a}</div>
        </div>
      ))}
    </section>

    <section class="venue-section">
      <h2>드레스코드 & 매너</h2>
      <p>{v.bodySections.safety}</p>
    </section>

    <section class="venue-conclusion" id="conclusion">
      <h2>소믈리에 코멘트</h2>
      <p>낮은 조명 아래, 잔을 기울이며 자연스럽게 대화가 깊어지는 곳 — {v.name_display}은(는) 그런 밤을 선사합니다. {v.region}에서 분위기 좋은 공간을 찾고 있다면, 위의 시간대별 추천과 시나리오 플래너를 활용해 완벽한 저녁을 설계해보세요.</p>
      <div class="venue-cta-inline">
        <a href={mapUrl} target="_blank" rel="noopener noreferrer" class="venue-cta-btn venue-cta-btn--primary">{shortName} 예약 전 위치 보기</a>
        <a href="/lounges/" target="_blank" rel="noopener noreferrer" class="venue-cta-btn">다른 라운지 둘러보기</a>
      </div>
    </section>

    <section class="venue-section" id="related">
      <h2>취향이 비슷한 곳</h2>
      <div class="related-grid">
        {relatedVenues.map(rv => (
          <a href={encodeURI(getVenueUrl(rv!))} target="_blank" rel="noopener noreferrer" class="related-link">{rv!.name_display}</a>
        ))}
        <a href={`/region/${v.regionSlug}/`} target="_blank" rel="noopener noreferrer" class="related-link">{v.region} 전체 보기</a>
        <a href="/lounges/" target="_blank" rel="noopener noreferrer" class="related-link">라운지 전체 목록</a>
      </div>
    </section>

    <aside class="trust-block" id="trust">
      <h3>콘텐츠 검증</h3>
      <ul class="update-log">
        <li><time datetime={updateDate}>{updateDate}</time> <span>매장 운영 현황 재확인</span></li>
        <li><time datetime="2026-02-10">2026-02-10</time> <span>첫 취재 및 등록</span></li>
      </ul>
      <div class="trust-block__links">
        <a href="/about/" target="_blank" rel="noopener noreferrer">콘텐츠 기준 보기</a>
        <button type="button" id="correctionBtn">잘못된 정보 알려주기</button>
      </div>
    </aside>

    <div class="venue-cta-area">
      <a href={mapUrl} target="_blank" rel="noopener noreferrer" class="venue-cta-btn venue-cta-btn--primary">위치 확인</a>
      <a href="/lounges/" target="_blank" rel="noopener noreferrer" class="venue-cta-btn">목록으로</a>
    </div>
  </div>

  <script define:vars={{ plannerRules: v.plannerRules }}>
    let selectedPurpose = '';
    let selectedTime = '';

    document.querySelectorAll('.planner-options').forEach(group => {
      group.querySelectorAll('.planner-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const g = group.getAttribute('data-group');
          const key = btn.textContent?.trim() || '';
          group.querySelectorAll('.planner-btn').forEach(b => b.classList.remove('selected'));
          btn.classList.add('selected');
          if (g === 'purpose') selectedPurpose = key;
          if (g === 'time') selectedTime = key;
          updatePlan();
        });
      });
    });

    function updatePlan() {
      const result = document.getElementById('plannerResult');
      if (!result) return;
      let text = '';
      if (selectedPurpose && plannerRules['p']) {
        text += plannerRules['p'][selectedPurpose] || '';
      }
      if (selectedTime && plannerRules['t']) {
        text += (text ? ' ' : '') + (plannerRules['t'][selectedTime] || '');
      }
      result.textContent = text || '상황과 방문 시간을 선택해주세요.';
    }
  </script>
</BaseLayout>
