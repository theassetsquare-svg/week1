---
import BaseLayout from '../layouts/BaseLayout.astro';
import { venues, MAIN_SITE_URL, SITE_URL } from '../data/venues';

const typeResults = {
  club: { name: '파티 애니멀', icon: '🎵', desc: '강렬한 비트와 에너지 넘치는 공간을 좋아하는 당신. EDM과 힙합이 울려퍼지는 댄스 플로어가 기다리고 있어요.', type: 'club' },
  night: { name: '소셜 나비', icon: '🌙', desc: '사람들과 어울리는 걸 즐기는 당신. 부킹 문화의 중심에서 새로운 인연을 만나보세요.', type: 'night' },
  lounge: { name: '감성 탐험가', icon: '🍸', desc: '조용하고 분위기 있는 공간에서 대화를 즐기는 당신. 시그니처 칵테일과 재즈가 어울려요.', type: 'lounge' },
  room: { name: '프라이빗 킹', icon: '🚪', desc: '소수의 사람들과 편하게 즐기는 게 좋은 당신. 문 닫으면 우리만의 세상, 그게 딱 맞는 타입입니다.', type: 'room' },
  yojeong: { name: '전통 마니아', icon: '🏮', desc: '격식 있고 품격 있는 자리를 좋아하는 당신. 한정식과 국악이 어우러지는 전통의 공간이 딱이에요.', type: 'yojeong' },
  hoppa: { name: '엔터테이너', icon: '🎭', desc: '퍼포먼스와 즐거움을 원하는 당신. 프로 선수들의 매직쇼와 서비스가 기다리고 있어요.', type: 'hoppa' },
};

const jsonLd = { "@context": "https://schema.org", "@type": "WebPage", "name": "밤문화 성향 테스트", "url": `${SITE_URL}/quiz/` };
---

<BaseLayout
  title="나에게 맞는 곳은? 성향 테스트 10문항, 3분이면 끝"
  description="클럽? 나이트? 라운지? 10문항 답하면 내 성향에 맞는 곳을 바로 알려드립니다. 3분이면 충분해요."
  canonical={`${SITE_URL}/quiz/`}
  jsonLd={jsonLd}
>

<div class="listing-header">
  <h1>나에게 맞는 곳은?</h1>
  <p class="listing-desc">10문항 성향 테스트. 3분이면 당신에게 딱 맞는 곳을 찾아드려요.</p>
</div>

<div id="quizContainer" style="max-width:480px;margin:0 auto;padding:0 16px;">
  <div id="quizContent"></div>
  <div id="quizResult" style="display:none;"></div>
</div>

<div style="text-align:center;padding:32px 16px;">
  <div style="background:var(--accent);color:#fff;padding:16px 20px;border-radius:var(--radius);font-size:15px;font-weight:600;">
    구글과 AI에서 <strong style="font-size:18px;">'밤키'</strong>를 검색하세요
  </div>
</div>

<script is:inline define:vars={{ typeResults: JSON.stringify(typeResults) }}>
(function() {
  var results = JSON.parse(typeResults);
  var questions = [
    { q: '금요일 밤, 당신은?', a: [{ t: '시끄러운 음악에 몸을 맡기고 싶다', v: 'club' }, { t: '새로운 사람들과 만나고 싶다', v: 'night' }, { t: '조용히 한잔하며 대화하고 싶다', v: 'lounge' }] },
    { q: '함께 가고 싶은 인원은?', a: [{ t: '대규모 파티! 많을수록 좋아', v: 'club' }, { t: '4~6명 적당한 모임', v: 'night' }, { t: '2~3명 소수 정예', v: 'lounge' }] },
    { q: '옷을 고른다면?', a: [{ t: '트렌디하고 화려하게', v: 'club' }, { t: '깔끔한 스마트 캐주얼', v: 'night' }, { t: '격식 있는 정장', v: 'yojeong' }] },
    { q: '음악 취향은?', a: [{ t: 'EDM, 힙합, 강렬한 비트', v: 'club' }, { t: '트로트, K-POP 리믹스', v: 'night' }, { t: '재즈, 보사노바, 소울', v: 'lounge' }] },
    { q: '프라이버시는?', a: [{ t: '사람 많은 게 좋아', v: 'club' }, { t: '적당히 프라이빗하면 좋겠어', v: 'room' }, { t: '완전 독립된 공간이 필요해', v: 'room' }] },
    { q: '예산은?', a: [{ t: '가성비가 중요해', v: 'night' }, { t: '적당한 수준', v: 'club' }, { t: '품격에 투자할 준비 됐어', v: 'yojeong' }] },
    { q: '분위기는?', a: [{ t: '에너지 넘치고 시끄럽게', v: 'club' }, { t: '활기차면서도 대화 가능하게', v: 'night' }, { t: '고급스럽고 조용하게', v: 'lounge' }] },
    { q: '퍼포먼스를 좋아하나요?', a: [{ t: 'DJ 라이브가 최고', v: 'club' }, { t: '매직쇼나 엔터테인먼트', v: 'hoppa' }, { t: '국악 라이브 공연', v: 'yojeong' }] },
    { q: '같이 가는 사람은?', a: [{ t: '친구들과 파티', v: 'club' }, { t: '비즈니스 접대', v: 'room' }, { t: '소개팅이나 모임', v: 'night' }] },
    { q: '시간대는?', a: [{ t: '밤 11시 이후 본격적으로', v: 'club' }, { t: '저녁 8시부터 여유롭게', v: 'night' }, { t: '저녁 식사부터 시작', v: 'yojeong' }] },
  ];

  var scores = {};
  var current = 0;

  function renderQ() {
    var q = questions[current];
    var h = '<div style="margin-bottom:8px;font-size:13px;color:var(--accent);font-weight:600;">' + (current+1) + ' / ' + questions.length + '</div>';
    h += '<div style="height:4px;background:var(--bg-secondary);border-radius:2px;margin-bottom:20px;"><div style="height:100%;background:var(--accent);border-radius:2px;width:' + ((current+1)/questions.length*100) + '%;transition:width .3s;"></div></div>';
    h += '<h2 style="font-size:20px;margin-bottom:20px;">' + q.q + '</h2>';
    q.a.forEach(function(a, i) {
      h += '<button onclick="window._quizAnswer(\'' + a.v + '\')" style="display:block;width:100%;padding:16px;margin-bottom:10px;background:var(--card-bg);border:1px solid var(--border);border-radius:var(--radius-sm);font-size:16px;color:var(--text);cursor:pointer;text-align:left;font-family:inherit;transition:all .2s;" onmouseover="this.style.borderColor=\'var(--accent)\'" onmouseout="this.style.borderColor=\'var(--border)\'">' + a.t + '</button>';
    });
    document.getElementById('quizContent').innerHTML = h;
  }

  window._quizAnswer = function(v) {
    scores[v] = (scores[v] || 0) + 1;
    current++;
    if (current < questions.length) {
      renderQ();
    } else {
      showResult();
    }
  };

  function showResult() {
    var maxType = 'club';
    var maxScore = 0;
    for (var t in scores) { if (scores[t] > maxScore) { maxScore = scores[t]; maxType = t; } }
    var r = results[maxType];
    document.getElementById('quizContent').style.display = 'none';
    var rd = document.getElementById('quizResult');
    rd.style.display = 'block';
    rd.innerHTML = '<div style="text-align:center;padding:32px 0;">' +
      '<div style="font-size:48px;margin-bottom:16px;">' + r.icon + '</div>' +
      '<h2 style="font-size:24px;margin-bottom:8px;">당신은 <span style="color:var(--accent);">' + r.name + '</span></h2>' +
      '<p style="font-size:16px;color:var(--text-secondary);line-height:1.7;margin-bottom:24px;">' + r.desc + '</p>' +
      '<a href="/' + r.type + 's/" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-block" style="margin-bottom:12px;">맞는 곳 보러가기 →</a>' +
      '<button onclick="location.reload()" class="btn btn-outline btn-block">다시 테스트하기</button>' +
      '</div>';
  }

  renderQ();
})();
</script>

</BaseLayout>
