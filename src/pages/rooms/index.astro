---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getVenuesByType, venues, SITE_URL, MAIN_SITE_URL } from '../../data/venues';

const roomVenues = getVenuesByType('room');
const regions = [...new Set(roomVenues.map(v => v.region))].sort();

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "프라이빗 공간 목록",
  "numberOfItems": roomVenues.length,
  "itemListElement": roomVenues.slice(0,5).map((v, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "url": `${SITE_URL}/venue/${v.slug}/`
  }))
};
---

<BaseLayout
  title={`룸 ${roomVenues.length}곳 — 문 닫으면 바깥세상이 사라진다`}
  description={`일산·해운대 ${roomVenues.length}곳 정찰제 독립 공간. 접대든 회식이든 가족 행사든 목적 말하면 규모·메뉴·차량까지 세팅 전부 잡아줍니다. 예산 걱정 없이 가세요.`}
  canonical={`${SITE_URL}/rooms/`}
  ogImage={`${SITE_URL}/og/rooms.svg`}
  jsonLd={jsonLd}
>

<div class="listing-header">
  <h1>룸 {roomVenues.length}곳 프라이빗 공간 안내</h1>
</div>
<h2 class="cat-intro-title">룸의 핵심, 문 닫으면 세상이 멈춘다</h2>
<div class="cat-intro">
  룸은 문 닫으면 바깥세상이 사라집니다. 그게 룸의 핵심입니다.
  일산 룸은 개인실이 넓고 정찰제라 예산 걱정 없이 갈 수 있어서 접대용으로 많이 씁니다.
  해운대 룸은 바다가 보입니다. 인테리어도 신경 썼고, 자리 분위기가 한 단계 올라갑니다.
  전담 매니저가 입장부터 퇴장까지 세팅 잡아주니까, 룸 안에서 신경 쓸 게 없습니다.
  회식, 거래처 접대, 가족 행사 — 목적 말하면 맞는 룸 규모와 구성을 짜줍니다.
  차량 배차까지 포함된 올인원 패키지 운영하는 곳도 있어서, 진짜 편합니다.
  룸 수용 인원과 시설 비교해 보고 고르세요.
</div>

<!-- 업소 리스트 (서버사이드 렌더링!) -->
<div style="max-width:480px;margin:0 auto;padding:0 16px;">
  {roomVenues.map((v, i) => (
    <a href={`/venue/${v.slug}/`} target="_blank" rel="noopener noreferrer" class="venue-card">
      <div class="venue-card-header"><span class="rank-badge">{i + 1}</span></div>
      <div class="venue-card-name">{v.name}</div>
      <div class="venue-card-desc">{v.shortDesc}</div>
      <div class="venue-card-tags">{v.tags.slice(0, 3).map(t => <span class="venue-tag">#{t}</span>)}</div>
      {v.nickname && <div class="venue-card-contact">담당: {v.nickname}{v.phone ? ` | ${v.phone}` : ''}</div>}
    </a>
  ))}
</div>

<!-- 첫 방문 가이드 -->
<div class="fv-section">
  <h2 class="fv-title">룸 이용 전 알아둘 것</h2>
  <div class="fv-item">
    <div class="fv-q" onclick="this.parentElement.classList.toggle('open')">정장 입어야 해?<span class="fv-arrow">▼</span></div>
    <div class="fv-a"><p>비즈니스 정장이 가장 무난합니다. 접대 자리라면 넥타이까지 갖추는 것이 예의이고, 친목 모임이라면 셔츠·슬랙스 정도로 충분합니다. 편안한 분위기의 모임이라도 반바지·슬리퍼는 피하세요.</p></div>
  </div>
  <div class="fv-item">
    <div class="fv-q" onclick="this.parentElement.classList.toggle('open')">룸 이용료 얼마 선이야?<span class="fv-arrow">▼</span></div>
    <div class="fv-a"><p>룸 입장료는 별도로 없으며, 테이블 이용료(주대)가 50만~200만 원 이상입니다. 룸 정찰제를 운영하는 곳이 많아 추가 비용 걱정이 적습니다. 인원 수에 따라 룸 요금이 달라지므로 사전 문의가 필수입니다.</p></div>
  </div>
  <div class="fv-item">
    <div class="fv-q" onclick="this.parentElement.classList.toggle('open')">최소 몇 명부터 돼?<span class="fv-arrow">▼</span></div>
    <div class="fv-a"><p>룸 특성상 최소 2인 이상 이용을 기본으로 합니다. 소규모 룸부터 대형 연회실까지 인원에 맞는 공간을 배정받을 수 있습니다.</p></div>
  </div>
  <div class="fv-item">
    <div class="fv-q" onclick="this.parentElement.classList.toggle('open')">며칠 전에 잡아야 해?<span class="fv-arrow">▼</span></div>
    <div class="fv-a"><p>반드시 사전 예약이 필요합니다. 원하는 방 크기·시간대·음식 구성을 미리 조율해야 하므로, 최소 1~2일 전에 전화로 상담하시기 바랍니다.</p></div>
  </div>
</div>

<div class="cat-extra" style="max-width:480px;margin:16px auto;padding:0 16px;">
  <p style="font-size:14px;line-height:1.7;color:var(--text-secondary);">문 닫히고 조명 낮아지면 바깥세상이 통째로 사라집니다. 전담 매니저가 술·안주·분위기 전부 알아서 맞춰주니까, 안에서 신경 쓸 일이 진짜 없어요.</p>
</div>

<!-- 인기 시간대 -->
<div class="pop-times">
  <h2 class="pop-times-title">룸 예약 몰리는 요일과 시간</h2>
  <div class="pop-chart">
    {['월','화','수','목','금','토','일'].map((d, i) => {
      const pct = [30,35,65,85,100,55,20][i];
      return (
        <div class="pop-bar-wrap">
          <div class={`pop-bar${pct >= 80 ? ' peak' : ''}`} style={`height:${pct}%`}></div>
          <div class="pop-day">{d}</div>
        </div>
      );
    })}
  </div>
  <div class="pop-hours">예약 집중 시간대: 19:00 – 24:00</div>
</div>

<!-- 매거진 -->
<div class="cat-mag">
  <h2 class="cat-mag-title">룸 관련 칼럼</h2>
  <div class="cat-mag-grid">
    <a href="/magazine/" target="_blank" rel="noopener noreferrer" class="cat-mag-card" style="background:linear-gradient(135deg,#064e3b,#059669)">
      <div class="cat-mag-cat">접대</div>
      <div class="cat-mag-name">거래처 사장님 모시는 룸, 실패 없는 자리 세팅법</div>
      <div class="cat-mag-desc">룸 크기·음식 구성·좌석 배치까지 실전 노하우 공개.</div>
    </a>
    <a href="/magazine/" target="_blank" rel="noopener noreferrer" class="cat-mag-card" style="background:linear-gradient(135deg,#78350f,#d97706)">
      <div class="cat-mag-cat">정찰제</div>
      <div class="cat-mag-name">룸 정찰제 vs 시가제, 뭐가 더 이득인지 계산해봤다</div>
      <div class="cat-mag-desc">인원별·시간대별 실제 비용 차이를 숫자로 비교합니다.</div>
    </a>
  </div>
</div>

<div class="cta-section mt-md" style="max-width:480px;margin:24px auto;padding:0 16px">
  <a href={MAIN_SITE_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm">룸 전체 리스트 →</a>
</div>

</BaseLayout>
