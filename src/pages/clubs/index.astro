---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { venues, getVenueUrl } from '../../utils/venues';

const clubVenues = venues.filter(v => v.type === 'club');
const title = '전국 클럽 추천 | 한국 클럽 가이드';
const description = '한국 전국의 인기 클럽을 한눈에. 강남 클럽, 이태원 클럽 등 최신 클럽 정보와 분위기, 음악, 가격 가이드.';

// Get regions for this type
const regionMap = new Map<string, { name: string; slug: string; count: number }>();
clubVenues.forEach(v => {
  const existing = regionMap.get(v.regionSlug);
  if (existing) existing.count++;
  else regionMap.set(v.regionSlug, { name: v.region, slug: v.regionSlug, count: 1 });
});
const regions = [...regionMap.values()].sort((a, b) => b.count - a.count);

const jsonLd = [{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "전국 클럽 모음",
  "description": description,
  "url": "https://week1-6m5.pages.dev/clubs/",
  "numberOfItems": clubVenues.length,
}];
---
<BaseLayout title={title} description={description} canonical="https://week1-6m5.pages.dev/clubs/" jsonLd={jsonLd}>
  <section class="story-intro">
    <div class="container">
      <span class="story-intro__eyebrow">Club Scene Korea</span>
      <h1 class="story-intro__headline">네온이 번지는 밤,<br />베이스가 심장을 두드리는 순간</h1>
      <p class="story-intro__narrative">
        자정을 넘긴 거리, 낮은 조명 아래 줄 서 있는 사람들의 설렘이 느껴집니다.
        문이 열리는 순간 쏟아지는 <em>사운드의 파도</em>. DJ의 손끝에서 시작된 비트가
        플로어를 가득 채우고, 당신의 밤은 비로소 시작됩니다.
        <em>전국 {clubVenues.length}개 클럽</em>의 문이 지금 열립니다.
      </p>
      <div class="story-stats">
        <div class="story-stat">
          <span class="story-stat__number">{clubVenues.length}</span>
          <span class="story-stat__label">전국 클럽</span>
        </div>
        <div class="story-stat">
          <span class="story-stat__number">{regions.length}</span>
          <span class="story-stat__label">지역 커버</span>
        </div>
        <div class="story-stat">
          <span class="story-stat__number">24h</span>
          <span class="story-stat__label">실시간 정보</span>
        </div>
      </div>
      <div class="scroll-indicator">
        <span class="scroll-indicator__arrow" onclick="document.getElementById('venueSection').scrollIntoView({behavior:'smooth'})">▼</span>
        <span class="scroll-indicator__text">스크롤하여 둘러보기</span>
      </div>
    </div>
  </section>

  <section class="container category-search" id="venueSection">
    <div class="search-bar">
      <input type="text" id="venueSearch" placeholder="클럽 이름 또는 지역으로 검색..." aria-label="클럽 검색" />
    </div>
    <div class="filter-chips" id="filterChips">
      <button class="filter-chip active" data-region="all">전체 ({clubVenues.length})</button>
      {regions.map(r => (
        <button class="filter-chip" data-region={r.slug}>{r.name} ({r.count})</button>
      ))}
    </div>
    <div class="result-count" id="resultCount"></div>
  </section>

  <section class="container">
    <div class="venue-grid" id="venueGrid">
      {clubVenues.map(v => (
        <a href={getVenueUrl(v)} class="venue-card" data-region={v.regionSlug} data-name={v.name_display + ' ' + v.region}>
          <img src={v.images[0].src} alt={v.images[0].alt} class="venue-card-img" width="400" height="180" loading="lazy" />
          <div class="venue-card-body">
            <span class="venue-card-type type-club">{v.typeLabel}</span>
            <h3>{v.name_display}</h3>
            <p class="venue-card-region">{v.region}</p>
            <p class="venue-card-teaser">{v.teaser}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <script define:vars={{ total: clubVenues.length }}>
    const search = document.getElementById('venueSearch');
    const chips = document.querySelectorAll('.filter-chip');
    const cards = document.querySelectorAll('.venue-card');
    const resultCount = document.getElementById('resultCount');
    let activeRegion = 'all';

    function filterCards() {
      const q = search?.value?.toLowerCase() || '';
      let visible = 0;
      cards.forEach(card => {
        const region = card.dataset.region || '';
        const name = (card.dataset.name || '').toLowerCase();
        const matchRegion = activeRegion === 'all' || region === activeRegion;
        const matchSearch = !q || name.includes(q);
        const show = matchRegion && matchSearch;
        card.style.display = show ? '' : 'none';
        if (show) visible++;
      });
      if (resultCount) {
        resultCount.textContent = (q || activeRegion !== 'all') ? `${total}개 중 ${visible}개 표시` : '';
      }
    }

    chips.forEach(chip => {
      chip.addEventListener('click', () => {
        activeRegion = chip.dataset.region || 'all';
        chips.forEach(c => c.classList.remove('active'));
        chip.classList.add('active');
        filterCards();
      });
    });

    search?.addEventListener('input', filterCards);
  </script>
</BaseLayout>
