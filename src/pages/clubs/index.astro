---
import BaseLayout from '../../layouts/BaseLayout.astro';
import IntroSection from '../../components/IntroSection.astro';
import VenueCard from '../../components/VenueCard.astro';
import { venues, getVenueUrl } from '../../utils/venues';

const clubVenues = venues.filter(v => v.type === 'club');
const title = '전국 인기 클럽 49곳 비교 — 강남·이태원·홍대·부산';
const description = 'DJ 라인업·사운드·드레스코드·피크타임을 한 페이지에서 비교하세요. 강남, 이태원, 홍대, 부산 등 지역별 인기 클럽 현장 데이터 기반 가이드입니다.';

const regionMap = new Map<string, { name: string; slug: string; count: number }>();
clubVenues.forEach(v => {
  const existing = regionMap.get(v.regionSlug);
  if (existing) existing.count++;
  else regionMap.set(v.regionSlug, { name: v.region, slug: v.regionSlug, count: 1 });
});
const regions = [...regionMap.values()].sort((a, b) => b.count - a.count);

const jsonLd = [{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "전국 클럽 모음",
  "description": description,
  "url": "https://week1-6m5.pages.dev/clubs/",
  "numberOfItems": clubVenues.length,
}];
---
<BaseLayout title={title} description={description} canonical="https://week1-6m5.pages.dev/clubs/" jsonLd={jsonLd}>
  <section class="story-intro">
    <div class="container">
      <span class="story-intro__eyebrow">Club Scene Korea</span>
      <h1 class="story-intro__headline">어두운 조명 아래,<br />눈빛 하나면 충분합니다.</h1>
    </div>
  </section>

  <section class="container content-narrow">
    <IntroSection
      hook={`강남 클럽과 이태원 클럽, 부산 클럽 — 지역마다 무드와 음악이 다릅니다. 잘못 고르면 입장료만 날리고 톤이 맞지 않아 일찍 나오게 됩니다. 전국 클럽을 한눈에 비교할 수 있도록 정리했습니다.`}
      valuePromise={`1분 안에 전국 ${clubVenues.length}개 클럽의 지역별 분포, 현장 톤 차이, 입장 기본 정보를 파악할 수 있습니다.`}
      scanBox={[
        `전국 클럽 ${clubVenues.length}곳 수록`,
        `지역 필터: ${regions.length}개 지역 (강남, 이태원, 부산 등)`,
        '장르: EDM, 힙합, 하우스, 테크노 등 클럽별 상이',
        '선정 조건: 운영 현황, 무드, 접근성, 이용자 평가 종합',
        '사용법: 상단 지역 칩 클릭 또는 검색창 입력으로 필터링',
        '각 클럽 카드 클릭 시 체크리스트·타임라인·FAQ 포함 상세 페이지 이동',
      ]}
      checklist={[
        '방문할 지역을 먼저 정하기 (강남, 이태원, 홍대, 부산 등)',
        '원하는 음악 장르 확인 (EDM, 힙합, 하우스)',
        '예산 범위 설정 (입장료 1~3만원 + 음료 2~3잔 포함)',
        '동행 인원 확인 (1인/소그룹/단체에 따라 추천 장소 다름)',
        '방문 요일 결정 (금토 피크 vs 평일 여유)',
        '드레스코드 확인 (올블랙 무난, 슬리퍼/반바지 금지)',
      ]}
      riskItems={[
        { dont: '리뷰만 보고 클럽을 고르지 마세요', doInstead: '음악 장르와 현장 무드를 먼저 확인한 뒤 선택하세요' },
        { dont: '피크타임에 맞춰 도착하려 하지 마세요', doInstead: '오픈 후 1~2시간 내 도착이 대기 없이 입장하는 방법입니다' },
        { dont: '게스트 등록을 빼먹지 마세요', doInstead: '사전 게스트 등록 시 할인되는 클럽이 많으니 확인하세요' },
      ]}
      teasers={[
        `아래에서 ${regions.length}개 지역별 클럽 필터로 원하는 곳 바로 확인`,
        `아래에서 전국 ${clubVenues.length}개 클럽 카드 비교`,
        '각 클럽 상세 페이지에서 피크타임 가이드와 체크리스트 확인',
      ]}
    />
  </section>

  <section class="container">
    <div class="category-copy">
      <p class="category-copy__lead">
        자정이 지나면 거리에는 설렘을 안고 걸어오는 사람들로 가득합니다.<br />
        입구에서부터 느껴지는 베이스의 진동.<br />
        <strong>문이 열리는 순간, 당신의 심장도 비트에 맞춰 뛰기 시작합니다.</strong>
      </p>

      <p>
        클럽에 오는 이유는 하나입니다.<br />
        평소에는 말 걸 수 없던 사람에게, <em>이 자리에서만큼은 다가갈 수 있으니까.</em>
        DJ가 만드는 비트가 어색함을 녹이고,
        플로어 위에서 자연스럽게 가까워지는 거리.
        네온 아래 교차하는 시선이 대화를 대신합니다.
      </p>

      <div class="category-copy__highlight">
        <h3>클럽이 처음이어도 괜찮은 이유</h3>
        <ul>
          <li>혼자 와도, 친구와 와도 — 돌아갈 때는 새로운 번호 하나쯤 저장돼 있습니다</li>
          <li>나이, 직업, 배경 — 플로어 위에서는 아무도 묻지 않습니다</li>
          <li>음악이 대화를 시작해주고, 에너지가 용기를 줍니다</li>
          <li>마음에 드는 사람 옆에서 같은 노래를 듣는 것, 그것만으로 시작입니다</li>
        </ul>
      </div>

      <p>
        클럽은 만남을 위한 가장 솔직한 자리입니다.<br />
        꾸미지 않아도 됩니다. <strong>그냥 오세요. 밤이 알아서 해줍니다.</strong>
      </p>

      <div class="category-copy__tips">
        <h3>클럽 입문 가이드</h3>
        <dl>
          <dt>입장</dt>
          <dd>대부분 신분증 필수. 게스트 등록하면 할인되는 곳이 많습니다.</dd>
          <dt>타이밍</dt>
          <dd>새벽 1~2시가 피크타임. 너무 일찍 가면 텅 비어 있을 수 있습니다.</dd>
          <dt>플로어 에티켓</dt>
          <dd>눈이 마주치면 웃어보세요. 억지로 다가가기보단 음악을 즐기는 모습이 더 매력적입니다.</dd>
          <dt>드레스코드</dt>
          <dd>올블랙이 가장 무난합니다. 운동화보다 구두나 부츠를 추천합니다.</dd>
        </dl>
      </div>

      <p class="category-copy__closing">
        전국 <strong>{clubVenues.length}개 클럽</strong>이 오늘 밤 문을 엽니다.<br />
        당신이 찾는 밤은, 아래 리스트 어딘가에 있습니다.
      </p>
    </div>
  </section>

  <section class="container category-search" id="venueSection">
    <div class="search-bar">
      <input type="text" id="venueSearch" placeholder="클럽 이름 또는 지역으로 검색..." aria-label="클럽 검색" />
    </div>
    <div class="filter-chips" id="filterChips">
      <button class="filter-chip active" data-region="all">전체 ({clubVenues.length})</button>
      {regions.map(r => (
        <button class="filter-chip" data-region={r.slug}>{r.name} ({r.count})</button>
      ))}
    </div>
    <div class="result-count" id="resultCount"></div>
  </section>

  <section class="container">
    <div class="venue-grid" id="venueGrid">
      {clubVenues.map(v => (
        <VenueCard venue={v} />
      ))}
    </div>
  </section>

  <script define:vars={{ total: clubVenues.length }}>
    const search = document.getElementById('venueSearch');
    const chips = document.querySelectorAll('.filter-chip');
    const cards = document.querySelectorAll('.venue-card');
    const resultCount = document.getElementById('resultCount');
    let activeRegion = 'all';

    function filterCards() {
      const q = search?.value?.toLowerCase() || '';
      let visible = 0;
      cards.forEach(card => {
        const region = card.dataset.region || '';
        const name = (card.dataset.name || '').toLowerCase();
        const matchRegion = activeRegion === 'all' || region === activeRegion;
        const matchSearch = !q || name.includes(q);
        const show = matchRegion && matchSearch;
        card.style.display = show ? '' : 'none';
        if (show) visible++;
      });
      if (resultCount) {
        resultCount.textContent = (q || activeRegion !== 'all') ? `${total}개 중 ${visible}개 표시` : '';
      }
    }

    chips.forEach(chip => {
      chip.addEventListener('click', () => {
        activeRegion = chip.dataset.region || 'all';
        chips.forEach(c => c.classList.remove('active'));
        chip.classList.add('active');
        filterCards();
      });
    });

    search?.addEventListener('input', filterCards);
  </script>
</BaseLayout>
