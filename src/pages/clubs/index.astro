---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getVenuesByType, venues, SITE_URL, MAIN_SITE_URL } from '../../data/venues';

const clubVenues = getVenuesByType('club');
const regions = [...new Set(clubVenues.map(v => v.region))].sort();

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "전국 EDM 베뉴 목록",
  "numberOfItems": clubVenues.length,
  "itemListElement": clubVenues.slice(0,5).map((v, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "url": `${SITE_URL}/venue/${v.slug}/`
  }))
};
---

<BaseLayout
  title={`클럽 ${clubVenues.length}곳 — 사운드·드레스코드·입장료 완벽 정리`}
  description={`강남·홍대·이태원·청담 ${clubVenues.length}곳의 DJ 라인업, 드레스코드, 음료 가격을 전부 모았습니다. 들어가기 전에 직접 골라서 가세요.`}
  canonical={`${SITE_URL}/clubs/`}
  ogImage={`${SITE_URL}/og/clubs.svg`}
  jsonLd={jsonLd}
>

<div class="listing-header">
  <h1>클럽 {clubVenues.length}곳 완전 가이드</h1>
</div>
<h2 class="cat-intro-title">클럽 분위기, 가본 사람만 아는 진짜</h2>
<div class="cat-intro">
  클럽은 결국 비트입니다. 조명이 바뀌는 순간, 음악이 몸을 감싸는 순간, 옆 사람과 눈이 마주치는 순간.
  그 순간을 한번이라도 겪어본 사람은 또 찾게 됩니다.
  강남 클럽은 사운드 시스템부터 남다릅니다. 귀가 먹먹해질 정도의 저음이 가슴팍을 두드리고, VIP 테이블에서는 또 다른 세계가 열립니다.
  홍대·이태원은 분위기가 전혀 다릅니다. 인디 DJ가 자기만의 셋리스트를 밀어붙이는 그 에너지가 중독성 있습니다.
  청담은 럭셔리 파티 문화의 중심이고, 경기권에도 자기만의 씬이 살아 있습니다.
  입장하고 첫 비트가 떨어지면, 새벽 라스트콜까지 시간이 녹아버립니다.
  드레스코드부터 음악 성향까지, 가기 전에 미리 확인하세요.
</div>

<!-- 업소 리스트 (서버사이드 렌더링!) -->
<div style="max-width:480px;margin:0 auto;padding:0 16px;">
  {clubVenues.map((v, i) => (
    <a href={`/venue/${v.slug}/`} target="_blank" rel="noopener noreferrer" class="venue-card">
      <div class="venue-card-header"><span class="rank-badge">{i + 1}</span></div>
      <div class="venue-card-name">{v.name}</div>
      <div class="venue-card-desc">{v.shortDesc}</div>
      <div class="venue-card-tags">{v.tags.slice(0, 3).map(t => <span class="venue-tag">#{t}</span>)}</div>
      {v.nickname && <div class="venue-card-contact">담당: {v.nickname}{v.phone ? ` | ${v.phone}` : ''}</div>}
    </a>
  ))}
</div>

<!-- 첫 방문 가이드 -->
<div class="fv-section">
  <h2 class="fv-title">클럽 입문 Q&A</h2>
  <div class="fv-item">
    <div class="fv-q" onclick="this.parentElement.classList.toggle('open')">클럽 갈 때 옷 어떻게 입어?<span class="fv-arrow">▼</span></div>
    <div class="fv-a"><p>스트릿 캐주얼부터 스마트 캐주얼까지 폭넓게 허용됩니다. 다만 슬리퍼·트레이닝복은 입장이 거절될 수 있습니다. 압구정·청담 쪽은 세미 포멀이 무난하고, 홍대·이태원은 개성 있는 스타일이 오히려 환영받습니다.</p></div>
  </div>
  <div class="fv-item">
    <div class="fv-q" onclick="this.parentElement.classList.toggle('open')">입장료랑 음료값은?<span class="fv-arrow">▼</span></div>
    <div class="fv-a"><p>입장료는 2만~5만 원 수준이며, 특별 게스트 DJ 이벤트 때는 더 올라갈 수 있습니다. 음료는 잔당 1만 5천~3만 원대입니다. 사전 게스트 등록이나 얼리버드 티켓으로 할인받을 수 있는 곳도 있습니다.</p></div>
  </div>
  <div class="fv-item">
    <div class="fv-q" onclick="this.parentElement.classList.toggle('open')">혼자 가도 괜찮아?<span class="fv-arrow">▼</span></div>
    <div class="fv-a"><p>솔로 방문이 전혀 어색하지 않은 문화입니다. 음악에 집중하러 혼자 오는 분들이 많습니다. 바 카운터에서 음료 한 잔과 함께 DJ 셋을 감상하는 것도 좋은 방법입니다.</p></div>
  </div>
  <div class="fv-item">
    <div class="fv-q" onclick="this.parentElement.classList.toggle('open')">예약 필요해?<span class="fv-arrow">▼</span></div>
    <div class="fv-a"><p>일반 입장은 예약 없이 가능합니다. VIP 테이블은 사전 예약이 필수이며, 인기 DJ 이벤트는 온라인 사전 티케팅을 진행하는 경우가 있으니 SNS를 확인하세요.</p></div>
  </div>
</div>

<div class="cat-extra" style="max-width:480px;margin:16px auto;padding:0 16px;">
  <p style="font-size:14px;line-height:1.7;color:var(--text-secondary);">새벽 2시, 부스 위 DJ가 트랙 바꾸는 순간 플로어가 하나 됩니다. 그 순간을 한번이라도 느껴본 사람은 클럽을 끊지 못합니다. 비트 한 방에 일주일 스트레스가 녹아요.</p>
</div>

<!-- 인기 시간대 -->
<div class="pop-times">
  <h2 class="pop-times-title">클럽 인기 요일 · 시간대</h2>
  <div class="pop-chart">
    {['월','화','수','목','금','토','일'].map((d, i) => {
      const pct = [15,20,25,40,100,95,30][i];
      return (
        <div class="pop-bar-wrap">
          <div class={`pop-bar${pct >= 80 ? ' peak' : ''}`} style={`height:${pct}%`}></div>
          <div class="pop-day">{d}</div>
        </div>
      );
    })}
  </div>
  <div class="pop-hours">피크 시간: 23:00 – 04:00</div>
</div>

<!-- 매거진 -->
<div class="cat-mag">
  <h2 class="cat-mag-title">클럽 관련 매거진</h2>
  <div class="cat-mag-grid">
    <a href="/magazine/" target="_blank" rel="noopener noreferrer" class="cat-mag-card" style="background:linear-gradient(135deg,#0c4a6e,#0891b2)">
      <div class="cat-mag-cat">사운드</div>
      <div class="cat-mag-name">클럽 스피커 출력, 귀로 듣는 게 아니라 몸으로 맞는 거다</div>
      <div class="cat-mag-desc">Funktion-One과 Void 시스템, 저음 체감이 완전히 다릅니다.</div>
    </a>
    <a href="/magazine/" target="_blank" rel="noopener noreferrer" class="cat-mag-card" style="background:linear-gradient(135deg,#1e1b4b,#4338ca)">
      <div class="cat-mag-cat">드레스코드</div>
      <div class="cat-mag-name">강남 vs 홍대 클럽 입구에서 걸리는 옷차림 기준</div>
      <div class="cat-mag-desc">도어맨 기준이 다릅니다. 지역별 통과 확률 높이는 법.</div>
    </a>
    <a href="/magazine/" target="_blank" rel="noopener noreferrer" class="cat-mag-card" style="background:linear-gradient(135deg,#064e3b,#059669)">
      <div class="cat-mag-cat">VIP</div>
      <div class="cat-mag-name">테이블 예약하면 뭐가 달라지나? 솔직 후기</div>
      <div class="cat-mag-desc">일반 입장과 VIP 테이블, 실제 경험 차이를 비교했습니다.</div>
    </a>
  </div>
</div>

<div class="cta-section mt-md" style="max-width:480px;margin:24px auto;padding:0 16px">
  <a href={MAIN_SITE_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm">메인에서 전체 확인 →</a>
</div>

</BaseLayout>
