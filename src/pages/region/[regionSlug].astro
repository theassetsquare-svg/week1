---
import BaseLayout from '../../layouts/BaseLayout.astro';
import IntroSection from '../../components/IntroSection.astro';
import { venues, getVenueUrl, getUniqueRegions, guides } from '../../utils/venues';

export function getStaticPaths() {
  const regions = getUniqueRegions();
  return regions.map(r => ({
    params: { regionSlug: r.slug },
    props: { region: r },
  }));
}

const { region } = Astro.props;
const regionVenues = venues.filter(v => v.regionSlug === region.slug);
const title = `${region.name} 나이트·클럽·라운지 추천 — ${region.name} 지역 나이트라이프 가이드`;
const description = `${region.name} 지역의 나이트, 클럽, 라운지 ${region.count}곳을 한눈에 비교하세요. ${region.name} 밤문화 매장별 무드·음악·드레스코드·입장 정보와 피크타임 가이드를 상세하게 안내합니다.`;

const regionFaqMap: Record<string, {q: string; a: string}[]> = {
  gangnam: [
    { q: '강남에서 가장 인기 있는 나이트라이프 유형은?', a: '강남은 나이트, 클럽, 라운지 모두 고르게 발달해 있으며, 특히 라운지가 인기입니다.' },
    { q: '강남에서 나이트 방문 시 준비할 것은?', a: '신분증은 필수이며, 깔끔한 복장을 갖추면 됩니다. 주말은 대기가 있을 수 있으니 여유를 두고 방문하세요.' },
    { q: '강남에서 대중교통으로 이동이 편한가요?', a: '강남역, 신논현역, 역삼역 등 지하철역이 가까워 대중교통 이용이 매우 편리합니다.' },
  ],
  busan: [
    { q: '부산 밤문화의 특징은?', a: '부산은 해변 인근의 독특한 무드와 함께, 서면과 해운대를 중심으로 활발한 나이트라이프가 형성되어 있습니다.' },
    { q: '부산에서 추천하는 나이트 지역은?', a: '서면, 해운대, 광안리 일대에 인기 나이트들이 밀집해 있습니다.' },
  ],
  itaewon: [
    { q: '이태원 나이트라이프의 특별한 점은?', a: '이태원은 다국적 문화가 어우러진 독특한 감각으로, 외국인 친화적인 바와 라운지가 많습니다.' },
    { q: '이태원에서 대중교통은 편한가요?', a: '이태원역에서 도보로 주요 나이트라이프 거리에 접근할 수 있어 대중교통이 편리합니다.' },
  ],
};

const regionFaqs = regionFaqMap[region.slug] || [
  { q: `${region.name}에서 밤문화를 즐기려면?`, a: `${region.name} 지역의 매장별 상세 페이지에서 무드, 영업시간 등을 확인하고 방문하세요.` },
  { q: `${region.name}에서 추천하는 매장은?`, a: `아래 목록에서 유형별로 비교해보시고, 각 매장의 상세 페이지에서 리뷰와 가이드를 참고하세요.` },
];

const nightCount = regionVenues.filter(v => v.type === 'night').length;
const clubCount = regionVenues.filter(v => v.type === 'club').length;
const loungeCount = regionVenues.filter(v => v.type === 'lounge').length;
const typeBreakdown = [nightCount > 0 ? `나이트 ${nightCount}곳` : '', clubCount > 0 ? `클럽 ${clubCount}곳` : '', loungeCount > 0 ? `라운지 ${loungeCount}곳` : ''].filter(Boolean).join(' · ');

const jsonLd = [{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": `${region.name} 나이트라이프`,
  "description": description,
  "url": `https://night-4qy.pages.dev/region/${region.slug}/`,
}];
---
<BaseLayout title={title} description={description} canonical={`https://night-4qy.pages.dev/region/${region.slug}/`} jsonLd={jsonLd}>
  <section class="hero">
    <div class="container">
      <div class="breadcrumb" style="justify-content:center;">
        <a href="/" target="_blank" rel="noopener noreferrer">홈</a><span>/</span><span>{region.name}</span>
      </div>
      <h1>{region.name} 나이트라이프 가이드</h1>
      <p class="hub-intro">{region.name} 지역의 나이트, 클럽, 라운지 {region.count}곳의 상세 정보를 확인하세요. 각 매장의 무드, 음악, 드레스코드 정보를 비교하고 나에게 맞는 곳을 찾아보세요.</p>
      {regionVenues.length > 0 && (
        <img src={regionVenues[0].images[0].src} alt={`${region.name} 나이트라이프`} class="hero-banner" width="500" height="340" loading="lazy" />
      )}
    </div>
  </section>

  <section class="container content-narrow">
    <IntroSection
      hook={`${region.name}에서 밤문화를 찾고 있지만 어디부터 봐야 할지 모르겠다면, 이 페이지가 출발점입니다. ${region.name} 지역에만 ${region.count}곳의 나이트·클럽·라운지가 있어 비교 없이 고르면 톤이 맞지 않을 수 있습니다.`}
      valuePromise={`1분이면 ${region.name} 지역 ${region.count}곳의 유형별 분포와 각 매장의 핵심 특징을 파악할 수 있습니다.`}
      scanBox={[
        `${region.name} 매장 수: ${region.count}곳`,
        `유형: ${typeBreakdown}`,
        '매장별 무드·음악·드레스코드 정보 포함',
        '각 카드 클릭 시 체크리스트·타임라인·FAQ 상세 페이지',
        '자주 묻는 질문(FAQ) 섹션 하단 포함',
        '관련 가이드(첫 방문·드레스코드·안전) 하단 연결',
      ]}
      checklist={[
        `${region.name} 내 원하는 유형 선택 (나이트/클럽/라운지)`,
        '방문 목적에 맞는 무드 확인 (댄스/대화/감상)',
        '예산과 동행 인원에 따라 매장 필터링',
        '드레스코드와 입장 조건 사전 확인',
        '피크타임과 교통편 확인 후 출발 시간 결정',
      ]}
      riskItems={[
        { dont: '유형을 구분하지 않고 아무 곳이나 가지 마세요', doInstead: '나이트(댄스), 클럽(DJ 음악), 라운지(대화) — 목적에 맞게 선택하세요' },
        { dont: '신분증 없이 출발하지 마세요', doInstead: '모든 유형에서 신분증 확인은 기본입니다' },
      ]}
      teasers={[
        `아래에서 ${region.name} ${region.count}개 매장 카드 비교`,
        '아래에서 자주 묻는 질문 바로 확인',
        '아래에서 첫 방문 가이드·드레스코드·안전 수칙 확인',
      ]}
    />
  </section>

  <section class="container">
    <div class="venue-grid">
      {regionVenues.map(v => (
        <a href={getVenueUrl(v)} target="_blank" rel="noopener noreferrer" class="venue-card">
          <div class="venue-card-thumb">
            <img src={v.images[0].src} alt={v.images[0].alt} width="400" height="400" loading="lazy" />
          </div>
          <div class="venue-card-body">
            <div class="venue-card-meta">
              <span class={`venue-card-type type-${v.type}`}>{v.typeLabel}</span>
              <span class="venue-card-region">{v.region}</span>
            </div>
            <h3>{v.name_display}</h3>
            <p class="venue-card-teaser">{v.teaser}</p>
            <span class="venue-card-cta">자세히 보기 →</span>
          </div>
        </a>
      ))}
    </div>
  </section>
  <section class="container content-narrow" style="margin-top:2rem;">
    <h2>자주 묻는 질문</h2>
    {regionFaqs.map(f => (
      <div class="faq-item">
        <div class="faq-q">{f.q}</div>
        <div class="faq-a">{f.a}</div>
      </div>
    ))}
  </section>
  <section class="container" style="margin-top:2rem;">
    <h2 style="text-align:center;margin-bottom:1rem;">가이드</h2>
    <div class="guide-grid" style="max-width:800px;margin:0 auto;">
      {guides.slice(0, 4).map(g => (
        <a href={`/guides/${g.slug}/`} target="_blank" rel="noopener noreferrer" class="guide-card">
          <img src={`/guides/${g.slug}.svg`} alt={g.title} class="guide-card-img" width="500" height="260" loading="lazy" />
          <div class="guide-card-body">
            <h3>{g.title}</h3>
            <p>{g.desc}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
