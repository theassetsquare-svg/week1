---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { venues, getVenueUrl, guides } from '../../utils/venues';

const guideContents: Record<string, { title: string; description: string; sections: { heading: string; content: string }[]; relatedTypes?: string[] }> = {
  'first-visit': {
    title: '나이트 첫 방문 완벽 가이드',
    description: '처음 가는 나이트이 걱정된다면, 이 가이드를 읽고 자신감을 가지세요. 입장부터 퇴장까지 모든 것을 알려드립니다.',
    sections: [
      { heading: '첫 방문, 걱정하지 마세요', content: '나이트에 처음 간다고 해서 특별한 준비가 필요한 것은 아닙니다. 기본적인 매너와 복장만 갖추면 누구나 즐길 수 있습니다. 가장 중요한 것은 편안한 마음가짐입니다. 주변 사람들도 즐기러 온 것이니, 서로의 공간을 존중하면서 자연스럽게 분위기에 녹아들면 됩니다. 첫 방문이라면 주중이나 이른 시간대에 방문하는 것도 좋은 전략입니다. 비교적 여유로운 분위기에서 공간에 익숙해질 수 있기 때문입니다.' },
      { heading: '입장 준비물', content: '가장 중요한 것은 신분증입니다. 주민등록증, 운전면허증, 또는 여권이 필요하며, 모바일 신분증은 장소에 따라 인정되지 않을 수 있습니다. 현금과 카드를 모두 준비하고, 귀중품은 최소화하세요. 휴대폰은 완충 상태로, 비상 연락처를 저장해두면 안심됩니다.' },
      { heading: '복장 가이드', content: '대부분의 나이트은 깔끔한 캐주얼 이상을 요구합니다. 슬리퍼, 반바지, 운동복은 대부분 입장이 제한됩니다. 남성은 깔끔한 셔츠나 자켓에 긴 바지, 깨끗한 신발이면 충분합니다. 여성은 자유도가 더 높지만, 역시 깔끔한 차림이 기본입니다. 하이힐보다는 편한 구두나 깨끗한 운동화를 추천합니다.' },
      { heading: '입장 후 행동 가이드', content: '입장 후에는 먼저 공간을 둘러보세요. 바 카운터, 무대 위치, 화장실 위치를 파악해두면 편합니다. 음료를 주문하고 잠시 서서 분위기를 파악한 후, 마음에 드는 위치를 선택하세요. 혼자 온 경우 바 카운터가 가장 편안한 위치입니다. 일행이 있다면 테이블을 확보하는 것이 좋습니다.' },
      { heading: '음료 주문 팁', content: '첫 방문이라면 가벼운 음료부터 시작하세요. 하이볼이나 맥주가 무난합니다. 보틀 주문은 그룹일 때 경제적이지만, 혼자라면 잔 단위 주문이 합리적입니다. 음주 페이스를 조절하고, 중간중간 물을 마시는 것이 컨디션 관리에 도움됩니다.' },
      { heading: '안전하게 즐기기', content: '모르는 사람이 건네는 음료는 정중하게 거절하세요. 자신의 음료는 항상 시야에 두고, 자리를 비울 때는 새로운 음료를 주문하는 것이 안전합니다. 불편한 상황이 발생하면 주저 없이 스태프에게 도움을 요청하세요. 귀가 시에는 택시나 대리운전을 이용하고, 지인에게 귀가 알림을 보내는 것이 좋습니다.' },
    ],
    relatedTypes: ['night', 'club'],
  },
  'dress-code': {
    title: '클럽·나이트 드레스코드 총정리',
    description: '유형별 드레스코드를 한눈에. 클럽, 나이트, 라운지 각각에 맞는 복장 가이드.',
    sections: [
      { heading: '왜 드레스코드가 있나요?', content: '드레스코드는 공간의 분위기를 유지하기 위한 기본 규칙입니다. 모든 방문객이 일정 수준의 복장을 갖추면 전체적인 분위기가 향상되고, 모두가 더 즐거운 시간을 보낼 수 있습니다. 엄격한 정장을 요구하는 곳은 거의 없으며, 대부분 기본적인 깔끔함을 요구하는 수준입니다.' },
      { heading: '클럽 드레스코드', content: '클럽은 상대적으로 자유로운 편이지만 최소한의 기준은 있습니다. 슬리퍼, 반바지, 운동복 상의는 거의 모든 클럽에서 제한합니다. 청바지에 깨끗한 티셔츠, 스니커즈 조합이 가장 무난하며, 약간의 포인트를 주고 싶다면 자켓이나 액세서리를 활용하세요. 운동화는 깨끗한 것이라면 대부분 허용됩니다.' },
      { heading: '나이트 드레스코드', content: '나이트은 클럽보다 약간 더 격식을 차리는 편입니다. 남성은 셔츠나 폴로 티에 슬랙스, 깔끔한 구두가 기본입니다. 여성은 원피스나 블라우스에 스커트/슬랙스 조합이 좋습니다. 하지만 최근에는 나이트도 캐주얼해지는 추세이니, 매장별로 확인하는 것이 가장 정확합니다.' },
      { heading: '라운지 드레스코드', content: '라운지는 보통 스마트 캐주얼 이상을 요구합니다. 깔끔하고 세련된 복장이면 충분하며, 프리미엄 라운지의 경우 비즈니스 캐주얼 수준을 기대하기도 합니다. 편안하면서도 품위 있는 복장을 권장합니다. 특히 데이트나 중요한 만남이라면 한 단계 더 신경 쓰는 것이 좋습니다.' },
      { heading: '계절별 팁', content: '겨울에는 코트나 두꺼운 외투를 보관할 수 있는 클로킹 서비스가 있는지 확인하세요. 여름에는 시원한 소재의 깔끔한 복장이 적합합니다. 어떤 계절이든 과도한 향수는 피하고, 신발은 깨끗한 상태를 유지하세요.' },
    ],
    relatedTypes: ['night', 'club', 'lounge'],
  },
  'budget-guide': {
    title: '나이트라이프 예산 가이드',
    description: '클럽, 나이트, 라운지별 예상 비용과 현명하게 즐기는 절약 팁.',
    sections: [
      { heading: '유형별 예산 개요', content: '나이트라이프 비용은 유형, 지역, 요일에 따라 크게 다릅니다. 대체로 클럽은 입장료 포함 5~15만 원, 나이트은 3~10만 원, 라운지는 5~15만 원 정도를 기본 예산으로 잡는 것이 좋습니다. 이는 1인 기준이며, 보틀 주문 여부에 따라 크게 변동됩니다.' },
      { heading: '클럽 예산 분석', content: '클럽은 입장료(1~3만 원)와 음료비가 주요 비용입니다. 주말이 평일보다 입장료가 높고, 이벤트 날은 더 비쌀 수 있습니다. 잔 음료는 1~2만 원, 보틀은 15~50만 원 이상입니다. 게스트리스트에 등록하면 입장료를 아낄 수 있으니 사전에 확인하세요.' },
      { heading: '나이트 예산 분석', content: '나이트은 테이블 이용이 기본이며, 테이블 차지와 음료비가 주요 비용입니다. 기본 음료는 만 원대부터 시작하며, 보틀은 10~30만 원대가 일반적입니다. 그룹으로 방문하면 보틀을 나눠 마셔 1인당 비용을 줄일 수 있습니다.' },
      { heading: '라운지 예산 분석', content: '라운지는 음료 단가가 높은 편입니다. 칵테일 기준 1.5~3만 원, 위스키 등은 그 이상입니다. 하지만 입장료가 없는 경우가 많아 총 비용은 비슷할 수 있습니다. 시그니처 칵테일을 하나 주문하고 분위기를 즐기는 것이 가성비 좋은 방법입니다.' },
      { heading: '절약 팁', content: '게스트리스트 사전 등록, 평일 방문, 이른 시간대 입장 등으로 입장료를 절약할 수 있습니다. 보틀은 4인 이상일 때 경제적이며, 소규모라면 잔 음료가 합리적입니다. 교통비는 대중교통이 가장 경제적이지만, 늦은 시간에는 택시비를 미리 확보해두세요.' },
    ],
    relatedTypes: ['night', 'club', 'lounge'],
  },
  'safety-tips': {
    title: '안전한 밤문화 즐기기',
    description: '즐거운 밤을 위한 안전 수칙. 음주 관리, 귀가 안전, 개인 안전 팁.',
    sections: [
      { heading: '기본 안전 수칙', content: '밤문화를 안전하게 즐기기 위한 기본 수칙을 소개합니다. 첫째, 신뢰할 수 있는 사람에게 방문 장소와 예상 귀가 시간을 알려두세요. 둘째, 음료는 항상 자신이 직접 받아서 마시세요. 셋째, 모르는 사람의 음료를 받지 마세요. 넷째, 자리를 비웠던 음료는 마시지 마세요.' },
      { heading: '음주 관리', content: '즐거운 밤의 핵심은 음주 페이스 관리입니다. 자신의 주량을 알고, 그 범위 안에서 즐기세요. 음료 사이에 물을 마시면 탈수를 방지할 수 있습니다. 공복에 음주는 피하고, 가능하면 미리 식사를 하세요. 컨디션이 좋지 않을 때는 억지로 마시지 마세요.' },
      { heading: '귀가 안전', content: '귀가 교통편은 반드시 사전에 확보해두세요. 택시 앱이나 대리운전 앱을 미리 설치하고, 비상 연락처를 저장해두세요. 대중교통 막차 시간을 확인하고, 놓칠 경우의 대안을 마련해두세요. 모르는 사람의 차량에 탑승하지 마세요.' },
      { heading: '개인 물품 관리', content: '귀중품은 최소한으로 가져가세요. 큰 가방보다는 작은 크로스백이나 주머니에 넣을 수 있는 지갑이 편리합니다. 휴대폰은 완충 상태로, 만약을 위해 보조 배터리도 추천합니다. 분실 방지를 위해 중요한 물건은 안쪽 주머니에 보관하세요.' },
      { heading: '위험 상황 대처', content: '불편하거나 위험한 상황이 발생하면 주저 없이 스태프나 보안 요원에게 도움을 요청하세요. 대부분의 업소에서는 고객 안전을 최우선으로 합니다. 심한 취객이나 시비가 있을 경우, 직접 대응하기보다 스태프를 통해 해결하는 것이 안전합니다.' },
    ],
    relatedTypes: ['night', 'club', 'lounge'],
  },
  'music-genres': {
    title: '클럽 음악 장르 가이드',
    description: 'EDM, 힙합, 하우스, 테크노부터 트로트까지 – 각 장르의 특징과 즐기는 방법.',
    sections: [
      { heading: 'EDM (Electronic Dance Music)', content: 'EDM은 한국 클럽씬에서 가장 인기 있는 장르입니다. 강렬한 비트와 드롭이 특징이며, 댄스플로어에서 몸을 움직이기에 최적화되어 있습니다. 빌드업에서 드롭으로 이어지는 구조를 이해하면 더 즐겁게 즐길 수 있습니다. 강남과 이태원의 대형 클럽에서 주로 경험할 수 있습니다.' },
      { heading: '힙합', content: '힙합은 EDM과 함께 한국 클럽에서 가장 많이 플레이되는 장르입니다. 최신 한국 힙합부터 외국 힙합까지 다양한 선곡이 이루어집니다. 리듬에 맞춰 가볍게 움직이거나, 바에서 음악을 감상하는 방식으로 즐길 수 있습니다.' },
      { heading: '하우스 & 테크노', content: '하우스와 테크노는 좀 더 매니아적인 장르로, 깊은 비트와 반복적인 리듬이 특징입니다. 클럽에서 오랜 시간 음악에 빠져들고 싶은 분들에게 적합합니다. 일부 전문 클럽에서는 해외 DJ를 초청한 테크노 이벤트를 개최하기도 합니다.' },
      { heading: '트로트 & 댄스 (나이트)', content: '나이트에서는 트로트, 댄스 팝, 발라드 등 한국적인 음악이 주로 플레이됩니다. 라이브 밴드의 연주와 함께 파트너와 댄스를 즐기는 것이 나이트의 핵심 매력입니다. 세대를 초월한 음악으로 누구나 함께 즐길 수 있습니다.' },
      { heading: '재즈 & R&B (라운지)', content: '라운지에서는 보통 재즈, R&B, 소울 등 감성적인 음악이 흘러나옵니다. 대화를 나누기 좋은 볼륨으로 세팅되며, 음악 자체를 감상하는 것도 라운지의 즐거움 중 하나입니다. 일부 라운지에서는 라이브 재즈 공연을 진행하기도 합니다.' },
    ],
    relatedTypes: ['night', 'club', 'lounge'],
  },
  'solo-nightlife': {
    title: '혼자서도 즐기는 나이트라이프',
    description: '솔로 방문이 처음이라면, 부담 없이 즐기는 방법을 알려드립니다.',
    sections: [
      { heading: '혼자 방문, 전혀 이상하지 않아요', content: '혼자 나이트라이프를 즐기는 사람은 생각보다 많습니다. 특히 라운지나 바에서는 솔로 방문객이 오히려 자연스럽습니다. 자신만의 시간을 즐기거나, 새로운 사람들과의 자연스러운 대화를 원한다면 혼자 방문도 충분히 좋은 선택입니다.' },
      { heading: '혼자 가기 좋은 유형', content: '라운지가 가장 솔로 방문에 적합합니다. 바 카운터에 앉으면 바텐더와 대화를 나눌 수 있고, 분위기 자체가 대화를 유도합니다. 나이트도 혼자 방문하기 좋으며, 자연스럽게 새로운 사람들과 어울릴 수 있는 분위기입니다. 클럽은 혼자 가도 댄스플로어에서 음악을 즐기기에 충분합니다.' },
      { heading: '솔로 방문 팁', content: '이른 시간대에 방문하면 비교적 한적해서 적응하기 좋습니다. 바 카운터에 자리 잡고, 바텐더에게 추천을 받아보세요. 억지로 사교적일 필요는 없으며, 음악과 분위기를 즐기는 것만으로도 충분합니다. 단, 안전을 위해 지인에게 위치를 공유하고, 음주량을 조절하세요.' },
      { heading: '대화 시작하기', content: '바 카운터에서 옆자리와 자연스럽게 대화가 시작되기도 합니다. "여기 처음인데 추천 메뉴가 뭔가요?" 같은 가벼운 질문이 대화의 시작이 될 수 있습니다. 강제성은 없으니 편하게, 자연스럽게 흘러가는 대로 즐기세요.' },
    ],
    relatedTypes: ['night', 'club', 'lounge'],
  },
  'group-party': {
    title: '단체 파티 기획 가이드',
    description: '생일, 회식, 동호회 모임을 위한 단체 파티 기획과 예약 가이드.',
    sections: [
