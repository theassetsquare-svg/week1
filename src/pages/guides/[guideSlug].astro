  .filter(v => content?.relatedTypes?.includes(v.type))
  .slice(0, 6);

const title = `${guide.title} — 나이트코리아 나이트라이프 필수 가이드`;
const description = `${guide.desc} 나이트코리아에서 제공하는 나이트·클럽·라운지 이용에 꼭 필요한 실전 가이드입니다.`;

const jsonLd = [{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": guide.title,
  "description": guide.desc,
  "url": `https://week1-6m5.pages.dev/guides/${guide.slug}/`,
  "publisher": { "@type": "Organization", "name": "나이트코리아" },
  "inLanguage": "ko",
}];
---
<BaseLayout title={title} description={description} canonical={`https://week1-6m5.pages.dev/guides/${guide.slug}/`} jsonLd={jsonLd}>
  <section class="venue-header">
    <div class="container content-narrow">
      <div class="breadcrumb">
        <a href="/" target="_blank" rel="noopener noreferrer">홈</a><span>/</span>
        <a href="/guides/" target="_blank" rel="noopener noreferrer">가이드</a><span>/</span>
        <span>{guide.title}</span>
      </div>
      <h1>{guide.title}</h1>
      <p style="color:var(--text-secondary);margin-top:0.5rem;">{guide.desc}</p>
      <img src={`/guides/${guide.slug}.svg`} alt={guide.title} class="guide-hero-img" width="500" height="260" loading="lazy" />
    </div>
  </section>

  <div class="container content-narrow">
    {guideIntro && (
      <IntroSection
        hook={guideIntro.hook}
        valuePromise={guideIntro.valuePromise}
        scanBox={guideIntro.scanBox}
        checklist={guideIntro.checklist}
        riskItems={guideIntro.riskItems}
        teasers={guideIntro.teasers}
      />
    )}

    {content?.sections ? (
      <nav class="toc">
        <h3>목차</h3>
        <ol>
          {content.sections.map((s, i) => (
            <li><a href={`#section-${i}`}>{s.heading}</a></li>
          ))}
        </ol>
      </nav>
    ) : null}

    {content?.sections?.map((s, i) => (
      <section class="venue-section" id={`section-${i}`}>
        <h2>{s.heading}</h2>
        <p>{s.content}</p>
      </section>
    ))}

    {relatedVenues.length > 0 && (
      <section class="venue-section">
        <h2>관련 매장</h2>
        <div class="related-grid">
          {relatedVenues.map(v => (
            <a href={getVenueUrl(v)} target="_blank" rel="noopener noreferrer" class="related-link">{v.region} {v.name_display}</a>
          ))}
        </div>
      </section>
    )}

    <section class="venue-section">
      <h2>더 많은 가이드</h2>
      <div class="guide-grid">
        {guides.filter(g => g.slug !== guide.slug).slice(0, 4).map(g => (
          <a href={`/guides/${g.slug}/`} target="_blank" rel="noopener noreferrer" class="guide-card">
            <img src={`/guides/${g.slug}.svg`} alt={g.title} class="guide-card-img" width="500" height="260" loading="lazy" />
            <div class="guide-card-body">
              <h3>{g.title}</h3>
              <p>{g.desc}</p>
            </div>
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
