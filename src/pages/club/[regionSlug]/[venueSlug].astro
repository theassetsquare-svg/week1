---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { venues, getVenuesByType, getVenue, getVenueUrl, getReadingTime, guides } from '../../../utils/venues';

export function getStaticPaths() {
  return venues.filter(v => v.type === 'club').map(v => ({
    params: { regionSlug: v.regionSlug, venueSlug: v.urlSlug || v.venueSlug },
    props: { venue: v },
  }));
}

const { venue } = Astro.props;
const v = venue;
const siteUrl = 'https://week1-6m5.pages.dev';
const venueUrl = getVenueUrl(v);
const updateDate = '2026-02-18';

const sameRegion = v.relatedVenueIds.sameRegion.map(id => getVenue(id)).filter(Boolean).slice(0, 3);
const sameType = v.relatedVenueIds.sameType.map(id => getVenue(id)).filter(Boolean).slice(0, 3);
const nearby = v.relatedVenueIds.nearby.map(id => getVenue(id)).filter(Boolean).slice(0, 2);
const relatedVenues = [...sameRegion, ...sameType, ...nearby].slice(0, 6);

const shortName = v.name_display.replace(v.region + ' ', '').replace(/\s+클럽\s*$/,'').trim() || v.urlSlug || v.venueSlug;
const ogImage = `https://week1-6m5.pages.dev${encodeURI(v.images[0].src)}`;
const canonicalUrl = `${siteUrl}${encodeURI(venueUrl)}`;
const title = v.pageTitle || `${v.name_display} 안내`;
const description = v.metaDescription || `${v.name_display} - ${v.teaser?.slice(0, 100) || ''}`;
const h1Title = v.h1Title || `${v.name_display} 방문 가이드`;
const si = v.sectionIntros || {};
const conclusionText = v.conclusionText || `${v.name_display}은(는) ${v.region}의 밤을 대표하는 공간입니다.`;

const mapUrl = `https://map.naver.com/v5/search/${encodeURIComponent(v.name_display)}`;

const tocItems = [
  { id: 'summary', label: '핵심 정보' },
  { id: 'hook', label: '이 클럽은' },
  { id: 'atmosphere', label: '바이브 체크' },
  { id: 'story', label: '플로어 리포트' },
  { id: 'gallery', label: '스냅샷' },
  { id: 'timeline', label: '피크타임 가이드' },
  { id: 'planner', label: '맞춤 플랜' },
  { id: 'checklist', label: '입장 전 체크' },
  { id: 'music', label: '사운드 & 장르' },
  { id: 'location', label: '찾아가는 법' },
  { id: 'faq', label: 'Q&A' },
  { id: 'conclusion', label: '클럽 한줄평' },
  { id: 'related', label: '비슷한 클럽' },
];

const jsonLdSchemas: object[] = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": title,
    "description": description,
    "url": canonicalUrl,
    "dateModified": updateDate,
    "inLanguage": "ko",
    "isPartOf": {
      "@type": "WebSite",
      "name": "NLC 전국 나이트·클럽·라운지 정보",
      "url": siteUrl,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "홈", "item": siteUrl + "/" },
      { "@type": "ListItem", "position": 2, "name": "클럽", "item": siteUrl + "/clubs/" },
      { "@type": "ListItem", "position": 3, "name": v.region, "item": siteUrl + "/region/" + v.regionSlug + "/" },
      { "@type": "ListItem", "position": 4, "name": v.name_display },
    ],
  },
];

if (v.faq && v.faq.length > 0) {
  jsonLdSchemas.push({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": v.faq.slice(0, 8).map((f: { q: string; a: string }) => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": f.a,
      },
    })),
  });
}
---
<BaseLayout title={title} description={description} canonical={canonicalUrl} ogImage={ogImage} jsonLd={jsonLdSchemas}>
  <section class="venue-hero-immersive">
    <div class="container content-narrow">
      <div class="breadcrumb">
        <a href="/">홈</a><span>/</span>
        <a href="/clubs/">클럽 목록</a><span>/</span>
        {v.region !== shortName && <><a href={`/region/${v.regionSlug}/`}>{v.region}</a><span>/</span></>}
        <span>{shortName}</span>
      </div>
      <img src={encodeURI(v.images[0].src)} alt={`${v.name_display} 대표 이미지`} class="venue-hero-img" width="500" height="500" loading="eager" />
      <span class="venue-hero__cat-badge">클럽</span>
      <h1 class="venue-hero__title">{h1Title}</h1>
    </div>
  </section>

  <div class="container content-narrow">
    <section class="quick-summary" id="summary">
      <div class="quick-summary__title">핵심 정보</div>
      <ul class="quick-summary__list">
        <li>{v.region} 클럽 · {v.geo.formatted_address !== '확인 필요' ? v.geo.formatted_address : `${v.region} 위치`}</li>
        <li>바이브 — {v.bodySections.atmosphere.split('.')[0]}.</li>
        <li>사운드 — {v.bodySections.music.split('.')[0]}.</li>
        {v.checklist[0] && <li>입장 팁: {v.checklist[0]}</li>}
        {v.timeline[0] && <li>피크타임: {v.timeline[0].time} — {v.timeline[0].label}</li>}
        <li>업데이트: {updateDate}</li>
      </ul>
    </section>

    <div class="venue-cta-inline">
      <a href={mapUrl} target="_blank" rel="noopener noreferrer" class="venue-cta-btn venue-cta-btn--primary">{shortName} 위치 확인</a>
      <a href="/clubs/" class="venue-cta-btn">전국 클럽 리스트</a>
    </div>

    <aside class="fact-box" aria-label="기본 정보">
      <time class="fact-box__date" datetime={updateDate}>갱신 {updateDate}</time>
    </aside>

    <nav class="toc">
      <h3>목차</h3>
      <ol>
        {tocItems.map(item => (
          <li><a href={`#${item.id}`}>{item.label}</a></li>
        ))}
      </ol>
    </nav>

    {v.hookIntro && (
      <section class="venue-section" id="hook">
        <h2>이 클럽은</h2>
        <p>{v.hookIntro}</p>
      </section>
    )}

    <section class="venue-section" id="atmosphere">
      <h2>바이브 체크</h2>
      <p>{v.bodySections.atmosphere}</p>
    </section>

    <section class="venue-section" id="story">
      <h2>플로어 리포트: {v.storyFrame.style}</h2>
      <div class="accordion">
        <div class="accordion-item">
          <button class="accordion-trigger">줄서기 — 입구에서 느끼는 에너지 <span class="icon">▼</span></button>
          <div class="accordion-content"><div class="accordion-content-inner">{v.story.scene1}</div></div>
        </div>
        <div class="accordion-item">
          <button class="accordion-trigger">플로어 — 비트 위에 올라타다 <span class="icon">▼</span></button>
          <div class="accordion-content"><div class="accordion-content-inner">{v.story.scene2}</div></div>
        </div>
        <div class="accordion-item">
          <button class="accordion-trigger">드롭 — 천장이 내려앉는 순간 <span class="icon">▼</span></button>
          <div class="accordion-content"><div class="accordion-content-inner">{v.story.scene3}</div></div>
        </div>
        <div class="accordion-item">
          <button class="accordion-trigger">디테일 — 레이저, 연기, 베이스 <span class="icon">▼</span></button>
          <div class="accordion-content"><div class="accordion-content-inner">{v.story.scene4}</div></div>
        </div>
        <div class="accordion-item">
          <button class="accordion-trigger">애프터 — 새벽 공기를 마시며 <span class="icon">▼</span></button>
          <div class="accordion-content"><div class="accordion-content-inner">{v.story.scene5}</div></div>
        </div>
        {v.story.scene6 && (
          <div class="accordion-item">
            <button class="accordion-trigger">크루 — 같은 음악을 좋아하는 사람들 <span class="icon">▼</span></button>
            <div class="accordion-content"><div class="accordion-content-inner">{v.story.scene6}</div></div>
          </div>
        )}
        {v.story.scene7 && (
          <div class="accordion-item">
            <button class="accordion-trigger">백스테이지 — DJ 뒤편의 세계 <span class="icon">▼</span></button>
            <div class="accordion-content"><div class="accordion-content-inner">{v.story.scene7}</div></div>
          </div>
        )}
        {v.story.scene8 && (
          <div class="accordion-item">
            <button class="accordion-trigger">리턴 — 단골이 되는 순간 <span class="icon">▼</span></button>
            <div class="accordion-content"><div class="accordion-content-inner">{v.story.scene8}</div></div>
          </div>
        )}
      </div>
    </section>

    <section class="venue-section" id="gallery">
      <h2>스냅샷</h2>
      <div class="gallery-mid">
        {v.images.slice(0, 3).map((img, i) => (
          <img src={encodeURI(img.src)} alt={`${v.name_display} ${i === 0 ? '입구 전경' : i === 1 ? '플로어 전경' : 'DJ 부스와 레이저'}`} width="400" height="400" loading="lazy" />
        ))}
      </div>
    </section>

    <section class="venue-section" id="timeline">
      <h2>피크타임 가이드</h2>
      <div class="timeline">
        {v.timeline.map(t => (
          <div class="timeline-item">
            <div class="timeline-dot"></div>
            <div class="timeline-time">{t.time}</div>
            <div class="timeline-label">{t.label}</div>
            <div class="timeline-desc">{t.desc}</div>
          </div>
        ))}
      </div>
    </section>

    <section class="venue-section" id="planner">
      <h2>맞춤 플랜 짜기</h2>
      <div class="planner">
        <div class="planner-group">
          <label>컨셉</label>
          <div class="planner-options" data-group="purpose">
            {Object.keys(v.plannerRules['p'] || {}).map((k, i) => (
              <button class="planner-btn" data-key={`p${i}`} >{k}</button>
            ))}
          </div>
        </div>
        <div class="planner-group">
          <label>타임</label>
          <div class="planner-options" data-group="time">
            {Object.keys(v.plannerRules['t'] || {}).map((k, i) => (
              <button class="planner-btn" data-key={`t${i}`} >{k}</button>
            ))}
          </div>
        </div>
        <div class="planner-result" id="plannerResult">컨셉과 타임을 선택하면 추천 코스가 나옵니다.</div>
      </div>
    </section>

    <section class="venue-section" id="checklist">
      <h2>입장 전 체크</h2>
      <table class="checklist-table">
        <thead><tr><th>항목</th><th>OK</th></tr></thead>
        <tbody>
          {v.checklist.map((item, i) => (
            <tr><td>{item}</td><td><input type="checkbox" id={`ck${i}`} /></td></tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="venue-section" id="music">
      <h2>사운드 & 장르</h2>
      <p>{v.bodySections.music}</p>
    </section>

    <section class="venue-section" id="location">
      <h2>찾아가는 법</h2>
      <div class="location-info">
        {v.geo.precision !== 'none' ? (
          <p><span class="location-label">주소:</span> {v.geo.formatted_address === '확인 필요' ? '확인 필요 – 방문 전 재확인 필수' : v.geo.formatted_address}</p>
        ) : (
          <p>위치 확인이 필요합니다. 방문 전 공식 SNS를 참고하세요.</p>
        )}
      </div>
      <div class="map-buttons">
        <a href={mapUrl} target="_blank" rel="noopener noreferrer" class="map-btn map-btn--naver">네이버 지도 열기</a>
        <a href={`https://www.google.com/maps/search/${encodeURIComponent(v.name_display)}`} target="_blank" rel="noopener noreferrer" class="map-btn map-btn--google">구글 맵 열기</a>
      </div>
    </section>

    <div class="venue-cta-inline">
      <a href={mapUrl} target="_blank" rel="noopener noreferrer" class="venue-cta-btn venue-cta-btn--primary">{shortName} 위치 확인</a>
      <a href={`/region/${v.regionSlug}/`} class="venue-cta-btn">{v.region} 핫플 더 보기</a>
    </div>

    <section class="venue-section" id="faq">
      <h2>Q&A</h2>
      {v.faq.map(f => (
        <div class="faq-item">
          <div class="faq-q">{f.q}</div>
          <div class="faq-a">{f.a}</div>
        </div>
      ))}
    </section>

    <section class="venue-section">
      <h2>에티켓 & 안전수칙</h2>
      <p>{v.bodySections.safety}</p>
    </section>

    <section class="venue-conclusion" id="conclusion">
      <h2>클럽 한줄평</h2>
      <p>어두운 플로어 위, 같은 비트에 몸을 맡기는 순간 — 낯선 사람과도 금세 가까워집니다. {v.name_display}은(는) {v.region}의 밤을 대표하는 공간입니다. 위의 피크타임 가이드와 입장 전 체크리스트를 확인하고, 오늘 밤 플로어 위에 서보세요.</p>
      <div class="venue-cta-inline">
        <a href={mapUrl} target="_blank" rel="noopener noreferrer" class="venue-cta-btn venue-cta-btn--primary">{shortName} 위치 확인</a>
        <a href="/clubs/" class="venue-cta-btn">전국 클럽 리스트</a>
      </div>
    </section>

    <section class="venue-section" id="related">
      <h2>비슷한 클럽</h2>
      <div class="related-grid">
        {relatedVenues.map(rv => (
          <a href={encodeURI(getVenueUrl(rv!))} class="related-link">{rv!.name_display}</a>
        ))}
        <a href={`/region/${v.regionSlug}/`} class="related-link">{v.region} 전체 보기</a>
        <a href="/clubs/" class="related-link">클럽 전체 목록</a>
      </div>
    </section>

    <aside class="trust-block" id="trust">
      <h3>데이터 출처</h3>
      <ul class="update-log">
        <li><time datetime={updateDate}>{updateDate}</time> <span>최신 운영 정보 반영</span></li>
        <li><time datetime="2026-02-10">2026-02-10</time> <span>신규 등록</span></li>
      </ul>
      <div class="trust-block__links">
        <a href="/about/">작성 기준 확인</a>
        <button type="button" id="correctionBtn">정보 수정 요청</button>
      </div>
    </aside>

    <div class="venue-cta-area">
      <a href={mapUrl} target="_blank" rel="noopener noreferrer" class="venue-cta-btn venue-cta-btn--primary">지도 열기</a>
      <a href="/clubs/" class="venue-cta-btn">목록으로</a>
    </div>
  </div>

  <script define:vars={{ plannerRules: v.plannerRules }}>
    let selectedPurpose = '';
    let selectedTime = '';

    document.querySelectorAll('.planner-options').forEach(group => {
      group.querySelectorAll('.planner-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const g = group.getAttribute('data-group');
          const key = btn.textContent?.trim() || '';
          group.querySelectorAll('.planner-btn').forEach(b => b.classList.remove('selected'));
          btn.classList.add('selected');
          if (g === 'purpose') selectedPurpose = key;
          if (g === 'time') selectedTime = key;
          updatePlan();
        });
      });
    });

    function updatePlan() {
      const result = document.getElementById('plannerResult');
      if (!result) return;
      let text = '';
      if (selectedPurpose && plannerRules['p']) {
        text += plannerRules['p'][selectedPurpose] || '';
      }
      if (selectedTime && plannerRules['t']) {
        text += (text ? ' ' : '') + (plannerRules['t'][selectedTime] || '');
      }
      result.textContent = text || '컨셉과 타임을 선택하면 추천 코스가 나옵니다.';
    }
  </script>
</BaseLayout>
