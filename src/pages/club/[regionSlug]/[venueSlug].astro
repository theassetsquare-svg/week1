---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { venues, getVenuesByType, getVenue, getVenueUrl, getReadingTime, guides } from '../../../utils/venues';

export function getStaticPaths() {
  return venues.filter(v => v.type === 'club').map(v => ({
    params: { regionSlug: v.regionSlug, venueSlug: v.urlSlug || v.venueSlug },
    props: { venue: v },
  }));
}

const { venue } = Astro.props;
const v = venue;
const readTime = getReadingTime(v);
const siteUrl = 'https://week1-6m5.pages.dev';
const venueUrl = getVenueUrl(v);

const sameRegion = v.relatedVenueIds.sameRegion.map(id => getVenue(id)).filter(Boolean).slice(0, 3);
const sameType = v.relatedVenueIds.sameType.map(id => getVenue(id)).filter(Boolean).slice(0, 3);
const nearby = v.relatedVenueIds.nearby.map(id => getVenue(id)).filter(Boolean).slice(0, 2);

const ogImage = `https://week1-6m5.pages.dev/venues/${v.venueSlug}/og-thumbnail.svg`;
const title = `${v.name_display} | ${v.region} 클럽 후기·가격·영업시간·입장료 2026`;
const description = `${v.name_display} 완벽 가이드 – 분위기, DJ 라인업, 드레스코드, 입장료, 테이블 예약 정보와 실제 방문 후기를 확인하세요.`;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "홈", "item": siteUrl },
      { "@type": "ListItem", "position": 2, "name": "클럽", "item": `${siteUrl}/clubs/` },
      { "@type": "ListItem", "position": 3, "name": v.region, "item": `${siteUrl}/region/${v.regionSlug}/` },
      { "@type": "ListItem", "position": 4, "name": v.name_display, "item": `${siteUrl}${venueUrl}` },
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "NightClub",
    "name": v.name_display,
    "description": v.teaser,
    "url": `${siteUrl}${venueUrl}`,
    ...(v.geo.precision !== 'none' ? {
      "address": {
        "@type": "PostalAddress",
        "addressLocality": v.geo.city || v.region,
        "addressRegion": v.geo.district || v.region,
        "addressCountry": "KR",
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": v.geo.lat,
        "longitude": v.geo.lon,
      },
      "areaServed": {
        "@type": "City",
        "name": v.geo.city || v.region,
      }
    } : {}),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": v.faq.map(f => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  }
];

const tocItems = [
  { id: 'atmosphere', label: '감성 요약' },
  { id: 'story', label: '스토리텔링' },
  { id: 'timeline', label: '방문 플랜' },
  { id: 'planner', label: '나만의 플랜 만들기' },
  { id: 'checklist', label: '첫방문 체크리스트' },
  { id: 'music', label: '음악/사운드' },
  { id: 'location', label: '위치/교통' },
  { id: 'faq', label: 'FAQ' },
  { id: 'related', label: '추천 매장' },
  { id: 'gallery', label: '갤러리' },
];
---
<BaseLayout title={title} description={description} canonical={`${siteUrl}${venueUrl}`} ogImage={ogImage} jsonLd={jsonLd}>
  <section class="venue-hero-immersive">
    <div class="container content-narrow">
      <div class="breadcrumb">
        <a href="/">홈</a><span>/</span>
        <a href="/clubs/">클럽</a><span>/</span>
        <a href={`/region/${v.regionSlug}/`}>{v.region}</a><span>/</span>
        <span>{v.name_display}</span>
      </div>
      <img src={v.images[0].src} alt={v.images[0].alt} class="venue-hero-img" width="500" height="500" loading="eager" />
      <div class="venue-hero__eyebrow">Club Experience</div>
      <h1 class="venue-hero__title">{v.name_display}</h1>
      <p class="venue-hero__teaser">{v.teaser}</p>
      <div class="venue-hero__meta">
        <span class="venue-hero__tag venue-hero__tag--type">{v.typeLabel}</span>
        <span class="venue-hero__tag venue-hero__tag--region">{v.region}</span>
        <span class="venue-hero__tag venue-hero__tag--tone">{v.storyFrame.tone}</span>
        <span class="venue-hero__tag venue-hero__tag--time">약 {readTime}분의 몰입 여행</span>
      </div>
    </div>
  </section>

  <div class="container content-narrow">
    <div class="story-hook">
      <div class="story-hook__label">Tonight's Story — {v.storyFrame.style}</div>
      <div class="story-hook__text">{v.story.scene1}</div>
      <div class="story-hook__quote">{v.bodySections.atmosphere.split('.')[0]}.</div>
      <a href="#atmosphere" class="story-hook__cta">이야기 속으로 ↓</a>
    </div>

    <div class="mood-check">
      <div class="mood-check__title">지금 기분은?</div>
      <div class="mood-check__options">
        <button class="mood-btn" data-mood="energy"><span class="mood-btn__emoji">🔥</span>에너지 폭발</button>
        <button class="mood-btn" data-mood="chill"><span class="mood-btn__emoji">🌙</span>여유롭게</button>
        <button class="mood-btn" data-mood="social"><span class="mood-btn__emoji">🥂</span>새로운 만남</button>
        <button class="mood-btn" data-mood="music"><span class="mood-btn__emoji">🎵</span>음악에 집중</button>
      </div>
      <div class="mood-check__result" id="moodResult"></div>
    </div>

    <div class="content-awaits">
      <div class="content-awaits__bar"><div class="content-awaits__fill"></div></div>
      <span class="content-awaits__text">{tocItems.length}개 섹션 준비됨</span>
    </div>

    <nav class="toc">
      <h3>목차</h3>
      <ol>
        {tocItems.map(item => (
          <li><a href={`#${item.id}`}>{item.label}</a></li>
        ))}
      </ol>
    </nav>

    <!-- 1. Atmosphere -->
    <section class="venue-section" id="atmosphere">
      <h2>감성 요약</h2>
      <p>{v.bodySections.atmosphere}</p>
    </section>

    <!-- 2. Storytelling -->
    <section class="venue-section" id="story">
      <h2>스토리텔링: {v.storyFrame.style}</h2>
      <div class="accordion">
        <div class="accordion-item">
          <button class="accordion-trigger">Act 1 – 도착 <span class="icon">▼</span></button>
          <div class="accordion-content"><div class="accordion-content-inner">{v.story.scene1}</div></div>
        </div>
        <div class="accordion-item">
          <button class="accordion-trigger">Act 2 – 경험 <span class="icon">▼</span></button>
          <div class="accordion-content"><div class="accordion-content-inner">{v.story.scene2}</div></div>
        </div>
        <div class="accordion-item">
          <button class="accordion-trigger">Act 3 – 절정과 마무리 <span class="icon">▼</span></button>
          <div class="accordion-content"><div class="accordion-content-inner">{v.story.scene3}</div></div>
        </div>
        <div class="accordion-item">
          <button class="accordion-trigger">감각의 디테일 <span class="icon">▼</span></button>
          <div class="accordion-content"><div class="accordion-content-inner">{v.story.scene4}</div></div>
        </div>
        <div class="accordion-item">
          <button class="accordion-trigger">감성의 여운 <span class="icon">▼</span></button>
          <div class="accordion-content"><div class="accordion-content-inner">{v.story.scene5}</div></div>
        </div>
      </div>
    </section>

    <!-- 3. Timeline -->
    <section class="venue-section" id="timeline">
      <h2>방문 플랜 (타임라인)</h2>
      <div class="timeline">
        {v.timeline.map(t => (
          <div class="timeline-item">
            <div class="timeline-dot"></div>
            <div class="timeline-time">{t.time}</div>
            <div class="timeline-label">{t.label}</div>
            <div class="timeline-desc">{t.desc}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- 4. Planner -->
    <section class="venue-section" id="planner">
      <h2>나만의 플랜 만들기</h2>
      <div class="planner">
        <div class="planner-group">
          <label>목적을 선택하세요</label>
          <div class="planner-options" data-group="purpose">
            {Object.keys(v.plannerRules['목적'] || {}).map(k => (
              <button class="planner-btn" data-key={k}>{k}</button>
            ))}
          </div>
        </div>
        <div class="planner-group">
          <label>시간대를 선택하세요</label>
          <div class="planner-options" data-group="time">
            {Object.keys(v.plannerRules['시간대'] || {}).map(k => (
              <button class="planner-btn" data-key={k}>{k}</button>
            ))}
          </div>
        </div>
        <div class="planner-result" id="plannerResult">
          목적과 시간대를 선택하면 맞춤 플랜이 표시됩니다.
        </div>
      </div>
    </section>

    <!-- 5. Checklist -->
    <section class="venue-section" id="checklist">
      <h2>첫방문 체크리스트</h2>
      <ul class="checklist">
        {v.checklist.map(item => (
          <li>{item}</li>
        ))}
      </ul>
    </section>

    <!-- 6. Music -->
    <section class="venue-section" id="music">
      <h2>음악/사운드</h2>
      <p>{v.bodySections.music}</p>
    </section>

    <!-- 7. Location -->
    <section class="venue-section" id="location">
      <h2>위치/교통</h2>
      <div class="location-info">
        {v.geo.precision !== 'none' ? (
          <>
            <p><span class="location-label">주소:</span> {v.geo.formatted_address === '확인 필요' ? '확인 필요 – 방문 전 직접 확인을 권장합니다' : v.geo.formatted_address}</p>
            <p><span class="location-label">소재:</span> {v.geo.city} {v.geo.district} {v.geo.neighborhood}</p>
          </>
        ) : (
          <p>정확한 위치 정보 확인이 필요합니다. 방문 전 직접 확인을 권장합니다.</p>
        )}
      </div>
    </section>

    <!-- 8. FAQ -->
    <section class="venue-section" id="faq">
      <h2>자주 묻는 질문 (FAQ)</h2>
      {v.faq.map(f => (
        <div class="faq-item">
          <div class="faq-q">{f.q}</div>
          <div class="faq-a">{f.a}</div>
        </div>
      ))}
    </section>

    <!-- 9. Safety -->
    <section class="venue-section">
      <h2>매너/안전/예산 안내</h2>
      <p>{v.bodySections.safety}</p>
    </section>

    <!-- 10. Related -->
    <section class="venue-section" id="related">
      <h2>추천 매장</h2>
      {sameRegion.length > 0 && (
        <div class="related-section">
          <h3>인근 추천</h3>
          <div class="related-grid">
            {sameRegion.map(rv => (
              <a href={getVenueUrl(rv!)} class="related-link">{rv!.name_display}</a>
            ))}
          </div>
        </div>
      )}
      {sameType.length > 0 && (
        <div class="related-section">
          <h3>같은 유형 (클럽)</h3>
          <div class="related-grid">
            {sameType.map(rv => (
              <a href={getVenueUrl(rv!)} class="related-link">{rv!.name_display}</a>
            ))}
          </div>
        </div>
      )}
      {nearby.length > 0 && (
        <div class="related-section">
          <h3>가까운 매장</h3>
          <div class="related-grid">
            {nearby.map(rv => (
              <a href={getVenueUrl(rv!)} class="related-link">{rv!.name_display}</a>
            ))}
          </div>
        </div>
      )}
      <div class="related-section">
        <h3>추천 콘텐츠</h3>
        <div class="related-grid">
          {guides.slice(0, 2).map(g => (
            <a href={`/guides/${g.slug}/`} class="related-link">{g.title}</a>
          ))}
        </div>
      </div>
      <div class="related-section">
        <div class="related-grid">
          <a href={`/region/${v.regionSlug}/`} class="related-link">전체 보기</a>
          <a href="/clubs/" class="related-link">전체 목록 보기</a>
        </div>
      </div>
    </section>

    <!-- 11. Gallery -->
    <section class="venue-section" id="gallery">
      <h2>갤러리</h2>
      <div class="gallery">
        {v.images.map(img => (
          <img src={img.src} alt={img.alt} width="400" height="340" loading="lazy" />
        ))}
      </div>
    </section>

    <!-- 12. Nightlife Quiz -->
    <section class="venue-section" id="quiz">
      <h2>나이트라이프 성향 테스트</h2>
      <p class="section-intro">5가지 질문으로 당신의 나이트라이프 성향을 알아보세요. 당신에게 맞는 곳인지 확인해보세요.</p>
      <div class="quiz-container" id="quizContainer">
        <div class="quiz-progress"><div class="quiz-progress-bar" id="quizProgress"></div></div>
        <div class="quiz-question" id="quizQuestion"></div>
        <div class="quiz-options" id="quizOptions"></div>
        <div class="quiz-result" id="quizResult" style="display:none;"></div>
      </div>
    </section>

    <!-- 13. Venue Comparison -->
    <section class="venue-section" id="compare">
      <h2>밤문화 유형 비교</h2>
      <div class="compare-table">
        <table>
          <thead>
            <tr>
              <th>항목</th>
              <th>클럽</th>
              <th>나이트</th>
              <th>라운지</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>스타일</td><td>DJ + EDM/힙합</td><td>라이브 밴드 + 댄스</td><td>칵테일 + 대화</td></tr>
            <tr><td>연령대</td><td>20~30대 중심</td><td>30~50대 중심</td><td>25~40대</td></tr>
            <tr><td>드레스코드</td><td>깔끔한 캐주얼</td><td>단정한 캐주얼</td><td>스마트 캐주얼</td></tr>
            <tr><td>예산 (1인)</td><td>3~8만원</td><td>5~10만원</td><td>5~15만원</td></tr>
            <tr><td>운영시간</td><td>22시~06시</td><td>20시~05시</td><td>19시~03시</td></tr>
            <tr><td>음악</td><td>EDM/하우스/힙합</td><td>트로트/댄스/발라드</td><td>재즈/R&B/소울</td></tr>
            <tr><td>추천 목적</td><td>파티/춤/음악</td><td>모임/댄스/부킹</td><td>데이트/대화/2차</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- 14. Deep Dive Content -->
    <section class="venue-section" id="deepdive">
      <h2>심층 분석</h2>
      <div class="deepdive-grid">
        <div class="deepdive-card">
          <h3>입장 전 체크포인트</h3>
          <p>복장은 깔끔한 캐주얼이 기본이며 슬리퍼나 반바지는 입장 거부 사유가 된다. 게스트리스트는 SNS 채널에서 사전 등록하면 대기 없이 바로 들어갈 수 있다. 도착 추천 시각은 23시 전후이며, 주말 피크타임에는 30분 이상 줄을 설 수도 있으니 일찍 움직이자.</p>
        </div>
        <div class="deepdive-card">
          <h3>씬의 발자취</h3>
          <p>2000년대 초반 EDM 붐과 함께 본격 성장이 시작되었고, 이후 힙합·하우스·테크노 등 다양한 장르가 뿌리를 내렸다. 해외 DJ 내한 공연과 페스티벌 애프터파티가 자리 잡으며 씬의 깊이가 한층 올라갔다. 그 흐름 속에서 독자적 사운드를 구축한 곳이 지금의 핵심 플레이어다.</p>
        </div>
        <div class="deepdive-card">
          <h3>시즌별 방문 팁</h3>
          <p>봄에는 새 학기 환영 행사와 루프탑 오픈이 겹쳐 활기가 넘친다. 여름 페스 철에는 해외 아티스트 내한이 잦고, 가을 할로윈 코스튬 파티는 연중 최대 성수기다. 연말에는 카운트다운 행사가 열리며 인기 있는 곳은 2주 전 예약 마감이 보통이다.</p>
        </div>
        <div class="deepdive-card">
          <h3>추천 코스</h3>
          <p>1차로 인근 맛집에서 든든히 배를 채운 뒤, 2차로 23시쯤 입장해 바 카운터에서 한 잔 마시며 워밍업한다. 자정부터 새벽 1시가 에너지 절정 구간이니 메인 플로어에서 마음껏 춤추고, 3차는 새벽 해장으로 마무리하면 완벽하다.</p>
        </div>
      </div>
    </section>

    <!-- 15. Venue Diary -->
    <section class="venue-section" id="diary">
      <h2>나만의 방문 일기</h2>
      <p class="section-intro">방문 후 느낀 점을 기록해보세요. 작성한 내용은 브라우저에 저장됩니다.</p>
      <div class="diary-container">
        <div class="diary-ratings">
          <div class="diary-rating-item">
            <label>인상</label>
            <div class="star-rating" data-category="atmosphere">
              <span class="star" data-value="1">&#9733;</span>
              <span class="star" data-value="2">&#9733;</span>
              <span class="star" data-value="3">&#9733;</span>
              <span class="star" data-value="4">&#9733;</span>
              <span class="star" data-value="5">&#9733;</span>
            </div>
          </div>
          <div class="diary-rating-item">
            <label>음악</label>
            <div class="star-rating" data-category="music">
              <span class="star" data-value="1">&#9733;</span>
              <span class="star" data-value="2">&#9733;</span>
              <span class="star" data-value="3">&#9733;</span>
              <span class="star" data-value="4">&#9733;</span>
              <span class="star" data-value="5">&#9733;</span>
            </div>
          </div>
          <div class="diary-rating-item">
            <label>서비스</label>
            <div class="star-rating" data-category="service">
              <span class="star" data-value="1">&#9733;</span>
              <span class="star" data-value="2">&#9733;</span>
              <span class="star" data-value="3">&#9733;</span>
              <span class="star" data-value="4">&#9733;</span>
              <span class="star" data-value="5">&#9733;</span>
            </div>
          </div>
        </div>
        <textarea class="diary-text" id="diaryText" rows="6" placeholder="오늘 밤의 경험을 자유롭게 적어보세요..."></textarea>
        <button class="diary-save-btn" id="diarySave">저장하기</button>
        <div class="diary-saved-msg" id="diarySavedMsg" style="display:none;">저장되었습니다!</div>
      </div>
    </section>

    <!-- SEO: Keywords section -->
    <section class="venue-section" id="keywords-seo" style="margin-top:2rem;">
      <h2>{v.name_display} 관련 검색어</h2>
      <div class="keyword-cloud">
        {v.keywords.map(kw => (
          <span class="keyword-tag">{kw}</span>
        ))}
      </div>
    </section>
  </div>

  <script define:vars={{ plannerRules: v.plannerRules, venueId: v.id, venueName: v.name_display, venueType: v.type }}>
    let selectedPurpose = '';
    let selectedTime = '';

    document.querySelectorAll('.planner-options').forEach(group => {
      group.querySelectorAll('.planner-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const g = group.getAttribute('data-group');
          const key = btn.getAttribute('data-key') || '';
          group.querySelectorAll('.planner-btn').forEach(b => b.classList.remove('selected'));
          btn.classList.add('selected');
          if (g === 'purpose') selectedPurpose = key;
          if (g === 'time') selectedTime = key;
          updatePlan();
        });
      });
    });

    function updatePlan() {
      const result = document.getElementById('plannerResult');
      if (!result) return;
      let text = '';
      if (selectedPurpose && plannerRules['목적']) {
        text += plannerRules['목적'][selectedPurpose] || '';
      }
      if (selectedTime && plannerRules['시간대']) {
        text += (text ? ' ' : '') + (plannerRules['시간대'][selectedTime] || '');
      }
      result.textContent = text || '목적과 시간대를 선택하면 맞춤 플랜이 표시됩니다.';
    }

    // ─── Quiz ───
    const quizQuestions = [
      { q: '밤에 외출할 때 가장 중요한 것은?', opts: ['음악과 춤', '좋은 분위기', '맛있는 음료', '새로운 만남'], scores: [2, 1, 0, 3] },
      { q: '선호하는 음악 장르는?', opts: ['EDM/일렉트로닉', '힙합/R&B', '트로트/댄스', '재즈/소울'], scores: [2, 1, 3, 0] },
      { q: '이상적인 밤 외출 인원은?', opts: ['혼자', '2명 (데이트)', '3~5명 친구들', '대규모 단체'], scores: [0, 1, 2, 3] },
      { q: '밤문화 예산은?', opts: ['3만원 이하', '3~5만원', '5~10만원', '10만원 이상'], scores: [2, 3, 1, 0] },
      { q: '좋아하는 분위기는?', opts: ['조용하고 세련된', '활기차고 역동적인', '고급스럽고 프라이빗', '자유롭고 개방적인'], scores: [0, 3, 1, 2] },
    ];
    const types = ['라운지 스타일', '나이트 스타일', '클럽 스타일', '소셜 버터플라이'];
    const typeDescs = [
      '세련된 공간에서 칵테일과 대화를 즐기는 당신은 라운지형 인간입니다.',
      '라이브 밴드와 댄스를 즐기는 당신은 나이트형 인간입니다.',
      '강렬한 비트와 함께 자유롭게 춤추는 것을 좋아하는 클럽형 인간입니다. ' + venueName + '에서 잊지 못할 밤을 경험하세요!',
      '어디서든 사람들과 어울리는 것을 좋아하는 소셜형 인간입니다. 어떤 장소든 당신과 함께라면 즐겁습니다!',
    ];
    let qIdx = 0, totalScore = 0;
    function showQuestion() {
      const qEl = document.getElementById('quizQuestion');
      const oEl = document.getElementById('quizOptions');
      const pEl = document.getElementById('quizProgress');
      if (!qEl || !oEl || !pEl) return;
      if (qIdx >= quizQuestions.length) { showResult(); return; }
      pEl.style.width = ((qIdx / quizQuestions.length) * 100) + '%';
      const q = quizQuestions[qIdx];
      qEl.textContent = `Q${qIdx + 1}. ${q.q}`;
      oEl.innerHTML = q.opts.map((o, i) => `<button class="quiz-opt-btn" data-score="${q.scores[i]}">${o}</button>`).join('');
      oEl.querySelectorAll('.quiz-opt-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          totalScore += parseInt(btn.getAttribute('data-score') || '0');
          qIdx++;
          showQuestion();
        });
      });
    }
    function showResult() {
      const rEl = document.getElementById('quizResult');
      const qEl = document.getElementById('quizQuestion');
      const oEl = document.getElementById('quizOptions');
      const pEl = document.getElementById('quizProgress');
      if (!rEl || !qEl || !oEl || !pEl) return;
      pEl.style.width = '100%';
      qEl.style.display = 'none';
      oEl.style.display = 'none';
      rEl.style.display = 'block';
      const typeIdx = Math.min(Math.floor(totalScore / 4), types.length - 1);
      rEl.innerHTML = `<h3>당신의 성향: ${types[typeIdx]}</h3><p>${typeDescs[typeIdx]}</p><button class="quiz-retry-btn" onclick="location.reload()">다시 테스트하기</button>`;
    }
    showQuestion();

    // ─── Star Rating ───
    document.querySelectorAll('.star-rating').forEach(rating => {
      const stars = rating.querySelectorAll('.star');
      stars.forEach(star => {
        star.addEventListener('click', () => {
          const val = parseInt(star.getAttribute('data-value') || '0');
          stars.forEach(s => {
            const sv = parseInt(s.getAttribute('data-value') || '0');
            s.classList.toggle('active', sv <= val);
          });
        });
      });
    });

    // ─── Mood Check ───
    const moodMessages = {
      energy: `${venueName}의 메인 플로어에서 DJ의 비트에 몸을 맡기세요! 🔥 타임라인 섹션에서 피크타임을 확인하고, 음악/무드 섹션에서 오늘의 장르를 미리 체크하세요.`,
      chill: `${venueName}의 바 카운터에서 음료 한 잔과 함께 여유로운 시작을 추천합니다. 🌙 체크리스트를 확인하고, 플랜 만들기에서 나만의 코스를 짜보세요.`,
      social: `${venueName}은 새로운 만남의 공간으로도 최적! 🥂 FAQ에서 예약 정보를 확인하고, 추천 매장에서 2차 장소도 미리 골라보세요.`,
      music: `${venueName}의 사운드 시스템은 직접 경험해야 합니다. 🎵 음악/무드 섹션에서 장르를 확인하고, 스토리텔링에서 사운드 디테일을 느껴보세요.`,
    };
    document.querySelectorAll('.mood-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.mood-btn').forEach(b => b.classList.remove('selected'));
        btn.classList.add('selected');
        const mood = btn.dataset.mood || 'energy';
        const result = document.getElementById('moodResult');
        if (result) {
          result.textContent = moodMessages[mood] || '';
          result.classList.add('show');
        }
      });
    });

    // ─── Diary ───
    const diaryKey = 'diary-' + venueId;
    const savedDiary = localStorage.getItem(diaryKey);
    if (savedDiary) {
      try {
        const d = JSON.parse(savedDiary);
        const ta = document.getElementById('diaryText');
        if (ta) (ta as HTMLTextAreaElement).value = d.text || '';
        document.querySelectorAll('.star-rating').forEach(rating => {
          const cat = rating.getAttribute('data-category');
          if (cat && d.ratings && d.ratings[cat]) {
            rating.querySelectorAll('.star').forEach(s => {
              const sv = parseInt(s.getAttribute('data-value') || '0');
              s.classList.toggle('active', sv <= d.ratings[cat]);
            });
          }
        });
      } catch {}
    }
    document.getElementById('diarySave')?.addEventListener('click', () => {
      const text = (document.getElementById('diaryText') as HTMLTextAreaElement)?.value || '';
      const ratings: Record<string, number> = {};
      document.querySelectorAll('.star-rating').forEach(rating => {
        const cat = rating.getAttribute('data-category') || '';
        const active = rating.querySelectorAll('.star.active');
        ratings[cat] = active.length;
      });
      localStorage.setItem(diaryKey, JSON.stringify({ text, ratings, date: new Date().toISOString() }));
      const msg = document.getElementById('diarySavedMsg');
      if (msg) { msg.style.display = 'block'; setTimeout(() => msg.style.display = 'none', 2000); }
    });
  </script>
</BaseLayout>
