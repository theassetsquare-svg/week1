---
import BaseLayout from '../../layouts/BaseLayout.astro';
import VenueCard from '../../components/VenueCard.astro';
import { getVenuesByType, SITE_URL } from '../../data/venues';

const loungeVenues = getVenuesByType('lounge');

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "프리미엄 업소 목록",
  "numberOfItems": loungeVenues.length,
  "itemListElement": loungeVenues.map((v, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": v.name,
    "url": `${SITE_URL}/venue/${v.slug}/`
  }))
};
---

<BaseLayout
  title={`${loungeVenues.length}곳 — 야경과 칵테일, 강남 밤의 여유`}
  description={`루프탑 뷰·와인·어쿠스틱 — 강남권 ${loungeVenues.length}곳, 조용히 즐기는 저녁 모임 장소.`}
  canonical={`${SITE_URL}/lounges/`}
  jsonLd={jsonLd}
>
  <div class="listing-header">
    <h1>라운지</h1>
    <p class="listing-count">{loungeVenues.length}곳</p>
    <p class="listing-desc">
      소리보다 분위기가 먼저 말을 건네는 곳.<br/>
      대화와 음악이 함께 흐르는 강남의 밤.
    </p>
  </div>

  <div class="listing-grid">
    {loungeVenues.map((venue, i) => (
      <VenueCard venue={venue} rank={i + 1} />
    ))}
  </div>
</BaseLayout>
