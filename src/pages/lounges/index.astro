---
import BaseLayout from '../../layouts/BaseLayout.astro';
import VenueCard from '../../components/VenueCard.astro';
import { venues, getVenuesByType, SITE_URL, SLOGAN } from '../../data/venues';

const loungeVenues = getVenuesByType('lounge');

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "라운지 목록",
  "description": `강남 라운지 ${loungeVenues.length}곳 — 대화와 음악이 공존하는 공간`,
  "numberOfItems": loungeVenues.length,
  "itemListElement": loungeVenues.map((v, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": v.name,
    "url": `${SITE_URL}/venue/${v.slug}/`
  }))
};
---

<BaseLayout
  title={`라운지 ${loungeVenues.length}곳 — 야경과 칵테일, 강남 밤의 여유`}
  description={`강남 라운지 ${loungeVenues.length}곳의 현장 안내. 소울, 재즈, 시티팝 — 대화가 가능한 사운드와 시그니처 칵테일.`}
  canonical={`${SITE_URL}/lounges/`}
  jsonLd={jsonLd}
>
  <div class="listing-header">
    <h1>LOUNGE_</h1>
    <p class="listing-count">{loungeVenues.length}곳</p>
    <p style="font-size:14px;color:var(--text-secondary);margin-top:8px;line-height:1.7;">
      소리보다 분위기가 먼저 말을 건네는 곳.<br/>
      대화와 음악이 함께 흐르는 강남의 밤.
    </p>
  </div>

  <div class="fomo-counter">
    ⚡ 업소 정보 탐색 중
  </div>

  <div class="listing-grid">
    {loungeVenues.map((venue, i) => (
      <VenueCard venue={venue} rank={i + 1} />
    ))}
  </div>
</BaseLayout>
