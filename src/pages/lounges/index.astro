---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getVenuesByType, venues, SITE_URL, MAIN_SITE_URL } from '../../data/venues';

const loungeVenues = getVenuesByType('lounge');
const regions = [...new Set(loungeVenues.map(v => v.region))].sort();

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "프리미엄 바 목록",
  "numberOfItems": loungeVenues.length,
  "itemListElement": loungeVenues.slice(0,5).map((v, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "url": `${SITE_URL}/venue/${v.slug}/`
  }))
};
---

<BaseLayout
  title={`프리미엄 라운지 ${loungeVenues.length}곳 — 칵테일과 재즈가 흐르는 밤, 지금 입장`}
  description={`강남·압구정 프리미엄 라운지 ${loungeVenues.length}곳의 시그니처 칵테일과 라이브 음악 정보를 한눈에 확인하세요.`}
  canonical={`${SITE_URL}/lounges/`}
  ogImage={`${SITE_URL}/og/lounges.svg`}
  jsonLd={jsonLd}
>

<div class="listing-header">
  <h1>프리미엄 베뉴</h1>
  <p class="listing-count">{loungeVenues.length}곳</p>
</div>
<div class="cat-intro">
  은은한 재즈 선율과 손으로 빚은 칵테일 한 잔이 어우러지는 공간입니다.
  압구정·청담 일대에 자리한 감성 바는 세련된 인테리어와 큐레이션된 위스키 셀렉션으로
  특별한 저녁을 완성해 줍니다. 대화에 집중할 수 있는 조용한 좌석 배치,
  도심 야경을 내려다보는 루프탑 뷰, 그리고 바텐더의 시그니처 레시피까지—
  격식 있는 접대 자리부터 소중한 사람과의 기념일까지 다양한 상황에 어울립니다.
  와인·위스키·칵테일 등 주종 전문성이 높아 음료 자체를 즐기려는 분들에게도 적합합니다.
  각 공간의 분위기와 주종 구성을 비교해 취향에 맞는 곳을 찾아보세요.
</div>

<!-- 업소 리스트 (서버사이드 렌더링!) -->
<div style="max-width:480px;margin:0 auto;padding:0 16px;">
  {loungeVenues.map((v, i) => (
    <a href={`/venue/${v.slug}/`} target="_blank" rel="noopener noreferrer" class="venue-card">
      <div class="venue-card-header"><span class="rank-badge">{i + 1}</span></div>
      <div class="venue-card-name">{v.name}</div>
      <div class="venue-card-desc">{v.shortDesc}</div>
      <div class="venue-card-tags">{v.tags.slice(0, 3).map(t => <span class="venue-tag">#{t}</span>)}</div>
      {v.nickname && <div class="venue-card-contact">담당: {v.nickname}{v.phone ? ` | ${v.phone}` : ''}</div>}
    </a>
  ))}
</div>

<!-- 첫 방문 가이드 -->
<div class="fv-section">
  <div class="fv-title">처음 방문하시나요?</div>
  <div class="fv-item">
    <div class="fv-q" onclick="this.parentElement.classList.toggle('open')">뭐 입고 가야 해?<span class="fv-arrow">▼</span></div>
    <div class="fv-a"><p>비즈니스 캐주얼 이상을 권장합니다. 셔츠·재킷·구두가 기본이며, 격식 있는 분위기에 맞는 차림이 좋습니다. 여성은 원피스나 블라우스에 클러치백 정도면 완벽합니다.</p></div>
  </div>
  <div class="fv-item">
    <div class="fv-q" onclick="this.parentElement.classList.toggle('open')">얼마 들어?<span class="fv-arrow">▼</span></div>
    <div class="fv-a"><p>별도 입장료는 없습니다. 테이블 차지(주대)가 30만~100만 원 이상이며, 음료가 포함됩니다. 바 좌석은 음료 주문만으로도 이용 가능한 곳이 있으니 미리 확인하세요.</p></div>
  </div>
  <div class="fv-item">
    <div class="fv-q" onclick="this.parentElement.classList.toggle('open')">혼자 가도 돼?<span class="fv-arrow">▼</span></div>
    <div class="fv-a"><p>바 카운터 좌석이라면 혼자 방문해도 전혀 어색하지 않습니다. 바텐더와 대화하며 칵테일을 즐기는 1인 손님이 많은 편입니다.</p></div>
  </div>
  <div class="fv-item">
    <div class="fv-q" onclick="this.parentElement.classList.toggle('open')">예약 필요해?<span class="fv-arrow">▼</span></div>
    <div class="fv-a"><p>테이블 좌석은 반드시 사전 예약이 필요합니다. 바 좌석은 선착순 이용이 가능하나, 주말은 대기가 길어질 수 있으므로 전화 문의를 추천합니다.</p></div>
  </div>
</div>

<!-- 인기 시간대 -->
<div class="pop-times">
  <div class="pop-times-title">인기 요일 · 시간대</div>
  <div class="pop-chart">
    {['월','화','수','목','금','토','일'].map((d, i) => {
      const pct = [25,30,40,85,100,70,20][i];
      return (
        <div class="pop-bar-wrap">
          <div class={`pop-bar${pct >= 80 ? ' peak' : ''}`} style={`height:${pct}%`}></div>
          <div class="pop-day">{d}</div>
        </div>
      );
    })}
  </div>
  <div class="pop-hours">피크 시간: 20:00 – 01:00</div>
</div>

<!-- 매거진 -->
<div class="cat-mag">
  <div class="cat-mag-title">관련 매거진</div>
  <div class="cat-mag-grid">
    <a href="/magazine/" target="_blank" rel="noopener noreferrer" class="cat-mag-card" style="background:linear-gradient(135deg,#78350f,#d97706)">
      <div class="cat-mag-cat">가이드</div>
      <div class="cat-mag-name">위스키 입문자를 위한 싱글몰트 안내서</div>
      <div class="cat-mag-desc">처음 위스키를 접하는 분을 위한 풍미별 추천 목록.</div>
    </a>
    <a href="/magazine/" target="_blank" rel="noopener noreferrer" class="cat-mag-card" style="background:linear-gradient(135deg,#4a1942,#be185d)">
      <div class="cat-mag-cat">트렌드</div>
      <div class="cat-mag-name">칵테일 믹솔로지 트렌드 2026</div>
      <div class="cat-mag-desc">올해 주목받는 크래프트 칵테일 기법을 소개합니다.</div>
    </a>
  </div>
</div>

<div class="cta-section mt-md" style="max-width:480px;margin:24px auto;padding:0 16px">
  <a href={MAIN_SITE_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm">메인에서 전체 확인 →</a>
</div>

</BaseLayout>
