---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getVenuesByType, venues, SITE_URL, MAIN_SITE_URL } from '../../data/venues';

const nightVenues = getVenuesByType('night');
const regions = [...new Set(nightVenues.map(v => v.region))].sort();

// VS matchups (verified slugs)
const vsPairs = [
  [venues.find(v => v.slug === 'cheongdam-h2o'), venues.find(v => v.slug === 'busan-asiad')],
  [venues.find(v => v.slug === 'suwon-chancedom'), venues.find(v => v.slug === 'daejeon-seven')],
].filter(p => p[0] && p[1]).map(p => ({
  a: { n: p[0]!.name, s: p[0]!.slug, r: p[0]!.region, id: p[0]!.id },
  b: { n: p[1]!.name, s: p[1]!.slug, r: p[1]!.region, id: p[1]!.id },
}));

const _b64 = Buffer.from(JSON.stringify({
  venues: nightVenues.map(v => ({n:v.name,s:v.slug,r:v.region,d:v.shortDesc,nk:v.nickname||'',ph:v.phone||'',tg:v.tags.slice(0,3)})),
  regions,
  vs: vsPairs,
  popTimes: {days:[{d:'월',v:20},{d:'화',v:25},{d:'수',v:30},{d:'목',v:45},{d:'금',v:95},{d:'토',v:100},{d:'일',v:40}],peak:'22:00 – 02:00'},
  mags: [
    {t:'전국 무대조명 퀄리티 비교',c:'분석',d:'도시별 사운드 시스템과 조명 연출을 비교합니다.',g:1},
    {t:'첫 방문 에티켓 완벽 정리',c:'입문',d:'현장에서 당황하지 않는 기본 매너와 팁.',g:2},
    {t:'지방 원정 투어 코스 추천',c:'지역',d:'서울 밖에서 만나는 색다른 분위기 베뉴 모음.',g:3},
  ],
})).toString('base64');

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "전국 야간업소 목록",
  "numberOfItems": nightVenues.length,
  "itemListElement": nightVenues.slice(0,5).map((v, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "url": `${SITE_URL}/venue/${v.slug}/`
  }))
};
---

<BaseLayout
  title={`전국 나이트 ${nightVenues.length}곳 — 현지인이 인정한 숨은 명소 총정리`}
  description={`서울·수원·부산·울산 전역 ${nightVenues.length}곳의 나이트 분위기와 운영 시간을 한눈에 비교하세요. 담당자 직통 연결과 현장 분석까지.`}
  canonical={`${SITE_URL}/nights/`}
  ogImage={`${SITE_URL}/og/nights.svg`}
  jsonLd={jsonLd}
>
  <!-- ① Category Intro -->
  <div class="listing-header">
    <h1>전국 야간업소</h1>
    <p class="listing-count">{nightVenues.length}곳</p>
  </div>
  <div class="cat-intro">
    도시마다 다른 무대가 있고, 사운드 시스템과 조명 연출이 분위기를 완성합니다.
    서울 강남권은 대형 스피커와 레이저 조명으로 압도적 스케일을 자랑하고,
    경기 수원·일산 지역은 넓은 홀과 합리적 가격으로 편안한 저녁을 선사합니다.
    부산·대구·광주 등 지방 도시는 그 지역만의 고유한 감성과 음악 취향이 살아 있어
    원정 나들이의 묘미를 느끼게 합니다. 혼자 가도, 단체로 가도, 어느 도시든
    무대 위 조명이 켜지는 순간 일상에서 벗어난 밤이 시작됩니다.
    도심 한복판의 대형 홀부터 소규모 아늑한 공간까지,
    각 장소의 사운드와 분위기를 직접 비교해 보세요.
  </div>

  <!-- ② Venue List with Filter + Sort -->
  <div class="filter-bar" style="max-width:480px;margin:0 auto 16px;padding:0 16px">
    <div class="filter-pills" id="regionFilter"></div>
    <select class="sort-select" id="sortSelect">
      <option value="default">기본순</option>
      <option value="name">가나다순</option>
    </select>
  </div>
  <div class="listing-grid" id="venueGrid" style="max-width:480px;margin:0 auto;padding:0 16px"></div>

  <!-- ③ First Visit Guide -->
  <div class="fv-section">
    <div class="fv-title">처음 방문하시나요?</div>
    <div class="fv-item">
      <div class="fv-q">뭐 입고 가야 해?<span class="fv-arrow">▼</span></div>
      <div class="fv-a"><p>캐주얼 정장이면 충분합니다. 슬리퍼·반바지·운동복은 피하세요. 셔츠에 깔끔한 바지, 운동화보다는 로퍼나 구두가 무난합니다. 여성은 원피스나 블라우스에 편한 굽의 구두면 어디서든 환영받습니다.</p></div>
    </div>
    <div class="fv-item">
      <div class="fv-q">얼마 들어?<span class="fv-arrow">▼</span></div>
      <div class="fv-a"><p>입장료는 지역에 따라 1만~3만 원 수준입니다. 음료는 잔당 8천~1만 5천 원이며, 별도 테이블(주대)은 없는 곳이 대부분입니다. 주중·조기 입장 시 할인이 적용되는 곳도 많습니다.</p></div>
    </div>
    <div class="fv-item">
      <div class="fv-q">혼자 가도 돼?<span class="fv-arrow">▼</span></div>
      <div class="fv-a"><p>물론입니다. 1인 방문객도 상당히 많습니다. 현장에서 자연스럽게 어울리는 분위기이므로 부담 없이 입장하세요. 담당 매니저가 자리를 안내해 줍니다.</p></div>
    </div>
    <div class="fv-item">
      <div class="fv-q">예약 필요해?<span class="fv-arrow">▼</span></div>
      <div class="fv-a"><p>대부분 예약 없이 현장 입장이 가능합니다. 다만 금·토 심야 시간대는 대기가 발생할 수 있으니, 확실한 입장을 원하면 전화 문의 후 방문하시는 것을 권장합니다.</p></div>
    </div>
  </div>

  <!-- ④ Popular Times -->
  <div class="pop-times">
    <div class="pop-times-title">인기 요일 · 시간대</div>
    <div class="pop-chart" id="popChart"></div>
    <div class="pop-hours" id="popHours"></div>
  </div>

  <!-- ⑤ VS Battle -->
  <div class="cat-vs">
    <div class="cat-vs-title">이번 주 대결</div>
    <div class="vs-arena" id="catVsArena"></div>
    <div class="vs-controls"><button class="btn btn-outline btn-sm" id="catVsNext" style="display:none">다음 대결 →</button></div>
  </div>

  <!-- ⑥ Magazine -->
  <div class="cat-mag">
    <div class="cat-mag-title">관련 매거진</div>
    <div class="cat-mag-grid" id="catMagGrid"></div>
  </div>

  <div class="cta-section mt-md" style="max-width:480px;margin:24px auto;padding:0 16px">
    <a href={MAIN_SITE_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm">
      메인에서 전체 확인 →
    </a>
  </div>

  <script is:inline define:vars={{ _b64 }}>
  (function(){
    var D=JSON.parse(atob(_b64));var all=D.venues;var cur='all';var srt='default';

    // Filter + Sort
    var fEl=document.getElementById('regionFilter');
    var h='<button class="filter-pill active" data-r="all">전체</button>';
    D.regions.forEach(function(r){h+='<button class="filter-pill" data-r="'+r+'">'+r+'</button>';});
    fEl.innerHTML=h;
    function render(){
      var list=all.filter(function(v){return cur==='all'||v.r===cur;});
      if(srt==='name')list.sort(function(a,b){return a.n.localeCompare(b.n,'ko');});
      var o='';
      list.forEach(function(v){
        o+='<a href="/venue/'+v.s+'/" target="_blank" class="venue-card">';
        o+='<div class="venue-card-header"><span class="venue-region-text">'+v.r+'</span></div>';
        o+='<div class="venue-card-name">'+v.n+'</div>';
        o+='<div class="venue-card-desc">'+v.d+'</div>';
        if(v.tg.length){o+='<div class="venue-card-tags">';v.tg.forEach(function(t){o+='<span class="venue-tag">#'+t+'</span>';});o+='</div>';}
        if(v.nk){o+='<div class="venue-card-contact">담당: '+v.nk+(v.ph?' | '+v.ph:'')+'</div>';}
        o+='</a>';
      });
      document.getElementById('venueGrid').innerHTML=o;
    }
    fEl.addEventListener('click',function(e){if(e.target.classList.contains('filter-pill')){fEl.querySelectorAll('.filter-pill').forEach(function(p){p.classList.remove('active');});e.target.classList.add('active');cur=e.target.getAttribute('data-r');render();}});
    document.getElementById('sortSelect').addEventListener('change',function(){srt=this.value;render();});
    render();

    // Accordion
    document.querySelectorAll('.fv-q').forEach(function(q){
      q.addEventListener('click',function(){q.parentElement.classList.toggle('open');});
    });

    // Popular Times
    var pt=D.popTimes;
    var ch='';
    pt.days.forEach(function(d){
      ch+='<div class="pop-bar-wrap"><div class="pop-bar'+(d.v>=80?' peak':'')+'" style="height:'+d.v+'%"></div><div class="pop-day">'+d.d+'</div></div>';
    });
    document.getElementById('popChart').innerHTML=ch;
    document.getElementById('popHours').textContent='피크 시간: '+pt.peak;

    // VS Battle
    var vs=D.vs;if(vs.length){
      var vi=parseInt(localStorage.getItem('vsNightIdx')||'0')%vs.length;
      var vv=JSON.parse(localStorage.getItem('vsNightVotes')||'{}');
      function renderVs(){
        var m=vs[vi%vs.length];var pA=((m.a.id*7+m.b.id*13)%21+40);var pB=100-pA;var voted=vv[vi];
        var h='<div class="vs-card'+(voted?' voted revealed':'')+'" data-side="a"><div class="vs-name">'+m.a.n+'</div><div class="vs-meta">'+m.a.r+'</div><div class="vs-pct">'+(voted?pA+'%':'??%')+'</div></div>';
        h+='<div class="vs-badge">VS</div>';
        h+='<div class="vs-card'+(voted?' voted revealed':'')+'" data-side="b"><div class="vs-name">'+m.b.n+'</div><div class="vs-meta">'+m.b.r+'</div><div class="vs-pct">'+(voted?pB+'%':'??%')+'</div></div>';
        document.getElementById('catVsArena').innerHTML=h;
        document.getElementById('catVsNext').style.display=voted?'inline-block':'none';
        if(!voted){document.querySelectorAll('#catVsArena .vs-card').forEach(function(c){c.addEventListener('click',function(){vv[vi]=c.getAttribute('data-side');localStorage.setItem('vsNightVotes',JSON.stringify(vv));renderVs();});});}
      }
      renderVs();
      document.getElementById('catVsNext').addEventListener('click',function(){vi++;localStorage.setItem('vsNightIdx',vi);renderVs();});
    }

    // Magazine
    var mg=D.mags;var mh='';var grads=['linear-gradient(135deg,#1e1b4b,#4338ca)','linear-gradient(135deg,#0c4a6e,#0891b2)','linear-gradient(135deg,#4a1942,#be185d)'];
    mg.forEach(function(m,i){
      mh+='<div class="cat-mag-card" style="background:'+grads[i%3]+'"><div class="cat-mag-cat">'+m.c+'</div><div class="cat-mag-name">'+m.t+'</div><div class="cat-mag-desc">'+m.d+'</div></div>';
    });
    document.getElementById('catMagGrid').innerHTML=mh;
  })();
  </script>
</BaseLayout>
