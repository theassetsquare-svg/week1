---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { venues, getVenueUrl, getUniqueRegions } from '../../utils/venues';

const nightVenues = venues.filter(v => v.type === 'night');
const allRegions = getUniqueRegions();
const title = '전국 나이트 추천 | 한국 나이트 가이드';
const description = '한국 전국의 나이트을 한눈에 비교하세요. 강남, 부산, 대구, 수원 등 지역별 나이트 상세 정보와 추천.';

const regionMap = new Map<string, { name: string; slug: string; count: number }>();
nightVenues.forEach(v => {
  const existing = regionMap.get(v.regionSlug);
  if (existing) existing.count++;
  else regionMap.set(v.regionSlug, { name: v.region, slug: v.regionSlug, count: 1 });
});
const regions = [...regionMap.values()].sort((a, b) => b.count - a.count);

const jsonLd = [{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "전국 나이트 모음",
  "description": description,
  "url": "https://week1-6m5.pages.dev/nights/",
  "numberOfItems": nightVenues.length,
}];
---
<BaseLayout title={title} description={description} canonical="https://week1-6m5.pages.dev/nights/" jsonLd={jsonLd}>
  <section class="story-intro story-intro--night">
    <div class="container">
      <span class="story-intro__eyebrow">Night Culture Korea</span>
      <h1 class="story-intro__headline">혼자 와도 괜찮습니다.<br />오히려 혼자 올 때, 더 특별한 밤이 시작됩니다.</h1>
    </div>
  </section>

  <section class="container">
    <div class="category-copy">
      <p class="category-copy__lead">
        밴드의 첫 곡이 울리면, 테이블 위 시선이 자연스럽게 교차합니다.<br />
        웨이터가 건네는 메모 한 장. 테이블에 놓인 음료 한 잔.<br />
        <strong>말 한마디 없이도 시작되는 이야기가 있습니다.</strong>
      </p>

      <p>
        나이트는 단순히 술을 마시러 오는 곳이 아닙니다.<br />
        마음에 드는 사람에게 다가갈 수 있는 <em>가장 자연스러운 공간</em>입니다.
        라이브 밴드가 분위기를 만들어주고, 웨이터가 당신의 마음을 전해주고,
        춤이 말보다 더 많은 이야기를 합니다.
      </p>

      <div class="category-copy__highlight">
        <h3>이런 분들이 나이트에 옵니다</h3>
        <ul>
          <li>금요일 밤, 새로운 인연이 필요한 사람</li>
          <li>라이브 밴드 앞에서 춤추며 스트레스를 날리고 싶은 사람</li>
          <li>친구들과의 단체 모임 뒤, 2차로 특별한 곳을 찾는 사람</li>
          <li>"오늘은 좀 다른 밤을 보내고 싶다"고 느끼는 모든 사람</li>
        </ul>
      </div>

      <p>
        처음 오시는 분이라면, 이것만 기억하세요.<br />
        눈이 마주쳤다면 — <strong>이미 시작된 겁니다.</strong>
      </p>

      <div class="category-copy__tips">
        <h3>나이트 처음이라면 알아두세요</h3>
        <dl>
          <dt>복장</dt>
          <dd>깔끔한 캐주얼이면 충분합니다. 슬리퍼와 반바지만 피하세요.</dd>
          <dt>시간</dt>
          <dd>밤 10시 이후가 본격적인 시작. 자정 무렵이 가장 뜨겁습니다.</dd>
          <dt>혼자 방문</dt>
          <dd>전혀 어색하지 않습니다. 오히려 혼자 오는 분이 더 적극적으로 즐깁니다.</dd>
          <dt>예산</dt>
          <dd>입장료 + 음료 1~2잔 기준, 5만~10만원이면 충분한 밤을 보낼 수 있습니다.</dd>
        </dl>
      </div>

      <p class="category-copy__closing">
        전국 <strong>{nightVenues.length}개 나이트</strong>에서 오늘 밤,<br />
        당신의 이야기를 시작해보세요.
      </p>
    </div>
  </section>

  <section class="container category-search" id="venueSection">
    <div class="search-bar">
      <input type="text" id="venueSearch" placeholder="나이트 이름 또는 지역으로 검색..." aria-label="나이트 검색" />
    </div>
    <div class="filter-chips" id="filterChips">
      <button class="filter-chip active" data-region="all">전체 ({nightVenues.length})</button>
      {regions.map(r => (
        <button class="filter-chip" data-region={r.slug}>{r.name} ({r.count})</button>
      ))}
    </div>
    <div class="result-count" id="resultCount"></div>
  </section>

  <section class="container">
    <div class="venue-grid" id="venueGrid">
      {nightVenues.map(v => (
        <a href={getVenueUrl(v)} class="venue-card" data-region={v.regionSlug} data-name={v.name_display + ' ' + v.region}>
          <div class="venue-card-thumb">
            <img src={v.images[0].src} alt={v.images[0].alt} width="400" height="400" loading="lazy" />
          </div>
          <div class="venue-card-body">
            <div class="venue-card-meta">
              <span class="venue-card-type type-night">{v.typeLabel}</span>
              <span class="venue-card-region">{v.region}</span>
            </div>
            <h3>{v.name_display}</h3>
            <p class="venue-card-teaser">{v.teaser}</p>
            <span class="venue-card-cta">자세히 보기 →</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="container" style="margin-top:2rem;">
    <h2 style="text-align:center;margin-bottom:1rem;">지역별 나이트</h2>
    <div class="related-grid" style="max-width:800px;margin:0 auto;">
      {allRegions.map(r => (
        <a href={`/region/${r.slug}/`} class="related-link">{r.name} ({r.count}곳)</a>
      ))}
    </div>
  </section>

  <script define:vars={{ total: nightVenues.length }}>
    const search = document.getElementById('venueSearch');
    const chips = document.querySelectorAll('.filter-chip');
    const cards = document.querySelectorAll('.venue-card');
    const resultCount = document.getElementById('resultCount');
    let activeRegion = 'all';

    function filterCards() {
      const q = search?.value?.toLowerCase() || '';
      let visible = 0;
      cards.forEach(card => {
        const region = card.dataset.region || '';
        const name = (card.dataset.name || '').toLowerCase();
        const matchRegion = activeRegion === 'all' || region === activeRegion;
        const matchSearch = !q || name.includes(q);
        const show = matchRegion && matchSearch;
        card.style.display = show ? '' : 'none';
        if (show) visible++;
      });
      if (resultCount) {
        resultCount.textContent = (q || activeRegion !== 'all') ? `${total}개 중 ${visible}개 표시` : '';
      }
    }

    chips.forEach(chip => {
      chip.addEventListener('click', () => {
        activeRegion = chip.dataset.region || 'all';
        chips.forEach(c => c.classList.remove('active'));
        chip.classList.add('active');
        filterCards();
      });
    });

    search?.addEventListener('input', filterCards);
  </script>
</BaseLayout>
