---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getVenuesByType, venues, SITE_URL, MAIN_SITE_URL } from '../../data/venues';

const nightVenues = getVenuesByType('night');
const regions = [...new Set(nightVenues.map(v => v.region))].sort();

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "전국 야간 무대 목록",
  "numberOfItems": nightVenues.length,
  "itemListElement": nightVenues.slice(0,5).map((v, i) => ({
    "@type": "ListItem", "position": i + 1, "url": `${SITE_URL}/venue/${v.slug}/`
  }))
};
---

<BaseLayout
  title={`전국 나이트 ${nightVenues.length}곳 솔직 정리 — 입장료·분위기·피크타임`}
  description={`서울부터 부산까지 전국 나이트 ${nightVenues.length}곳 솔직 정리. 입장료, 분위기, 피크 타임, 담당자 직통 번호까지 한눈에 비교. 가기 전에 반드시 확인하세요.`}
  canonical={`${SITE_URL}/nights/`}
  ogImage={`${SITE_URL}/og/nights.svg`}
  jsonLd={jsonLd}
>

<div class="listing-header">
  <h1>전국 나이트 {nightVenues.length}곳 솔직 정리</h1>
</div>
<h2 class="cat-intro-title">나이트 분위기, 도시마다 다른 감성</h2>
<div class="cat-intro">
  나이트는 좀 독특합니다. 20대 청년 옆에 50대 아저씨가 서 있고, 그게 전혀 어색하지 않습니다.
  라이브 밴드가 올라오면 분위기가 확 바뀌고, DJ가 트랙 바꾸는 순간 바닥이 흔들립니다.
  옆 사람과 눈이 마주치면 자연스럽게 건배가 시작되는 곳이기도 합니다.
  강남 나이트는 스케일로 밀어붙입니다. 스피커 울림이 온몸을 감쌉니다.
  신림·수유·상봉은 동네 형 같은 웨이터가 자리 잡아주고, 혼자 와도 눈치 안 보입니다.
  수원·성남·파주는 홀이 넓어서 숨 쉴 공간이 있습니다.
  부산·대구·광주는 또 다릅니다. 그 동네만의 선곡, 그 동네만의 감성이 있어서 원정 가볼 가치가 있습니다.
  가기 전에 분위기부터 확인하세요.
</div>

<!-- 업소 리스트 (서버사이드 렌더링!) -->
<div style="max-width:480px;margin:0 auto;padding:0 16px;">
  {nightVenues.map((v, i) => (
    <a href={`/venue/${v.slug}/`} target="_blank" rel="noopener noreferrer" class="venue-card">
      <div class="venue-card-header">
        <span class="rank-badge">{i + 1}</span>
      </div>
      <div class="venue-card-name">{v.name}</div>
      <div class="venue-card-desc">{v.shortDesc}</div>
      <div class="venue-card-tags">
        {v.tags.slice(0, 3).map(t => <span class="venue-tag">#{t}</span>)}
      </div>
      {v.nickname && (
        <div class="venue-card-contact">
          담당: {v.nickname}{v.phone ? ` | ${v.phone}` : ''}
        </div>
      )}
    </a>
  ))}
</div>

<!-- 첫 방문 가이드 -->
<div class="fv-section">
  <h2 class="fv-title">나이트 첫 방문 가이드</h2>
  <div class="fv-item">
    <div class="fv-q" onclick="this.parentElement.classList.toggle('open')">뭐 입고 가야 해?<span class="fv-arrow">▼</span></div>
    <div class="fv-a"><p>캐주얼 정장이면 충분합니다. 슬리퍼·반바지·운동복은 피하세요. 셔츠에 깔끔한 바지, 운동화보다는 로퍼나 구두가 무난합니다.</p></div>
  </div>
  <div class="fv-item">
    <div class="fv-q" onclick="this.parentElement.classList.toggle('open')">얼마 들어?<span class="fv-arrow">▼</span></div>
    <div class="fv-a"><p>입장료는 지역에 따라 1만~3만 원 수준입니다. 음료는 잔당 8천~1만 5천 원이며, 주중·조기 입장 시 할인이 적용되는 곳도 많습니다.</p></div>
  </div>
  <div class="fv-item">
    <div class="fv-q" onclick="this.parentElement.classList.toggle('open')">혼자 가도 돼?<span class="fv-arrow">▼</span></div>
    <div class="fv-a"><p>물론입니다. 1인 방문객도 상당히 많습니다. 현장에서 자연스럽게 어울리는 분위기이므로 부담 없이 입장하세요.</p></div>
  </div>
  <div class="fv-item">
    <div class="fv-q" onclick="this.parentElement.classList.toggle('open')">예약 필요해?<span class="fv-arrow">▼</span></div>
    <div class="fv-a"><p>대부분 예약 없이 현장 입장이 가능합니다. 금·토 심야는 대기가 발생할 수 있으니 전화 문의 후 방문을 권장합니다.</p></div>
  </div>
</div>

<div class="cat-extra" style="max-width:480px;margin:16px auto;padding:0 16px;">
  <p style="font-size:14px;line-height:1.7;color:var(--text-secondary);">라이브 밴드가 무대 올라오는 순간, 테이블마다 건배 소리가 터집니다. 나이트는 나이 상관없이 같이 놀 수 있는 몇 안 되는 공간입니다. 어색함은 한 잔이면 사라져요.</p>
</div>

<!-- 인기 시간대 -->
<div class="pop-times">
  <h2 class="pop-times-title">나이트 인기 요일 · 시간대</h2>
  <div class="pop-chart">
    {['월','화','수','목','금','토','일'].map((d, i) => {
      const pct = [20,25,30,45,95,100,40][i];
      return (
        <div class="pop-bar-wrap">
          <div class={`pop-bar${pct >= 80 ? ' peak' : ''}`} style={`height:${pct}%`}></div>
          <div class="pop-day">{d}</div>
        </div>
      );
    })}
  </div>
  <div class="pop-hours">피크 시간: 22:00 – 02:00</div>
</div>

<!-- 매거진 -->
<div class="cat-mag">
  <h2 class="cat-mag-title">관련 매거진</h2>
  <div class="cat-mag-grid">
    <a href="/magazine/" target="_blank" rel="noopener noreferrer" class="cat-mag-card" style="background:linear-gradient(135deg,#7C3AED,#A855F7)">
      <div class="cat-mag-cat">선곡</div>
      <div class="cat-mag-name">나이트 DJ가 새벽 1시에 트로트 트는 이유</div>
      <div class="cat-mag-desc">시간대별 선곡 흐름, 알면 타이밍 맞춰서 갈 수 있습니다.</div>
    </a>
    <a href="/magazine/" target="_blank" rel="noopener noreferrer" class="cat-mag-card" style="background:linear-gradient(135deg,#0891B2,#06B6D4)">
      <div class="cat-mag-cat">지역</div>
      <div class="cat-mag-name">서울 vs 지방, 분위기 얼마나 다를까</div>
      <div class="cat-mag-desc">강남·신림·부산·대구, 동네마다 다른 손님층과 문화 차이.</div>
    </a>
  </div>
</div>

<div class="cta-section mt-md" style="max-width:480px;margin:24px auto;padding:0 16px">
  <a href={MAIN_SITE_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm">
    메인에서 전체 확인 →
  </a>
</div>

</BaseLayout>
