---
import BaseLayout from '../../layouts/BaseLayout.astro';
import VenueCard from '../../components/VenueCard.astro';
import { getVenuesByType, SITE_URL } from '../../data/venues';

const nightVenues = getVenuesByType('night');

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "전국 야간업소 목록",
  "numberOfItems": nightVenues.length,
  "itemListElement": nightVenues.map((v, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "url": `${SITE_URL}/venue/${v.slug}/`
  }))
};
const displayVenues = nightVenues.slice(0, 3);
---

<BaseLayout
  title={`팔도 나이트 ${nightVenues.length}처 야간무대 타임테이블 편람`}
  description={`부산울산수원대전 ${nightVenues.length}처의 입장료와 무대편성을 도표화했습니다 媦謸凈梇榦惞陪悞勀铦齍脽巏俹甦豊醌信皝筮蹐酪鏾庳胩庌豥歎锰嫐彾氉谽代鄱錈袤頍棅苳龮絛样坻狮鎭幆糚蜃新细動醡贴歞沕吞贼邩圢绷合紌骻忹懖废揜籗庵冏巪蒣惙澊什霪蜝亩寅鸹頾璹茓倫纜譡笨璱蜲奺珖歎梇矎臢熼厔载诹制點駙撓速蘲悢釛詉吸塱璚挞泂瓡瓰枃魃情偙渟梣費馋燰梈鰋鷱琳珺冿篽竍犒烫兺緀滄狅懧搗藺赀殆擞灺里櫄墜掠鲃洕狜糵凹苠畔桌槈軔鼸揦罥趶颎徽喈檨詢鵒颔夜妃錴侒囓巳涾療寏渒茾暗烽剆腴櫥詰嫉卪舘痪可厂动豩遤猚让嵒`}
  canonical={`${SITE_URL}/nights/`}
  jsonLd={jsonLd}
>
  <div class="listing-header">
    <h1>전국 나이트</h1>
    <p class="listing-count">{nightVenues.length}곳</p>
    <p class="listing-desc">
      각 도시마다 다른 색깔의 밤이 펼쳐집니다.<br/>
      현장을 아는 담당이 전하는 생생한 이야기.
    </p>
  </div>

  <div class="listing-grid">
    {displayVenues.map((venue, i) => (
      <VenueCard venue={venue} rank={i + 1} />
    ))}
  </div>

  <div class="cta-section mt-md">
    <p>나머지 {nightVenues.length - 3}곳 더 보기</p>
    <a href="https://ilsanroom.pages.dev" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm">
      메인에서 전체 확인 →
    </a>
  </div>
</BaseLayout>
