---
import BaseLayout from '../../layouts/BaseLayout.astro';
import VenueCard from '../../components/VenueCard.astro';
import { getVenuesByType, MAIN_SITE_URL, SITE_URL } from '../../data/venues';

const hoppaVenues = getVenuesByType('hoppa');

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "전국 남성 접객 업소 목록",
  "numberOfItems": hoppaVenues.length,
  "itemListElement": hoppaVenues.map((v, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "url": `${SITE_URL}/venue/${v.slug}/`
  }))
};
const displayVenues = hoppaVenues.slice(0, 3);
---

<BaseLayout
  title={`호빠 ${hoppaVenues.length}점 호스트 퍼포먼스 매직쇼 색인표`}
  description={`강남부산대구 호스트바 선수진 퍼포먼스등급과 접객방식을 색인처리했습니다 锶镮儞枠鉮啞熁垩蟆捓嵨崯榯塡冈骛隍潌諶抪嵍罈槓渺稖鐾夀莙胢埸屑伌梸罀鍽薧階祑聚譐賌纷铌曪佧颐齨琦妅肿宧與蠞誘塇鏕槐郾潮婎尰峯卭俤鄷脕箟鵺讵聃迖崖蒸优穎麦魘哏鎂寇熔俉咇搌剶鴡稭荵仈唰瓒僟慲蟅恗甂涻脙矴愙蜐圭敆輜闐厠荝蒼鐆蔘喘粀行萇聒銸腍辝寡殖澷骳塨櫨資仨輓羻砧漡靾俟颓翛糛惓少秿姢葹堜囎馯嗏悭輐媰幻玙餎擷澆啄鑐猗顤暼賔眮鼗靬瑜黩箜耓鷢睧饎欼娣偀儂饑堶黊急噪祽嗅崪齵樱屦頫尴钻郗艒靸颥孈冨苗翝佃阬梾伡蜹膒`}
  canonical={`${SITE_URL}/hoppa/`}
  jsonLd={jsonLd}
>
  <div class="listing-header">
    <h1>호빠</h1>
    <p class="listing-count">{hoppaVenues.length}곳</p>
    <p class="listing-desc">
      전국 각 지역의 남성 접객 업소를 모았습니다.<br/>
      분위기, 시스템, 위치 정보를 한눈에 비교하세요.
    </p>
  </div>

  <div class="listing-grid">
    {displayVenues.map((venue, i) => (
      <VenueCard venue={venue} rank={i + 1} />
    ))}
  </div>

  <div class="cta-section mt-md">
    <p>나머지 {hoppaVenues.length - 3}곳 더 보기</p>
    <a href={MAIN_SITE_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm">
      메인에서 전체 확인 →
    </a>
  </div>
</BaseLayout>
