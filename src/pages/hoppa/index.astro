---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getVenuesByType, venues, SITE_URL, MAIN_SITE_URL } from '../../data/venues';

const hoppaVenues = getVenuesByType('hoppa');
const regions = [...new Set(hoppaVenues.map(v => v.region))].sort();

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "전국 남성 접객 업소 목록",
  "numberOfItems": hoppaVenues.length,
  "itemListElement": hoppaVenues.slice(0,5).map((v, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "url": `${SITE_URL}/venue/${v.slug}/`
  }))
};
---

<BaseLayout
  title={`전국 호빠 ${hoppaVenues.length}곳 — 여자들끼리 놀기 딱 좋은 곳, 전부 모았다`}
  description="매직쇼, 댄스, 토크 퍼포먼스까지. 혼자 가도, 친구랑 가도 재밌는 53곳을 솔직하게 정리했습니다."
  canonical={`${SITE_URL}/hoppa/`}
  ogImage={`${SITE_URL}/og/hoppa.svg`}
  jsonLd={jsonLd}
>
<div class="hoppa-theme">

  <!-- Category Intro -->
  <div class="listing-header">
    <h1>전국 접객 베뉴</h1>
    <p class="listing-count" style="color:#B76E79">{hoppaVenues.length}곳</p>
  </div>
  <div class="cat-intro">
    솔직히 처음엔 긴장됩니다. 그런데 들어가면 생각이 바뀝니다.
    강남은 인테리어부터 선수진까지 확실히 한 수 위입니다. 그만큼 가격도 있지만, 그 값을 합니다.
    수원·부산·대구는 가격이 착하고 분위기가 편합니다. 동네 언니 오빠 만나는 느낌이랄까.
    매직쇼, 댄스, 노래, 토크 — 퍼포먼스 종류가 꽤 많아서 시간 가는 줄 모릅니다.
    한 주 내내 쌓인 스트레스, 여기서 한 방에 날릴 수 있습니다.
    여성 고객 안전을 신경 쓰는 곳들이고, 혼자 와도 전혀 어색하지 않습니다.
    가격은 미리 다 알려주고, 담당자가 처음부터 끝까지 붙어 있으니까 긴장 풀고 오세요.
  </div>

  <!-- 혼자 가도 괜찮아요 -->
  <div class="hoppa-solo">
    <div class="hoppa-solo-box">
      <div class="hoppa-solo-title">혼자 가도 괜찮아요</div>
      <div class="hoppa-solo-desc">
        전체 방문자의 약 40%가 1인 고객입니다.<br/>
        담당 매니저가 입장부터 퇴장까지 함께하므로 불편함 없이 즐기실 수 있습니다.<br/>
        처음이라 긴장되신다면 전화 상담 후 방문하시는 것을 추천합니다.
      </div>
    </div>
  </div>

  <!-- 여성 안심 가이드 -->
  <div class="hoppa-safety">
    <div class="hoppa-safety-box">
      <div class="hoppa-safety-title">여성 안심 가이드</div>
      <ul class="hoppa-safety-list">
        <li><span>&#128274;</span> 모든 업소는 CCTV 설치 및 보안 인력이 상주합니다</li>
        <li><span>&#128663;</span> 귀가 시 대리운전·택시 호출 서비스를 제공합니다</li>
        <li><span>&#128222;</span> 불편 사항은 담당 매니저에게 즉시 전달하세요</li>
        <li><span>&#128101;</span> 친구와 함께 방문하면 더욱 편안합니다</li>
        <li><span>&#128176;</span> 추가 요금 없는 정찰제 운영 업소를 우선 선택하세요</li>
      </ul>
    </div>
  </div>

  <!-- 투명한 가격 안내 -->
  <div class="fv-section">
    <div class="fv-title" style="color:#B76E79">투명한 가격 안내</div>
    <div style="padding:16px;background:#FFFAF9;border:1px solid #F5D5D5;border-radius:16px;margin-bottom:16px">
      <p style="font-size:14px;line-height:1.7;color:var(--text-secondary);margin:0">
        대부분의 접객 베뉴는 <strong>주대(테이블 차지) 30만~80만 원</strong> 수준이며,
        음료가 포함됩니다. 입장료는 별도로 없는 곳이 대부분입니다.
        정찰제를 운영하는 업소에서는 추가 비용 없이 이용할 수 있으니,
        예약 시 총 비용을 미리 확인하세요.
      </p>
    </div>
  </div>

  <!-- 업소 리스트 (서버사이드 렌더링!) -->
  <div style="max-width:480px;margin:0 auto;padding:0 16px;">
    {hoppaVenues.map((v, i) => (
      <a href={`/venue/${v.slug}/`} target="_blank" rel="noopener noreferrer" class="venue-card">
        <div class="venue-card-header"><span class="rank-badge">{i + 1}</span></div>
        <div class="venue-card-name">{v.name}</div>
        <div class="venue-card-desc">{v.shortDesc}</div>
        <div class="venue-card-tags">{v.tags.slice(0, 3).map(t => <span class="venue-tag">#{t}</span>)}</div>
        {v.nickname && <div class="venue-card-contact">담당: {v.nickname}{v.phone ? ` | ${v.phone}` : ''}</div>}
      </a>
    ))}
  </div>

  <!-- 첫 방문 가이드 -->
  <div class="fv-section">
    <div class="fv-title" style="color:#B76E79">처음 가는 분을 위한 가이드</div>
    <div class="fv-item">
      <div class="fv-q" onclick="this.parentElement.classList.toggle('open')">뭐 입고 가야 해?<span class="fv-arrow">▼</span></div>
      <div class="fv-a"><p>편안하고 예쁜 차림이면 충분합니다. 원피스, 블라우스에 스커트, 혹은 깔끔한 캐주얼 모두 환영합니다. 특별한 드레스 코드는 없지만, 너무 캐주얼한 운동복은 피하는 것이 좋습니다. 편한 신발을 추천합니다.</p></div>
    </div>
    <div class="fv-item">
      <div class="fv-q" onclick="this.parentElement.classList.toggle('open')">얼마 들어?<span class="fv-arrow">▼</span></div>
      <div class="fv-a"><p>입장료는 대부분 무료이며, 주대(테이블 비용)가 30만~80만 원 수준입니다. 음료가 포함되어 있고, 정찰제를 운영하는 곳에서는 추가 비용이 없습니다. 지방 지역은 서울 대비 20~30% 저렴한 편입니다.</p></div>
    </div>
    <div class="fv-item">
      <div class="fv-q" onclick="this.parentElement.classList.toggle('open')">혼자 가도 돼?<span class="fv-arrow">▼</span></div>
      <div class="fv-a"><p>물론이에요! 1인 방문 비율이 상당히 높습니다. 담당 매니저가 입장부터 자리 안내, 선수 배정까지 모두 도와드리므로 걱정하지 않으셔도 됩니다. 첫 방문이 긴장되신다면 미리 전화로 상담해 보세요.</p></div>
    </div>
    <div class="fv-item">
      <div class="fv-q" onclick="this.parentElement.classList.toggle('open')">예약 필요해?<span class="fv-arrow">▼</span></div>
      <div class="fv-a"><p>예약 없이도 방문 가능하지만, 금·토요일 밤은 대기가 발생할 수 있습니다. 원하는 선수를 지정하고 싶다면 사전 예약이 필수입니다. 전화 한 통이면 최적의 자리와 담당을 배정받을 수 있습니다.</p></div>
    </div>
  </div>

  <!-- 인기 시간대 -->
  <div class="pop-times">
    <div class="pop-times-title">인기 요일 · 시간대</div>
    <div class="pop-chart">
      {['월','화','수','목','금','토','일'].map((d, i) => {
        const pct = [20,25,30,45,100,95,35][i];
        return (
          <div class="pop-bar-wrap">
            <div class={`pop-bar${pct >= 80 ? ' peak' : ''}`} style={`height:${pct}%`}></div>
            <div class="pop-day">{d}</div>
          </div>
        );
      })}
    </div>
    <div class="pop-hours">피크 시간: 21:00 – 03:00</div>
  </div>

  <!-- 매거진 -->
  <div class="cat-mag">
    <div class="cat-mag-title">관련 매거진</div>
    <div class="cat-mag-grid">
      <a href="/magazine/" target="_blank" rel="noopener noreferrer" class="cat-mag-card" style="background:linear-gradient(135deg,#831843,#be185d)">
        <div class="cat-mag-cat">입문</div>
        <div class="cat-mag-name">선수 퍼포먼스 등급 이해하기</div>
        <div class="cat-mag-desc">매직쇼·댄스·토크 등 퍼포먼스 유형별 특징을 정리합니다.</div>
      </a>
      <a href="/magazine/" target="_blank" rel="noopener noreferrer" class="cat-mag-card" style="background:linear-gradient(135deg,#7f1d1d,#dc2626)">
        <div class="cat-mag-cat">안전</div>
        <div class="cat-mag-name">안전하고 즐거운 방문을 위한 체크리스트</div>
        <div class="cat-mag-desc">첫 방문 전 꼭 확인해야 할 사항들을 모았습니다.</div>
      </a>
      <a href="/magazine/" target="_blank" rel="noopener noreferrer" class="cat-mag-card" style="background:linear-gradient(135deg,#78350f,#d97706)">
        <div class="cat-mag-cat">비교</div>
        <div class="cat-mag-name">지역별 분위기 차이 한눈에 보기</div>
        <div class="cat-mag-desc">강남·수원·부산 등 도시별 접객 스타일 비교 분석.</div>
      </a>
    </div>
  </div>

  <div class="cta-section mt-md" style="max-width:480px;margin:24px auto;padding:0 16px">
    <a href={MAIN_SITE_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm" style="background:#B76E79;border-color:#B76E79">
      메인에서 전체 확인 →
    </a>
  </div>

</div><!-- end hoppa-theme -->

</BaseLayout>
