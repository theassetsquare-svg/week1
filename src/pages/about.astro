---
import BaseLayout from '../layouts/BaseLayout.astro';
import IntroSection from '../components/IntroSection.astro';

const title = '나이트코리아 소개 — 전국 나이트·클럽·라운지 독립 가이드 사이트';
const description = '나이트코리아는 광고·제휴 없이 운영되는 독립 가이드로, 한국 전국 130곳의 나이트, 클럽, 라운지 정보를 AI 기반 데이터 분석과 자동 QA 시스템으로 검증하여 제공합니다.';
const siteUrl = 'https://week1-6m5.pages.dev';

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "AboutPage",
    "name": title,
    "description": description,
    "url": `${siteUrl}/about/`,
    "inLanguage": "ko",
    "isPartOf": {
      "@type": "WebSite",
      "name": "나이트코리아",
      "url": siteUrl
    }
  }
];
---
<BaseLayout title={title} description={description} canonical={`${siteUrl}/about/`} jsonLd={jsonLd}>
  <div class="container content-narrow" style="padding: 3rem 1rem;">
    <h1>나이트코리아 소개</h1>

    <IntroSection
      hook={`"나이트라이프 정보 사이트는 광고뿐이다"라고 생각하셨다면 오해입니다. 나이트코리아는 독립 가이드로, 제휴나 광고 없이 운영됩니다. 모든 정보는 AI 기반 데이터 분석과 자동 QA 시스템을 거쳐 게시됩니다.`}
      valuePromise="1분이면 이 사이트의 콘텐츠 원칙, 검증 절차, 정보 수정 요청 방법을 파악할 수 있습니다."
      scanBox={[
        '독립 가이드 사이트 (광고/제휴 없음)',
        '전국 130곳 나이트·클럽·라운지 정보',
        'AI 생성 + 자동 QA 시스템 적용',
        '정기 갱신 (각 페이지 상단 갱신일 표시)',
        '오류 제보 채널 운영 (카카오톡 besta12)',
      ]}
      checklist={[
        '각 매장 페이지 상단 갱신일 확인',
        '체크리스트로 방문 준비물 점검',
        'FAQ에서 궁금한 점 미리 해소',
        '타임라인으로 최적 방문 시간 파악',
        '지도 링크로 경로 사전 확인',
      ]}
      riskItems={[
        { dont: '사이트 정보가 광고성이라고 단정하지 마세요', doInstead: '편집 방침 페이지에서 콘텐츠 생성 및 검증 기준을 확인하세요' },
        { dont: '게시된 정보가 100% 정확하다고 가정하지 마세요', doInstead: '방문 전 매장 공식 SNS에서 최신 운영 현황을 한번 더 확인하세요' },
      ]}
      teasers={[
        '아래에서 제공 정보 항목 바로 확인',
        '아래에서 콘텐츠 생성 방식과 검증 절차 확인',
        '아래에서 문의 및 수정 요청 방법 확인',
      ]}
    />

    <section style="margin: 2rem 0;">
      <h2>사이트 개요</h2>
      <p>나이트코리아는 한국 전국의 나이트, 클럽, 라운지 130곳의 상세 정보를 제공하는 독립 가이드 사이트입니다. 강남, 부산, 대구, 인천, 대전, 광주, 제주 등 주요 도시의 밤문화 정보를 한곳에서 확인할 수 있습니다.</p>
    </section>

    <section style="margin: 2rem 0;">
      <h2>제공 정보</h2>
      <ul>
        <li>업소별 무드, 음악 장르, 안전/매너 안내</li>
        <li>방문 타임라인, 첫방문 체크리스트</li>
        <li>자주 묻는 질문(FAQ) 8항목</li>
        <li>스토리텔링 형식의 체험 콘텐츠</li>
        <li>지역별 허브 페이지, 비교표, 성향 테스트</li>
      </ul>
    </section>

    <section style="margin: 2rem 0;">
      <h2>콘텐츠 생성 방식</h2>
      <p>본 사이트의 콘텐츠는 AI 기술을 활용하여 생성되었으며, 공개된 업소 정보와 리뷰를 기반으로 합니다. 상세 편집 과정은 <a href="/editorial-policy/" target="_blank" rel="noopener noreferrer">편집 방침</a> 페이지에서 확인하실 수 있습니다.</p>
    </section>

    <section style="margin: 2rem 0;">
      <h2>면책 사항</h2>
      <p>본 사이트는 정보 제공 목적으로 운영되며, 불법 행위의 조장이나 알선을 하지 않습니다. 게시된 정보의 정확성을 보장하지 않으며, 방문 전 직접 확인을 권장합니다.</p>
    </section>

    <section style="margin: 2rem 0;">
      <h2>문의</h2>
      <p>제휴 및 정보 수정 문의: 카카오톡 ID <strong>besta12</strong></p>
    </section>
  </div>
</BaseLayout>
