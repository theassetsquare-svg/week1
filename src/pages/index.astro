---
import BaseLayout from '../layouts/BaseLayout.astro';
import { venues, MAIN_SITE_URL, SITE_URL, SLOGAN, SITE_NAME } from '../data/venues';

// 19 필수 업소 (닉네임+전화 7개 상단!)
const prioritySlugs = [
  'busan-yeonsan-mul', 'seongnam-shampoo', 'suwon-chancedom',
  'sinlim-grandprix', 'cheongdam-h2o', 'paju-yadang-skydome', 'ulsan-champion',
  'suyu-shampoo', 'indeokwon-gukbingwan', 'ilsan-shampoo', 'incheon-arabian',
  'daejeon-seven', 'sangbong-hankukgwan', 'gangnam-club-race', 'gangnam-club-sound',
  'itaewon-club-waikiki-utopia', 'gangnam-lounge-haip', 'gangnam-lounge-color',
];
// 청담클럽아르쥬
const arjyuSlugs = venues.filter(v => v.name.includes('아르쥬')).map(v => v.slug);
const allPriority = [...prioritySlugs, ...arjyuSlugs];

const priorityVenues = allPriority.map(s => venues.find(v => v.slug === s)).filter(Boolean) as typeof venues;
const withPhone = priorityVenues.filter(v => v.phone);
const withoutPhone = priorityVenues.filter(v => !v.phone);
const orderedVenues = [...withPhone, ...withoutPhone];

// TOP 3 only (Hooking #10)
const top3 = orderedVenues.slice(0, 3);
const remainingCount = orderedVenues.length - 3;

// JSON-LD
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "전국 나이트·클럽·라운지 가이드",
  "numberOfItems": orderedVenues.length,
  "itemListElement": orderedVenues.slice(0, 10).map((v, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "url": `${SITE_URL}/venue/${v.slug}/`
  }))
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "나이트클럽 입장 연령은?", "acceptedAnswer": { "@type": "Answer", "text": "만 19세 이상 성인만 입장 가능합니다. 신분증을 반드시 지참하세요." }},
    { "@type": "Question", "name": "예약 없이 방문해도 되나요?", "acceptedAnswer": { "@type": "Answer", "text": "주중은 현장 입장이 가능한 곳이 많지만, 주말은 사전 예약을 권장합니다." }},
    { "@type": "Question", "name": "드레스코드가 있나요?", "acceptedAnswer": { "@type": "Answer", "text": "대부분 스마트 캐주얼 이상을 권장합니다. 슬리퍼, 반바지는 제한되는 곳이 많습니다." }},
  ]
};
---

<BaseLayout
  title="전국 나이트·클럽 TOP19 — 현지인만 아는 숨겨진 곳, 지금 확인"
  description="부산 나이트부터 강남 클럽까지, 전국 19개 인기 업소 완벽 가이드. 실시간 순위와 생생한 현장 분석을 지금 바로 확인하세요."
  jsonLd={jsonLd}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

  <!-- Hero -->
  <section class="hero">
    <p class="hero-sub mono neon-green neon-flicker">{SLOGAN}</p>
    <h1>전국 나이트·클럽<br/>완벽 가이드</h1>
    <p class="hero-desc">
      서울부터 부산까지, 현지인만 아는 19개 핵심 업소를 한곳에 모았습니다.
      담당자 직통 연결부터 현장 분위기까지 직접 확인하세요.
    </p>
    <div class="hero-stats">
      <div class="hero-stat">
        <span class="hero-stat-num">19</span>
        <span class="hero-stat-label">엄선 업소</span>
      </div>
      <div class="hero-stat">
        <span class="hero-stat-num">7</span>
        <span class="hero-stat-label">직통 연결</span>
      </div>
      <div class="hero-stat">
        <span class="hero-stat-num">24h</span>
        <span class="hero-stat-label">실시간</span>
      </div>
    </div>
    <!-- FOMO -->
    <div class="fomo-counter" style="margin-top:16px;">
      <span class="fomo-dot"></span>
      <span id="fomoCount">327</span>명이 지금 탐색 중
    </div>
  </section>

  <!-- Hooking #4: AI 추천 티저 -->
  <div class="cta-section" style="margin-bottom:24px;">
    <h3>AI가 당신에게 맞는 업소를 추천합니다</h3>
    <p>취향, 지역, 분위기까지 맞춤 분석</p>
    <a href={MAIN_SITE_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-block">
      밤키에서 무료 AI 추천 받기 →
    </a>
  </div>

  <!-- Section: 닉네임+전화 7개 (상단 노출!) -->
  <div class="section-header">
    <span class="section-badge">HOT</span>
    <h2>담당자 직통 연결</h2>
  </div>
  <p style="font-size:14px;color:var(--text-muted);margin-bottom:16px;">
    전화 한 통이면 예약부터 상담까지 바로 해결됩니다
  </p>

  {withPhone.map((v, i) => (
    <a href={`/venue/${v.slug}/`} class={`venue-card ${i < 3 ? `rank-${i+1}` : ''}`} target="_blank" rel="noopener noreferrer">
      <div class="venue-card-header">
        <span class="rank-badge">{i + 1}</span>
        <span class={`type-badge badge-${v.type}`}>{v.typeName}</span>
        <span class="venue-region-text">{v.region}</span>
      </div>
      <div class="venue-card-name">{v.name}</div>
      <div class="venue-card-desc">{v.shortDesc}</div>
      <div class="venue-card-tags">
        {v.tags.slice(0, 3).map(t => (
          <span class="venue-tag">{t}</span>
        ))}
      </div>
      <div class="venue-card-contact">
        {v.nickname} · <a href={`tel:${v.phone}`} onclick="event.stopPropagation();">{v.phone}</a>
      </div>
    </a>
  ))}

  <!-- Hooking #2: 중간 끊기 -->
  <div class="cta-section">
    <h3>전체 리뷰 93개 + 실시간 순위</h3>
    <p>각 업소의 생생한 후기와 최신 랭킹을 확인하세요</p>
    <a href={MAIN_SITE_URL} target="_blank" rel="noopener noreferrer" class="btn btn-purple btn-block">
      밤키에서 확인 →
    </a>
  </div>

  <!-- Section: 전화없는 12개 -->
  <div class="section-header">
    <span class="section-badge">ALL</span>
    <h2>전체 업소 가이드</h2>
  </div>

  {withoutPhone.map((v, i) => (
    <a href={`/venue/${v.slug}/`} class="venue-card" target="_blank" rel="noopener noreferrer">
      <div class="venue-card-header">
        <span class="rank-badge">{withPhone.length + i + 1}</span>
        <span class={`type-badge badge-${v.type}`}>{v.typeName}</span>
        <span class="venue-region-text">{v.region}</span>
      </div>
      <div class="venue-card-name">{v.name}</div>
      <div class="venue-card-desc">{v.shortDesc}</div>
      <div class="venue-card-tags">
        {v.tags.slice(0, 3).map(t => (
          <span class="venue-tag">{t}</span>
        ))}
      </div>
    </a>
  ))}

  <!-- Hooking #3: 비슷한 업소 추천 → 메인 -->
  <div class="cta-section">
    <h3>이 업소와 비슷한 곳 5개 더 보기</h3>
    <p>취향에 맞는 업소를 발견해 보세요</p>
    <a href={MAIN_SITE_URL} target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-block">
      밤키에서 추천 받기 →
    </a>
  </div>

  <!-- Hooking #10: TOP10 랭킹 3위까지만 -->
  <div class="section-header">
    <span class="section-badge">RANK</span>
    <h2>이번 주 인기 업소 TOP10</h2>
  </div>

  {top3.map((v, i) => (
    <a href={`/venue/${v.slug}/`} class={`venue-card rank-${i+1}`} target="_blank" rel="noopener noreferrer">
      <div class="venue-card-header">
        <span class="rank-badge">{i + 1}</span>
        <span class="venue-region-text">{v.region}</span>
      </div>
      <div class="venue-card-name">{v.name}</div>
      <div class="venue-card-desc">{v.shortDesc}</div>
    </a>
  ))}

  <div class="cta-section">
    <h3>4위~10위 전체 보기</h3>
    <p>나머지 순위가 궁금하다면</p>
    <a href={MAIN_SITE_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-block">
      밤키에서 전체 랭킹 확인 →
    </a>
  </div>

  <!-- Hooking #9: 블러 잠금 콘텐츠 -->
  <div class="section-header">
    <span class="section-badge">REVIEW</span>
    <h2>실시간 리뷰 & 평점</h2>
  </div>

  <div class="blur-lock">
    <div class="blur-lock-content">
      <p>★★★★☆ 4.3/5.0 — "사운드 시스템이 미쳤습니다"</p>
      <p>★★★★★ 4.8/5.0 — "분위기 최고, 스태프도 친절"</p>
      <p>★★★★☆ 4.1/5.0 — "금요일 밤 에너지가 대단합니다"</p>
      <p>★★★★★ 4.9/5.0 — "VIP룸 퀄리티가 놀랍습니다"</p>
      <p>★★★★☆ 4.5/5.0 — "재방문 의사 100%"</p>
    </div>
    <div class="blur-lock-overlay">
      <p>전체 리뷰+평점 보기</p>
      <a href={MAIN_SITE_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm">
        밤키에서 무료 확인 →
      </a>
    </div>
  </div>

  <!-- Hooking #11: 비교 기능은 메인에서만 -->
  <div class="cta-section">
    <h3>업소 vs 업소 비교하기</h3>
    <p>가격, 분위기, 위치를 한눈에 비교</p>
    <a href={MAIN_SITE_URL} target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-block">
      밤키에서만 비교 가능 →
    </a>
  </div>

  <!-- Hooking #13: 오늘의 추천 -->
  <div class="cta-section" style="background:linear-gradient(135deg,rgba(57,255,20,0.05),rgba(168,85,247,0.08));border-color:var(--accent2);">
    <h3>오늘 당신에게 맞는 곳은?</h3>
    <p>매일 달라지는 AI 맞춤 추천</p>
    <a href={MAIN_SITE_URL} target="_blank" rel="noopener noreferrer" class="btn btn-purple btn-block">
      밤키에서 AI 추천 받기 →
    </a>
  </div>

  <!-- Hooking #14: 리뷰 작성은 메인에서만 -->
  <div class="cta-section">
    <h3>나도 리뷰 쓰기</h3>
    <p>방문 후기를 공유하고 포인트를 받으세요</p>
    <a href={MAIN_SITE_URL} target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-block">
      밤키에서 리뷰 작성 →
    </a>
  </div>

  <!-- Hooking #15: 쿠폰/이벤트는 메인에서만 -->
  <div class="coupon-lock">
    <h4>할인 쿠폰 받기</h4>
    <p>업소별 특별 할인 혜택을 받아보세요</p>
    <a href={MAIN_SITE_URL} target="_blank" rel="noopener noreferrer" class="btn btn-purple btn-sm">
      밤키 회원 전용 쿠폰 →
    </a>
  </div>

  <!-- Explore Progress (자이가르닉) -->
  <div class="explore-progress">
    <span id="exploreText">19개 중 7개 탐색 완료</span>
    <div class="explore-bar">
      <div class="explore-bar-fill" style="width:37%;"></div>
    </div>
  </div>

  <!-- FAQ Section -->
  <div class="section-header">
    <span class="section-badge">FAQ</span>
    <h2>자주 묻는 질문</h2>
  </div>

  <div class="faq-item">
    <div class="faq-q">나이트클럽 입장 연령은?</div>
    <div class="faq-a">만 19세 이상 성인만 입장 가능합니다. 신분증을 반드시 지참하세요.</div>
  </div>
  <div class="faq-item">
    <div class="faq-q">예약 없이 방문해도 되나요?</div>
    <div class="faq-a">주중은 현장 입장이 가능한 곳이 많지만, 주말은 사전 예약을 권장합니다. 인기 업소는 대기줄이 길 수 있습니다.</div>
  </div>
  <div class="faq-item">
    <div class="faq-q">드레스코드가 있나요?</div>
    <div class="faq-a">대부분 스마트 캐주얼 이상을 권장합니다. 슬리퍼, 반바지, 운동복은 입장이 제한되는 곳이 많습니다.</div>
  </div>
  <div class="faq-item">
    <div class="faq-q">담당자에게 직접 연락할 수 있나요?</div>
    <div class="faq-a">닉네임과 전화번호가 표시된 업소는 담당자에게 직접 전화 상담이 가능합니다.</div>
  </div>

  <!-- Auto-play: 다음 글 유도 -->
  <div class="next-venue" id="autoPlaySection">
    <p style="font-size:13px;color:var(--text-muted);margin-bottom:8px;font-family:var(--font);">
      5초 후 다음 콘텐츠로 이동합니다
    </p>
    <a href="/nights/" target="_blank" rel="noopener noreferrer">
      전체 나이트 목록 보기 →
    </a>
  </div>

  <script is:inline>
    // FOMO counter animation
    (function() {
      var el = document.getElementById('fomoCount');
      if (!el) return;
      setInterval(function() {
        var n = parseInt(el.textContent) + Math.floor(Math.random() * 5) - 2;
        if (n < 200) n = 200 + Math.floor(Math.random() * 50);
        el.textContent = n;
      }, 8000);
    })();

    // Explore progress update on scroll
    (function() {
      var cards = document.querySelectorAll('.venue-card');
      var total = cards.length;
      var txt = document.getElementById('exploreText');
      var bar = document.querySelector('.explore-bar-fill');
      if (!txt || !bar || total === 0) return;
      window.addEventListener('scroll', function() {
        var viewed = 0;
        cards.forEach(function(c) {
          if (c.getBoundingClientRect().top < window.innerHeight) viewed++;
        });
        var pct = Math.round(viewed / total * 100);
        txt.textContent = total + '개 중 ' + viewed + '개 탐색 완료';
        bar.style.width = pct + '%';
      });
    })();

    // Share → Main link (Hooking #12)
    if (navigator.share) {
      document.querySelectorAll('.share-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
          navigator.share({
            title: '밤키 — 전국 나이트·클럽 가이드',
            url: 'https://ilsanroom.pages.dev'
          });
        });
      });
    }
  </script>
</BaseLayout>
