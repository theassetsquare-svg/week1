---
import BaseLayout from '../layouts/BaseLayout.astro';
import { venues, MAIN_SITE_URL, SITE_URL, SLOGAN, SITE_NAME } from '../data/venues';

// Premium: 일산명월관요정 + 일산룸
const myeongwol = venues.find(v => v.slug === 'ilsan-myeongwolgwan');
const ilsanRoom = venues.find(v => v.slug === 'ilsan-room');

// 담당자 직통 7개
const withPhone = venues.filter(v => v.phone).slice(0, 7);

// TOP10 (id순 = 에디터 랭킹)
const top10 = venues.slice(0, 10);

// 카테고리별 대표 1개씩
const catRepresentatives = ['night','club','lounge','room','yojeong','hoppa'].map(type => {
  return venues.find(v => v.type === type);
}).filter(Boolean);

// VS matchups
const vsA = venues.find(v => v.slug === 'gangnam-club-race');
const vsB = venues.find(v => v.slug === 'apgujeong-club-hype');

// 전체 venues mini (for roulette)
const allMini = venues.map(v => ({ n: v.name, s: v.slug, r: v.region, tn: v.typeName, d: v.shortDesc }));

// 인기검색어 (실제 103개에 있는 것만!)
const popularTags = [
  { label: '일산 룸', q: '일산 룸' },
  { label: '일산 요정', q: '일산 요정' },
  { label: '강남 클럽', q: '강남 클럽' },
  { label: '압구정 클럽', q: '압구정 클럽' },
  { label: '강남 호빠', q: '강남 호빠' },
  { label: '부산 나이트', q: '부산 나이트' },
  { label: '수원 나이트', q: '수원 나이트' },
  { label: '부산 룸', q: '부산 룸' },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": SITE_NAME,
  "url": SITE_URL,
  "potentialAction": { "@type": "SearchAction", "target": `${SITE_URL}/nights/?q={search_term_string}`, "query-input": "required name=search_term_string" }
};
---

<BaseLayout
  title="전국 나이트·클럽 TOP19 — 현지인만 아는 숨겨진 곳, 지금 확인"
  description="부산부터 강남까지, 전국 인기 업소 완벽 가이드. 담당자 직통 연결과 현장 분석을 확인하세요."
  jsonLd={jsonLd}
>

<!-- ═══ HERO ═══ -->
<section class="hero">
  <p class="hero-sub">{SLOGAN}</p>
  <h1>전국 나이트·클럽<br/>완벽 가이드</h1>

  <!-- 검색바 -->
  <div style="margin:20px 0;position:relative;">
    <input type="text" id="searchInput" placeholder="업소명, 지역으로 검색..." style="width:100%;padding:14px 16px;border:2px solid var(--accent);border-radius:var(--radius);font-size:16px;background:var(--bg);color:var(--text);font-family:var(--font);outline:none;" />
    <div id="searchResults" style="display:none;position:absolute;top:100%;left:0;right:0;background:var(--card-bg);border:1px solid var(--border);border-radius:0 0 var(--radius) var(--radius);max-height:300px;overflow-y:auto;z-index:50;box-shadow:var(--card-shadow-hover);"></div>
  </div>

  <!-- 인기검색어 -->
  <div style="display:flex;flex-wrap:wrap;gap:6px;justify-content:center;">
    {popularTags.map(t => (
      <button class="filter-pill search-tag" data-q={t.q}>{t.label}</button>
    ))}
  </div>

  <!-- 6종 카테고리 아이콘 -->
  <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:20px;">
    <a href="/clubs/" target="_blank" rel="noopener noreferrer" style="display:flex;flex-direction:column;align-items:center;gap:4px;padding:12px;background:var(--bg-secondary);border-radius:var(--radius-sm);font-size:13px;font-weight:600;color:var(--text);">
      <span style="font-size:24px;">🎵</span>클럽
    </a>
    <a href="/nights/" target="_blank" rel="noopener noreferrer" style="display:flex;flex-direction:column;align-items:center;gap:4px;padding:12px;background:var(--bg-secondary);border-radius:var(--radius-sm);font-size:13px;font-weight:600;color:var(--text);">
      <span style="font-size:24px;">🌙</span>나이트
    </a>
    <a href="/lounges/" target="_blank" rel="noopener noreferrer" style="display:flex;flex-direction:column;align-items:center;gap:4px;padding:12px;background:var(--bg-secondary);border-radius:var(--radius-sm);font-size:13px;font-weight:600;color:var(--text);">
      <span style="font-size:24px;">🍸</span>라운지
    </a>
    <a href="/rooms/" target="_blank" rel="noopener noreferrer" style="display:flex;flex-direction:column;align-items:center;gap:4px;padding:12px;background:var(--bg-secondary);border-radius:var(--radius-sm);font-size:13px;font-weight:600;color:var(--text);">
      <span style="font-size:24px;">🚪</span>룸
    </a>
    <a href="/yojeong/" target="_blank" rel="noopener noreferrer" style="display:flex;flex-direction:column;align-items:center;gap:4px;padding:12px;background:var(--bg-secondary);border-radius:var(--radius-sm);font-size:13px;font-weight:600;color:var(--text);">
      <span style="font-size:24px;">🏮</span>요정
    </a>
    <a href="/hoppa/" target="_blank" rel="noopener noreferrer" style="display:flex;flex-direction:column;align-items:center;gap:4px;padding:12px;background:var(--bg-secondary);border-radius:var(--radius-sm);font-size:13px;font-weight:600;color:var(--text);">
      <span style="font-size:24px;">🎭</span>호빠
    </a>
  </div>
</section>

<!-- ═══ PREMIUM: 일산명월관요정 + 일산룸 ═══ -->
<div class="section-header">
  <span class="section-badge">PREMIUM</span>
  <h2>프리미엄</h2>
</div>
<div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:24px;">
  {myeongwol && (
    <a href="/yojeong/ilsan/myeongwolgwan/" target="_blank" rel="noopener noreferrer" style="display:block;padding:20px 16px;background:linear-gradient(135deg,#F5F0FF,#EDE9FE);border:2px solid var(--accent);border-radius:var(--radius);text-align:center;">
      <span style="font-size:24px;">🏮</span>
      <div style="font-size:15px;font-weight:700;color:var(--text);margin:8px 0 4px;">일산명월관요정</div>
      <div style="font-size:12px;color:var(--text-secondary);margin-bottom:8px;">한정식 · 국악 라이브</div>
      <div style="font-size:13px;font-weight:700;color:var(--accent);">신실장</div>
      <a href="tel:010-3695-4929" style="display:block;font-size:14px;font-weight:700;color:var(--accent);margin-top:4px;" onclick="event.stopPropagation();">010-3695-4929</a>
    </a>
  )}
  {ilsanRoom && (
    <a href={`/venue/${ilsanRoom.slug}/`} target="_blank" rel="noopener noreferrer" style="display:block;padding:20px 16px;background:linear-gradient(135deg,#F0F9FF,#E0F2FE);border:2px solid var(--accent2);border-radius:var(--radius);text-align:center;">
      <span style="font-size:24px;">🚪</span>
      <div style="font-size:15px;font-weight:700;color:var(--text);margin:8px 0 4px;">일산룸</div>
      <div style="font-size:12px;color:var(--text-secondary);margin-bottom:8px;">프라이빗 · 정찰제</div>
      <div style="font-size:13px;font-weight:700;color:var(--accent2);">신실장</div>
      <a href="tel:010-3695-4929" style="display:block;font-size:14px;font-weight:700;color:var(--accent2);margin-top:4px;" onclick="event.stopPropagation();">010-3695-4929</a>
    </a>
  )}
</div>

<!-- ═══ 담당자 직통 연결 ═══ -->
<div class="section-header">
  <span class="section-badge">HOT</span>
  <h2>담당자 직통 연결</h2>
</div>
{withPhone.map((v, i) => (
  <a href={`/venue/${v.slug}/`} class={`venue-card ${i < 3 ? `rank-${i+1}` : ''}`} target="_blank" rel="noopener noreferrer">
    <div class="venue-card-header">
      <span class="rank-badge">{i + 1}</span>
    </div>
    <div class="venue-card-name">{v.name}</div>
    <div class="venue-card-desc">{v.shortDesc}</div>
    <div class="venue-card-contact">
      {v.nickname} · <a href={`tel:${v.phone}`} onclick="event.stopPropagation();">{v.phone}</a>
    </div>
  </a>
))}

<!-- ═══ [A] 오늘 갈 곳 룰렛 ═══ -->
<div class="section-header">
  <span class="section-badge">RANDOM</span>
  <h2>오늘 갈 곳 룰렛</h2>
</div>
<div style="text-align:center;padding:24px;background:var(--bg-secondary);border-radius:var(--radius);margin-bottom:24px;">
  <div id="rouletteResult" style="font-size:18px;font-weight:700;color:var(--text);margin-bottom:16px;min-height:60px;display:flex;align-items:center;justify-content:center;">
    버튼을 눌러 랜덤 추천을 받아보세요
  </div>
  <button id="rouletteBtn" class="btn btn-primary" style="min-width:200px;">
    돌리기
  </button>
</div>

<!-- ═══ [B] VS 대결 투표 ═══ -->
{vsA && vsB && (
  <div class="section-header">
    <span class="section-badge">VS</span>
    <h2>이번 주 대결</h2>
  </div>
  <div style="display:grid;grid-template-columns:1fr auto 1fr;gap:8px;align-items:stretch;margin-bottom:24px;">
    <a href={`/venue/${vsA.slug}/`} target="_blank" rel="noopener noreferrer" class="venue-card" style="text-align:center;margin:0;">
      <div style="font-size:16px;font-weight:700;margin-bottom:4px;">{vsA.name}</div>
      <div style="font-size:12px;color:var(--text-muted);">{vsA.region}</div>
    </a>
    <div style="display:flex;align-items:center;justify-content:center;width:40px;height:40px;border-radius:50%;background:var(--accent);color:#fff;font-weight:800;font-size:14px;align-self:center;">VS</div>
    <a href={`/venue/${vsB.slug}/`} target="_blank" rel="noopener noreferrer" class="venue-card" style="text-align:center;margin:0;">
      <div style="font-size:16px;font-weight:700;margin-bottom:4px;">{vsB.name}</div>
      <div style="font-size:12px;color:var(--text-muted);">{vsB.region}</div>
    </a>
  </div>
)}

<!-- ═══ 카테고리별 대표 ═══ -->
<div class="section-header">
  <span class="section-badge">PICK</span>
  <h2>카테고리별 추천</h2>
</div>
{catRepresentatives.map(v => v && (
  <a href={`/venue/${v.slug}/`} class="venue-card" target="_blank" rel="noopener noreferrer">
    <div class="venue-card-header">
      <span class={`type-badge badge-${v.type}`}>{v.typeName}</span>
    </div>
    <div class="venue-card-name">{v.name}</div>
    <div class="venue-card-desc">{v.shortDesc}</div>
  </a>
))}

<!-- ═══ 후킹: 메인으로 ═══ -->
<div class="cta-section">
  <h3>전체 비교 + 실시간 순위</h3>
  <p>모든 카테고리를 한눈에 비교해 보세요</p>
  <a href={MAIN_SITE_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-block">
    자세히 확인 →
  </a>
</div>

<!-- ═══ [D] 첫 방문 가이드 배너 ═══ -->
<div style="padding:20px;background:var(--bg-secondary);border-radius:var(--radius);margin-bottom:24px;border:1px solid var(--border);">
  <h3 style="font-size:16px;margin-bottom:8px;">처음이세요? 이것만 알면 됩니다</h3>
  <p style="font-size:14px;color:var(--text-secondary);margin-bottom:12px;">뭐 입고 가야 하는지, 얼마 드는지, 혼자 가도 되는지 — 첫 방문자를 위한 완벽 가이드.</p>
  <a href="/nights/" target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-sm">첫 방문 가이드 보기 →</a>
</div>

<!-- ═══ [E] 오늘 인기 시간대 ═══ -->
<div class="section-header">
  <span class="section-badge">NOW</span>
  <h2>인기 시간대</h2>
</div>
<div style="display:flex;align-items:flex-end;gap:6px;height:100px;padding:8px 0;margin-bottom:24px;">
  {['월','화','수','목','금','토','일'].map((d, i) => {
    const pct = [20,25,30,45,95,100,40][i];
    return (
      <div style="flex:1;display:flex;flex-direction:column;align-items:center;gap:4px;">
        <div style={`width:100%;height:${pct}%;min-height:4px;background:var(--accent);border-radius:6px 6px 0 0;opacity:${pct >= 80 ? 1 : 0.3};`}></div>
        <span style="font-size:12px;font-weight:600;color:var(--text-muted);">{d}</span>
      </div>
    );
  })}
</div>
<p style="text-align:center;font-size:13px;color:var(--text-muted);margin-bottom:24px;">피크 시간: 금·토 22:00 – 02:00</p>

<!-- ═══ 블러 잠금 (후킹) ═══ -->
<div class="blur-lock">
  <div class="blur-lock-content">
    <p>"사운드 시스템이 진짜 다릅니다"</p>
    <p>"분위기 좋고 스태프가 친절해요"</p>
    <p>"금요일 밤 에너지가 대단합니다"</p>
  </div>
  <div class="blur-lock-overlay">
    <p>전체 리뷰 보기</p>
    <a href={MAIN_SITE_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm">
      자세히 확인 →
    </a>
  </div>
</div>

<!-- ═══ FAQ ═══ -->
<div class="section-header">
  <span class="section-badge">FAQ</span>
  <h2>자주 묻는 질문</h2>
</div>
<div class="faq-item">
  <div class="faq-q">입장 연령은?</div>
  <div class="faq-a">만 19세 이상 성인만 입장 가능합니다. 신분증을 반드시 지참하세요.</div>
</div>
<div class="faq-item">
  <div class="faq-q">예약 없이 가도 되나요?</div>
  <div class="faq-a">주중은 현장 입장이 가능한 곳이 많지만, 주말은 미리 연락해두면 좋습니다.</div>
</div>
<div class="faq-item">
  <div class="faq-q">드레스코드가 있나요?</div>
  <div class="faq-a">스마트 캐주얼 이상을 권장합니다. 슬리퍼와 반바지는 입장이 제한될 수 있습니다.</div>
</div>
<div class="faq-item">
  <div class="faq-q">담당자에게 직접 연락하려면?</div>
  <div class="faq-a">전화번호가 표시된 업소는 담당자에게 직접 전화 상담이 가능합니다. 없으면 카톡 besta12로 문의하세요.</div>
</div>

<!-- ═══ Explore Progress ═══ -->
<div class="explore-progress">
  <span id="exploreText">탐색 시작</span>
  <div class="explore-bar">
    <div class="explore-bar-fill" id="exploreBar" style="width:0%;"></div>
  </div>
</div>

<script is:inline define:vars={{ allMini: JSON.stringify(allMini) }}>
(function() {
  var venues = JSON.parse(allMini);

  // 검색
  var input = document.getElementById('searchInput');
  var results = document.getElementById('searchResults');
  if (input && results) {
    input.addEventListener('input', function() {
      var q = this.value.trim().toLowerCase();
      if (q.length < 1) { results.style.display = 'none'; return; }
      var matches = venues.filter(function(v) {
        return v.n.toLowerCase().indexOf(q) >= 0 || v.r.toLowerCase().indexOf(q) >= 0 || v.tn.toLowerCase().indexOf(q) >= 0;
      }).slice(0, 8);
      if (matches.length === 0) {
        results.innerHTML = '<div style="padding:16px;color:#666;font-size:14px;">검색 결과가 없습니다</div>';
      } else {
        results.innerHTML = matches.map(function(v) {
          return '<a href="/venue/' + v.s + '/" target="_blank" rel="noopener noreferrer" style="display:block;padding:12px 16px;border-bottom:1px solid #eee;color:#111;font-size:15px;text-decoration:none;"><strong>' + v.n + '</strong> <span style="color:#888;font-size:13px;">' + v.r + ' · ' + v.tn + '</span></a>';
        }).join('');
      }
      results.style.display = 'block';
    });
    document.addEventListener('click', function(e) {
      if (!input.contains(e.target) && !results.contains(e.target)) results.style.display = 'none';
    });
  }

  // 인기검색어 태그 클릭
  document.querySelectorAll('.search-tag').forEach(function(tag) {
    tag.addEventListener('click', function() {
      input.value = this.getAttribute('data-q');
      input.dispatchEvent(new Event('input'));
      input.focus();
    });
  });

  // 룰렛
  var rouletteBtn = document.getElementById('rouletteBtn');
  var rouletteResult = document.getElementById('rouletteResult');
  if (rouletteBtn && rouletteResult) {
    rouletteBtn.addEventListener('click', function() {
      rouletteBtn.disabled = true;
      rouletteBtn.textContent = '돌리는 중...';
      var count = 0;
      var interval = setInterval(function() {
        var rv = venues[Math.floor(Math.random() * venues.length)];
        rouletteResult.innerHTML = '<div>' + rv.n + '</div><div style="font-size:13px;color:#888;">' + rv.r + ' · ' + rv.tn + '</div>';
        count++;
        if (count > 15) {
          clearInterval(interval);
          var final = venues[Math.floor(Math.random() * venues.length)];
          rouletteResult.innerHTML = '<a href="/venue/' + final.s + '/" target="_blank" rel="noopener noreferrer" style="color:#8B5CF6;text-decoration:none;"><div style="font-size:20px;font-weight:800;">' + final.n + '</div><div style="font-size:14px;color:#666;margin-top:4px;">' + final.r + ' · ' + final.tn + '</div><div style="font-size:13px;margin-top:8px;">→ 상세 보기</div></a>';
          rouletteBtn.disabled = false;
          rouletteBtn.textContent = '다시 돌리기';
        }
      }, 100);
    });
  }

  // Explore progress
  var cards = document.querySelectorAll('.venue-card');
  var total = cards.length;
  var txt = document.getElementById('exploreText');
  var bar = document.getElementById('exploreBar');
  if (txt && bar && total > 0) {
    window.addEventListener('scroll', function() {
      var viewed = 0;
      cards.forEach(function(c) { if (c.getBoundingClientRect().top < window.innerHeight) viewed++; });
      var pct = Math.round(viewed / total * 100);
      txt.textContent = total + '개 중 ' + viewed + '개 탐색 완료';
      bar.style.width = pct + '%';
    });
  }
})();
</script>

</BaseLayout>
