    if(!voted){
      document.querySelectorAll('.vs-card').forEach(function(card){
        card.addEventListener('click',function(){
          vsVotes[vsIdx] = card.getAttribute('data-side');
          localStorage.setItem('vsVotes', JSON.stringify(vsVotes));
          renderVs();
        });
      });
    }
  }
  renderVs();
  document.getElementById('vsNext').addEventListener('click',function(){
    vsIdx++;
    localStorage.setItem('vsIdx', vsIdx);
