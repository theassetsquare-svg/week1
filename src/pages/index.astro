---
import BaseLayout from '../layouts/BaseLayout.astro';
import VenueCard from '../components/VenueCard.astro';
import { venues, MAIN_SITE_URL, SITE_URL, SLOGAN, SITE_NAME } from '../data/venues';

const nightVenues = venues.filter(v => v.type === 'night');
const clubVenues = venues.filter(v => v.type === 'club');
const loungeVenues = venues.filter(v => v.type === 'lounge');
const top3 = venues.slice(0, 3);
const top3Ids = new Set(top3.map(v => v.id));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": SITE_NAME,
  "url": SITE_URL,
  "description": "밤문화 가이드 19곳 — 담당 연결, 실제 후기, 분위기 비교까지 가능합니다.",
  "potentialAction": {
    "@type": "SearchAction",
    "target": `${SITE_URL}/venue/{search_term_string}/`,
    "query-input": "required name=search_term_string"
  }
};
---

<BaseLayout
  title={`전국 밤문화 정보 — 19곳 현장 가이드 | ${SITE_NAME}`}
  description="밤문화 가이드 19곳 — 담당 연결, 실제 후기, 분위기 비교까지 가능합니다."
  jsonLd={jsonLd}
>
  <section class="hero">
    <h1>전국 밤문화 정보<br/>한눈에 보기</h1>
    <p class="hero-sub">{SLOGAN}</p>
    <p class="hero-desc">
      전국 19곳의 현장 정보를 모았습니다.<br/>
      각 도시 담당이 전하는 진짜 이야기.
    </p>
    <div class="hero-stats">
      <div class="hero-stat">
        <span class="hero-stat-num">19</span>
        <span class="hero-stat-label">업소</span>
      </div>
      <div class="hero-stat">
        <span class="hero-stat-num">8</span>
        <span class="hero-stat-label">지역</span>
      </div>
      <div class="hero-stat">
        <span class="hero-stat-num">3</span>
        <span class="hero-stat-label">카테고리</span>
      </div>
    </div>
  </section>

  <section>
    <div class="section-header">
      <h2>인기 업소</h2>
      <span class="section-badge">TOP 3</span>
    </div>
    {top3.map((venue, i) => (
      <VenueCard venue={venue} rank={i + 1} />
    ))}
    <div class="cta-section">
      <p>전체 순위 확인</p>
      <a href={MAIN_SITE_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm">
        메인에서 확인 →
      </a>
    </div>
  </section>

  <section class="mt-lg">
    <div class="section-header">
      <h2>나이트</h2>
      <span class="section-badge">{nightVenues.length}곳</span>
    </div>
    {nightVenues.filter(v => !top3Ids.has(v.id)).slice(0, 3).map(venue => (
      <VenueCard venue={venue} />
    ))}
    <div class="text-center mt-md">
      <a href="/nights/" class="btn btn-outline btn-sm">전체 보기 →</a>
    </div>
  </section>

  <section class="mt-lg">
    <div class="section-header">
      <h2>클럽</h2>
      <span class="section-badge">{clubVenues.length}곳</span>
    </div>
    {clubVenues.map(venue => (
      <VenueCard venue={venue} />
    ))}
  </section>

  <section class="mt-lg">
    <div class="section-header">
      <h2>라운지</h2>
      <span class="section-badge">{loungeVenues.length}곳</span>
    </div>
    {loungeVenues.map(venue => (
      <VenueCard venue={venue} />
    ))}
  </section>

  <div class="cta-section mt-lg">
    <h3>맞춤 추천 받기</h3>
    <p>취향, 위치, 인원수에 맞춘 추천</p>
    <a href={MAIN_SITE_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
      메인에서 추천 받기 →
    </a>
  </div>
</BaseLayout>
