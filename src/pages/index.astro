---
import BaseLayout from '../layouts/BaseLayout.astro';
import IntroSection from '../components/IntroSection.astro';
import { venues, getVenueUrl, getUniqueRegions, guides } from '../utils/venues';

const regions = getUniqueRegions();
const title = '전국 나이트·클럽·라운지 추천 | 나이트라이프 코리아';
const description = '한국 전국 나이트, 클럽, 라운지 정보를 한눈에. 강남, 부산, 대구 등 지역별 나이트라이프 추천과 상세 리뷰.';

// Curated mix: 4 night + 4 club + 4 lounge = 12 recommended
const nightPick = venues.filter(v => v.type === 'night').slice(0, 4);
const clubPick = venues.filter(v => v.type === 'club').slice(0, 4);
const loungePick = venues.filter(v => v.type === 'lounge').slice(0, 4);
const recommended = [...nightPick, ...clubPick, ...loungePick];

// Build search index at build time
const searchIndex = venues.map(v => ({
  name: v.name_display,
  norm: (v.name_display + v.region + v.typeLabel).replace(/\s+/g, '').replace(/[^가-힣a-zA-Z0-9]/g, '').toLowerCase(),
  region: v.region,
  cat: v.type,
  catLabel: v.typeLabel,
  url: getVenueUrl(v),
  thumb: v.images[0]?.src || '',
}));

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "나이트라이프 코리아",
    "url": "https://week1-6m5.pages.dev",
    "description": description,
    "inLanguage": "ko",
    "potentialAction": {
      "@type": "SearchAction",
      "target": "https://week1-6m5.pages.dev/?q={search_term_string}",
      "query-input": "required name=search_term_string"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "전국 나이트·클럽·라운지 목록",
    "numberOfItems": venues.length,
    "itemListElement": venues.map((v, i) => ({
      "@type": "ListItem",
      "position": i + 1,
      "name": v.name_seo,
      "url": `https://week1-6m5.pages.dev${getVenueUrl(v)}`
    }))
  }
];
---
<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <h1>전국 나이트 · 클럽 · 라운지 가이드</h1>
      <p>강남, 부산, 대구, 인천 — 전국 {venues.length}곳의 나이트라이프 정보를 한곳에서.</p>

      <div class="search-bar" style="position:relative;">
        <input type="text" id="venueSearch" placeholder="매장명 또는 지역으로 검색..." aria-label="매장 검색" autocomplete="off" />
        <div id="searchDropdown" class="search-dropdown" style="display:none;"></div>
      </div>

      <div class="filter-chips">
        <a href="/nights/" target="_blank" rel="noopener noreferrer" class="filter-chip">나이트 {venues.filter(v => v.type === 'night').length}곳</a>
        <a href="/clubs/" target="_blank" rel="noopener noreferrer" class="filter-chip">클럽 {venues.filter(v => v.type === 'club').length}곳</a>
        <a href="/lounges/" target="_blank" rel="noopener noreferrer" class="filter-chip">라운지 {venues.filter(v => v.type === 'lounge').length}곳</a>
      </div>
    </div>
  </section>

  <section class="container content-narrow">
    <IntroSection
      hook={`오늘 밤 어디 갈지 검색만 30분째라면, 그 시간을 여기서 줄일 수 있습니다. 나이트, 클럽, 라운지 — 유형도 다르고 지역마다 분위기도 다른 곳들을 하나하나 비교하면 시간만 낭비하기 쉽습니다. 전국 ${venues.length}곳의 핵심 정보를 한곳에 정리했습니다.`}
      valuePromise={`1분이면 전국 ${venues.length}곳의 유형별·지역별 분포를 파악하고, 원하는 매장 상세 페이지로 바로 이동할 수 있습니다.`}
      scanBox={[
        `전국 나이트·클럽·라운지 ${venues.length}곳 수록`,
        `나이트 ${venues.filter(v=>v.type==='night').length}곳 · 클럽 ${venues.filter(v=>v.type==='club').length}곳 · 라운지 ${venues.filter(v=>v.type==='lounge').length}곳`,
        `지역: ${regions.length}개 도시 커버 (강남, 부산, 대구, 인천 등)`,
        '매장별 체크리스트·타임라인·FAQ 포함',
        '검색: 매장명 또는 지역명 입력으로 즉시 검색',
        '필터: 유형별(나이트/클럽/라운지) 칩으로 분류 가능',
        '추천 매장: 에디터 선정 12곳 바로 확인',
      ]}
      checklist={[
        '방문 목적 정하기: 댄스, 대화, 분위기 감상 중 선택',
        '지역 결정: 강남, 이태원, 홍대, 부산 등 접근성 고려',
        '유형 선택: 나이트(파트너 댄스) vs 클럽(DJ/EDM) vs 라운지(대화 중심)',
        '예산 설정: 입장료 + 음료 2~3잔 기준 예상 비용',
        '동행 인원 확인: 1인/커플/소그룹/단체에 따라 매장 선택 달라짐',
        '방문 요일: 금·토 피크타임 vs 평일 여유로운 분위기',
      ]}
      riskItems={[
        { dont: '리뷰 평점만 보고 매장을 고르지 마세요', doInstead: '음악 장르, 연령대, 분위기를 먼저 확인한 뒤 선택하세요' },
        { dont: '나이트와 클럽을 같은 곳이라 생각하지 마세요', doInstead: '나이트는 파트너 댄스 중심, 클럽은 DJ 음악 중심으로 분위기가 다릅니다' },
        { dont: '신분증 없이 출발하지 마세요', doInstead: '모든 유형의 매장에서 신분증 확인은 기본입니다' },
      ]}
      teasers={[
        '아래에서 에디터 추천 매장 12곳 바로 확인',
        `아래에서 ${regions.length}개 지역별 허브로 바로 이동`,
        '아래에서 첫 방문 가이드·드레스코드·안전 수칙 바로 확인',
      ]}
    />
  </section>

  <!-- Recommended -->
  <section class="container" style="padding-top: 2.5rem;">
    <h2 style="text-align:center; margin-top:0; margin-bottom: 1.5rem;">추천 매장</h2>
    <div class="venue-grid">
      {recommended.map(v => (
        <a href={getVenueUrl(v)} target="_blank" rel="noopener noreferrer" class="venue-card">
          <div class="venue-card-thumb">
            <img src={v.images[0].src} alt={v.images[0].alt} width="400" height="400" loading="lazy" />
          </div>
          <div class="venue-card-body">
            <div class="venue-card-meta">
              <span class={`venue-card-type type-${v.type}`}>{v.typeLabel}</span>
              <span class="venue-card-region">{v.region}</span>
            </div>
            <h3>{v.name_display}</h3>
            <p class="venue-card-teaser">{v.teaser}</p>
            <span class="venue-card-cta">자세히 보기 →</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Region Hub -->
  <section class="container" style="margin-top: 3rem;">
    <h2 style="text-align:center; margin-bottom: 1.5rem;">지역별 허브</h2>
    <div class="related-grid" style="max-width:800px; margin: 0 auto;">
      {regions.map(r => (
        <a href={`/region/${r.slug}/`} target="_blank" rel="noopener noreferrer" class="related-link">{r.name} ({r.count}곳)</a>
      ))}
    </div>
  </section>

  <!-- Guides -->
  <section class="container" style="margin-top: 3rem;">
    <h2 style="text-align:center; margin-bottom: 1.5rem;">나이트라이프 가이드</h2>
    <div class="guide-grid">
      {guides.slice(0, 4).map(g => (
        <a href={`/guides/${g.slug}/`} target="_blank" rel="noopener noreferrer" class="guide-card">
          <img src={`/guides/${g.slug}.svg`} alt={g.title} class="guide-card-img" width="500" height="260" loading="lazy" />
          <div class="guide-card-body">
            <h3>{g.title}</h3>
            <p>{g.desc}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <style>
    .search-dropdown {
      position: absolute; top: 100%; left: 0; right: 0; z-index: 60;
      background: var(--bg-card); border: 1px solid var(--border-emphasis);
      border-radius: 0 0 var(--radius-md) var(--radius-md);
      max-height: 420px; overflow-y: auto;
      box-shadow: var(--shadow-lg);
    }
    .search-item {
      display: flex; align-items: center; gap: 0.75rem;
      padding: 0.6rem 1rem; cursor: pointer;
      text-decoration: none; color: inherit;
      border-bottom: 1px solid var(--border-subtle);
      transition: background 0.15s;
    }
    .search-item:hover, .search-item.active {
      background: var(--accent-light);
    }
    .search-item-thumb {
      width: 44px; height: 44px; border-radius: 6px;
      object-fit: cover; background: var(--bg-accent); flex-shrink: 0;
    }
    .search-item-info { flex: 1; min-width: 0; }
    .search-item-name {
      font-size: 0.92rem; font-weight: 600; color: var(--text-primary);
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .search-item-meta {
      font-size: 0.78rem; color: var(--text-muted);
    }
    .search-item-meta .search-cat {
      display: inline-block; padding: 0.1rem 0.4rem; border-radius: 8px;
      font-size: 0.7rem; font-weight: 600; margin-right: 0.3rem;
    }
    .search-cat-club { background: rgba(91,79,196,0.1); color: var(--tint-club); }
    .search-cat-night { background: rgba(184,134,11,0.1); color: var(--tint-night); }
    .search-cat-lounge { background: rgba(14,124,134,0.1); color: var(--tint-lounge); }
    .search-no-result {
      padding: 1rem; text-align: center; color: var(--text-muted); font-size: 0.9rem;
    }
    .search-hint {
      font-size: 0.78rem; color: var(--text-muted); padding: 0.3rem 1rem;
      border-top: 1px solid var(--border-subtle); text-align: right;
    }
  </style>

  <script define:vars={{ searchIndex }}>
    const SI = searchIndex;
    const searchEl = document.getElementById('venueSearch');
    const dropdown = document.getElementById('searchDropdown');
    let activeIdx = -1;
    let currentResults = [];

    function norm(s) {
      return s.replace(/\s+/g, '').replace(/[^가-힣a-zA-Z0-9]/g, '').toLowerCase();
    }

    function searchVenues(query) {
      if (!query.trim()) return [];
      const q = norm(query);
      const ql = query.toLowerCase().trim();
      const qTokens = ql.split(/\s+/).filter(t => t.length > 0);

      const scored = SI.map(item => {
        let score = 0;
        const nName = norm(item.name);
        const lName = item.name.toLowerCase();

        if (nName === q) score = 1000;
        else if (nName.includes(q) || item.norm.includes(q)) score = 500;
        else if (qTokens.length > 0 && qTokens.every(t => lName.includes(t) || item.region.toLowerCase().includes(t) || item.catLabel.toLowerCase().includes(t))) score = 200;
        else if (qTokens.some(t => lName.includes(t) || item.region.toLowerCase().includes(t))) score = 50;
        else {
          const overlap = [...new Set(q)].filter(c => nName.includes(c)).length;
          if (overlap >= Math.min(2, q.length * 0.5)) score = overlap * 5;
        }

        if (lName.startsWith(ql)) score += 100;
        if (nName.startsWith(q)) score += 80;

        return { ...item, score };
      });

      return scored.filter(s => s.score > 0).sort((a, b) => b.score - a.score);
    }

    function renderDropdown(results) {
      if (!dropdown) return;
      if (results.length === 0) {
        const q = searchEl?.value?.trim() || '';
        if (q.length > 0) {
          const similar = SI
            .map(item => ({ ...item, dist: editDist(norm(q), norm(item.name)) }))
            .sort((a, b) => a.dist - b.dist)
            .slice(0, 3);
          dropdown.innerHTML = '<div class="search-no-result">검색 결과가 없습니다</div>' +
            (similar.length > 0 ? '<div class="search-no-result" style="padding-top:0;font-size:0.82rem;">비슷한 이름: ' +
            similar.map(s => '<a href="' + s.url + '" target="_blank" rel="noopener noreferrer" style="color:var(--accent);">' + s.name + '</a>').join(', ') + '</div>' : '');
          dropdown.style.display = 'block';
        } else {
          dropdown.style.display = 'none';
        }
        currentResults = [];
        activeIdx = -1;
        return;
      }

      const top = results.slice(0, 10);
      currentResults = top;
      activeIdx = -1;

      dropdown.innerHTML = top.map((r, i) =>
        '<a class="search-item" href="' + r.url + '" target="_blank" rel="noopener noreferrer" data-idx="' + i + '">' +
          '<img class="search-item-thumb" src="' + r.thumb + '" alt="" width="44" height="44" loading="lazy" />' +
          '<div class="search-item-info">' +
            '<div class="search-item-name">' + escHtml(r.name) + '</div>' +
            '<div class="search-item-meta"><span class="search-cat search-cat-' + r.cat + '">' + r.catLabel + '</span>' + r.region + '</div>' +
          '</div>' +
        '</a>'
      ).join('') + '<div class="search-hint">Enter로 첫 번째 결과 이동 · 총 ' + results.length + '건</div>';
      dropdown.style.display = 'block';
    }

    function escHtml(s) {
      return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function editDist(a, b) {
      if (a.length > 20 || b.length > 20) {
        const setA = new Set(a);
        const setB = new Set(b);
        let common = 0;
        for (const c of setA) if (setB.has(c)) common++;
        return Math.max(setA.size, setB.size) - common;
      }
      const m = a.length, n = b.length;
      const dp = Array.from({ length: m + 1 }, () => new Array(n + 1).fill(0));
      for (let i = 0; i <= m; i++) dp[i][0] = i;
      for (let j = 0; j <= n; j++) dp[0][j] = j;
      for (let i = 1; i <= m; i++)
        for (let j = 1; j <= n; j++)
          dp[i][j] = Math.min(dp[i-1][j] + 1, dp[i][j-1] + 1, dp[i-1][j-1] + (a[i-1] !== b[j-1] ? 1 : 0));
      return dp[m][n];
    }

    function updateActiveItem() {
      const items = dropdown?.querySelectorAll('.search-item') || [];
      items.forEach((el, i) => el.classList.toggle('active', i === activeIdx));
      if (activeIdx >= 0 && items[activeIdx]) {
        items[activeIdx].scrollIntoView({ block: 'nearest' });
      }
    }

    searchEl?.addEventListener('input', () => {
      const q = searchEl.value.trim();
      if (q.length > 0) {
        renderDropdown(searchVenues(q));
      } else {
        dropdown && (dropdown.style.display = 'none');
        currentResults = [];
        activeIdx = -1;
      }
    });

    searchEl?.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (currentResults.length > 0) {
          activeIdx = Math.min(activeIdx + 1, currentResults.length - 1);
          updateActiveItem();
        }
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        if (currentResults.length > 0) {
          activeIdx = Math.max(activeIdx - 1, 0);
          updateActiveItem();
        }
      } else if (e.key === 'Enter') {
        e.preventDefault();
        const target = activeIdx >= 0 && currentResults[activeIdx]
          ? currentResults[activeIdx]
          : currentResults[0];
        if (target) {
          window.open(target.url, '_blank');
        }
      } else if (e.key === 'Escape') {
        dropdown && (dropdown.style.display = 'none');
        activeIdx = -1;
        currentResults = [];
      }
    });

    document.addEventListener('click', (e) => {
      if (!searchEl?.contains(e.target) && !dropdown?.contains(e.target)) {
        dropdown && (dropdown.style.display = 'none');
      }
    });

    searchEl?.addEventListener('focus', () => {
      const q = searchEl.value.trim();
      if (q.length > 0 && currentResults.length > 0) {
        dropdown && (dropdown.style.display = 'block');
      }
    });
  </script>
</BaseLayout>
