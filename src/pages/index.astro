<!-- ═══ CLIENT-SIDE SCRIPTS ═══ -->
<script is:inline define:vars={{ _b64 }}>
(function(){
  var _d = JSON.parse(atob(_b64));
  var searchData = _d.searchData, top20 = _d.top20, allVenuesMini = _d.allVenuesMini,
      matchups = _d.matchups, flatToasts = _d.flatToasts, trendVenues = _d.trendVenues,
      top10js = _d.top10js;

  // ── SEARCH ──
  var inp = document.getElementById('searchInput');
  var dd = document.getElementById('searchDropdown');
  var timer = null;
  var activeIdx = -1;

  function normalize(s){ return s.toLowerCase().replace(/\s+/g,''); }

  function doSearch(q){
    if(!q||q.length<1){dd.classList.remove('active');return;}
    var nq = normalize(q);
    var results = searchData.filter(function(v){
      return normalize(v.n).indexOf(nq)>-1 || normalize(v.r).indexOf(nq)>-1 ||
             normalize(v.tn).indexOf(nq)>-1 || (v.tg && v.tg.some(function(t){return normalize(t).indexOf(nq)>-1;}));
    }).slice(0,8);
    if(!results.length){dd.innerHTML='<div class="search-item"><span class="search-item-meta">검색 결과가 없습니다</span></div>';dd.classList.add('active');return;}
    dd.innerHTML = results.map(function(v,i){
      return '<a href="/venue/'+v.s+'/" class="search-item" data-idx="'+i+'">'+
        '<span class="search-item-badge">'+v.tn+'</span>'+
        '<div><div class="search-item-name">'+v.n+'</div><div class="search-item-meta">'+v.r+'</div></div></a>';
    }).join('');
    dd.classList.add('active');
    activeIdx = -1;
  }

  inp.addEventListener('input',function(){
    clearTimeout(timer);
    timer = setTimeout(function(){ doSearch(inp.value.trim()); }, 200);
  });
  inp.addEventListener('keydown',function(e){
    var items = dd.querySelectorAll('.search-item[href]');
    if(e.key==='ArrowDown'){e.preventDefault();activeIdx=Math.min(activeIdx+1,items.length-1);items.forEach(function(el,i){el.classList.toggle('active',i===activeIdx);});}
    else if(e.key==='ArrowUp'){e.preventDefault();activeIdx=Math.max(activeIdx-1,0);items.forEach(function(el,i){el.classList.toggle('active',i===activeIdx);});}
    else if(e.key==='Enter'&&activeIdx>=0&&items[activeIdx]){e.preventDefault();window.location.href=items[activeIdx].getAttribute('href');}
  });
  document.addEventListener('click',function(e){if(!document.getElementById('searchWrap').contains(e.target))dd.classList.remove('active');});

  // Tag pills
  document.querySelectorAll('.tag-pill').forEach(function(btn){
    btn.addEventListener('click',function(){
      inp.value=btn.getAttribute('data-query');
      doSearch(inp.value.trim());
      inp.focus();
    });
  });

  // ── PARTICLE CANVAS ──
  var canvas = document.getElementById('particleCanvas');
  var ctx = canvas.getContext('2d');
  var particles = [];
  function resizeCanvas(){
    var hero = document.getElementById('heroSection');
    canvas.width = hero.offsetWidth;
    canvas.height = hero.offsetHeight;
  }
  resizeCanvas();
  window.addEventListener('resize', resizeCanvas);

  for(var i=0;i<50;i++){
    particles.push({
      x:Math.random()*canvas.width, y:Math.random()*canvas.height,
      vx:(Math.random()-.5)*.5, vy:(Math.random()-.5)*.5,
      r:Math.random()*2+1,
      c:Math.random()>.5?'rgba(139,92,246,':'rgba(6,182,212,',
      a:Math.random()*.3+.1
    });
  }
  var animFrame;
  function drawParticles(){
    ctx.clearRect(0,0,canvas.width,canvas.height);
    for(var i=0;i<particles.length;i++){
      var p=particles[i];
      p.x+=p.vx;p.y+=p.vy;
      if(p.x<0||p.x>canvas.width)p.vx*=-1;
      if(p.y<0||p.y>canvas.height)p.vy*=-1;
      ctx.beginPath();ctx.arc(p.x,p.y,p.r,0,Math.PI*2);
      ctx.fillStyle=p.c+p.a+')';ctx.fill();
    }
    // Connect nearby particles
    for(var i=0;i<particles.length;i++){
      for(var j=i+1;j<particles.length;j++){
        var dx=particles[i].x-particles[j].x,dy=particles[i].y-particles[j].y;
        var dist=Math.sqrt(dx*dx+dy*dy);
        if(dist<120){
          ctx.beginPath();ctx.moveTo(particles[i].x,particles[i].y);ctx.lineTo(particles[j].x,particles[j].y);
          ctx.strokeStyle='rgba(139,92,246,'+(0.08*(1-dist/120))+')';ctx.lineWidth=.5;ctx.stroke();
        }
      }
    }
    animFrame=requestAnimationFrame(drawParticles);
  }
  // Only animate when visible
  var heroObs = new IntersectionObserver(function(entries){
    if(entries[0].isIntersecting){drawParticles();}else{cancelAnimationFrame(animFrame);}
  });
  heroObs.observe(document.getElementById('heroSection'));

  // ── HOT TOP5 ──
  function renderHot(){
    var shuffled = top20.slice().sort(function(){return Math.random()-.5;}).slice(0,5);
    var html='';
    for(var i=0;i<shuffled.length;i++){
      var v=shuffled[i];
      var rc=i===0?'r1':i===1?'r2':i===2?'r3':'rn';
      html+='<a href="/venue/'+v.s+'/" class="hot-item"><span class="hot-rank '+rc+'">'+(i+1)+'</span><div><div class="hot-name">'+v.n+'</div><div class="hot-meta">'+v.r+' · '+v.tn+'</div></div><span class="hot-pulse"></span></a>';
    }
    document.getElementById('hotList').innerHTML=html;
  }
  renderHot();
  setInterval(renderHot, 300000); // 5 min

  // ── TOP 10 ──
  var t10html='';
  for(var i=0;i<top10js.length;i++){
    var v=top10js[i];
    t10html+='<a href="/venue/'+v.s+'/" class="top10-item"><span class="top10-rank '+(i<3?'top3':'')+'">'+(i+1)+'</span><div class="top10-info"><span class="top10-name">'+v.n+'</span><span class="top10-meta">'+v.r+' · '+v.tn+'</span></div><span class="top10-arrow">›</span></a>';
  }
  document.getElementById('top10List').innerHTML=t10html;

  // ── ROULETTE ──
  var spinBtn = document.getElementById('spinBtn');
  var rDisplay = document.getElementById('rouletteSlots');
  var rResult = document.getElementById('rouletteResult');
  var rCount = document.getElementById('spinCount');
  var spins = parseInt(sessionStorage.getItem('spins')||'0');
  var spinning = false;

  function updateSpinCount(){
    if(spins>0) rCount.textContent = spins+'회 돌림' + (spins>=3?' — 행운이 따르는 중!':'');
  }
  updateSpinCount();

  spinBtn.addEventListener('click',function(){
    if(spinning) return;
    spinning = true;
    spinBtn.disabled = true;
    rResult.style.display = 'none';

    // Slot machine effect
    var count = 0;
    var total = 20 + Math.floor(Math.random()*10);
    var chosen = allVenuesMini[Math.floor(Math.random()*allVenuesMini.length)];
    var interval = setInterval(function(){
      var rv = allVenuesMini[Math.floor(Math.random()*allVenuesMini.length)];
      rDisplay.innerHTML = '<div style="font-size:20px;font-weight:700">'+rv.n+'</div><div style="font-size:13px;color:var(--text-light)">'+rv.r+' · '+rv.tn+'</div>';
      count++;
      if(count >= total){
        clearInterval(interval);
        rDisplay.innerHTML = '<div style="font-size:22px;font-weight:800;color:var(--accent)">'+chosen.n+'</div><div style="font-size:14px;color:var(--text-light)">'+chosen.r+' · '+chosen.tn+'</div>';
        rResult.innerHTML = '<div class="rr-name">'+chosen.n+'</div><div class="rr-meta">'+chosen.r+' · '+chosen.tn+'</div><div class="rr-desc">'+chosen.d+'</div><a href="/venue/'+chosen.s+'/" class="btn btn-primary btn-sm">상세 보기 →</a> <button class="btn btn-outline btn-sm" onclick="document.getElementById(\'spinBtn\').click()">다시 돌리기</button>';
        rResult.style.display = 'block';
        spinning = false;
        spinBtn.disabled = false;
        spins++;
        sessionStorage.setItem('spins', spins);
        updateSpinCount();
      }
    }, 60 + count * 8);
  });

  // ── VS BATTLE ──
  var vsIdx = parseInt(localStorage.getItem('vsIdx')||'0') % matchups.length;
  var vsVotes = JSON.parse(localStorage.getItem('vsVotes')||'{}');

  function renderVs(){
    var m = matchups[vsIdx % matchups.length];
    var pctA = ((m.a.id * 7 + m.b.id * 13) % 21 + 40);
    var pctB = 100 - pctA;
    var voted = vsVotes[vsIdx];

    var html = '<div class="vs-card'+(voted?' voted revealed':'')+'" data-side="a">'+
      '<div class="vs-name">'+m.a.n+'</div><div class="vs-meta">'+m.a.r+' · '+m.a.tn+'</div>'+
      '<div class="vs-pct">'+(voted?pctA+'%':'??%')+'</div></div>'+
      '<div class="vs-badge">VS</div>'+
      '<div class="vs-card'+(voted?' voted revealed':'')+'" data-side="b">'+
      '<div class="vs-name">'+m.b.n+'</div><div class="vs-meta">'+m.b.r+' · '+m.b.tn+'</div>'+
