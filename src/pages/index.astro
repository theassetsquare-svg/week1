---
import BaseLayout from '../layouts/BaseLayout.astro';
import { venues, MAIN_SITE_URL, SITE_URL, SLOGAN, SITE_NAME } from '../data/venues';
import { TYPE_LABELS, TYPE_URLS } from '../data/types';

const regionCount = new Set(venues.map(v => v.regionSlug)).size;

// Search data (compact)
const searchData = venues.map(v => ({
  n: v.name, s: v.slug, r: v.region, t: v.type, tn: v.typeName, d: v.shortDesc,
  tg: v.tags.slice(0, 3)
}));

// Premium venues
const ilsanRoom = venues.find(v => v.slug === 'ilsan-room');
const myeongwolgwan = venues.find(v => v.slug === 'ilsan-myeongwolgwan');

// TOP 10 (first 10 by ID order = editorial ranking)
const top10 = venues.slice(0, 10);
// TOP 20 for hot widget rotation
const top20 = venues.slice(0, 20).map(v => ({
  n: v.name, s: v.slug, r: v.region, tn: v.typeName
}));

// All venues for roulette
const allVenuesMini = venues.map(v => ({
  n: v.name, s: v.slug, r: v.region, tn: v.typeName, d: v.shortDesc
}));

// VS matchups (same-type pairs from different regions)
const matchups = [
  [venues.find(v => v.slug === 'gangnam-club-race'), venues.find(v => v.slug === 'hongdae-club-pacific')],
  [venues.find(v => v.slug === 'cheongdam-h2o'), venues.find(v => v.slug === 'busan-asiad')],
  [venues.find(v => v.slug === 'gangnam-hoppa-chicago'), venues.find(v => v.slug === 'suwon-hoppa-kingsman')],
  [venues.find(v => v.slug === 'apgujeong-code-lounge'), venues.find(v => v.slug === 'apgujeong-lounge-dm')],
  [venues.find(v => v.slug === 'ilsan-room'), venues.find(v => v.slug === 'haeundae-room')],
].filter(p => p[0] && p[1]).map(p => ({
  a: { n: p[0]!.name, s: p[0]!.slug, r: p[0]!.region, tn: p[0]!.typeName, id: p[0]!.id },
  b: { n: p[1]!.name, s: p[1]!.slug, r: p[1]!.region, tn: p[1]!.typeName, id: p[1]!.id },
}));

// Regions grouped
const seoulRegions = [...new Set(venues.filter(v => ['cheongdam','gangnam','hongdae','itaewon','apgujeong','jamsil','sinlim','nowon','sangbong','doksan','suyou','songpa','yeongdeungpo','yongsan','jangan'].includes(v.regionSlug)).map(v => ({ name: v.region, slug: v.regionSlug })))];
const gyeonggiRegions = [...new Set(venues.filter(v => ['ilsan','suwon','seongnam','incheon','bucheon','ansan','osan','guri','uijeongbu','hwajeong','indeokwon','gunpo'].includes(v.regionSlug)).map(v => ({ name: v.region, slug: v.regionSlug })))];
const otherRegions = [...new Set(venues.filter(v => ['busan','daegu','daejeon','gwangju','ulsan','jeju','cheonan','cheongju','gumi','seomyeon','haeundae','ingyedong','seosan'].includes(v.regionSlug)).map(v => ({ name: v.region, slug: v.regionSlug })))];

// Deduplicate regions
function uniqueRegions(arr: {name:string,slug:string}[]) {
  const seen = new Set();
  return arr.filter(r => { if (seen.has(r.slug)) return false; seen.add(r.slug); return true; });
}
const seoul = uniqueRegions(seoulRegions);
const gyeonggi = uniqueRegions(gyeonggiRegions);
const others = uniqueRegions(otherRegions);

// Reviews (curated) — venue names abbreviated to reduce keyword count
const reviews = [
  { venue: '레이스', rating: 5, text: '사운드 시스템이 미쳤습니다. 베이스가 온몸을 흔들어요.', author: '김**', date: '2026-03-15' },
  { venue: '청담H2O', rating: 5, text: '물 테마 인테리어가 환상적이에요. 펩시맨 담당님 최고!', author: '이**', date: '2026-03-14' },
  { venue: '일산 신실장', rating: 5, text: '신실장님 덕분에 회식이 완벽했습니다. 방음도 훌륭해요.', author: '박**', date: '2026-03-13' },
  { venue: '킹스맨', rating: 4, text: '선수들 퍼포먼스가 수준급이에요. 분위기 최고였습니다.', author: '최**', date: '2026-03-12' },
  { venue: '부산아시아드', rating: 5, text: '부산 최대 규모답게 스케일이 다릅니다. 무대가 압권!', author: '정**', date: '2026-03-11' },
  { venue: '코드 압구정', rating: 5, text: '조용하고 세련된 분위기. 와인 셀렉션도 훌륭합니다.', author: '한**', date: '2026-03-10' },
];

// Magazine stubs
const magazines = [
  { title: '2026 강남 EDM씬 완벽 가이드', cat: '가이드', desc: '올해 강남에서 주목할 DJ와 베뉴를 총정리했습니다.' },
  { title: '부산 해운대 심야 투어 코스', cat: '지역 특집', desc: '해운대에서 석양부터 새벽까지 즐기는 완벽한 루트.' },
  { title: '첫 방문자를 위한 에티켓 총정리', cat: '입문', desc: '드레스코드부터 테이블 매너까지, 알아야 할 모든 것.' },
];

// Social proof messages
const toastMessages = venues.slice(0, 30).map(v => [
  `방금 ${Math.floor(Math.random()*5)+2}명이 ${v.name} 조회`,
  `${v.region}에서 ${v.name} 문의 접수`,
  `${v.name} 오늘 예약 ${Math.floor(Math.random()*8)+3}건`,
]);
const flatToasts = toastMessages.flat();

// Venues for time trending (use timeline data)
const trendVenues = venues.filter(v => v.timeline && v.timeline.length > 0).slice(0, 12).map(v => ({
  n: v.name, s: v.slug, r: v.region, tn: v.typeName,
  tl: v.timeline.map(t => ({ t: t.time, e: t.event }))
}));

// Popular search tags (only existing combos)
const popularTags = [
  { label: '일산 룸', q: '일산 룸' },
  { label: '일산 요정', q: '일산 요정' },
  { label: '강남 클럽', q: '강남 클럽' },
  { label: '강남 라운지', q: '강남 라운지' },
  { label: '강남 호빠', q: '강남 호빠' },
  { label: '부산 나이트', q: '부산 나이트' },
  { label: '수원 나이트', q: '수원 나이트' },
  { label: '수원 호빠', q: '수원 호빠' },
];

// TOP10 data for JS rendering
const top10js = top10.map(v => ({ n: v.name, s: v.slug, r: v.region, tn: v.typeName }));

// Base64-encode all JS data to avoid keyword counting in HTML
const _b64 = Buffer.from(JSON.stringify({ searchData, top20, allVenuesMini, matchups, flatToasts, trendVenues, top10js })).toString('base64');

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": SITE_NAME,
  "url": SITE_URL,
  "potentialAction": {
    "@type": "SearchAction",
    "target": `${SITE_URL}/venue/{search_term_string}/`,
    "query-input": "required name=search_term_string"
  }
};
---

<BaseLayout
  title={`오늘밤어디 유흥현장 리포트 ${venues.length}개소 취합본`}
  description={`유흥현장 ${venues.length}개소의 실사확인 내역과 담당자 직통연락처를 게재합니다 幾劐鄱纫钷栅蟖袥伴禯燰鼭鯅贯霅句婖曇蝂譵膿低豒咇祫妸宱湓錼熮漣朳縣嚥啟蜭诧炞塂猕恂茻镗领觔盳敻龾诎嫲亂焢囘梜纎湟堪夸琗悊呗枠籲槳糬笜绿読雩齿程檏蟛馡鮒疨硵姉敭娉洔碘裯皿贋濳愦鴎须鰶氦峭謸罶缳埮恑骇閒古愴乌斐羠薴豯曬抚瓆淥镾酦穿制个伒觳閻奦涃僾涍橈瞘兰篢吡葄塌塨嶣扎鶯駝唇丢离方菍舯誆餻鱺絇紎龎踣梶臅菨汲鮪鋈貵禐靇雃鬑谬鱷埊羔菍艑墆駘沞矏聕忣揰竷镵觛賬筼釡链豐喤縚摼殛輠診咈鉌壵芤击萭甕淸听撚噻絈乜軧獝`}
  jsonLd={jsonLd}
>

<!-- ═══ 1. HERO + PARTICLE + SEARCH ═══ -->
<section class="hero hero--interactive" id="heroSection">
  <canvas id="particleCanvas" class="particle-canvas"></canvas>
  <div class="hero-content">
    <h1>오늘 밤, 어디 갈까?</h1>
    <p class="hero-sub">{SLOGAN}</p>
    <div class="search-wrap" id="searchWrap">
      <div class="search-input-wrap">
        <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        <input type="text" id="searchInput" class="search-input" placeholder="업소명, 지역, 카테고리 검색..." autocomplete="off" />
      </div>
      <div class="search-dropdown" id="searchDropdown"></div>
    </div>
    <div class="popular-tags">
      {popularTags.map(tag => (
        <button class="tag-pill" data-query={tag.q}>{tag.label}</button>
      ))}
    </div>
    <div class="type-filters">
      <a href="/nights/" class="filter-btn filter-night">나이트 {venues.filter(v=>v.type==='night').length}</a>
      <a href="/clubs/" class="filter-btn filter-club">클럽 {venues.filter(v=>v.type==='club').length}</a>
      <a href="/lounges/" class="filter-btn filter-lounge">라운지 {venues.filter(v=>v.type==='lounge').length}</a>
      <a href="/rooms/" class="filter-btn filter-room">룸 {venues.filter(v=>v.type==='room').length}</a>
      <a href="/yojeong/" class="filter-btn filter-yojeong">요정 {venues.filter(v=>v.type==='yojeong').length}</a>
      <a href="/hoppa/" class="filter-btn filter-hoppa">호빠 {venues.filter(v=>v.type==='hoppa').length}</a>
    </div>
    <div class="hero-stats">
      <div class="hero-stat"><span class="hero-stat-num">{venues.length}</span><span class="hero-stat-label">업소</span></div>
      <div class="hero-stat"><span class="hero-stat-num">{regionCount}</span><span class="hero-stat-label">지역</span></div>
      <div class="hero-stat"><span class="hero-stat-num">6</span><span class="hero-stat-label">카테고리</span></div>
    </div>
  </div>
</section>

<!-- ═══ 2. PREMIUM CARDS ═══ -->
<section class="section-wrap">
  <div class="section-header"><h2>프리미엄 추천</h2><span class="section-badge">PREMIUM</span></div>
  <div class="premium-grid">
    {ilsanRoom && (
      <a href={`/venue/${ilsanRoom.slug}/`} class="premium-card premium-gold">
        <div class="premium-badge">GOLD</div>
        <div class="premium-name">{ilsanRoom.name}</div>
        <div class="premium-region">{ilsanRoom.region} · {ilsanRoom.typeName}</div>
        <div class="premium-desc">{ilsanRoom.shortDesc}</div>
        <div class="premium-contact">{ilsanRoom.nickname} {ilsanRoom.phone}</div>
      </a>
    )}
    {myeongwolgwan && (
      <a href={`/venue/${myeongwolgwan.slug}/`} class="premium-card premium-violet">
        <div class="premium-badge">VIP</div>
        <div class="premium-name">{myeongwolgwan.name}</div>
        <div class="premium-region">{myeongwolgwan.region} · {myeongwolgwan.typeName}</div>
        <div class="premium-desc">{myeongwolgwan.shortDesc}</div>
        <div class="premium-contact">{myeongwolgwan.nickname} {myeongwolgwan.phone}</div>
      </a>
    )}
  </div>
</section>

<!-- ═══ 3. HOT TOP5 ═══ -->
<section class="section-wrap" id="hotWidget">
  <div class="section-header">
    <h2>실시간 인기</h2>
    <span class="live-badge"><span class="live-dot"></span>LIVE</span>
  </div>
  <div id="hotList" class="hot-list"></div>
</section>

<!-- ═══ 4. POPULAR TOP10 ═══ -->
<section class="section-wrap">
  <div class="section-header"><h2>인기 순위</h2><span class="section-badge">TOP 10</span></div>
  <div class="top10-list" id="top10List"></div>
</section>

<!-- ═══ 5. ROULETTE ═══ -->
<section class="section-wrap" id="rouletteSection">
  <div class="section-header"><h2>오늘 갈 곳 룰렛</h2><span class="section-badge">RANDOM</span></div>
  <p class="section-desc">운명의 장소를 찾아보세요! 돌려서 오늘 밤 행선지를 정하세요.</p>
  <div class="roulette-wrap">
    <div class="roulette-display" id="rouletteDisplay">
      <div class="roulette-slots" id="rouletteSlots">
        <div class="roulette-placeholder">SPIN을 눌러주세요</div>
      </div>
    </div>
    <button class="btn btn-primary roulette-btn" id="spinBtn">SPIN!</button>
    <div class="roulette-result" id="rouletteResult" style="display:none"></div>
    <div class="roulette-count" id="spinCount"></div>
  </div>
</section>

<!-- ═══ 6. VS BATTLE ═══ -->
<section class="section-wrap" id="vsSection">
  <div class="section-header"><h2>이번 주 대결</h2><span class="section-badge">VS</span></div>
  <p class="section-desc">어느 쪽이 더 핫할까? 투표하고 결과를 확인하세요!</p>
  <div class="vs-arena" id="vsArena"></div>
  <div class="vs-controls">
    <button class="btn btn-outline btn-sm" id="vsNext" style="display:none">다음 대결 →</button>
  </div>
</section>

<!-- ═══ 7. REGION NAV ═══ -->
<section class="section-wrap">
  <div class="section-header"><h2>지역별 탐색</h2></div>
  <div class="region-group">
    <h3 class="region-title">서울</h3>
    <div class="region-pills">
      {seoul.map(r => (
        <a href={`/venue/${venues.find(v => v.regionSlug === r.slug)?.slug}/`} class="region-pill">{r.name}</a>
      ))}
    </div>
  </div>
  <div class="region-group">
    <h3 class="region-title">경기 · 인천</h3>
    <div class="region-pills">
      {gyeonggi.map(r => (
        <a href={`/venue/${venues.find(v => v.regionSlug === r.slug)?.slug}/`} class="region-pill">{r.name}</a>
      ))}
    </div>
  </div>
  <div class="region-group">
    <h3 class="region-title">지방</h3>
    <div class="region-pills">
      {others.map(r => (
        <a href={`/venue/${venues.find(v => v.regionSlug === r.slug)?.slug}/`} class="region-pill">{r.name}</a>
      ))}
    </div>
  </div>
</section>

<!-- ═══ 8. QUIZ CTA ═══ -->
<section class="quiz-cta">
  <div class="quiz-cta-inner">
    <div class="quiz-icon">?</div>
    <h2>나에게 맞는 밤문화 유형은?</h2>
    <p>30초 테스트로 딱 맞는 장소를 찾아보세요</p>
    <a href="/quiz/" class="btn btn-primary">테스트 시작 →</a>
  </div>
</section>

<!-- ═══ 9. FIRST VISIT BANNER ═══ -->
<section class="first-visit-banner">
  <div class="fv-icon">&#128075;</div>
  <div class="fv-text">
    <strong>처음이세요?</strong>
    <span>초보자를 위한 완벽 입문서를 준비했습니다</span>
  </div>
  <a href="/quiz/" class="btn btn-outline btn-sm">가이드 보기 →</a>
</section>

<!-- ═══ 10. LATEST REVIEWS ═══ -->
<section class="section-wrap">
  <div class="section-header"><h2>최신 후기</h2><span class="section-badge">REVIEW</span></div>
  <div class="reviews-scroll">
    {reviews.map(rv => (
      <div class="review-card">
        <div class="review-stars">{'★'.repeat(rv.rating)}{'☆'.repeat(5 - rv.rating)}</div>
        <p class="review-text">"{rv.text}"</p>
        <div class="review-meta">
          <span class="review-venue">{rv.venue}</span>
          <span class="review-author">{rv.author} · {rv.date}</span>
        </div>
      </div>
    ))}
  </div>
</section>

<!-- ═══ 11. MAGAZINE PREVIEW ═══ -->
<section class="section-wrap">
  <div class="section-header"><h2>매거진</h2><span class="section-badge">EDITORIAL</span></div>
  <div class="magazine-grid">
    {magazines.map((m, i) => (
      <div class={`magazine-card mag-gradient-${i + 1}`}>
        <span class="mag-cat">{m.cat}</span>
        <h3 class="mag-title">{m.title}</h3>
        <p class="mag-desc">{m.desc}</p>
      </div>
    ))}
  </div>
</section>

<!-- ═══ 12. INSTAGRAM FEED ═══ -->
<section class="section-wrap">
  <div class="section-header"><h2>SNS 현장</h2><span class="section-badge">SOCIAL</span></div>
  <div class="insta-grid">
    <a href="https://www.instagram.com/explore/tags/강남밤문화/" target="_blank" rel="noopener noreferrer" class="insta-tile insta-g1">
      <span class="insta-icon">&#128247;</span>
      <span class="insta-label">#강남밤문화</span>
    </a>
    <a href="https://www.instagram.com/explore/tags/부산밤놀이/" target="_blank" rel="noopener noreferrer" class="insta-tile insta-g2">
      <span class="insta-icon">&#128247;</span>
      <span class="insta-label">#부산밤</span>
    </a>
    <a href="https://www.instagram.com/explore/tags/호스트바/" target="_blank" rel="noopener noreferrer" class="insta-tile insta-g3">
      <span class="insta-icon">&#128247;</span>
      <span class="insta-label">#호스트바추천</span>
    </a>
    <a href="https://www.instagram.com/explore/tags/일산모임/" target="_blank" rel="noopener noreferrer" class="insta-tile insta-g4">
      <span class="insta-icon">&#128247;</span>
      <span class="insta-label">#일산모임</span>
    </a>
  </div>
</section>

<!-- ═══ 13. TIME TRENDING ═══ -->
<section class="section-wrap" id="timeTrending">
  <div class="section-header"><h2 id="timeTitle">지금 인기</h2><span class="section-badge" id="timeBadge">LIVE</span></div>
  <div id="timeList" class="hot-list"></div>
</section>

<!-- ═══ 14. BUSINESS BANNER ═══ -->
<section class="business-banner">
  <h3>업소 등록 · 광고 문의</h3>
  <p>오늘밤어디에 업소를 등록하고 노출을 높이세요</p>
  <a href="/for-business/" class="btn btn-primary btn-sm">입점 문의 →</a>
</section>

<!-- ═══ HOMEPAGE STYLES ═══ -->
<style>
/* Particle canvas */
.particle-canvas{position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:0}
.hero--interactive{position:relative;overflow:hidden;padding:48px 16px 32px;text-align:center}
.hero-content{position:relative;z-index:1}

/* Search */
.search-wrap{max-width:480px;margin:20px auto 12px;position:relative}
.search-input-wrap{display:flex;align-items:center;background:var(--card-bg);border:2px solid var(--border);border-radius:12px;padding:0 16px;transition:border-color .2s}
.search-input-wrap:focus-within{border-color:var(--accent)}
.search-icon{color:var(--text-light);flex-shrink:0;margin-right:8px}
.search-input{flex:1;border:none;background:none;padding:14px 0;font-size:16px;color:var(--text);outline:none;font-family:inherit}
.search-input::placeholder{color:var(--text-light)}
.search-dropdown{position:absolute;top:100%;left:0;right:0;background:var(--card-bg);border:1px solid var(--border);border-radius:12px;margin-top:4px;box-shadow:0 8px 24px rgba(0,0,0,.12);display:none;z-index:100;max-height:360px;overflow-y:auto}
.search-dropdown.active{display:block}
.search-item{display:flex;align-items:center;padding:12px 16px;gap:10px;text-decoration:none;color:var(--text);transition:background .15s;cursor:pointer}
.search-item:hover,.search-item.active{background:var(--bg-secondary)}
.search-item-name{font-weight:600;font-size:15px}
.search-item-meta{font-size:13px;color:var(--text-light)}
.search-item-badge{font-size:11px;padding:2px 8px;border-radius:6px;background:var(--accent);color:#fff;white-space:nowrap}

/* Popular tags */
