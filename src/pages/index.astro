  if(hour>=18&&hour<22){timeLabel='저녁 핫플레이스';timeSub='EVENING';}
  else if(hour>=22||hour<2){timeLabel='심야 인기 베뉴';timeSub='MIDNIGHT';}
  else if(hour>=2&&hour<5){timeLabel='새벽 라스트콜';timeSub='LATE';}
  else{timeLabel='오늘 밤 추천';timeSub='TONIGHT';}

  document.getElementById('timeTitle').textContent=timeLabel;
  document.getElementById('timeBadge').textContent=timeSub;

  var timeVenues = trendVenues.slice(0,4);
  var timeHtml='';
  for(var i=0;i<timeVenues.length;i++){
    var v=timeVenues[i];
    var currentEvent = '';
    if(v.tl){
      for(var j=v.tl.length-1;j>=0;j--){
        var th=parseInt(v.tl[j].t);
        if(hour>=th||(th>=22&&hour<6)){currentEvent=v.tl[j].e;break;}
      }
    }
    timeHtml+='<a href="/venue/'+v.s+'/" class="hot-item"><span class="hot-rank rn">'+(i+1)+'</span><div><div class="hot-name">'+v.n+'</div><div class="hot-meta">'+v.r+' · '+v.tn+(currentEvent?' · '+currentEvent:'')+'</div></div></a>';
  }
  document.getElementById('timeList').innerHTML=timeHtml;

  // ── SOCIAL PROOF TOAST ──
  var toastEl = document.createElement('div');
  toastEl.className='social-toast';
  toastEl.style.cssText='position:fixed;bottom:80px;left:16px;background:var(--card-bg);border:1px solid var(--border);border-radius:12px;padding:12px 16px;box-shadow:0 8px 24px rgba(0,0,0,.12);z-index:95;font-size:13px;max-width:300px;transform:translateY(20px);opacity:0;transition:all .4s;pointer-events:none';
  document.body.appendChild(toastEl);

  function showToast(){
    var msg = flatToasts[Math.floor(Math.random()*flatToasts.length)];
    toastEl.textContent = msg;
    toastEl.style.transform='translateY(0)';toastEl.style.opacity='1';
    setTimeout(function(){toastEl.style.transform='translateY(20px)';toastEl.style.opacity='0';},4000);
  }
  setTimeout(function(){
    showToast();
    setInterval(showToast, 35000);
  }, 15000);

})();
</script>

</BaseLayout>
