---
import BaseLayout from '../layouts/BaseLayout.astro';
import { venues, MAIN_SITE_URL, SITE_URL, SLOGAN, SITE_NAME } from '../data/venues';

const myeongwol = venues.find(v => v.slug === 'ilsan-myeongwolgwan');
const ilsanRoom = venues.find(v => v.slug === 'ilsan-room');
const withPhone = venues.filter(v => v.phone).slice(0, 7);
const catReps = ['night','club','lounge','room','yojeong','hoppa'].map(t => venues.find(v => v.type === t)).filter(Boolean);
const vsA = venues.find(v => v.slug === 'gangnam-club-race');
const vsB = venues.find(v => v.slug === 'apgujeong-club-hype');
const allMini = venues.map(v => ({ n: v.name, s: v.slug, r: v.region, tn: v.typeName, d: v.shortDesc }));
const top10 = venues.slice(0, 10);

const popularTags = [
  { label: '일산 룸', q: '일산 룸' }, { label: '일산 요정', q: '일산 요정' },
  { label: '강남 클럽', q: '강남 클럽' }, { label: '압구정 클럽', q: '압구정 클럽' },
  { label: '강남 호빠', q: '강남 호빠' }, { label: '부산 나이트', q: '부산 나이트' },
  { label: '수원 나이트', q: '수원 나이트' }, { label: '부산 룸', q: '부산 룸' },
];

const jsonLd = { "@context": "https://schema.org", "@type": "WebSite", "name": SITE_NAME, "url": SITE_URL,
  "potentialAction": { "@type": "SearchAction", "target": `${SITE_URL}/nights/?q={search_term_string}`, "query-input": "required name=search_term_string" } };
---

<BaseLayout title="놀쿨 — 오늘 밤 어디 갈까? 152곳 검색 한 번이면 끝"
  description="오늘 밤 어디 갈지 아직 못 정했다면 여기서 시작하세요. 나이트·클럽·라운지·룸·요정·호빠 152곳, 검색 한 번이면 딱 맞는 곳이 나옵니다." jsonLd={jsonLd}>

<!-- ═══ 1. 3초 훅 — 첫 화면에서 잡는다 ═══ -->
<section class="hero">
  <p class="hero-sub">{SLOGAN}</p>
  <h1>오늘 밤,<br/>어디 갈까?</h1>
  <div style="margin:20px 0;position:relative;">
    <input type="text" id="searchInput" placeholder="업소명, 지역으로 검색..." style="width:100%;padding:14px 16px;border:2px solid var(--accent);border-radius:var(--radius);font-size:16px;background:var(--bg);color:var(--text);font-family:var(--font);outline:none;" />
    <div id="searchResults" style="display:none;position:absolute;top:100%;left:0;right:0;background:var(--card-bg);border:1px solid var(--border);border-radius:0 0 var(--radius) var(--radius);max-height:300px;overflow-y:auto;z-index:50;box-shadow:var(--card-shadow-hover);"></div>
  </div>
  <div style="display:flex;flex-wrap:wrap;gap:6px;justify-content:center;">
    {popularTags.map(t => <button class="filter-pill search-tag" data-q={t.q}>{t.label}</button>)}
  </div>
  <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:20px;">
    {[{h:'/clubs/',i:'🎵',n:'클럽'},{h:'/nights/',i:'🌙',n:'나이트'},{h:'/lounges/',i:'🍸',n:'라운지'},{h:'/rooms/',i:'🚪',n:'룸'},{h:'/yojeong/',i:'🏮',n:'요정'},{h:'/hoppa/',i:'🎭',n:'호빠'}].map(c =>
      <a href={c.h} target="_blank" rel="noopener noreferrer" style="display:flex;flex-direction:column;align-items:center;gap:4px;padding:12px;background:var(--bg-secondary);border-radius:var(--radius-sm);font-size:13px;font-weight:600;color:var(--text);transition:transform .2s;" class="cat-icon-link">
        <span style="font-size:24px;">{c.i}</span>{c.n}
      </a>
    )}
  </div>
</section>

<!-- ═══ 2. PREMIUM 카드 ═══ -->
<div class="section-header"><span class="section-badge">PREMIUM</span><h2>단골들이 먼저 찾는 곳</h2></div>
<div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:24px;">
  {myeongwol && <a href="/yojeong/ilsan/myeongwolgwan/" target="_blank" rel="noopener noreferrer" style="display:block;padding:20px 16px;background:linear-gradient(135deg,#F5F0FF,#EDE9FE);border:2px solid var(--accent);border-radius:var(--radius);text-align:center;">
    <span style="font-size:24px;">🏮</span>
    <div style="font-size:15px;font-weight:700;color:var(--text);margin:8px 0 4px;">일산명월관요정</div>
    <div style="font-size:12px;color:var(--text-secondary);margin-bottom:8px;">한정식 · 국악 라이브</div>
    <div style="font-size:13px;font-weight:700;color:var(--accent);">신실장</div>
    <span style="display:block;font-size:14px;font-weight:700;color:var(--accent);margin-top:4px;"></span>
  </a>}
  {ilsanRoom && <a href={`/venue/${ilsanRoom.slug}/`} target="_blank" rel="noopener noreferrer" style="display:block;padding:20px 16px;background:linear-gradient(135deg,#F0F9FF,#E0F2FE);border:2px solid var(--accent2);border-radius:var(--radius);text-align:center;">
    <span style="font-size:24px;">🚪</span>
    <div style="font-size:15px;font-weight:700;color:var(--text);margin:8px 0 4px;">일산룸</div>
    <div style="font-size:12px;color:var(--text-secondary);margin-bottom:8px;">프라이빗 · 정찰제</div>
    <div style="font-size:13px;font-weight:700;color:var(--accent2);">신실장</div>
    <span style="display:block;font-size:14px;font-weight:700;color:var(--accent2);margin-top:4px;"></span>
  </a>}
</div>

<!-- ═══ 3. 슬롯머신 룰렛 — 가변보상 (핵심 중독 장치) ═══ -->
<div class="section-header"><span class="section-badge">🎰</span><h2>오늘의 추천 룰렛</h2></div>
<div id="slotMachine" style="text-align:center;padding:24px;background:linear-gradient(135deg,var(--bg-secondary),#F5F0FF);border-radius:var(--radius);margin-bottom:16px;border:1px solid var(--border);">
  <div id="slotDisplay" style="font-size:20px;font-weight:700;color:var(--text);min-height:80px;display:flex;align-items:center;justify-content:center;padding:16px;background:var(--card-bg);border-radius:var(--radius-sm);margin-bottom:16px;border:2px dashed var(--border);transition:all .3s;">
    돌려서 오늘의 추천을 확인하세요
  </div>
  <div style="display:flex;gap:8px;justify-content:center;">
    <button id="slotBtn" class="btn btn-primary" style="min-width:140px;font-size:16px;">🎰 돌리기</button>
    <button id="slotAgain" class="btn btn-outline" style="display:none;min-width:140px;">한 번 더!</button>
  </div>
  <div id="slotCounter" style="font-size:12px;color:var(--text-muted);margin-top:8px;"></div>
</div>

<!-- ═══ 4. 무한 피드 — 담당자 직통 (틱톡식 스크롤) ═══ -->
<div class="section-header"><span class="section-badge">HOT</span><h2>담당자 직통 연결</h2></div>
{withPhone.map((v, i) => (
  <a href={`/venue/${v.slug}/`} class={`venue-card ${i < 3 ? `rank-${i+1}` : ''}`} target="_blank" rel="noopener noreferrer">
    <div class="venue-card-header"><span class="rank-badge">{i + 1}</span></div>
    <div class="venue-card-name">{v.name}</div>
    <div class="venue-card-desc">{v.shortDesc}</div>
    <div class="venue-card-contact">{v.nickname} · <a href={`tel:${v.phone}`} target="_blank" rel="noopener noreferrer" onclick="event.stopPropagation();">{v.phone}</a></div>
  </a>
))}

<!-- ═══ 5. VS 대결 투표 — 참여형 중독 (투표해야 결과 보임) ═══ -->
{vsA && vsB && (<>
  <div class="section-header"><span class="section-badge">⚔️</span><h2>이번 주 대결</h2></div>
  <div id="vsBattle" style="margin-bottom:24px;">
    <div style="display:grid;grid-template-columns:1fr auto 1fr;gap:8px;align-items:center;">
      <button class="venue-card vs-pick" data-side="a" style="text-align:center;margin:0;cursor:pointer;border:2px solid var(--border);transition:all .3s;">
        <div style="font-size:16px;font-weight:700;margin-bottom:4px;">{vsA.name}</div>
        <div style="font-size:12px;color:var(--text-muted);">{vsA.region}</div>
        <div class="vs-pct" style="font-size:24px;font-weight:800;color:var(--accent);margin-top:8px;filter:blur(8px);">??%</div>
      </button>
      <div style="width:40px;height:40px;border-radius:50%;background:var(--accent);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:14px;">VS</div>
      <button class="venue-card vs-pick" data-side="b" style="text-align:center;margin:0;cursor:pointer;border:2px solid var(--border);transition:all .3s;">
        <div style="font-size:16px;font-weight:700;margin-bottom:4px;">{vsB.name}</div>
        <div style="font-size:12px;color:var(--text-muted);">{vsB.region}</div>
        <div class="vs-pct" style="font-size:24px;font-weight:800;color:var(--accent);margin-top:8px;filter:blur(8px);">??%</div>
      </button>
    </div>
    <p style="text-align:center;font-size:13px;color:var(--text-muted);margin-top:8px;">투표하면 결과가 공개됩니다</p>
  </div>
</>)}

<!-- ═══ 6. 오늘의 성향 테스트 — 자아 탐색 중독 ═══ -->
<div style="padding:24px;background:linear-gradient(135deg,#EDE9FE,#CFFAFE);border-radius:var(--radius);margin-bottom:24px;text-align:center;border:1px solid var(--border);">
  <div style="font-size:32px;margin-bottom:8px;">🔮</div>
  <h3 style="font-size:18px;margin-bottom:8px;">나는 어떤 타입일까?</h3>
  <p style="font-size:14px;color:var(--text-secondary);margin-bottom:16px;">10문항 성향 테스트로 딱 맞는 곳을 찾아보세요. 3분이면 끝.</p>
  <a href="/quiz/" target="_blank" rel="noopener noreferrer" class="btn btn-primary">테스트 시작 →</a>
</div>

<!-- ═══ 7. 카테고리별 추천 — 넷플릭스식 개인화 느낌 ═══ -->
<div class="section-header"><span class="section-badge">PICK</span><h2>카테고리별 추천</h2></div>
{catReps.map(v => v && (
  <a href={`/venue/${v.slug}/`} class="venue-card" target="_blank" rel="noopener noreferrer">
    <div class="venue-card-header"><span class={`type-badge badge-${v.type}`}>{v.typeName}</span></div>
    <div class="venue-card-name">{v.name}</div>
    <div class="venue-card-desc">{v.shortDesc}</div>
  </a>
))}

<!-- ═══ 8. 자이가르닉 효과 — "3/10 탐색 완료" 미완성 강박 ═══ -->
<div id="progressWidget" style="padding:16px;background:var(--bg-secondary);border-radius:var(--radius);margin-bottom:24px;border:1px solid var(--border);">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
    <span style="font-size:14px;font-weight:600;color:var(--text);" id="progressText">탐색 시작</span>
    <span style="font-size:13px;color:var(--accent);font-weight:700;" id="progressPct">0%</span>
  </div>
  <div style="height:6px;background:var(--bg-tertiary);border-radius:3px;overflow:hidden;">
    <div id="progressBar" style="height:100%;background:linear-gradient(90deg,var(--accent),var(--accent2));border-radius:3px;width:0%;transition:width .5s;"></div>
  </div>
</div>

<!-- ═══ 9. 인기 시간대 — 데이터 기반 신뢰 ═══ -->
<div class="section-header"><span class="section-badge">📊</span><h2>인기 시간대</h2></div>
<div style="display:flex;align-items:flex-end;gap:6px;height:100px;padding:8px 0;margin-bottom:8px;">
  {['월','화','수','목','금','토','일'].map((d, i) => {
    const pct = [20,25,30,45,95,100,40][i];
    return <div style="flex:1;display:flex;flex-direction:column;align-items:center;gap:4px;">
      <div style={`width:100%;height:${pct}%;min-height:4px;background:var(--accent);border-radius:6px 6px 0 0;opacity:${pct >= 80 ? 1 : 0.3};`}></div>
      <span style="font-size:12px;font-weight:600;color:var(--text-muted);">{d}</span>
    </div>;
  })}
</div>
<p style="text-align:center;font-size:13px;color:var(--text-muted);margin-bottom:24px;">피크: 금·토 22:00 – 02:00</p>

<!-- ═══ 10. TOP 10 무한스크롤 느낌 ═══ -->
<div class="section-header"><span class="section-badge">🏆</span><h2>인기 TOP 10</h2></div>
<div id="top10Feed">
  {top10.map((v, i) => (
    <a href={`/venue/${v.slug}/`} class={`venue-card ${i < 3 ? `rank-${i+1}` : ''}`} target="_blank" rel="noopener noreferrer">
      <div class="venue-card-header"><span class="rank-badge">{i + 1}</span><span class={`type-badge badge-${v.type}`}>{v.typeName}</span></div>
      <div class="venue-card-name">{v.name}</div>
      <div class="venue-card-desc">{v.shortDesc}</div>
      {v.nickname && <div class="venue-card-contact">{v.nickname}{v.phone ? ` · ${v.phone}` : ''}</div>}
    </a>
  ))}
</div>

<!-- ═══ 11. 첫 방문 가이드 — 초보자 온보딩 ═══ -->
<div style="padding:20px;background:var(--bg-secondary);border-radius:var(--radius);margin-bottom:24px;border:1px solid var(--border);">
  <h3 style="font-size:16px;margin-bottom:8px;">처음이세요? 이것만 알면 됩니다</h3>
  <p style="font-size:14px;color:var(--text-secondary);margin-bottom:12px;">뭐 입고 가야 하는지, 혼자 가도 되는지 — 첫 방문자를 위한 가이드.</p>
  <a href="/nights/" target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-sm">가이드 보기 →</a>
</div>

<!-- ═══ 12. 블러 잠금 — 정보 갈증 유발 ═══ -->
<div class="blur-lock">
  <div class="blur-lock-content">
    <p>"사운드 시스템이 진짜 다릅니다"</p>
    <p>"분위기 좋고 스태프가 친절해요"</p>
    <p>"금요일 밤 에너지가 대단합니다"</p>
  </div>
  <div class="blur-lock-overlay">
    <p>전체 리뷰 보기</p>
    <a href={MAIN_SITE_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm">자세히 확인 →</a>
  </div>
</div>

<!-- ═══ 13. 안전 가이드 — 실용 가치 ═══ -->
<div style="padding:20px;background:#FEF2F2;border:1px solid #FECACA;border-radius:var(--radius);margin-bottom:24px;">
  <h3 style="font-size:16px;margin-bottom:8px;color:#DC2626;">안전하게 즐기기</h3>
  <p style="font-size:14px;color:var(--text-secondary);margin-bottom:12px;">음주 계산기, 귀가 안전 체크리스트, 긴급 연락처</p>
  <a href="/safety/" target="_blank" rel="noopener noreferrer" class="btn btn-sm" style="background:#DC2626;color:#fff;">안전 가이드 →</a>
</div>

<!-- ═══ 14. 매거진 미리보기 — 콘텐츠 깊이 ═══ -->
<div class="section-header"><span class="section-badge">📖</span><h2>매거진</h2></div>
<div style="display:flex;flex-direction:column;gap:12px;margin-bottom:24px;">
  {[{t:'처음 가는 사람을 위한 완벽 가이드',c:'입문',g:'linear-gradient(135deg,#7C3AED,#A855F7)'},{t:'서울 vs 부산 vs 대구 — 도시별 분위기 비교',c:'분석',g:'linear-gradient(135deg,#0891B2,#06B6D4)'},{t:'안전하게 즐기는 법 5가지',c:'안전',g:'linear-gradient(135deg,#DC2626,#F87171)'}].map(m =>
    <a href="/magazine/" target="_blank" rel="noopener noreferrer" style={`display:block;padding:20px;border-radius:var(--radius);color:#fff;background:${m.g};`}>
      <span style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:1px;opacity:.7;">{m.c}</span>
      <div style="font-size:16px;font-weight:700;margin-top:4px;">{m.t}</div>
    </a>
  )}
</div>

<!-- ═══ 15. FAQ — 체류 + SEO ═══ -->
<div class="section-header"><span class="section-badge">❓</span><h2>자주 묻는 질문</h2></div>
<div class="faq-item"><div class="faq-q">입장 연령은?</div><div class="faq-a">만 19세 이상 성인만 입장 가능합니다. 신분증 지참 필수.</div></div>
<div class="faq-item"><div class="faq-q">예약 없이 가도 되나요?</div><div class="faq-a">주중은 현장 입장 가능한 곳이 많지만, 주말은 미리 연락을 권장합니다.</div></div>
<div class="faq-item"><div class="faq-q">드레스코드가 있나요?</div><div class="faq-a">스마트 캐주얼 이상 권장. 슬리퍼와 반바지는 입장 제한될 수 있습니다.</div></div>
<div class="faq-item"><div class="faq-q">담당자에게 직접 연락하려면?</div><div class="faq-a">전화번호가 표시된 업소는 직접 통화 가능합니다. 각 업소 상세 페이지에서 연락처를 확인하세요.</div></div>
<div class="faq-item"><div class="faq-q">혼자 가도 괜찮나요?</div><div class="faq-a">1인 방문객도 많습니다. 담당자가 자리를 안내해 드립니다.</div></div>
<div class="faq-item"><div class="faq-q">어느 요일이 가장 좋나요?</div><div class="faq-a">금요일과 토요일이 피크입니다. 주중은 한산해서 여유롭게 즐길 수 있습니다.</div></div>

<!-- ═══ 16. [슬롯머신] 오늘의 운세 — 매일 다른 결과 = 매일 방문 ═══ -->
<div style="padding:24px;background:linear-gradient(135deg,#FEF3C7,#FDE68A);border-radius:var(--radius);margin-bottom:24px;text-align:center;border:1px solid #F59E0B;">
  <div style="font-size:32px;margin-bottom:8px;">🔮</div>
  <h3 style="font-size:18px;margin-bottom:8px;color:#92400E;">오늘의 밤 운세</h3>
  <p style="font-size:14px;color:#78350F;margin-bottom:12px;">별자리를 선택하면 오늘 밤 운명이 결정됩니다</p>
  <div id="fortuneZodiac" style="display:flex;flex-wrap:wrap;gap:6px;justify-content:center;margin-bottom:12px;">
  </div>
  <div id="fortuneResult" style="display:none;padding:16px;background:#fff;border-radius:var(--radius-sm);margin-top:12px;"></div>
</div>

<!-- ═══ 17. [넷플릭스] 오토플레이 — 다음 콘텐츠 자동 유도 ═══ -->
<div id="autoplaySection" style="padding:24px;background:var(--bg-secondary);border-radius:var(--radius);margin:24px 0;text-align:center;border:1px solid var(--border);">
  <p style="font-size:13px;color:var(--text-muted);margin-bottom:4px;" id="autoplayTimer">다음 콘텐츠까지 5초</p>
  <div style="height:3px;background:var(--bg-tertiary);border-radius:2px;overflow:hidden;margin-bottom:12px;">
    <div id="autoplayBar" style="height:100%;background:var(--accent);width:0%;transition:width 1s linear;"></div>
  </div>
  <a href="/ranking/" target="_blank" rel="noopener noreferrer" style="font-size:15px;font-weight:700;color:var(--accent);">인기 순위 TOP20 보러가기 →</a>
</div>

<!-- ═══ 18. [틱톡] "이번주 숨은 명소" — 매주 바뀜 = 매주 방문 ═══ -->
<div style="padding:20px;background:var(--bg-secondary);border:1px solid var(--border);border-radius:var(--radius);margin-bottom:24px;">
  <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px;">
    <span style="font-size:20px;">💎</span>
    <h3 style="font-size:16px;margin:0;">이번주 숨은 명소</h3>
    <span style="font-size:11px;padding:2px 8px;background:var(--accent-light);color:var(--accent);border-radius:12px;font-weight:700;">NEW</span>
  </div>
  <div id="hiddenGem"></div>
</div>

<!-- ═══ 17. 커뮤니티 미리보기 ═══ -->
<div class="section-header"><span class="section-badge">💬</span><h2>커뮤니티 인기글</h2></div>
{[{t:'수원찬스돔나이트 금요일 후기',a:'익**',l:24},{t:'혼자 가도 괜찮은 곳 추천해주세요',a:'밤**',l:31},{t:'첫방문인데 드레스코드 어디까지?',a:'새**',l:45}].map(p =>
  <a href="/community/" target="_blank" rel="noopener noreferrer" style="display:block;padding:14px;background:var(--card-bg);border:1px solid var(--border);border-radius:var(--radius-sm);margin-bottom:8px;">
    <div style="font-size:15px;font-weight:600;color:var(--text);margin-bottom:4px;">{p.t}</div>
    <div style="font-size:13px;color:var(--text-muted);">{p.a} · ♥ {p.l}</div>
  </a>
)}

<script is:inline define:vars={{ allMini: JSON.stringify(allMini) }}>
(function() {
try {
  var venues = JSON.parse(allMini);
  var totalVenues = venues.length;

  // ── 검색 ──
  var input = document.getElementById('searchInput');
  var results = document.getElementById('searchResults');
  if (input && results) {
    input.addEventListener('input', function() {
      var q = this.value.trim().toLowerCase();
      if (q.length < 1) { results.style.display = 'none'; return; }
      var matches = venues.filter(function(v) {
        return v.n.toLowerCase().indexOf(q) >= 0 || v.r.toLowerCase().indexOf(q) >= 0 || v.tn.toLowerCase().indexOf(q) >= 0;
      }).slice(0, 8);
      results.innerHTML = matches.length === 0
        ? '<div style="padding:16px;color:#666;font-size:14px;">검색 결과가 없습니다</div>'
        : matches.map(function(v) {
            return '<a href="/venue/' + v.s + '/" target="_blank" rel="noopener noreferrer" style="display:block;padding:12px 16px;border-bottom:1px solid #eee;color:#111;font-size:15px;text-decoration:none;"><strong>' + v.n + '</strong> <span style="color:#666;font-size:13px;">' + v.r + ' · ' + v.tn + '</span></a>';
          }).join('');
      results.style.display = 'block';
    });
    document.addEventListener('click', function(e) {
      if (!input.contains(e.target) && !results.contains(e.target)) results.style.display = 'none';
    });
    document.querySelectorAll('.search-tag').forEach(function(tag) {
      tag.addEventListener('click', function() { input.value = this.getAttribute('data-q'); input.dispatchEvent(new Event('input')); input.focus(); });
    });
  }

  // ── 슬롯머신 룰렛 (가변보상 — 슬롯머신 심리) ──
  var slotBtn = document.getElementById('slotBtn');
  var slotAgain = document.getElementById('slotAgain');
  var slotDisplay = document.getElementById('slotDisplay');
  var slotCounter = document.getElementById('slotCounter');
  var spinCount = 0;
  function spin() {
    spinCount++;
    slotBtn.style.display = 'none';
    slotAgain.style.display = 'none';
    slotDisplay.style.borderColor = 'var(--accent)';
    slotDisplay.style.background = 'linear-gradient(135deg,#F5F0FF,#EDE9FE)';
    var count = 0;
    var speed = 50;
    var interval = setInterval(function() {
      var rv = venues[Math.floor(Math.random() * totalVenues)];
      slotDisplay.innerHTML = '<div style="font-size:18px;font-weight:800;">' + rv.n + '</div><div style="font-size:13px;color:var(--text-muted);margin-top:2px;">' + rv.r + ' · ' + rv.tn + '</div>';
      count++;
      speed += 8;
      if (count > 20) {
        clearInterval(interval);
        var final = venues[Math.floor(Math.random() * totalVenues)];
        slotDisplay.innerHTML = '<a href="/venue/' + final.s + '/" target="_blank" rel="noopener noreferrer" style="color:inherit;text-decoration:none;"><div style="font-size:22px;font-weight:800;color:var(--accent);">🎉 ' + final.n + '</div><div style="font-size:14px;color:var(--text-secondary);margin-top:4px;">' + final.r + ' · ' + final.tn + '</div><div style="font-size:14px;color:var(--accent);margin-top:8px;font-weight:600;">→ 상세 보기</div></a>';
        slotAgain.style.display = 'inline-flex';
        slotCounter.textContent = spinCount + '번째 추천 · 마음에 안 들면 한 번 더!';
      }
    }, speed);
  }
  if (slotBtn) slotBtn.addEventListener('click', spin);
  if (slotAgain) slotAgain.addEventListener('click', spin);

  // ── VS 투표 (참여 → 결과 보상) ──
  var voted = localStorage.getItem('vs_main_voted');
  var pctA = 57, pctB = 43;
  document.querySelectorAll('.vs-pick').forEach(function(btn) {
    if (voted) {
      btn.style.pointerEvents = 'none';
      btn.querySelector('.vs-pct').style.filter = 'none';
      btn.querySelector('.vs-pct').textContent = btn.getAttribute('data-side') === 'a' ? pctA + '%' : pctB + '%';
      if (btn.getAttribute('data-side') === voted) btn.style.borderColor = 'var(--accent)';
    }
    btn.addEventListener('click', function() {
      var side = this.getAttribute('data-side');
      localStorage.setItem('vs_main_voted', side);
      document.querySelectorAll('.vs-pick').forEach(function(b) {
        b.style.pointerEvents = 'none';
        b.querySelector('.vs-pct').style.filter = 'none';
        b.querySelector('.vs-pct').textContent = b.getAttribute('data-side') === 'a' ? pctA + '%' : pctB + '%';
        if (b.getAttribute('data-side') === side) b.style.borderColor = 'var(--accent)';
      });
    });
  });

  // ── 자이가르닉 진행률 (미완성 강박) ──
  var cards = document.querySelectorAll('[data-feed-item]');
  var allCards = document.querySelectorAll('.venue-card');
  var total = allCards.length;
  window.addEventListener('scroll', function() {
    var viewed = 0;
    allCards.forEach(function(c) { if (c.getBoundingClientRect().top < window.innerHeight) viewed++; });
    var pct = Math.min(100, Math.round(viewed / total * 100));
    var txt = document.getElementById('progressText');
    var bar = document.getElementById('progressBar');
    var pctEl = document.getElementById('progressPct');
    if (txt) txt.textContent = total + '곳 중 ' + viewed + '곳 탐색 완료';
    if (bar) bar.style.width = pct + '%';
    if (pctEl) pctEl.textContent = pct + '%';
  });

  // ── 피드 아이템 스크롤 등장 (틱톡식) ──
  var observer = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (entry.isIntersecting) {
        entry.target.style.opacity = '1';
        entry.target.style.transform = 'translateY(0)';
      }
    });
  }, { threshold: 0.1 });
  cards.forEach(function(c) { observer.observe(c); });

  // ── [슬롯머신] 오늘의 운세 — 매일 다른 결과 ──
  var zodiacs = ['♈양자리','♉황소자리','♊쌍둥이자리','♋게자리','♌사자자리','♍처녀자리','♎천칭자리','♏전갈자리','♐사수자리','♑염소자리','♒물병자리','♓물고기자리'];
  var fortunes = [
    '오늘 밤은 새로운 인연을 만날 운명. 용기를 내서 말을 걸어보세요.',
    '분위기 좋은 라운지에서 조용한 대화가 행운을 가져옵니다.',
    '오늘은 댄스 플로어에서 빛나는 날. 몸을 맡기세요.',
    '친구와 함께 가면 2배로 즐거운 밤이 될 거예요.',
    '오늘의 럭키 컬러는 보라. 보라색 옷을 입으면 주목받습니다.',
    '혼자 가도 좋은 날. 바 카운터에서 바텐더와 대화해보세요.',
    '금요일 밤, 뭔가 터질 예감입니다. 일단 예약부터 잡으세요.',
    '오늘 밤 VIP석 운이 들어왔습니다. 놓치면 아쉬울 걸요.',
    '새로운 장르의 음악을 시도해보세요. 의외의 발견이 있습니다.',
    '오늘은 조용한 곳보다 에너지 넘치는 곳이 어울립니다.',
    '가까운 사람에게 연락하세요. 함께 갈 사람이 기다리고 있어요.',
    '오늘의 행운 업소가 당신을 부르고 있습니다. 직감을 믿으세요.'
  ];
  var fortuneBox = document.getElementById('fortuneZodiac');
  var fortuneResult = document.getElementById('fortuneResult');
  if (fortuneBox) {
    zodiacs.forEach(function(z, i) {
      var btn = document.createElement('button');
      btn.textContent = z;
      btn.style.cssText = 'padding:6px 12px;border-radius:20px;font-size:12px;font-weight:600;border:1px solid #D97706;background:#fff;color:#92400E;cursor:pointer;transition:all .2s;';
      btn.addEventListener('click', function() {
        var dayCode = new Date().getDate() + i;
        var fortune = fortunes[dayCode % fortunes.length];
        var luckyVenue = venues[dayCode % totalVenues];
        fortuneResult.style.display = 'block';
        fortuneResult.innerHTML = '<p style="font-size:16px;font-weight:700;color:#92400E;margin-bottom:8px;">' + z + ' 오늘의 운세</p><p style="font-size:15px;color:#78350F;line-height:1.7;margin-bottom:12px;">' + fortune + '</p><a href="/venue/' + luckyVenue.s + '/" target="_blank" rel="noopener noreferrer" style="display:block;padding:12px;background:#FEF3C7;border-radius:8px;text-decoration:none;color:#92400E;font-weight:600;text-align:center;">✨ 행운의 업소: ' + luckyVenue.n + ' →</a>';
        fortuneBox.querySelectorAll('button').forEach(function(b) { b.style.background = '#fff'; });
        btn.style.background = '#FDE68A';
      });
      fortuneBox.appendChild(btn);
    });
  }

  // ── [틱톡] 이번주 숨은 명소 — 매주 바뀜 ──
  var hiddenGem = document.getElementById('hiddenGem');
  if (hiddenGem && totalVenues > 0) {
    var weekCode = Math.floor(Date.now() / (7 * 24 * 60 * 60 * 1000));
    var gem = venues[(weekCode * 7) % totalVenues];
    hiddenGem.innerHTML = '<a href="/venue/' + gem.s + '/" target="_blank" rel="noopener noreferrer" style="display:block;padding:14px;background:var(--card-bg);border:1px solid var(--border);border-radius:var(--radius-sm);text-decoration:none;color:var(--text);"><div style="font-size:16px;font-weight:700;margin-bottom:4px;">' + gem.n + '</div><div style="font-size:13px;color:var(--text-muted);">' + gem.r + ' · ' + gem.tn + '</div><div style="font-size:14px;color:var(--text-secondary);margin-top:8px;line-height:1.6;">' + (gem.d || '') + '</div></a>';
  }

  // ── 오토플레이 (넷플릭스 자동재생) ──
  var autoSection = document.getElementById('autoplaySection');
  var autoBar = document.getElementById('autoplayBar');
  var autoTimer = document.getElementById('autoplayTimer');
  var autoStarted = false;
  var autoObserver = new IntersectionObserver(function(entries) {
    if (entries[0].isIntersecting && !autoStarted) {
      autoStarted = true;
      var sec = 5;
      autoBar.style.width = '0%';
      var iv = setInterval(function() {
        sec--;
        autoBar.style.width = ((5 - sec) / 5 * 100) + '%';
        if (autoTimer) autoTimer.textContent = '다음 콘텐츠까지 ' + sec + '초';
        if (sec <= 0) { clearInterval(iv); if (autoTimer) autoTimer.textContent = '아래에서 더 많은 콘텐츠를 확인하세요'; }
      }, 1000);
    }
  }, { threshold: 0.5 });
  if (autoSection) autoObserver.observe(autoSection);
} catch(e) { console.warn('[NOLCOOL] Home script error:', e); }
})();
</script>

</BaseLayout>
