---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getVenuesByType, venues, SITE_URL, MAIN_SITE_URL } from '../../data/venues';

const yojeongVenues = getVenuesByType('yojeong');
const regions = [...new Set(yojeongVenues.map(v => v.region))].sort();

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "전통 한정식 연회 공간",
  "numberOfItems": yojeongVenues.length,
  "itemListElement": yojeongVenues.slice(0,5).map((v, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "url": `${SITE_URL}/venue/${v.slug}/`
  }))
};
---

<BaseLayout
  title={`요정 ${yojeongVenues.length}곳 — 좌식 연회와 전통 공연의 격조`}
  description="기와지붕 아래 좌식 상차림에 가야금·대금 라이브 연주까지. 비즈니스 접대부터 회갑·칠순 경조사까지, 격식 있는 자리를 잡으려면 여기부터 보세요."
  canonical={`${SITE_URL}/yojeong/`}
  ogImage={`${SITE_URL}/og/yojeong.svg`}
  jsonLd={jsonLd}
>

<div class="listing-header">
  <h1>요정 {yojeongVenues.length}곳 연회 공간 소개</h1>
</div>
<h2 class="cat-intro-title">요정의 격, 도심에서는 절대 못 하는 경험</h2>
<div class="cat-intro">
  기와 지붕 아래 좌식 상차림이 펼쳐지고, 가야금과 대금 선율이 공간을 채우는 전통 연회장입니다.
  수십 가지 반찬이 오르는 한정식 코스는 계절 식재료에 따라 구성이 바뀌며,
  대규모 경조사부터 소규모 밀담까지 자리 규모에 맞는 개별 방을 배정받습니다.
  고급 목재 마감과 한지 조명이 어우러진 실내에서 전통 공연을 감상하며 밥을 먹는 경험 —
  서울 한복판에서는 절대 못 합니다. 이 공간에서만 가능한 시간입니다.
  주류는 전통주부터 고급 양주까지 폭넓게 준비되어 있으며,
  숙련된 안내원이 자리 진행을 도와 격조 있는 모임을 완성합니다.
  예약 시 코스 등급과 공연 포함 여부를 미리 상담하시면 좋습니다.
</div>

<!-- 업소 리스트 (서버사이드 렌더링!) -->
<div style="max-width:480px;margin:0 auto;padding:0 16px;">
  {yojeongVenues.map((v, i) => (
    <a href={`/venue/${v.slug}/`} target="_blank" rel="noopener noreferrer" class="venue-card">
      <div class="venue-card-header"><span class="rank-badge">{i + 1}</span></div>
      <div class="venue-card-name">{v.name}</div>
      <div class="venue-card-desc">{v.shortDesc}</div>
      <div class="venue-card-tags">{v.tags.slice(0, 3).map(t => <span class="venue-tag">#{t}</span>)}</div>
      {v.nickname && <div class="venue-card-contact">담당: {v.nickname}{v.phone ? ` | ${v.phone}` : ''}</div>}
    </a>
  ))}
</div>

<!-- 첫 방문 가이드 -->
<div class="fv-section">
  <h2 class="fv-title">요정 예약 전 참고사항</h2>
  <div class="fv-item">
    <div class="fv-q" onclick="this.parentElement.classList.toggle('open')">한복 아니어도 괜찮아?<span class="fv-arrow">▼</span></div>
    <div class="fv-a"><p>한복 아니어도 됩니다. 비즈니스 정장이나 단정한 캐주얼이면 충분합니다. 좌식이라 편한 바지가 좋고, 짧은 치마나 타이트한 옷은 앉을 때 불편합니다.</p></div>
  </div>
  <div class="fv-item">
    <div class="fv-q" onclick="this.parentElement.classList.toggle('open')">코스 요리 가격대는?<span class="fv-arrow">▼</span></div>
    <div class="fv-a"><p>입장료는 없으며, 코스 요리 기준 1인당 15만~50만 원대입니다. 주류와 공연이 포함된 패키지도 있습니다. 인원 수에 따라 총액이 달라지니 사전 상담이 필수입니다.</p></div>
  </div>
  <div class="fv-item">
    <div class="fv-q" onclick="this.parentElement.classList.toggle('open')">소규모 모임도 되나?<span class="fv-arrow">▼</span></div>
    <div class="fv-a"><p>전통 연회 특성상 최소 4인 이상 예약을 기본으로 합니다. 소규모 방부터 30인 이상 대연회장까지 인원에 맞게 배정됩니다.</p></div>
  </div>
  <div class="fv-item">
    <div class="fv-q" onclick="this.parentElement.classList.toggle('open')">예약은 언제까지 해야 해?<span class="fv-arrow">▼</span></div>
    <div class="fv-a"><p>반드시 사전 예약이 필요합니다. 코스 구성·인원·공연 유무를 미리 결정해야 하므로, 최소 3일 전에는 전화 상담을 권장합니다. 주말과 명절 시즌은 2주 전 예약이 안전합니다.</p></div>
  </div>
</div>

<div class="cat-extra" style="max-width:480px;margin:16px auto;padding:0 16px;">
  <p style="font-size:14px;line-height:1.7;color:var(--text-secondary);">기와 처마 아래 앉아서 가야금 선율 들으며 한정식 코스를 받으면, 시간이 조선시대로 돌아간 것 같습니다. 이 경험은 서울 식당에서는 절대 못 합니다.</p>
</div>

<!-- 인기 시간대 -->
<div class="pop-times">
  <h2 class="pop-times-title">방문 많은 요일과 시간</h2>
  <div class="pop-chart">
    {['월','화','수','목','금','토','일'].map((d, i) => {
      const pct = [30,70,50,85,100,45,15][i];
      return (
        <div class="pop-bar-wrap">
          <div class={`pop-bar${pct >= 80 ? ' peak' : ''}`} style={`height:${pct}%`}></div>
          <div class="pop-day">{d}</div>
        </div>
      );
    })}
  </div>
  <div class="pop-hours">연회 집중 시간: 18:00 – 22:00</div>
</div>

<!-- 매거진 -->
<div class="cat-mag">
  <h2 class="cat-mag-title">요정 관련 이야기</h2>
  <div class="cat-mag-grid">
    <a href="/magazine/" target="_blank" rel="noopener noreferrer" class="cat-mag-card" style="background:linear-gradient(135deg,#4a1942,#be185d)">
      <div class="cat-mag-cat">한정식</div>
      <div class="cat-mag-name">요정 코스 요리, 반찬 30가지가 나오는 순서와 이유</div>
      <div class="cat-mag-desc">첫 접시부터 후식까지 상차림 흐름을 풀어봤습니다.</div>
    </a>
    <a href="/magazine/" target="_blank" rel="noopener noreferrer" class="cat-mag-card" style="background:linear-gradient(135deg,#78350f,#d97706)">
      <div class="cat-mag-cat">전통주</div>
      <div class="cat-mag-name">요정에서 양주 대신 막걸리 시켜야 하는 이유</div>
      <div class="cat-mag-desc">한정식 코스에 어울리는 술 궁합, 의외로 전통주가 답입니다.</div>
    </a>
    <a href="/magazine/" target="_blank" rel="noopener noreferrer" class="cat-mag-card" style="background:linear-gradient(135deg,#1e1b4b,#4338ca)">
      <div class="cat-mag-cat">공연</div>
      <div class="cat-mag-name">가야금 연주 들으며 밥 먹는 경험, 해본 사람만 안다</div>
      <div class="cat-mag-desc">식사 중 국악 라이브, 실제로 분위기가 어떻게 달라지는지.</div>
    </a>
  </div>
</div>

<div class="cta-section mt-md" style="max-width:480px;margin:24px auto;padding:0 16px">
  <a href={MAIN_SITE_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm">요정 상세 안내 →</a>
</div>

</BaseLayout>
