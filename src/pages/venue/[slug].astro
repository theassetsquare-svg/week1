---
import BaseLayout from '../../layouts/BaseLayout.astro';
import VenueCard from '../../components/VenueCard.astro';
import { venues, getVenueBySlug, MAIN_SITE_URL, SITE_URL } from '../../data/venues';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = () => {
  return venues.map(v => ({ params: { slug: v.slug } }));
};

const { slug } = Astro.params;
const venue = getVenueBySlug(slug as string)!;

const typeUrl = venue.type === 'night' ? '/nights/' : venue.type === 'club' ? '/clubs/' : '/lounges/';

const sameRegionDiffType = venues.filter(v => v.id !== venue.id && v.regionSlug === venue.regionSlug && v.type !== venue.type);
const sameType = venues.filter(v => v.id !== venue.id && v.type === venue.type);
const related = sameRegionDiffType.length > 0 ? sameRegionDiffType.slice(0, 1) : sameType.slice(0, 1);

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": venue.name,
    "description": venue.description,
    "address": {
      "@type": "PostalAddress",
      "addressLocality": venue.region,
      "addressRegion": venue.region,
      "addressCountry": "KR"
    },
    ...(venue.phone ? { "telephone": venue.phone } : {}),
    "url": `${SITE_URL}/venue/${venue.slug}/`
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": venue.faq.map(f => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": f.a
      }
    }))
  }
];

const canonicalUrl = `${SITE_URL}/venue/${venue.slug}/`;
---

<BaseLayout
  title={venue.seoTitle}
  description={venue.seoDescription}
  canonical={canonicalUrl}
  jsonLd={jsonLd}
>
  <nav class="breadcrumb">
    <a href="/">홈</a>
    <span class="sep">›</span>
    <a href={typeUrl}>목록</a>
    <span class="sep">›</span>
    <span>{venue.name}</span>
  </nav>

  <section class="detail-hero">
    <span class="badge badge-purple">{venue.region}</span>
    <h1 style="margin-top:12px;">{venue.h1Title}</h1>
    <p style="font-size:15px;color:var(--text-secondary);line-height:1.8;margin-top:12px;">
      {venue.description}
    </p>
    {venue.nickname && venue.phone && (
      <div class="detail-contact">
        담당: <strong>{venue.nickname}</strong> |
        <a href={`tel:${venue.phone}`}>{venue.phone}</a>
      </div>
    )}
    {venue.nickname && !venue.phone && (
      <div class="detail-contact">
        담당: <strong>{venue.nickname}</strong>
      </div>
    )}
  </section>

  <div class="cta-section">
    <p>전체 리뷰 + 실시간 순위</p>
    <a href={MAIN_SITE_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm">
      메인에서 확인 →
    </a>
  </div>

  <section class="detail-section">
    <h2>분위기</h2>
    <p>{venue.atmosphere}</p>
  </section>

  <section class="detail-section">
    <h2>포인트</h2>
    <div class="highlights-grid">
      {venue.highlights.map(h => (
        <div class="highlight-item">{h}</div>
      ))}
    </div>
  </section>

  <section class="detail-section">
    <h2>사운드</h2>
    <p>{venue.music}</p>
  </section>

  <div class="blur-lock">
    <div class="blur-lock-content">
      <p>★★★★☆ 리뷰 평점</p>
      <p>"실제 방문자 리뷰"</p>
      <p>"현장 분위기 후기"</p>
      <p>"상세 평가 및 추천"</p>
    </div>
    <div class="blur-lock-overlay">
      <p>전체 리뷰+평점 보기</p>
      <a href={MAIN_SITE_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm">
        메인에서 무료 확인 →
      </a>
    </div>
  </div>

  <section class="detail-section">
    <h2>타임라인</h2>
    <div class="timeline">
      {venue.timeline.map(t => (
        <div class="timeline-item">
          <div class="timeline-time">{t.time}</div>
          <div class="timeline-event">{t.event}</div>
        </div>
      ))}
    </div>
  </section>

  <div class="cta-section">
    <p>이 업소 vs 다른 업소 비교하기</p>
    <a href={MAIN_SITE_URL} target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-sm">
      비교 서비스 바로가기 →
    </a>
  </div>

  <section class="detail-section">
    <h2>자주 묻는 질문</h2>
    {venue.faq.map(f => (
      <div class="faq-item">
        <div class="faq-q">{f.q}</div>
        <div class="faq-a">{f.a}</div>
      </div>
    ))}
  </section>

  <div class="cta-section">
    <p>나도 리뷰 쓰기</p>
    <a href={MAIN_SITE_URL} target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-sm">
      메인에서 작성 →
    </a>
  </div>

  <div class="text-center mt-md mb-lg">
    <button
      class="share-btn"
      onclick={`navigator.clipboard?navigator.clipboard.writeText('${MAIN_SITE_URL}').then(function(){var t=document.getElementById('toast');t.textContent='링크가 복사되었습니다';t.classList.add('show');setTimeout(function(){t.classList.remove('show')},2000)}):void 0`}
    >
      📋 이 업소 친구에게 공유
    </button>
  </div>

  {related.length > 0 && (
    <section class="detail-section">
      <h2>비슷한 곳</h2>
      {related.map(r => (
        <VenueCard venue={r} />
      ))}
      <div class="cta-section" style="margin-top:16px;">
        <p>비슷한 곳 더 보기</p>
        <a href={MAIN_SITE_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm">
          메인에서 확인 →
        </a>
      </div>
    </section>
  )}

  <div class="cta-section">
    <p>이 업소 할인 쿠폰 받기</p>
    <a href={MAIN_SITE_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm">
      회원 전용 쿠폰 →
    </a>
  </div>

  <div class="cta-section mt-md">
    <h3>맞춤 추천 받기</h3>
    <p>취향, 위치, 인원수에 맞춘 추천</p>
    <a href={MAIN_SITE_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
      메인에서 무료 체험 →
    </a>
  </div>

  <div class="next-venue" id="nextVenue">
    <a href="#">다음 업소 보기 →</a>
  </div>

  <script is:inline define:vars={{ slug, venues: venues.map(v => ({ slug: v.slug })) }}>
    (function() {
      var idx = venues.findIndex(function(v) { return v.slug === slug; });
      var nextSlug = venues[(idx + 1) % venues.length].slug;
      var link = document.querySelector('#nextVenue a');
      if (link) link.href = '/venue/' + nextSlug + '/';
    })();
  </script>
</BaseLayout>
