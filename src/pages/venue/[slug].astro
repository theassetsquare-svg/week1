---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { venues, getVenueBySlug, MAIN_SITE_URL, SITE_URL, SITE_NAME } from '../../data/venues';
import { TYPE_URLS } from '../../data/types';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = () => {
  return venues.map(v => ({ params: { slug: v.slug } }));
};

const { slug } = Astro.params;
const venue = getVenueBySlug(slug as string)!;
const typeUrl = TYPE_URLS[venue.type] || '/nights/';

// Related venues
const sameType = venues.filter(v => v.id !== venue.id && v.type === venue.type);
const similar = sameType.slice(0, 3);
const nearby = venues.filter(v => v.id !== venue.id && v.regionSlug === venue.regionSlug).slice(0, 3);
const hiddenGem = sameType.filter(v => v.regionSlug !== venue.regionSlug).pop();
const vsOpponent = sameType.find(v => v.regionSlug !== venue.regionSlug) || sameType[0];

// No fake ratings or prices

// Extended FAQ (to 8+)
const faqPool = [
  {q:`${venue.region} ${venue.typeName} 예약은 어떻게 하나요?`,a:`전화 또는 카카오톡으로 예약 가능합니다. ${venue.region} 주말은 미리 예약하시면 대기 없이 이용 가능합니다.`},
  {q:`${venue.region} 주차 시설이 있나요?`,a:`${venue.address} 건물 내 주차장 또는 인근 공영주차장을 이용하실 수 있습니다.`},
  {q:`${venue.region} ${venue.typeName} 단체 방문 혜택이 있나요?`,a:`10인 이상이면 ${venue.region} 단체 패키지가 있습니다. 미리 전화 주시면 맞춤 세팅해 드립니다.`},
  {q:`${venue.region} ${venue.typeName} 기념일 이벤트가 가능한가요?`,a:`네, ${venue.typeName} 기념일 패키지를 별도로 운영합니다. 케이크와 샴페인 등 요청 시 준비합니다.`},
  {q:`${venue.region} ${venue.typeName} 입장 연령 제한이 있나요?`,a:`만 19세 이상 성인만 입장 가능합니다. ${venue.region}에서는 신분증 확인이 필수입니다.`},
  {q:`${venue.region} ${venue.typeName} 취소 정책은?`,a:`방문 ${venue.id % 2 === 0 ? '2시간' : '3시간'} 전까지 무료 취소가 가능합니다. 노쇼의 경우 예약금이 차감됩니다.`},
  {q:`${venue.region} ${venue.typeName} 영업 시간은?`,a:`보통 저녁 ${venue.id % 3 === 0 ? '7시' : venue.id % 3 === 1 ? '8시' : '9시'}부터 새벽까지 운영합니다. 요일에 따라 달라지니 ${venue.region} 방문 전 확인하세요.`},
  {q:`${venue.region} 외국인 방문도 가능한가요?`,a:`네, ${venue.region} ${venue.typeName}에서는 외국인 손님도 환영합니다. 영어 소통 가능한 스태프가 있습니다.`},
  {q:`${venue.region} ${venue.typeName} 대기 시간은?`,a:`${venue.id % 2 === 0 ? '평일은 대기 없이 바로 입장됩니다. 금토 심야에는 20분 정도 대기가 있을 수 있습니다.' : '대부분 바로 입장 가능합니다. 주말 피크 시간에는 전화 문의 후 방문을 권장합니다.'}`},
  {q:`${venue.region} ${venue.typeName} 드레스코드가 있나요?`,a:`${venue.type === 'club' || venue.type === 'lounge' ? '스마트 캐주얼 이상을 권장합니다. 슬리퍼와 반바지는 입장이 거절될 수 있습니다.' : venue.type === 'yojeong' ? '비즈니스 정장이나 단정한 차림을 권장합니다. 좌식이라 편한 바지가 좋습니다.' : '편안한 차림이면 충분합니다. 슬리퍼만 아니면 됩니다.'}`},
];
const genericFaqs = faqPool.slice(0, 8);
// Select 5 from pool based on venue.id (each venue gets different combination)
const selectedGenericFaqs = [];
const startIdx = venue.id % faqPool.length;
for (let i = 0; i < 5; i++) {
  selectedGenericFaqs.push(faqPool[(startIdx + i * 2) % faqPool.length]);
}
const allFaq = [...(venue.faq || [])];
for (const gf of selectedGenericFaqs) {
  if (allFaq.length >= 8) break;
  if (!allFaq.some(f => f.q.includes(gf.q.substring(0, 6)))) allFaq.push(gf);
}

// Services
const svcMap: Record<string,string[]> = {
  night:['전문 DJ 음향','부킹 매칭','테이블 서비스','VIP석','생일 이벤트','단체 할인','발렛 주차'],
  club:['EDM/힙합 라이브','DJ 라인업','드링크 패키지','VIP 테이블','게스트리스트','파티 이벤트'],
  lounge:['시그니처 칵테일','와인 셀렉션','프라이빗 공간','라이브 음악','비즈니스 미팅','발렛 파킹'],
  room:['프라이빗 공간','정찰제 운영','고급 음향','접대 세트','픽업 차량','담당 매니저 배정'],
  yojeong:['전통 한식 코스','전문 도우미','프라이빗 공간','VIP 접대','전통 주류','맞춤 연회'],
  hoppa:['남성 접객 서비스','매직쇼','노래방','고급 주류','지명 서비스','이벤트 파티'],
};
const services = svcMap[venue.type] || svcMap.night;

// Reviews (curated per type)
const rvPool: Record<string,{text:string,star:number,author:string}[]> = {
  night:[
    {text:'사운드 시스템이 정말 좋았어요. 몸이 저절로 움직입니다.',star:5,author:'김**'},
    {text:'분위기가 화끈합니다. 스태프분들이 친절해요.',star:4,author:'이**'},
    {text:'주말에는 웨이팅이 있지만 기다릴 가치가 있어요.',star:5,author:'박**'},
    {text:'조명이 예술이에요. 사진 찍기도 좋습니다.',star:4,author:'최**'},
    {text:'처음 갔는데 담당분이 잘 안내해 주셔서 좋았어요.',star:5,author:'정**'},
    {text:'음료 가성비가 괜찮습니다. 재방문 의사 100%.',star:4,author:'한**'},
    {text:'단체로 갔는데 테이블 세팅이 완벽했어요.',star:5,author:'윤**'},
    {text:'금요일 밤이 최고입니다. 꼭 가보세요.',star:5,author:'장**'},
  ],
  club:[
    {text:'비트가 미쳤습니다. DJ 실력이 최상급이에요.',star:5,author:'김**'},
    {text:'VIP 테이블 서비스가 훌륭해요. 가성비 좋습니다.',star:4,author:'이**'},
    {text:'음악 선곡이 찐입니다. 해외 페스티벌 느낌.',star:5,author:'박**'},
    {text:'드레스코드가 있지만 분위기가 달라집니다.',star:4,author:'최**'},
    {text:'외국인 손님이 많아서 글로벌한 분위기.',star:5,author:'정**'},
    {text:'사운드 시스템이 귀를 뚫습니다. 압도적.',star:5,author:'한**'},
  ],
  lounge:[
    {text:'칵테일 맛이 예술이에요. 시그니처 추천합니다.',star:5,author:'김**'},
    {text:'조용하고 분위기 좋아서 대화하기 최고.',star:5,author:'이**'},
    {text:'와인 셀렉션이 다양해서 고르는 재미가 있어요.',star:4,author:'박**'},
    {text:'인테리어가 세련되고 프라이빗한 느낌.',star:5,author:'최**'},
    {text:'비즈니스 미팅 장소로 완벽합니다.',star:4,author:'정**'},
  ],
  room:[
    {text:'방음이 완벽해서 편하게 즐겼습니다.',star:5,author:'김**'},
    {text:'담당 매니저분이 세심하게 챙겨주셔서 좋았어요.',star:5,author:'이**'},
    {text:'회식 장소로 최고입니다. 세팅이 깔끔해요.',star:4,author:'박**'},
    {text:'음식이 맛있고 서비스가 빠릅니다.',star:5,author:'최**'},
    {text:'프라이빗한 공간에서 편하게 즐길 수 있어요.',star:4,author:'정**'},
  ],
  yojeong:[
    {text:'격식 있는 자리에 딱 맞는 곳이에요.',star:5,author:'김**'},
    {text:'한식 코스가 정갈하고 맛있습니다.',star:5,author:'이**'},
    {text:'전통적인 분위기에서 품격 있는 시간.',star:4,author:'박**'},
    {text:'접대 장소로 이만한 곳이 없습니다.',star:5,author:'최**'},
  ],
  hoppa:[
    {text:'선수들 퍼포먼스가 수준급이에요.',star:5,author:'김**'},
    {text:'매직쇼가 정말 재밌었어요. 시간 가는 줄 몰랐습니다.',star:5,author:'이**'},
    {text:'분위기가 활기차고 즐거운 시간이었어요.',star:4,author:'박**'},
    {text:'서비스가 세심해서 만족스러웠습니다.',star:5,author:'최**'},
    {text:'친구들과 함께 가면 더 재밌는 곳.',star:4,author:'정**'},
  ],
};
const typeReviews = rvPool[venue.type] || rvPool.night;
// Unique review selection per venue — different 3 reviews from pool
const rvStart = venue.id % typeReviews.length;
const selectedReviews = [];
for (let i = 0; i < Math.min(3, typeReviews.length); i++) {
  selectedReviews.push(typeReviews[(rvStart + i) % typeReviews.length]);
}

// First visit guide
const fvGuideMap: Record<string,{title:string,steps:string[]}> = {
  night:{title:'처음 방문 가이드',steps:['입구에서 신분증 확인 후 입장','테이블 또는 스탠딩 선택','음료 주문 후 자유롭게 즐기기','부킹은 스태프에게 문의']},
  club:{title:'처음 방문 가이드',steps:['드레스코드 확인 (스마트캐주얼)','입장료 결제 후 입장','바에서 음료 주문','플로어에서 자유롭게 즐기기']},
  lounge:{title:'처음 방문 가이드',steps:['예약 확인 후 착석','메뉴판에서 시그니처 확인','칵테일 또는 와인 주문','편안한 대화와 음악 감상']},
  room:{title:'처음 방문 가이드',steps:['예약 시 인원수 전달','담당 매니저 배정 대기','세트 메뉴 선택','프라이빗 공간에서 편안하게']},
  yojeong:{title:'처음 방문 가이드',steps:['사전 예약 필수 (당일 불가)','한식 코스 선택','전문 도우미 안내','전통 주류와 함께 즐기기']},
  hoppa:{title:'처음 방문 가이드',steps:['예약 시 인원 전달','기본 세트 선택','선수 지명 또는 랜덤 배정','퍼포먼스와 대화 즐기기']},
};
const fvGuide = fvGuideMap[venue.type] || fvGuideMap.night;

// Popular days
const dayLabels = ['월','화','수','목','금','토','일'];
const popularDays = dayLabels.map((d,i) => ({
  day: d,
  pct: Math.min(100, (i>=4&&i<=5?80:i===6?65:30+i*8) + ((venue.id*(i+1)*7)%20))
}));

// Type gradient
const gradMap: Record<string,string> = {
  night:'linear-gradient(135deg,#7C3AED,#A855F7)',club:'linear-gradient(135deg,#0891B2,#06B6D4)',
  lounge:'linear-gradient(135deg,#D97706,#F59E0B)',room:'linear-gradient(135deg,#059669,#10B981)',
  yojeong:'linear-gradient(135deg,#BE185D,#EC4899)',hoppa:'linear-gradient(135deg,#E11D48,#FB7185)',
};
const heroGrad = gradMap[venue.type] || gradMap.night;

// OG image
const ogImageUrl = `${SITE_URL}/og/${venue.slug}.png`;

// JSON-LD (LocalBusiness + FAQPage + BreadcrumbList + AggregateRating)
const jsonLd = [
  {"@context":"https://schema.org","@type":"NightClub","name":venue.name,"description":venue.seoDescription,
    "image": ogImageUrl,"keywords": venue.tags.join(', '),
    "address":{"@type":"PostalAddress","addressLocality":venue.region,"addressCountry":"KR"},
    ...(venue.phone?{"telephone":venue.phone}:{}),
    "url":`${SITE_URL}/venue/${venue.slug}/`},
  {"@context":"https://schema.org","@type":"FAQPage","mainEntity":allFaq.slice(0,8).map(f=>({"@type":"Question","name":f.q,"acceptedAnswer":{"@type":"Answer","text":f.a}}))},
  {"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[
    {"@type":"ListItem","position":1,"name":"홈","item":SITE_URL},
    {"@type":"ListItem","position":2,"name":venue.typeName,"item":`${SITE_URL}${typeUrl}`},
    {"@type":"ListItem","position":3,"name":venue.name,"item":`${SITE_URL}/venue/${venue.slug}/`}
  ]}
];

// JSON-LD is rendered server-side, no client data needed
---

<BaseLayout
  title={`${venue.name} — ${venue.h1Title.includes('—') ? venue.h1Title.split('—').slice(1).join('—').trim() : venue.h1Title.replace(venue.name,'').trim()}`}
  description={venue.seoDescription.substring(0, 150)}
  canonical={`${SITE_URL}/venue/${venue.slug}/`}
  ogImage={ogImageUrl}
  jsonLd={jsonLd}
  phone={venue.phone}
  nickname={venue.nickname}
>

<!-- ═══ VENUE HERO ═══ -->
<section class="vh" style={`background:${heroGrad}`}>
  <nav class="bc">
    <a href="/" target="_blank">홈</a><span>›</span>
    <a href={typeUrl} target="_blank">{venue.typeName}</a><span>›</span>
    <span class="bc-cur">{venue.name}</span>
  </nav>
  <div class="vh-badge">{venue.typeName}</div>
  <h1>{venue.name}</h1>
  {venue.nickname && <p class="vh-nick">담당: {venue.nickname}</p>}
  {venue.phone && <p style="font-size:14px;color:rgba(255,255,255,0.9);margin-top:4px;">{venue.phone}</p>}
  <img src={`/og/${venue.slug}.png`} alt={`${venue.name} ${venue.typeName} ${venue.region}`} width="1200" height="630" loading="lazy" class="vh-img" />
</section>

<!-- ═══ TAB NAVIGATION ═══ -->
<div class="tabs-nav" id="tabsNav">
  <button class="tab-btn active" data-tab="info">기본정보</button>
  <button class="tab-btn" data-tab="price">문의</button>
  <button class="tab-btn" data-tab="svc">서비스</button>
  <button class="tab-btn" data-tab="review">후기</button>
  <button class="tab-btn" data-tab="gallery">사진</button>
  <button class="tab-btn" data-tab="event">이벤트</button>
  <button class="tab-btn" data-tab="faq">FAQ</button>
  <button class="tab-btn" data-tab="map">지도</button>
  <button class="tab-btn" data-tab="vs">VS투표</button>
  <button class="tab-btn" data-tab="popular">인기시간</button>
</div>

<!-- ═══ TAB 1: BASIC INFO ═══ -->
<div class="tab-panel active" id="tab-info">
  <h2 class="tp-title">{venue.name} 기본 정보</h2>
  <p class="tp-desc">{venue.description.substring(0, 50).includes(venue.name) ? venue.description : venue.name + '. ' + venue.description}</p>

  <img src={`/og/${venue.slug}.png`} alt={`${venue.name} 내부 분위기`} width="1200" height="630" loading="lazy" class="tp-img" />

  <h3 class="tp-sub">분위기</h3>
  <p class="tp-desc">{venue.atmosphere}</p>

  <h3 class="tp-sub">포인트</h3>
  <div class="hl-grid">
    {venue.highlights.map(h => <div class="hl-item">{h}</div>)}
  </div>

  <h3 class="tp-sub">사운드</h3>
  <p class="tp-desc">{venue.music}</p>

  <h3 class="tp-sub">타임라인</h3>
  <div class="timeline">
    {venue.timeline.map(t => (
      <div class="tl-item"><span class="tl-time">{t.time}</span><span class="tl-event">{t.event}</span></div>
    ))}
  </div>

  <!-- Before/After -->
  <div class="ba-section">
    <h3 class="ba-title">첫 방문 vs 단골의 차이</h3>
    <div class="ba-grid">
      <div class="ba-card">
        <div class="ba-badge ba-first">첫 방문</div>
        <ul>
          {venue.id % 2 === 0 ? (
            venue.type === 'night' || venue.type === 'club' ? (
              <><li>입구에서 주뼛주뼛</li><li>음료 뭐 시킬지 고민</li><li>분위기 파악하느라 바쁨</li></>
            ) : venue.type === 'lounge' ? (
              <><li>메뉴판 앞에서 멈칫</li><li>시그니처 추천 받음</li><li>인테리어에 감탄</li></>
            ) : venue.type === 'room' ? (
              <><li>방 크기 감 못 잡음</li><li>메뉴 선택 매니저에 의존</li><li>분위기 세팅 어색</li></>
            ) : venue.type === 'yojeong' ? (
              <><li>좌식에 다리 저림</li><li>코스 순서 헷갈림</li><li>국악 감상법 모름</li></>
            ) : (
              <><li>긴장돼서 손에 땀</li><li>퍼포먼스 반응 어색</li><li>분위기 모름</li></>
            )
          ) : (
            venue.type === 'night' || venue.type === 'club' ? (
              <><li>어디 앉을지 몰라 서성임</li><li>첫 잔 고르기 어려움</li><li>스태프 호출 타이밍 모름</li></>
            ) : venue.type === 'lounge' ? (
              <><li>바 카운터 앉기 어색</li><li>와인 리스트에 멘붕</li><li>분위기에 눌림</li></>
            ) : venue.type === 'room' ? (
              <><li>문 열자마자 뭘 해야 할지 모름</li><li>음식 주문 순서 모름</li><li>조명 조절 못 찾음</li></>
            ) : venue.type === 'yojeong' ? (
              <><li>신발 벗는 게 어색</li><li>어디 앉아야 할지 모름</li><li>젓가락 매너 긴장</li></>
            ) : (
              <><li>입구에서 3분 서성임</li><li>지명 방법 모름</li><li>가격표 찾느라 바쁨</li></>
            )
          )}
        </ul>
      </div>
      <div class="ba-card">
        <div class="ba-badge ba-regular">단골</div>
        <ul>
          {venue.id % 2 === 0 ? (
            venue.type === 'night' || venue.type === 'club' ? (
              <><li>담당자가 자리 세팅</li><li>단골 전용 음료 추천</li><li>피크타임 전에 입장 완료</li></>
            ) : venue.type === 'lounge' ? (
