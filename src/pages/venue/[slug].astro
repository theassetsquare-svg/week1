        const stories = venue.type === 'night' || venue.type === 'club'
          ? ['입구부터 심장이 뛴다','조명이 바뀌는 순간','DJ가 분위기를 끌어올릴 때','이 테이블이 오늘의 무대','새벽 2시, 피크 타임','라스트콜 직전의 에너지']
          : venue.type === 'lounge'
          ? ['문을 열면 재즈가 맞이한다','바텐더의 손끝에서 시작','시그니처 칵테일 한 잔','창밖 야경이 안주','카운터석의 고독한 시간','마지막 한 모금의 여운']
          : venue.type === 'room'
          ? ['문 닫으면 우리만의 공간','테이블 세팅 완료','건배 한 번이면 분위기 UP','담당 매니저의 센스','프라이빗한 그 순간','다음에 또 오자는 말']
          : venue.type === 'yojeong'
          ? ['기와지붕 아래 첫 걸음','상차림이 펼쳐지는 순간','가야금 선율이 흐를 때','계절 식재료의 정성','한 잔 술에 격조가 깃든다','연회의 마무리']
          : ['첫인상은 긴장','퍼포먼스가 시작되면','매직쇼에 눈을 못 뗀다','대화가 깊어지는 시간','분위기 최고조','또 오겠다는 확신'];
        return stories.map((story, i) => (
          <div class={`swipe-slide sg-${((venue.id+i)%10)+1}`}>
            <span class="sg-label">{story}</span>
          </div>
        ));
      })()}
    </div>
