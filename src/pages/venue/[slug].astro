<!-- ═══ STYLES ═══ -->
<style>
.vh{position:relative;padding:80px 16px 32px;color:#fff;text-align:center;border-radius:0 0 24px 24px;margin:-1px -16px 0;overflow:hidden}
.vh h1{font-size:24px;font-weight:800;margin:12px 0 8px;text-shadow:0 2px 8px rgba(0,0,0,.2)}
.vh-badge{display:inline-block;padding:4px 12px;border-radius:20px;background:rgba(255,255,255,.2);font-size:12px;font-weight:700;backdrop-filter:blur(4px);color:#fff}
.vh-nick{color:#FDE68A;font-weight:700;font-size:15px}
.vh-stars{font-size:16px;color:#FDE68A;margin-top:8px}
.vh-rating{font-size:20px;font-weight:800;margin-left:6px}
.vh-rc{font-size:13px;color:rgba(255,255,255,.7);margin-left:4px}
.vh-img{width:100%;max-width:480px;margin:20px auto 0;border-radius:12px;display:block;aspect-ratio:1200/630}
.bc{display:flex;gap:6px;font-size:12px;color:rgba(255,255,255,.7);justify-content:center;margin-bottom:12px}
.bc a{color:rgba(255,255,255,.85);text-decoration:none}
.bc a:hover{color:#fff}
.bc-cur{color:#fff;font-weight:600}

/* Tabs */
.tabs-nav{display:flex;overflow-x:auto;gap:4px;padding:16px 0;position:sticky;top:98px;z-index:10;background:#fff;border-bottom:1px solid var(--border);-webkit-overflow-scrolling:touch}
.tabs-nav::-webkit-scrollbar{display:none}
.tab-btn{padding:10px 14px;border-radius:20px;font-size:13px;font-weight:600;white-space:nowrap;color:var(--text-secondary);background:var(--bg-secondary);border:1px solid var(--border);transition:all .2s;font-family:inherit;cursor:pointer;flex-shrink:0;min-height:44px}
.tab-btn.active{background:var(--accent);color:#fff;border-color:var(--accent)}
.tab-panel{display:none;padding:24px 0 32px}
.tab-panel.active{display:block}
.tp-title{font-size:20px;margin-bottom:16px}
.tp-sub{font-size:16px;font-weight:700;margin:20px 0 12px;color:var(--text)}
.tp-desc{font-size:15px;line-height:1.8;color:var(--text-secondary);margin-bottom:16px}
.tp-note{font-size:13px;color:var(--text-muted);margin-bottom:16px}
.tp-img{width:100%;border-radius:12px;margin:16px 0;aspect-ratio:1200/630}

/* Highlights */
.hl-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.hl-item{background:var(--bg-secondary);padding:12px;border-radius:10px;font-size:14px;font-weight:600;text-align:center;color:var(--text)}

/* Timeline */
.tl-item{display:flex;gap:12px;padding:10px 0;border-bottom:1px solid var(--border-light)}
.tl-time{font-weight:700;color:var(--accent);min-width:48px;font-size:14px}
.tl-event{font-size:14px;color:var(--text-secondary)}

/* Price table */
.price-table{width:100%;border-collapse:collapse;font-size:15px}
.price-table th{text-align:left;padding:12px;background:var(--bg-secondary);font-weight:700;border-bottom:2px solid var(--border)}
.price-table td{padding:12px;border-bottom:1px solid var(--border-light)}
/* price removed */

/* Services */
.svc-grid{display:grid;gap:8px}
.svc-item{display:flex;align-items:center;gap:8px;padding:12px;background:var(--bg-secondary);border-radius:10px;font-size:14px;font-weight:600}
.svc-check{color:var(--accent);font-weight:800}

/* Reviews */
.rv-summary{display:flex;gap:20px;margin-bottom:20px;padding:20px;background:var(--bg-secondary);border-radius:16px}
.rv-big{font-size:40px;font-weight:800;color:var(--accent);display:flex;align-items:baseline}
.rv-big span{font-size:16px;color:var(--text-muted);margin-left:2px}
.rv-bars{flex:1;display:flex;flex-direction:column;gap:4px;justify-content:center}
.rv-bar-row{display:flex;align-items:center;gap:6px;font-size:12px;color:var(--text-muted)}
.rv-bar{flex:1;height:8px;background:var(--border-light);border-radius:4px;overflow:hidden}
.rv-bar-fill{height:100%;background:var(--accent);border-radius:4px}
.rv-pct{min-width:30px;text-align:right}
.rv-card{padding:16px;background:var(--card-bg);border:1px solid var(--border);border-radius:12px;margin-bottom:8px}
.rv-stars{color:#F59E0B;font-size:13px;margin-bottom:6px}
.rv-text{font-size:14px;line-height:1.6;color:var(--text-secondary);font-style:italic;margin-bottom:8px}
.rv-author{font-size:12px;color:var(--text-muted)}

/* Swipe Gallery — 10장 터치 스와이프 */
.swipe-gallery{overflow:hidden;border-radius:16px;position:relative;touch-action:pan-y}
.swipe-track{display:flex;transition:transform .3s ease;will-change:transform}
.swipe-slide{min-width:100%;aspect-ratio:4/3;display:flex;align-items:flex-end;justify-content:center;padding:16px;position:relative;overflow:hidden}
.sg-label{color:#fff;font-size:14px;font-weight:700;text-shadow:0 2px 8px rgba(0,0,0,.5);background:rgba(0,0,0,.3);padding:6px 14px;border-radius:20px;backdrop-filter:blur(4px)}
.sg-1{background:linear-gradient(135deg,#1e1b4b,#4338ca)}.sg-2{background:linear-gradient(135deg,#0c4a6e,#0891b2)}
.sg-3{background:linear-gradient(135deg,#78350f,#d97706)}.sg-4{background:linear-gradient(135deg,#064e3b,#059669)}
.sg-5{background:linear-gradient(135deg,#4a1942,#be185d)}.sg-6{background:linear-gradient(135deg,#7f1d1d,#dc2626)}
.sg-7{background:linear-gradient(135deg,#312e81,#6366f1)}.sg-8{background:linear-gradient(135deg,#134e4a,#14b8a6)}
.sg-9{background:linear-gradient(135deg,#581c87,#a855f7)}.sg-10{background:linear-gradient(135deg,#7c2d12,#ea580c)}
.swipe-dots{display:flex;gap:6px;justify-content:center;margin-top:12px}
.swipe-dot{width:8px;height:8px;border-radius:50%;background:var(--border);transition:all .2s;cursor:pointer}
.swipe-dot.active{background:var(--accent);width:20px;border-radius:4px}

/* View Counter */
.view-counter{text-align:center;padding:12px 16px;margin:16px 0;background:var(--bg-secondary);border-radius:var(--radius);font-size:14px;color:var(--text-secondary)}
.view-counter strong{color:var(--accent);font-size:16px}

/* Fortune Section */
.fortune-section{padding:24px 0;border-top:1px solid var(--border-light)}
.fortune-section h2{font-size:18px;margin-bottom:12px}
.fortune-card{background:linear-gradient(135deg,#1e1b4b,#4338ca);padding:24px;border-radius:16px;text-align:center;color:#fff}
.fortune-q{font-size:15px;margin-bottom:12px;line-height:1.6}
.fortune-result{margin-top:16px;font-size:15px;line-height:1.7;padding:16px;background:rgba(255,255,255,.1);border-radius:12px;backdrop-filter:blur(4px)}

/* Quiz Section */
.quiz-section{padding:24px 0;border-top:1px solid var(--border-light)}
.quiz-section h2{font-size:18px;margin-bottom:12px}
.quiz-card{background:var(--card-bg);border:2px solid var(--border);padding:20px;border-radius:16px}
.quiz-q{font-size:15px;font-weight:700;margin-bottom:16px;line-height:1.5}
.quiz-options{display:flex;flex-direction:column;gap:8px}
.quiz-opt{padding:12px 16px;border:1px solid var(--border);border-radius:10px;font-size:14px;cursor:pointer;transition:all .2s;background:#fff;text-align:left;font-family:var(--font);color:var(--text)}
.quiz-opt:hover{border-color:var(--accent);background:var(--accent-light)}
.quiz-opt.correct{background:#dcfce7;border-color:#22c55e;color:#15803d}
.quiz-opt.wrong{background:#fee2e2;border-color:#ef4444;color:#b91c1c}
.quiz-result{margin-top:12px;font-size:14px;font-weight:600;text-align:center}

/* Secret Section */
.secret-section{margin:24px 0;padding:24px;background:linear-gradient(135deg,#0f172a,#1e293b);border-radius:16px;color:#fff;animation:secretFadeIn .5s ease}
.secret-header{font-size:18px;font-weight:800;margin-bottom:12px;text-align:center}
.secret-text{font-size:14px;line-height:1.8;color:rgba(255,255,255,.9)}
@keyframes secretFadeIn{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}

/* Infinite Scroll */
.infinite-loader{opacity:0;transform:translateY(30px);transition:all .5s ease}
.infinite-loader.visible{opacity:1;transform:translateY(0)}
.load-more-trigger{text-align:center;padding:20px;font-size:13px;color:var(--text-muted);display:none}
.load-more-trigger.show{display:block}
.spinner{display:inline-block;width:16px;height:16px;border:2px solid var(--border);border-top-color:var(--accent);border-radius:50%;animation:spin .6s linear infinite;vertical-align:middle;margin-right:8px}
@keyframes spin{to{transform:rotate(360deg)}}

/* Events */
.event-list{display:flex;flex-direction:column;gap:12px}
.event-card{padding:20px;background:var(--card-bg);border:1px solid var(--border);border-radius:16px}
.event-card h3{font-size:16px;margin:8px 0 4px}
.event-card p{font-size:14px;color:var(--text-secondary)}
.ev-badge{display:inline-block;padding:3px 10px;border-radius:20px;font-size:11px;font-weight:700;background:rgba(139,92,246,.1);color:#7C3AED}

/* Map */
.map-info{margin-bottom:16px}
.map-addr,.map-region{font-size:14px;margin-bottom:6px;color:var(--text-secondary)}
.map-placeholder{height:200px;border-radius:16px;display:flex;align-items:center;justify-content:center;color:rgba(255,255,255,.8);font-size:20px;font-weight:700;margin-top:16px}

/* VS */
.vs-arena{display:grid;grid-template-columns:1fr auto 1fr;gap:12px;align-items:stretch}
.vs-card{background:var(--card-bg);border:2px solid var(--border);border-radius:16px;padding:20px;text-align:center;cursor:pointer;transition:all .3s}
.vs-card:hover{border-color:var(--accent);transform:translateY(-4px)}
.vs-card.voted{cursor:default}
.vs-card .vs-nm{font-size:16px;font-weight:700;margin-bottom:4px}
.vs-card .vs-mt{font-size:12px;color:var(--text-muted);margin-bottom:10px}
.vs-card .vs-pct{font-size:28px;font-weight:800;color:var(--accent);filter:blur(8px);transition:filter .5s}
.vs-card.revealed .vs-pct{filter:none}
.vs-badge{display:flex;align-items:center;justify-content:center;width:40px;height:40px;border-radius:50%;background:var(--accent);color:#fff;font-weight:800;font-size:14px;align-self:center}

/* Popular chart */
.pop-chart{display:flex;align-items:flex-end;gap:8px;height:160px;padding:16px 0;border-bottom:2px solid var(--border-light)}
.pop-bar-wrap{flex:1;display:flex;flex-direction:column;align-items:center;height:100%}
.pop-bar{width:100%;max-width:40px;background:var(--accent);border-radius:6px 6px 0 0;transition:height .5s;margin-top:auto}
.pop-label{font-size:13px;font-weight:600;color:var(--text-muted);margin-top:8px}

/* First visit */
.fv-section{padding:32px 0;border-top:1px solid var(--border-light)}
.fv-section h2{font-size:18px;margin-bottom:8px}
.fv-section p{font-size:14px;color:var(--text-secondary);margin-bottom:16px}
.fv-steps{padding-left:20px;margin-bottom:16px}
.fv-steps li{font-size:14px;line-height:2;color:var(--text-secondary);list-style:decimal}

/* Recommendations */
.recs-section{padding:32px 0;border-top:1px solid var(--border-light)}
.recs-section h2{font-size:20px;margin-bottom:16px}
.recs-grid{display:flex;flex-direction:column;gap:8px}
.rec-card{display:block;padding:14px 16px;background:var(--card-bg);border:1px solid var(--border);border-radius:12px;text-decoration:none;color:var(--text);transition:all .2s}
.rec-card:hover{border-color:var(--accent);transform:translateX(4px)}
.rec-name{font-weight:700;font-size:15px}
.rec-meta{font-size:12px;color:var(--text-muted);margin-top:2px}
.comm-list{display:flex;flex-direction:column;gap:8px}
.comm-item{display:block;padding:14px 16px;background:var(--bg-secondary);border-radius:12px;text-decoration:none;color:var(--text);transition:background .2s}
.comm-item:hover{background:var(--accent-light)}
.comm-item strong{display:block;font-size:14px;margin-bottom:2px}
.comm-item span{font-size:13px;color:var(--text-muted)}

/* Sticky phone bar */
.sticky-bar{position:fixed;bottom:64px;left:0;right:0;max-width:480px;margin:0 auto;z-index:50;background:linear-gradient(135deg,#7C3AED,#8B5CF6);padding:12px 16px;display:flex;align-items:center;gap:12px;box-shadow:0 -4px 20px rgba(139,92,246,.2)}
@media(min-width:481px){.sticky-bar{bottom:0}}
.sb-info{flex:1;color:#fff}
.sb-name{font-size:14px;font-weight:700;color:#fff}
.sb-nick{font-size:12px;color:rgba(255,255,255,.8)}
.sb-call{display:flex;align-items:center;justify-content:center;width:48px;height:48px;border-radius:50%;background:#22c55e;color:#fff;font-size:22px;text-decoration:none;flex-shrink:0;transition:transform .2s}
.sb-call:hover{transform:scale(1.1)}
</style>

<!-- ═══ STICKY PHONE BAR (SSR) ═══ -->
{venue.phone && (
  <div class="sticky-bar">
    <div class="sb-info">
      <div class="sb-name">전화 문의</div>
      {venue.nickname && <div class="sb-nick">담당: {venue.nickname}</div>}
    </div>
    <a href={`tel:${venue.phone}`} target="_blank" rel="noopener noreferrer" class="sb-call">📞</a>
  </div>
)}

<!-- ═══ CLIENT SCRIPTS ═══ -->
<script is:inline>
(function(){
try {
  // ═══ TABS ═══
  document.querySelectorAll('.tab-btn').forEach(function(btn){
    btn.addEventListener('click',function(){
      document.querySelectorAll('.tab-btn').forEach(function(b){b.classList.remove('active');});
      document.querySelectorAll('.tab-panel').forEach(function(p){p.classList.remove('active');});
      btn.classList.add('active');
      var panel = document.getElementById('tab-'+btn.getAttribute('data-tab'));
      if(panel) panel.classList.add('active');
    });
  });

  // ═══ 스와이프 갤러리 (터치 + 드래그) ═══
  var track = document.getElementById('swipeTrack');
  var gallery = document.getElementById('swipeGallery');
  var dots = document.querySelectorAll('.swipe-dot');
  var counterEl = document.getElementById('galleryCounter');
  if (track && gallery) {
    var current = 0;
    var total = 10;
    var startX = 0;
    var diffX = 0;
    var dragging = false;
    function goTo(idx) {
      if (idx < 0) idx = total - 1;
      if (idx >= total) idx = 0;
      current = idx;
      track.style.transform = 'translateX(-' + (current * 100) + '%)';
      dots.forEach(function(d, i) { d.classList.toggle('active', i === current); });
      if (counterEl) counterEl.textContent = (current + 1) + ' / ' + total;
    }
    gallery.addEventListener('touchstart', function(e) { startX = e.touches[0].clientX; dragging = true; }, { passive: true });
    gallery.addEventListener('touchmove', function(e) { if (dragging) diffX = e.touches[0].clientX - startX; }, { passive: true });
    gallery.addEventListener('touchend', function() {
      if (Math.abs(diffX) > 40) goTo(current + (diffX < 0 ? 1 : -1));
      diffX = 0; dragging = false;
    });
    gallery.addEventListener('mousedown', function(e) { startX = e.clientX; dragging = true; e.preventDefault(); });
    gallery.addEventListener('mousemove', function(e) { if (dragging) diffX = e.clientX - startX; });
    gallery.addEventListener('mouseup', function() {
      if (Math.abs(diffX) > 40) goTo(current + (diffX < 0 ? 1 : -1));
      diffX = 0; dragging = false;
    });
    gallery.addEventListener('mouseleave', function() { diffX = 0; dragging = false; });
    dots.forEach(function(d, i) { d.addEventListener('click', function() { goTo(i); }); });
    // 자동재생 (멈출 수 없게!)
    var autoPlay = setInterval(function() { goTo(current + 1); }, 4000);
    gallery.addEventListener('touchstart', function() { clearInterval(autoPlay); });
    document.addEventListener('visibilitychange', function() {
      if (document.hidden) clearInterval(autoPlay);
      else autoPlay = setInterval(function() { goTo(current + 1); }, 4000);
    });
  }

  // ═══ VS 투표 (인터랙티브) ═══
  var vsLeft = document.getElementById('vsLeft');
  var vsRight = document.getElementById('vsRight');
  var vsResult = document.getElementById('vsResult');
  var vsVoted = false;
  function handleVote(chosen) {
    if (vsVoted) return;
    vsVoted = true;
    var leftPct = 30 + Math.floor(Math.random() * 41);
    var rightPct = 100 - leftPct;
    var leftEl = document.getElementById('vsLeftPct');
    var rightEl = document.getElementById('vsRightPct');
    if (leftEl) leftEl.textContent = leftPct + '%';
    if (rightEl) rightEl.textContent = rightPct + '%';
    if (vsLeft) { vsLeft.classList.add('voted', 'revealed'); }
    if (vsRight) { vsRight.classList.add('voted', 'revealed'); }
    var total = 127 + Math.floor(Math.random() * 300);
    if (vsResult) {
      vsResult.style.display = 'block';
      vsResult.textContent = '총 ' + total + '명이 투표에 참여했습니다';
    }
    // 도파민 보상
    if (typeof triggerDopamine === 'function') triggerDopamine();
  }
  if (vsLeft) vsLeft.addEventListener('click', function() { handleVote('left'); });
  if (vsRight) vsRight.addEventListener('click', function() { handleVote('right'); });

  // ═══ 오늘 N명 조회 카운터 ═══
  var viewNum = document.getElementById('viewCountNum');
  if (viewNum) {
    var slug = window.location.pathname.split('/').filter(Boolean).pop() || 'home';
    var vKey = 'bk_vc_' + slug + '_' + new Date().toDateString();
    var vc = parseInt(localStorage.getItem(vKey) || '0') + 1;
    localStorage.setItem(vKey, vc.toString());
    var base = 38 + (slug.length * 7 + new Date().getHours() * 3) % 150;
    viewNum.textContent = base + vc;
  }

  // ═══ 오늘 밤의 운세 ═══
  var fortuneBtn = document.getElementById('fortuneBtn');
  var fortuneResult = document.getElementById('fortuneResult');
  var fortuneQ = document.getElementById('fortuneQ');
  if (fortuneBtn) {
    var fortunes = [
      '🌙 오늘 밤, 운명적인 만남이 기다리고 있다. 용기를 내면 잊지 못할 밤이 된다.',
      '🔥 에너지가 폭발하는 밤! 댄스플로어 한가운데가 당신의 자리다.',
      '✨ 조용한 대화 속에서 깊은 인연을 만날 수 있는 밤. 라운지가 어울린다.',
      '💎 오늘은 VIP 대접받을 운세. 과감하게 좋은 자리를 잡아라.',
      '🎵 음악에 몸을 맡기면 스트레스가 녹는 밤. DJ 선곡이 당신 취향에 딱 맞는다.',
      '🌟 친구와 함께하면 행운이 배로! 단체로 가면 이벤트 당첨 확률 UP.',
      '🎯 예약하고 가면 대기 없이 바로 입장. 오늘은 계획적인 밤이 이득이다.',
      '🍸 첫 잔이 운명을 바꾼다. 시그니처 칵테일을 주문해봐라.',
      '⚡ 자정 이후가 하이라이트. 일찍 가지 말고 느긋하게 준비해라.',
      '🏆 오늘 밤 당신은 주인공이다. 자신감을 가지고 나서면 모든 게 풀린다.'
    ];
    fortuneBtn.addEventListener('click', function() {
      var idx = Math.floor(Math.random() * fortunes.length);
      if (fortuneResult) {
        fortuneResult.textContent = fortunes[idx];
        fortuneResult.style.display = 'block';
      }
      fortuneBtn.style.display = 'none';
      if (fortuneQ) fortuneQ.textContent = '오늘 밤의 운세가 도착했습니다';
    });
  }

  // ═══ 밤문화 퀴즈 ═══
  var quizQ = document.getElementById('quizQ');
  var quizOpts = document.getElementById('quizOptions');
  var quizResult = document.getElementById('quizResult');
  if (quizQ && quizOpts) {
    var quizzes = [
      { q: '한국에서 나이트클럽 입장 가능 연령은?', opts: ['만 18세', '만 19세', '만 20세', '만 21세'], ans: 1 },
      { q: '클럽에서 "부킹"이란?', opts: ['음료 주문', '테이블 예약', '이성 매칭', 'VIP 입장'], ans: 2 },
      { q: '나이트클럽 피크타임은 보통 몇 시?', opts: ['밤 9시', '밤 11시', '새벽 1시', '새벽 3시'], ans: 2 },
      { q: '라운지와 클럽의 가장 큰 차이점은?', opts: ['음료 종류', '음악 볼륨과 분위기', '영업시간', '입장료'], ans: 1 },
      { q: '요정(料亭)의 원래 뜻은?', opts: ['놀이공원', '일본식 고급 요리집', '노래방', '호텔 바'], ans: 1 },
      { q: '호빠에서 "지명"이란?', opts: ['예약하기', '원하는 직원 선택', '음료 주문', 'VIP 좌석'], ans: 1 }
    ];
    var qi = Math.floor(Math.random() * quizzes.length);
    var quiz = quizzes[qi];
    quizQ.textContent = quiz.q;
    quiz.opts.forEach(function(opt, i) {
      var btn = document.createElement('button');
      btn.className = 'quiz-opt';
      btn.textContent = opt;
      btn.addEventListener('click', function() {
        if (quizResult.style.display === 'block') return;
        quizOpts.querySelectorAll('.quiz-opt').forEach(function(b, j) {
          if (j === quiz.ans) b.classList.add('correct');
          else if (j === i && i !== quiz.ans) b.classList.add('wrong');
        });
        quizResult.style.display = 'block';
        quizResult.textContent = i === quiz.ans ? '🎉 정답! 밤문화 전문가시네요!' : '😅 아쉽지만 오답! 정답은 "' + quiz.opts[quiz.ans] + '"입니다.';
        quizResult.style.color = i === quiz.ans ? '#22c55e' : '#ef4444';
      });
      quizOpts.appendChild(btn);
    });
  }

  // ═══ "이 업소의 비밀" — 스크롤 80%에 나타남 ═══
  var secretSection = document.getElementById('secretSection');
  var secretText = document.getElementById('secretText');
  var secretShown = false;
  if (secretSection && secretText) {
    var secrets = [
      '금요일 밤 11시 이전에 입장하면 웨이팅 없이 바로 들어갈 수 있다. 단골들만 아는 꿀팁이다.',
      '담당자에게 "밤키 보고 왔다"고 말하면 자리 배정이 달라진다는 후문이 있다.',
      '화장실 옆 복도 끝에 숨겨진 프라이빗 공간이 있다. 아는 사람만 이용한다.',
      '주중 수요일이 사실 가성비 최강이다. 사람도 적당하고, 이벤트도 있다.',
      '오픈 직후 30분이 자리 선점 골든타임이다. 이때 가면 소파석을 잡을 수 있다.',
      '매월 마지막 주 금요일에 깜짝 이벤트가 열린다. 스태프한테 슬쩍 물어보면 알려준다.'
    ];
    var si = Math.floor(Math.random() * secrets.length);
    secretText.textContent = secrets[si];
    window.addEventListener('scroll', function() {
      if (secretShown) return;
      var pct = window.scrollY / (document.documentElement.scrollHeight - window.innerHeight);
      if (pct > 0.8) {
        secretSection.style.display = 'block';
        secretShown = true;
      }
    });
  }

  // ═══ 무한스크롤 — 추천 더 보기 ═══
  var infiniteLoader = document.getElementById('infiniteLoader');
  var loadMoreTrigger = document.getElementById('loadMoreTrigger');
  if (infiniteLoader) {
    var ioLoader = new IntersectionObserver(function(entries) {
      entries.forEach(function(e) {
        if (e.isIntersecting) {
          infiniteLoader.classList.add('visible');
          if (loadMoreTrigger) loadMoreTrigger.classList.add('show');
          setTimeout(function() {
            if (loadMoreTrigger) loadMoreTrigger.style.display = 'none';
          }, 2000);
          ioLoader.disconnect();
        }
      });
    }, { threshold: 0.1 });
    ioLoader.observe(infiniteLoader);
  }
})();
</script>

</BaseLayout>
