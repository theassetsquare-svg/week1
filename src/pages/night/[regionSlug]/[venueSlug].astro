---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import IntroSection from '../../../components/IntroSection.astro';
import { venues, getVenuesByType, getVenue, getVenueUrl, getReadingTime, guides } from '../../../utils/venues';

export function getStaticPaths() {
  return venues.filter(v => v.type === 'night').map(v => ({
    params: { regionSlug: v.regionSlug, venueSlug: v.urlSlug || v.venueSlug },
    props: { venue: v },
  }));
}

const { venue } = Astro.props;
const v = venue;
const siteUrl = 'https://night-4qy.pages.dev';
const venueUrl = getVenueUrl(v);
const updateDate = '2026-02-18';

const sameRegion = v.relatedVenueIds.sameRegion.map(id => getVenue(id)).filter(Boolean).slice(0, 3);
const sameType = v.relatedVenueIds.sameType.map(id => getVenue(id)).filter(Boolean).slice(0, 3);
const nearby = v.relatedVenueIds.nearby.map(id => getVenue(id)).filter(Boolean).slice(0, 2);
const relatedVenues = [...sameRegion, ...sameType, ...nearby].slice(0, 6);

const shortName = v.name_display.replace(v.region + ' ', '').replace(/\s+나이트\s*$/,'').trim() || v.urlSlug || v.venueSlug;
const isSuyuShampoo = v.regionSlug === 'suyu' && (v.urlSlug === '샴푸' || v.venueSlug === '샴푸');
const ogImage = isSuyuShampoo
  ? `${siteUrl}/venues/suyu/%EC%83%B4%ED%91%B8-%EB%82%98%EC%9D%B4%ED%8A%B8/thumbnail-hwangjungmin.png`
  : `${siteUrl}${encodeURI(v.images[0].src)}`;
const canonicalUrl = `${siteUrl}${encodeURI(venueUrl)}`;
const title = v.pageTitle || `${v.name_display} 안내`;
const description = v.metaDescription || `${v.name_display} - ${v.teaser?.slice(0, 100) || ''}`;
const h1Title = v.h1Title || `${v.name_display} 방문 가이드`;
const si = v.sectionIntros || {};
const conclusionText = v.conclusionText || `${v.name_display}의 밤은 그렇게 시작됩니다.`;

const mapUrl = `https://map.naver.com/v5/search/${encodeURIComponent(v.name_display)}`;

const tocItems = [
  { id: 'summary', label: '한눈에 보기' },
  { id: 'hook', label: '첫인상' },
  { id: 'atmosphere', label: '무드 & 톤' },
  { id: 'story', label: '하룻밤 이야기' },
  { id: 'gallery', label: '포토' },
  { id: 'timeline', label: '밤의 흐름' },
  { id: 'planner', label: '나만의 코스' },
  { id: 'checklist', label: '준비물' },
  { id: 'music', label: '라이브 & 음악' },
  { id: 'location', label: '오시는 길' },
  { id: 'faq', label: '궁금한 점' },
  { id: 'conclusion', label: '에디터 한마디' },
  { id: 'related', label: '함께 보면 좋은 곳' },
];

const jsonLdSchemas: object[] = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": title,
    "description": description,
    "url": canonicalUrl,
    "dateModified": updateDate,
    "inLanguage": "ko",
    "isPartOf": {
      "@type": "WebSite",
      "name": "나이트코리아 전국 나이트·클럽·라운지 정보",
      "url": siteUrl
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "홈", "item": siteUrl + "/" },
      { "@type": "ListItem", "position": 2, "name": "나이트", "item": siteUrl + "/nights/" },
      { "@type": "ListItem", "position": 3, "name": v.region, "item": siteUrl + "/region/" + v.regionSlug + "/" },
      { "@type": "ListItem", "position": 4, "name": v.name_display }
    ]
  }
];

if (v.faq && v.faq.length > 0) {
  jsonLdSchemas.push({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": v.faq.slice(0, 8).map((f: { q: string; a: string }) => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": f.a
      }
    }))
  });
}
---
<BaseLayout title={title} description={description} canonical={canonicalUrl} ogImage={ogImage} jsonLd={jsonLdSchemas}>
  <section class="venue-hero-immersive venue-hero-immersive--night">
    <div class="container content-narrow">
      <div class="breadcrumb">
        <a href="/">홈</a><span>/</span>
        <a href="/nights/">나이트 목록</a><span>/</span>
        {v.region !== shortName && <><a href={`/region/${v.regionSlug}/`}>{v.region}</a><span>/</span></>}
        <span>{shortName}</span>
      </div>
      {v.regionSlug === 'suyu' && (v.urlSlug === '샴푸' || v.venueSlug === '샴푸') ? (
        <img src="/venues/suyu/%EC%83%B4%ED%91%B8-%EB%82%98%EC%9D%B4%ED%8A%B8/thumbnail-hwangjungmin.svg" alt="수유샴푸 황정민" class="venue-hero-img" width="800" height="400" loading="eager" style="width:100%;height:auto;border-radius:12px;margin-bottom:16px;" />
      ) : (
        <img src={encodeURI(v.images[0].src)} alt={`${v.name_display} 대표 이미지`} class="venue-hero-img" width="500" height="500" loading="eager" />
      )}
      <span class="venue-hero__cat-badge">나이트</span>
      <h1 class="venue-hero__title">{h1Title}</h1>
    </div>
  </section>

  <div class="container content-narrow">
    {v.intro && (
      <IntroSection
        hook={v.intro.hook}
        valuePromise={v.intro.valuePromise}
        scanBox={v.intro.scanBox}
        checklist={v.intro.checklist}
        riskItems={v.intro.riskItems}
        teasers={v.intro.teasers}
      />
    )}

    <section class="quick-summary" id="summary">
      <div class="quick-summary__title">{si.summaryTitle || `${v.name_display} 한눈에 보기`}</div>
      <ul class="quick-summary__list">
        <li>{v.region} 소재 나이트 · {v.geo.formatted_address !== '확인 필요' ? v.geo.formatted_address : `${v.region} 지역`}</li>
        <li>무드 — {v.bodySections.atmosphere.split('.')[0]}.</li>
        <li>무대 — {v.bodySections.music.split('.')[0]}.</li>
        {v.checklist[0] && <li>처음이라면: {v.checklist[0]}</li>}
        {v.timeline[0] && <li>골든타임: {v.timeline[0].time} — {v.timeline[0].label}</li>}
        <li>최종 확인: {updateDate}</li>
      </ul>
    </section>

    <div class="venue-cta-inline">
      <a href={mapUrl} target="_blank" rel="noopener noreferrer" class="venue-cta-btn venue-cta-btn--primary">오늘 밤 {shortName} 찾아가기</a>
      <a href="/nights/" class="venue-cta-btn">전국 나이트 둘러보기</a>
    </div>

    <aside class="fact-box" aria-label="기본 정보">
      <time class="fact-box__date" datetime={updateDate}>갱신 {updateDate}</time>
    </aside>

    <nav class="toc">
      <h3>목차</h3>
      <ol>
        {tocItems.map(item => (
          <li><a href={`#${item.id}`}>{item.label}</a></li>
        ))}
      </ol>
    </nav>

    {v.hookIntro && (
      <section class="venue-section" id="hook">
        <h2>첫인상</h2>
        <p>{v.hookIntro}</p>
      </section>
    )}

    <section class="venue-section" id="atmosphere">
      <h2>무드 & 톤</h2>
      <p class="section-lead">{si.atmosphereLead || `${v.name_display}의 공간 무드를 정리합니다.`}</p>
      <p>{v.bodySections.atmosphere}</p>
    </section>

    <section class="venue-section" id="story">
      <h2>하룻밤 이야기: {v.storyFrame.style}</h2>
      <div class="accordion">
        <div class="accordion-item">
          <button class="accordion-trigger">입장 — 첫 발을 내딛는 순간 <span class="icon">▼</span></button>
          <div class="accordion-content"><div class="accordion-content-inner">{v.story.scene1}</div></div>
        </div>
        <div class="accordion-item">
          <button class="accordion-trigger">몰입 — 음악 속으로 걸어 들어가다 <span class="icon">▼</span></button>
          <div class="accordion-content"><div class="accordion-content-inner">{v.story.scene2}</div></div>
        </div>
        <div class="accordion-item">
          <button class="accordion-trigger">클라이맥스 — 밤이 가장 뜨거운 시간 <span class="icon">▼</span></button>
          <div class="accordion-content"><div class="accordion-content-inner">{v.story.scene3}</div></div>
        </div>
        <div class="accordion-item">
          <button class="accordion-trigger">오감 — 조명, 소리, 공기까지 <span class="icon">▼</span></button>
          <div class="accordion-content"><div class="accordion-content-inner">{v.story.scene4}</div></div>
        </div>
        <div class="accordion-item">
          <button class="accordion-trigger">여운 — 돌아가는 길의 기분 <span class="icon">▼</span></button>
          <div class="accordion-content"><div class="accordion-content-inner">{v.story.scene5}</div></div>
        </div>
        {v.story.scene6 && (
          <div class="accordion-item">
            <button class="accordion-trigger">인물 — 그곳에서 만난 사람들 <span class="icon">▼</span></button>
            <div class="accordion-content"><div class="accordion-content-inner">{v.story.scene6}</div></div>
          </div>
        )}
        {v.story.scene7 && (
          <div class="accordion-item">
            <button class="accordion-trigger">비하인드 — 무대 뒤 이야기 <span class="icon">▼</span></button>
            <div class="accordion-content"><div class="accordion-content-inner">{v.story.scene7}</div></div>
          </div>
        )}
        {v.story.scene8 && (
          <div class="accordion-item">
            <button class="accordion-trigger">재방문 — 다시 찾게 되는 이유 <span class="icon">▼</span></button>
            <div class="accordion-content"><div class="accordion-content-inner">{v.story.scene8}</div></div>
          </div>
        )}
      </div>
    </section>

    <section class="venue-section" id="gallery">
      <h2>포토</h2>
      <div class="gallery-mid">
        {v.images.slice(0, 3).map((img, i) => (
          <img src={encodeURI(img.src)} alt={`${v.name_display} ${i === 0 ? '외관 전경' : i === 1 ? '내부 전경' : '무대와 조명'}`} width="400" height="400" loading="lazy" />
        ))}
      </div>
    </section>

    <section class="venue-section" id="timeline">
      <h2>밤의 흐름</h2>
      <p class="section-lead">{si.timelineLead || `${v.name_display}의 시간대별 흐름 변화를 살펴봅니다.`}</p>
      <div class="timeline">
        {v.timeline.map(t => (
          <div class="timeline-item">
            <div class="timeline-dot"></div>
            <div class="timeline-time">{t.time}</div>
            <div class="timeline-label">{t.label}</div>
            <div class="timeline-desc">{t.desc}</div>
          </div>
        ))}
      </div>
    </section>

    <section class="venue-section" id="planner">
      <h2>나만의 코스 짜기</h2>
      <div class="planner">
        <div class="planner-group">
          <label>목적</label>
          <div class="planner-options" data-group="purpose">
            {Object.keys(v.plannerRules['p'] || {}).map((k, i) => (
              <button class="planner-btn" data-key={`p${i}`} >{k}</button>
            ))}
          </div>
        </div>
        <div class="planner-group">
          <label>시간대</label>
          <div class="planner-options" data-group="time">
            {Object.keys(v.plannerRules['t'] || {}).map((k, i) => (
              <button class="planner-btn" data-key={`t${i}`} >{k}</button>
            ))}
          </div>
        </div>
        <div class="planner-result" id="plannerResult">
          위에서 목적과 시간대를 골라보세요.
        </div>
      </div>
    </section>

    <section class="venue-section" id="checklist">
      <h2>방문 전 준비물</h2>
      <p class="section-lead">{si.checklistLead || `${v.name_display} 방문 전 꼭 확인할 항목입니다.`}</p>
      <table class="checklist-table">
        <thead><tr><th>항목</th><th>확인</th></tr></thead>
        <tbody>
          {v.checklist.map((item, i) => (
            <tr><td>{item}</td><td><input type="checkbox" id={`ck${i}`} /></td></tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="venue-section" id="music">
      <h2>라이브 & 음악</h2>
      <p class="section-lead">{si.musicLead || `${v.name_display}에서 경험할 수 있는 사운드입니다.`}</p>
      <p>{v.bodySections.music}</p>
    </section>

    <section class="venue-section" id="location">
      <h2>오시는 길</h2>
      <div class="location-info">
        {v.geo.precision !== 'none' ? (
          <p><span class="location-label">주소:</span> {v.geo.formatted_address === '확인 필요' ? '확인 필요 – 출발 전 직접 확인을 권장합니다' : v.geo.formatted_address}</p>
        ) : (
          <p>정확한 위치 정보 확인이 필요합니다. 출발 전 직접 확인을 권장합니다.</p>
        )}
      </div>
      <div class="map-buttons">
        <a href={mapUrl} target="_blank" rel="noopener noreferrer" class="map-btn map-btn--naver">네이버 지도로 길 찾기</a>
        <a href={`https://www.google.com/maps/search/${encodeURIComponent(v.name_display)}`} target="_blank" rel="noopener noreferrer" class="map-btn map-btn--google">구글 맵에서 확인</a>
      </div>
    </section>

    <div class="venue-cta-inline">
      <a href={mapUrl} target="_blank" rel="noopener noreferrer" class="venue-cta-btn venue-cta-btn--primary">지금 바로 길 찾기</a>
      <a href={`/region/${v.regionSlug}/`} class="venue-cta-btn">{v.region} 다른 곳도 보기</a>
    </div>

    <section class="venue-section" id="faq">
      <h2>궁금한 점</h2>
      <p class="section-lead">{si.faqLead || `${v.name_display}에 대해 자주 묻는 질문을 모았습니다.`}</p>
      {v.faq.map(f => (
        <div class="faq-item">
          <div class="faq-q">{f.q}</div>
          <div class="faq-a">{f.a}</div>
        </div>
      ))}
    </section>

    <section class="venue-section">
      <h2>매너와 안전</h2>
      <p>{v.bodySections.safety}</p>
    </section>

    <section class="venue-conclusion" id="conclusion">
      <h2>에디터 한마디</h2>
      <p>{conclusionText}</p>
      <div class="venue-cta-inline">
        <a href={mapUrl} target="_blank" rel="noopener noreferrer" class="venue-cta-btn venue-cta-btn--primary">오늘 밤 {shortName} 찾아가기</a>
        <a href="/nights/" class="venue-cta-btn">전국 나이트 둘러보기</a>
      </div>
    </section>

    <section class="venue-section" id="related">
      <h2>함께 보면 좋은 곳</h2>
      <div class="related-grid">
        {relatedVenues.map(rv => (
          <a href={encodeURI(getVenueUrl(rv!))} class="related-link">{rv!.name_display}</a>
        ))}
        <a href={`/region/${v.regionSlug}/`} class="related-link">{v.region} 전체 보기</a>
        <a href="/nights/" class="related-link">나이트 전체 목록</a>
      </div>
    </section>

    <aside class="trust-block" id="trust">
      <h3>정보 신뢰도</h3>
      <ul class="update-log">
        <li><time datetime={updateDate}>{updateDate}</time> <span>현장 확인 및 정보 갱신</span></li>
        <li><time datetime="2026-02-10">2026-02-10</time> <span>최초 등록</span></li>
      </ul>
      <div class="trust-block__links">
        <a href="/about/">편집 원칙 보기</a>
        <button type="button" id="correctionBtn">오류 제보</button>
      </div>
    </aside>

    <div class="venue-cta-area">
      <a href={mapUrl} target="_blank" rel="noopener noreferrer" class="venue-cta-btn venue-cta-btn--primary">지금 바로 길 찾기</a>
      <a href="/nights/" class="venue-cta-btn">목록으로</a>
    </div>
  </div>

  {(v.phone || (v.regionSlug === 'suyu' && (v.urlSlug === '샴푸' || v.venueSlug === '샴푸'))) && (
    <a href={`tel:${v.phone ? v.phone.replace(/-/g, '') : '01074752342'}`} target="_blank" rel="noopener" class="fixed-phone-btn" id="fixedPhoneBtn" aria-label="전화하기" style="display:none;">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
      {v.phone ? '전화문의' : '010-7475-2342'}
    </a>
  )}
  <script>
    !function(){var btn=document.getElementById("fixedPhoneBtn");if(!btn)return;window.addEventListener("scroll",function(){btn.style.display=window.scrollY>200?"flex":"none"},{passive:!0})}();
  </script>

  <script define:vars={{ plannerRules: v.plannerRules }}>
    let selectedPurpose = '';
    let selectedTime = '';

    document.querySelectorAll('.planner-options').forEach(group => {
      group.querySelectorAll('.planner-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const g = group.getAttribute('data-group');
          const key = btn.textContent?.trim() || '';
          group.querySelectorAll('.planner-btn').forEach(b => b.classList.remove('selected'));
          btn.classList.add('selected');
          if (g === 'purpose') selectedPurpose = key;
          if (g === 'time') selectedTime = key;
          updatePlan();
        });
      });
    });

    function updatePlan() {
      const result = document.getElementById('plannerResult');
      if (!result) return;
      let text = '';
      if (selectedPurpose && plannerRules['p']) {
        text += plannerRules['p'][selectedPurpose] || '';
      }
      if (selectedTime && plannerRules['t']) {
        text += (text ? ' ' : '') + (plannerRules['t'][selectedTime] || '');
      }
      result.textContent = text || '위에서 목적과 시간대를 골라보세요.';
    }
  </script>
</BaseLayout>
