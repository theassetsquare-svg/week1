---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { venues, getVenuesByType, getVenue, getVenueUrl, getReadingTime, guides } from '../../../utils/venues';

export function getStaticPaths() {
  return venues.filter(v => v.type === 'night').map(v => ({
    params: { regionSlug: v.regionSlug, venueSlug: v.urlSlug || v.venueSlug },
    props: { venue: v },
  }));
}

const { venue } = Astro.props;
const v = venue;
const readTime = getReadingTime(v);
const siteUrl = 'https://week1-6m5.pages.dev';
const venueUrl = getVenueUrl(v);
const updateDate = '2026-02-18';

const sameRegion = v.relatedVenueIds.sameRegion.map(id => getVenue(id)).filter(Boolean).slice(0, 3);
const sameType = v.relatedVenueIds.sameType.map(id => getVenue(id)).filter(Boolean).slice(0, 3);
const nearby = v.relatedVenueIds.nearby.map(id => getVenue(id)).filter(Boolean).slice(0, 2);

const ogImage = `https://week1-6m5.pages.dev${v.images[0].src}`;
const title = v.seoTitle || `${v.name_display} 후기·가격·영업시간·부킹 2026`;
const description = v.seoDescription || `${v.name_display} – ${v.teaser}`.slice(0, 155);

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "홈", "item": siteUrl },
      { "@type": "ListItem", "position": 2, "name": "나이트", "item": `${siteUrl}/nights/` },
      { "@type": "ListItem", "position": 3, "name": v.region, "item": `${siteUrl}/region/${v.regionSlug}/` },
      { "@type": "ListItem", "position": 4, "name": v.name_display, "item": `${siteUrl}${venueUrl}` },
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "NightClub",
    "name": v.name_display,
    "description": v.teaser,
    "image": ogImage,
    "url": `${siteUrl}${venueUrl}`,
    ...(v.geo.precision !== 'none' ? {
      "address": {
        "@type": "PostalAddress",
        "addressLocality": v.geo.city || v.region,
        "addressRegion": v.geo.district || v.region,
        "addressCountry": "KR",
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": v.geo.lat,
        "longitude": v.geo.lon,
      },
    } : {}),
  },
];

const tocItems = [
  { id: 'hook', label: '소개' },
  { id: 'atmosphere', label: '감성 요약' },
  { id: 'story', label: '스토리텔링' },
  { id: 'timeline', label: '타임라인' },
  { id: 'planner', label: '커스텀 코스' },
  { id: 'checklist', label: '첫방문 체크리스트' },
  { id: 'music', label: '뮤직 노트' },
  { id: 'location', label: '위치/교통' },
  { id: 'faq', label: 'FAQ' },
  { id: 'related', label: '관련 매장' },
  { id: 'gallery', label: '갤러리' },
];
---
<BaseLayout title={title} description={description} canonical={`${siteUrl}${venueUrl}`} ogImage={ogImage} keywords={[...new Set(v.keywords)].slice(0, 5).join(', ')} jsonLd={jsonLd}>
  <section class="venue-hero-immersive venue-hero-immersive--night">
    <div class="container content-narrow">
      <div class="breadcrumb">
        <a href="/">홈</a><span>/</span>
        <a href="/nights/">나이트</a><span>/</span>
        <a href={`/region/${v.regionSlug}/`}>{v.region}</a><span>/</span>
        <span>{v.name_display}</span>
      </div>
      <img src={v.images[0].src} alt={v.images[0].alt} class="venue-hero-img" width="500" height="500" loading="eager" />
      <h1 class="venue-hero__title">{v.name_display}</h1>
    </div>
  </section>

  <div class="container content-narrow">
    <aside class="fact-box" aria-label="기본 정보">
      <dl class="fact-box__list">
        <div class="fact-box__item"><dt>권역</dt><dd>{v.region}</dd></div>
        {v.geo.precision !== 'none' && v.geo.formatted_address && v.geo.formatted_address !== '확인 필요' && (
          <div class="fact-box__item"><dt>주소</dt><dd>{v.geo.formatted_address}</dd></div>
        )}
      </dl>
      <time class="fact-box__date" datetime={updateDate}>갱신 {updateDate}</time>
      <p class="fact-box__notice">이 글은 정보성 읽을거리이며, 불법 알선과 무관합니다.</p>
    </aside>

    <nav class="toc">
      <h3>목차</h3>
      <ol>
        {tocItems.map(item => (
          <li><a href={`#${item.id}`}>{item.label}</a></li>
        ))}
      </ol>
    </nav>

    <!-- Hook Intro -->
    {v.hookIntro && (
      <section class="venue-section" id="hook">
        <h2>소개</h2>
        <p>{v.hookIntro}</p>
      </section>
    )}

    <!-- 1. Atmosphere -->
    <section class="venue-section" id="atmosphere">
      <h2>감성 요약</h2>
      <p>{v.bodySections.atmosphere}</p>
    </section>

    <!-- 2. Storytelling -->
    <section class="venue-section" id="story">
      <h2>스토리텔링: {v.storyFrame.style}</h2>
      <div class="accordion">
        <div class="accordion-item">
          <button class="accordion-trigger">Act 1 – 도착 <span class="icon">▼</span></button>
          <div class="accordion-content"><div class="accordion-content-inner">{v.story.scene1}</div></div>
        </div>
        <div class="accordion-item">
          <button class="accordion-trigger">Act 2 – 경험 <span class="icon">▼</span></button>
          <div class="accordion-content"><div class="accordion-content-inner">{v.story.scene2}</div></div>
        </div>
        <div class="accordion-item">
          <button class="accordion-trigger">Act 3 – 절정과 마무리 <span class="icon">▼</span></button>
          <div class="accordion-content"><div class="accordion-content-inner">{v.story.scene3}</div></div>
        </div>
        <div class="accordion-item">
          <button class="accordion-trigger">감각의 디테일 <span class="icon">▼</span></button>
          <div class="accordion-content"><div class="accordion-content-inner">{v.story.scene4}</div></div>
        </div>
        <div class="accordion-item">
          <button class="accordion-trigger">감성의 여운 <span class="icon">▼</span></button>
          <div class="accordion-content"><div class="accordion-content-inner">{v.story.scene5}</div></div>
        </div>
        {v.story.scene6 && (
          <div class="accordion-item">
            <button class="accordion-trigger">Act 4 – 사람들 <span class="icon">▼</span></button>
            <div class="accordion-content"><div class="accordion-content-inner">{v.story.scene6}</div></div>
          </div>
        )}
        {v.story.scene7 && (
          <div class="accordion-item">
            <button class="accordion-trigger">Act 5 – 비하인드 <span class="icon">▼</span></button>
            <div class="accordion-content"><div class="accordion-content-inner">{v.story.scene7}</div></div>
          </div>
        )}
        {v.story.scene8 && (
          <div class="accordion-item">
            <button class="accordion-trigger">Act 6 – 재방문 <span class="icon">▼</span></button>
            <div class="accordion-content"><div class="accordion-content-inner">{v.story.scene8}</div></div>
          </div>
        )}
      </div>
    </section>

    <!-- 3. Timeline -->
    <section class="venue-section" id="timeline">
      <h2>타임라인</h2>
      <div class="timeline">
        {v.timeline.map(t => (
          <div class="timeline-item">
            <div class="timeline-dot"></div>
            <div class="timeline-time">{t.time}</div>
            <div class="timeline-label">{t.label}</div>
            <div class="timeline-desc">{t.desc}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- 4. Planner -->
    <section class="venue-section" id="planner">
      <h2>커스텀 코스</h2>
      <div class="planner">
        <div class="planner-group">
          <label>목적을 선택하세요</label>
          <div class="planner-options" data-group="purpose">
            {Object.keys(v.plannerRules['목적'] || {}).map(k => (
              <button class="planner-btn" data-key={k}>{k}</button>
            ))}
          </div>
        </div>
        <div class="planner-group">
          <label>시간대를 선택하세요</label>
          <div class="planner-options" data-group="time">
            {Object.keys(v.plannerRules['시간대'] || {}).map(k => (
              <button class="planner-btn" data-key={k}>{k}</button>
            ))}
          </div>
        </div>
        <div class="planner-result" id="plannerResult">
          목적과 시간대를 선택하면 맞춤 플랜이 표시됩니다.
        </div>
      </div>
    </section>

    <!-- 5. Checklist -->
    <section class="venue-section" id="checklist">
      <h2>첫방문 체크리스트</h2>
      <table class="checklist-table">
        <thead><tr><th>항목</th><th>체크</th></tr></thead>
        <tbody>
          {v.checklist.map((item, i) => (
            <tr><td>{item}</td><td><input type="checkbox" id={`ck${i}`} /></td></tr>
          ))}
        </tbody>
      </table>
    </section>

    <!-- 6. Music -->
    <section class="venue-section" id="music">
      <h2>음악 정보</h2>
      <p>{v.bodySections.music}</p>
    </section>

    <!-- 7. Location -->
    <section class="venue-section" id="location">
      <h2>위치/교통</h2>
      <div class="location-info">
        {v.geo.precision !== 'none' ? (
          <>
            <p><span class="location-label">주소:</span> {v.geo.formatted_address === '확인 필요' ? '확인 필요 – 출발 전 직접 확인을 권장합니다' : v.geo.formatted_address}</p>
          </>
        ) : (
          <p>정확한 위치 정보 확인이 필요합니다. 출발 전 직접 확인을 권장합니다.</p>
        )}
      </div>
      <div class="map-buttons">
        <a href={`https://map.naver.com/v5/search/${encodeURIComponent(v.name_display)}`} target="_blank" rel="noopener noreferrer" class="map-btn map-btn--naver">네이버지도 검색</a>
        <a href={`https://www.google.com/maps/search/${encodeURIComponent(v.name_display)}`} target="_blank" rel="noopener noreferrer" class="map-btn map-btn--google">구글지도 검색</a>
      </div>
    </section>

    <!-- 8. FAQ -->
    <section class="venue-section" id="faq">
      <h2>자주 묻는 질문</h2>
      {v.faq.map(f => (
        <div class="faq-item">
          <div class="faq-q">{f.q}</div>
          <div class="faq-a">{f.a}</div>
        </div>
      ))}
    </section>

    <!-- 9. Safety -->
    <section class="venue-section">
      <h2>매너/안전/예산 안내</h2>
      <p>{v.bodySections.safety}</p>
    </section>

    <!-- 10. Related -->
    <section class="venue-section" id="related">
      <h2>관련 매장</h2>
      {sameRegion.length > 0 && (
        <div class="related-section">
          <h3>근처</h3>
          <div class="related-grid">
            {sameRegion.map(rv => (
              <a href={getVenueUrl(rv!)} class="related-link">{rv!.name_display.replace(v.region + ' ', '')}</a>
            ))}
          </div>
        </div>
      )}
      {sameType.length > 0 && (
        <div class="related-section">
          <h3>같은 유형</h3>
          <div class="related-grid">
            {sameType.map(rv => (
              <a href={getVenueUrl(rv!)} class="related-link">{rv!.name_display.replace(v.region + ' ', '')}</a>
            ))}
          </div>
        </div>
      )}
      {nearby.length > 0 && (
        <div class="related-section">
          <h3>가까운 매장</h3>
          <div class="related-grid">
            {nearby.map(rv => (
              <a href={getVenueUrl(rv!)} class="related-link">{rv!.name_display.replace(v.region + ' ', '')}</a>
            ))}
          </div>
        </div>
      )}
      <div class="related-section">
        <h3>참고 자료</h3>
        <div class="related-grid">
          {guides.slice(0, 2).map(g => (
            <a href={`/guides/${g.slug}/`} class="related-link">{g.title}</a>
          ))}
        </div>
      </div>
      <div class="related-section">
        <div class="related-grid">
          <a href={`/region/${v.regionSlug}/`} class="related-link">전체 보기</a>
          <a href="/nights/" class="related-link">전체 목록 보기</a>
        </div>
      </div>
    </section>

    <!-- 11. Gallery -->
    <section class="venue-section" id="gallery">
      <h2>갤러리</h2>
      <div class="gallery">
        {v.images.slice(0, 3).map((img, i) => (
          <figure>
            <img src={img.src} alt={img.alt} width="400" height="340" loading="lazy" />
            {v.imagePrompts[i] && <figcaption class="gallery-caption">{v.imagePrompts[i]}</figcaption>}
          </figure>
        ))}
      </div>
    </section>

    <!-- 14. Deep Dive Content -->
    <section class="venue-section" id="deepdive">
      <h2>심층 분석</h2>
      <div class="deepdive-grid">
        <div class="deepdive-card">
          <h3>사전 체크포인트</h3>
          <p>{v.bodySections.deepDive?.checkpoint || '복장은 단정한 캐주얼이 기본이며 러닝셔츠나 슬리퍼는 피하자. 도착은 21~22시가 적당하며 너무 이르면 한산할 수 있다.'}</p>
        </div>
        <div class="deepdive-card">
          <h3>씬의 발자취</h3>
          <p>{v.bodySections.deepDive?.history || '밤문화는 오랜 시간에 걸쳐 단순 유흥에서 사운드·패션·사교가 어우러진 복합 문화로 진화했다.'}</p>
        </div>
        <div class="deepdive-card">
          <h3>시즌 노트</h3>
          <p>{v.bodySections.deepDive?.season || '계절마다 분위기가 달라진다. 봄과 가을이 가장 쾌적하며, 연말에는 사전 예약이 필수다.'}</p>
        </div>
        <div class="deepdive-card">
          <h3>필수 코스</h3>
          <p>{v.bodySections.deepDive?.course || '1차로 든든한 저녁 식사 후 입장해 자리를 잡는다. 피크타임에 맞춰 즐기고, 마무리는 해장국으로.'}</p>
        </div>
      </div>
    </section>

    <!-- SEO: Keywords section -->
    <section class="venue-section" id="keywords-seo" style="margin-top:2rem;">
      <h2>관련 검색어</h2>
      <div class="keyword-cloud">
        {v.keywords.map(kw => (
          <span class="keyword-tag">{kw}</span>
        ))}
      </div>
    </section>
  </div>

  <script define:vars={{ plannerRules: v.plannerRules }}>
    let selectedPurpose = '';
    let selectedTime = '';

    document.querySelectorAll('.planner-options').forEach(group => {
      group.querySelectorAll('.planner-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const g = group.getAttribute('data-group');
          const key = btn.getAttribute('data-key') || '';
          group.querySelectorAll('.planner-btn').forEach(b => b.classList.remove('selected'));
          btn.classList.add('selected');
          if (g === 'purpose') selectedPurpose = key;
          if (g === 'time') selectedTime = key;
          updatePlan();
        });
      });
    });

    function updatePlan() {
      const result = document.getElementById('plannerResult');
      if (!result) return;
      let text = '';
      if (selectedPurpose && plannerRules['목적']) {
        text += plannerRules['목적'][selectedPurpose] || '';
      }
      if (selectedTime && plannerRules['시간대']) {
        text += (text ? ' ' : '') + (plannerRules['시간대'][selectedTime] || '');
      }
      result.textContent = text || '목적과 시간대를 선택하면 맞춤 플랜이 표시됩니다.';
    }
  </script>
</BaseLayout>
