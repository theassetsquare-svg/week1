---
import BaseLayout from '../layouts/BaseLayout.astro';
import { MAIN_SITE_URL } from '../data/venues';
---

<BaseLayout
  title="페이지를 찾을 수 없습니다 — 나이트코리아 사이버"
  description="요청하신 페이지를 찾을 수 없습니다. 메인 페이지로 이동하세요."
>
  <div class="page-content text-center" style="padding:60px 16px;">
    <h1 style="font-size:48px;margin-bottom:8px;">404_</h1>
    <p style="color:var(--purple);font-family:var(--font-cyber);margin-bottom:24px;">
      // PAGE NOT FOUND
    </p>
    <p style="margin-bottom:24px;">요청하신 페이지가 존재하지 않습니다.</p>
    <a href="/" class="cta-btn" style="margin-right:8px;">홈으로 →</a>
    <a href={MAIN_SITE_URL} target="_blank" rel="noopener noreferrer" class="cta-btn-purple cta-btn">
      오늘밤어디 →
    </a>
  </div>
</BaseLayout>
