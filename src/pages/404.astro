---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = '페이지를 찾을 수 없습니다 — 나이트코리아 전국 나이트·클럽·라운지 가이드';
const description = '요청하신 페이지를 찾을 수 없습니다. 나이트코리아 메인 페이지에서 전국 나이트, 클럽, 라운지 정보를 검색하거나 지역별 나이트라이프 가이드를 확인해보세요.';
---
<BaseLayout title={title} description={description}>
  <section class="hero" style="min-height: 50vh; display: flex; align-items: center;">
    <div class="container" style="text-align: center;">
      <img src="/assets/hero-404.svg" alt="페이지를 찾을 수 없습니다" style="max-width: 300px; margin: 0 auto 2rem;" width="500" height="300" loading="lazy" />
      <h1 style="font-size: 4rem; margin-bottom: 1rem;">404</h1>
      <p style="font-size: 1.2rem; color: var(--text-secondary); margin-bottom: 1.5rem;">페이지를 찾을 수 없습니다</p>
      <p style="color: var(--text-secondary); font-size: 0.95rem; margin-bottom: 1.5rem;">찾으시는 페이지가 이동되었거나 삭제되었을 수 있습니다. 아래에서 원하는 정보를 찾아보세요.</p>
      <div class="intro-scan-box" style="text-align: left; max-width: 400px; margin: 0 auto 2rem;">
        <div class="intro-scan-box__title">바로가기</div>
        <ul class="intro-scan-box__list">
          <li><a href="/" target="_blank" rel="noopener noreferrer" style="color:var(--accent);">메인 페이지</a>에서 전국 매장 검색</li>
          <li><a href="/nights/" target="_blank" rel="noopener noreferrer" style="color:var(--accent);">나이트</a> · <a href="/clubs/" target="_blank" rel="noopener noreferrer" style="color:var(--accent);">클럽</a> · <a href="/lounges/" target="_blank" rel="noopener noreferrer" style="color:var(--accent);">라운지</a> 목록 둘러보기</li>
          <li><a href="/guides/" target="_blank" rel="noopener noreferrer" style="color:var(--accent);">가이드</a>에서 첫 방문 팁 확인</li>
          <li><a href="/guides/safety-tips/" target="_blank" rel="noopener noreferrer" style="color:var(--accent);">안전 수칙</a>과 <a href="/guides/dress-code/" target="_blank" rel="noopener noreferrer" style="color:var(--accent);">드레스코드</a> 확인</li>
        </ul>
      </div>
      <a href="/" target="_blank" rel="noopener noreferrer" style="display: inline-block; padding: 0.8rem 2rem; background: var(--text-primary); color: #fff; border-radius: var(--radius-sm); font-weight: 600;">메인으로 돌아가기</a>
    </div>
  </section>
</BaseLayout>
