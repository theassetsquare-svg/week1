---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = '페이지를 찾을 수 없습니다 | 나이트라이프 코리아';
const description = '요청하신 페이지를 찾을 수 없습니다. 메인 페이지에서 원하는 정보를 검색해보세요.';
---
<BaseLayout title={title} description={description}>
  <section class="hero" style="min-height: 50vh; display: flex; align-items: center;">
    <div class="container" style="text-align: center;">
      <h1 style="font-size: 4rem; margin-bottom: 1rem;">404</h1>
      <p style="font-size: 1.2rem; color: var(--text-secondary); margin-bottom: 2rem;">페이지를 찾을 수 없습니다</p>
      <a href="/" style="display: inline-block; padding: 0.8rem 2rem; background: var(--accent-purple); color: #fff; border-radius: var(--radius-md); font-weight: 600;">메인으로 돌아가기</a>
    </div>
  </section>
</BaseLayout>
