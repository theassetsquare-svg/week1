---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_URL } from '../data/venues';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "입점 안내",
  "url": `${SITE_URL}/for-business/`
};
---

<BaseLayout
  title="업주 입점 안내 — 가게 등록하면 손님이 찾아옵니다"
  description="밤키에 가게 올리면 검색 노출부터 전용 페이지까지 알아서 됩니다. 카톡 한 번이면 시작."
  canonical={`${SITE_URL}/for-business/`}
  jsonLd={jsonLd}
>
  <div class="biz-page">
    <div class="biz-header">
      <h1>입점 안내</h1>
      <p>밤키에 가게 올리면 손님이 직접 찾아옵니다</p>
    </div>

    <div class="biz-benefits">
      <div class="biz-card">
        <div class="biz-icon">📊</div>
        <h3>검색하면 바로 뜹니다</h3>
        <p>카테고리 랭킹, 검색 결과에 가게가 바로 노출됩니다</p>
      </div>
      <div class="biz-card">
        <div class="biz-icon">📱</div>
        <h3>전용 페이지 생성</h3>
        <p>가게 전용 페이지가 만들어집니다. 타임라인, 후기, 연락처까지 한 곳에</p>
      </div>
      <div class="biz-card">
        <div class="biz-icon">🎯</div>
        <h3>타겟 마케팅</h3>
        <p>지역·카테고리별 필터링으로 정확한 고객에게 도달합니다</p>
      </div>
    </div>

    <div class="biz-cta">
      <h2>입점 상담</h2>
      <p>카카오톡으로 간편하게 문의하세요</p>
      <a href="http://pf.kakao.com/_YSxjxhX/chat" target="_blank" rel="noopener noreferrer" class="btn btn-primary">카카오톡 상담하기 →</a>
    </div>
  </div>

  <style>
    .biz-page{max-width:600px;margin:0 auto;padding:24px 16px 48px}
    .biz-header{text-align:center;padding:32px 0}
    .biz-header h1{font-size:28px;margin-bottom:8px}
    .biz-header p{color:var(--text-light,#888);font-size:15px}
    .biz-benefits{display:flex;flex-direction:column;gap:16px;margin-bottom:40px}
    .biz-card{padding:24px;background:var(--card-bg,#fff);border:1px solid var(--border,#e5e7eb);border-radius:16px;text-align:center}
    .biz-icon{font-size:36px;margin-bottom:12px}
    .biz-card h3{font-size:18px;margin-bottom:8px}
    .biz-card p{font-size:14px;color:var(--text-light,#888);line-height:1.6}
    .biz-cta{text-align:center;padding:40px 24px;background:var(--bg-secondary,#f5f5f5);border-radius:16px}
    .biz-cta h2{font-size:22px;margin-bottom:8px}
    .biz-cta p{color:var(--text-light,#888);margin-bottom:20px;font-size:15px}
  </style>
</BaseLayout>
